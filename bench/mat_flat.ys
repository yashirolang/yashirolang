# 行列積 N³（平坦な list[float]。版分けが効く形）
#
# ★ mat_flat.c と同じ書き方です。二重リスト（mat）や linalg.Matrix
#   （mat_linalg）との差が、そのまま
#   「ループの版分けが効いているか」「ベクトル化されているか」の指標になります。
#
# 注意: 版分けが効く条件は「数える形のループ・呼び出しなし・添字が誘導変数に
#   ついてアフィン」です。ここはその形になっています。
import time

N: int = 512

def make(seed: int) -> list[float]:
    d: list[float] = []
    s: int = seed
    for i in range(N * N):
        s = (s * 1103515 + 12345) % 2147483648
        d.append(float(s % 1000) / 1000.0)
    return d

def matmul(a: list[float], b: list[float], c: mut list[float]) -> None:
    i: int = 0
    while i < N:
        k: int = 0
        while k < N:
            aik: float = a[i * N + k]
            j: int = 0
            while j < N:
                c[i * N + j] = c[i * N + j] + aik * b[k * N + j]
                j = j + 1
            k = k + 1
        i = i + 1

def main() -> int:
    a: list[float] = make(1)
    b: list[float] = make(7)
    c: list[float] = []
    z: int = 0
    while z < N * N:
        c.append(0.0)
        z = z + 1

    t0: int = time.monotonic_ns()
    matmul(a, b, c)
    ms: float = time.since_ms(t0)

    t: float = 0.0
    for i in range(N):
        t = t + c[i * N + i]
    print("RESULT " + str(t))
    print("TIME_MS " + str(ms))
    return 0
