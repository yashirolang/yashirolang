# BLAS を繋いで行列積を速くする（A-33）
#
#   macOS : {{cc}} -O2 examples/blas_matmul{{ext}} -framework Accelerate -o blas_matmul
#   Linux : {{cc}} -O2 examples/blas_matmul{{ext}} -lopenblas -o blas_matmul
#
# ★ 512³ の行列積で、手書き（ベクトル化つき）36 ms に対して BLAS は 3 ms です。
#   キャッシュの段数まで合わせて磨かれた実装には、手書きは敵いません。
#   ⚠️ 写しは 1 回も起きません（list[float] の中身をそのまま渡します）。
import blas
import linalg
import time

N: int = 512

def fill(n: int) -> list[float]:
    xs: list[float] = linalg.zeros(n * n)
    i: int = 0
    while i < n * n:
        xs[i] = float(i % 7) * 0.5
        i = i + 1
    return xs

def hand_matmul(a: list[float], b: list[float], c: mut list[float], n: int) -> None:
    i: int = 0
    while i < n:
        k: int = 0
        while k < n:
            aik: float = a[i * n + k]
            j: int = 0
            while j < n:
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
                j = j + 1
            k = k + 1
        i = i + 1

def main() -> int:
    a: list[float] = fill(N)
    b: list[float] = fill(N)

    c1: list[float] = linalg.zeros(N * N)
    t0: int = time.now_ns()
    hand_matmul(a, b, c1, N)
    t1: int = time.now_ns()
    print("手書き " + str((t1 - t0) // 1000000) + " ms")

    t2: int = time.now_ns()
    c2: list[float] = blas.matmul_new(a, b, N, N, N)
    t3: int = time.now_ns()
    print("BLAS   " + str((t3 - t2) // 1000000) + " ms")

    # 答えが合っているか（左上と右下）
    print("一致 " + str(c1[0] == c2[0] and c1[N * N - 1] == c2[N * N - 1]))
    return 0
