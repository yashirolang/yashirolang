# spectrum — 信号の周波数を当てる
#
#   $ ./build/<cc> -O2 examples/spectrum<ext> -o spectrum && ./spectrum
#
#
# ★ <cc> はコンパイラのコマンド名、<ext> はソースの拡張子です（`make info` で分かります）。
#
# ★ ここに出てくる複素数も FFT も、**言語の組み込みではありません**。
#   lib/complex と lib/fft に本言語で書かれた、ふつうの
#   ライブラリです（0.7.0 の演算子の多重定義で書けるようになりました）。
import fft
import math
import strings

N: int = 64
RATE: float = 64.0        # 標本化周波数（Hz）

# 3 Hz と 10 Hz の正弦波を混ぜた信号を作る（10 Hz のほうが半分の振幅）
def make_signal() -> list[float]:
    xs: list[float] = []
    for n in range(N):
        t: float = float(n) / RATE
        v: float = math.sin(2.0 * math.pi() * 3.0 * t)
        v = v + 0.5 * math.sin(2.0 * math.pi() * 10.0 * t)
        xs.append(v)
    return xs

def main() -> int:
    xs: list[float] = make_signal()
    sp: list[float] = fft.spectrum(xs)

    print("周波数  振幅")
    # ⚠️ 後半は前半の鏡像なので、N/2 まで見れば足ります
    k: int = 0
    while k <= N // 2:
        amp: float = sp[k] * 2.0 / float(N)
        if amp > 0.01:
            freq: float = float(k) * RATE / float(N)
            bar: str = strings.repeat("#", int(amp * 40.0))
            print(strings.lpad(str(freq) + " Hz", 12) + "  " +
                  strings.lpad(str(amp), 10) + "  " + bar)
        k = k + 1
    return 0
