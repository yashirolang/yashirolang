# frame — 表形式のデータ（pandas でやっていたこと）
#
# ★ **列ごとに型のある表**です。CSV の読み書き・絞り込み・並べ替え・
#   集計・結合まで、本言語だけで書いてあります。
#
# 注意: **pandas の設計は真似していません。** pandas の列は「何でも入る」
#   ものですが、この言語には暗黙の型変換がありません。列は
#   `Column`（数値か文字列か）として持ち、**取り出すときに型を選ばせます**
#   （`df.num("price")` / `df.text("name")`）。取り違えたらその場でエラーです。
#
# ★ **欠損値（空の欄）は、黙って埋めも飛ばしもしません。**
#   pandas は欠損を NaN にして、平均では黙って飛ばし、足し算では NaN を広げます。
#   どちらが起きたかを見落とすと、集計の数字が静かに変わります。
#   ここでは欠損のある列を `num` / `text` で取り出そうとすると止め、
#   `fill_num`（埋める）か `drop_missing`（その行を捨てる）を**先に選ばせます**。
#
# 使い方:
#
#   import frame
#   df: frame.Frame = frame.read_csv("sales.csv")
#   print(frame.describe(df))
#   hi: frame.Frame = df.where(frame.gt(df.num("price"), 100.0))
#   print(str(frame.mean_of(hi.num("price"))))
#   g: frame.Frame = frame.agg(df, ["shop"], ["price", "price"], ["sum", "mean"])
#   j: frame.Frame = frame.join(df, shops, ["shop"], "left")
import dict
import i18n
import io
import math
import stats
import strings

# 列の種類
COL_NUM: int = 0
COL_TEXT: int = 1


# 外から来たデータ（CSV）の誤り。
# ★ 外から来るものは panic ではなく raises で返します（try_parse_csv / try_read_csv）。
class FrameError:
    message: str

    def init(self, message: own str) -> None:
        self.message = message


class Column:
    name: str
    kind: int
    nums: list[float]
    texts: list[str]
    # 欠損の印（nums / texts と同じ並び）と、その数
    miss: list[bool]
    nmiss: int

    def init(self, name: str, kind: int) -> None:
        self.name = copy(name)
        self.kind = kind
        self.nums = []
        self.texts = []
        self.miss = []
        self.nmiss = 0

    def size(self) -> int:
        if self.kind == COL_NUM:
            return len(self.nums)
        return len(self.texts)

    # 1 つ足す（missing なら欠損。値は数値なら 0.0、文字列なら "" を置きます）
    def push_num(mut self, x: float, missing: bool) -> None:
        if missing:
            self.nums.append(0.0)
        else:
            self.nums.append(x)
        self.push_mark(missing)

    def push_text(mut self, s: str, missing: bool) -> None:
        if missing:
            self.texts.append("")
        else:
            self.texts.append(copy(s))
        self.push_mark(missing)

    def push_mark(mut self, missing: bool) -> None:
        # ★ nums / texts に直に足されていた場合（古い書き方）も印の数を合わせます
        while len(self.miss) < self.size() - 1:
            self.miss.append(False)
        self.miss.append(missing)
        if missing:
            self.nmiss = self.nmiss + 1

    def is_missing(self, i: int) -> bool:
        return i < len(self.miss) and self.miss[i]

    # i 行目を元の列からもう 1 つの列へ写す（k が負なら欠損）
    def push_from(mut self, src: Column, k: int) -> None:
        if k < 0 or src.is_missing(k):
            if self.kind == COL_NUM:
                self.push_num(0.0, True)
            else:
                self.push_text("", True)
        elif self.kind == COL_NUM:
            self.push_num(src.nums[k], False)
        else:
            self.push_text(src.texts[k], False)

    # 1 行ぶんを文字列にする（CSV の書き出しで使います。欠損は空）
    def cell(self, i: int) -> str:
        if self.is_missing(i):
            return ""
        if self.kind == COL_NUM:
            return str(self.nums[i])
        return copy(self.texts[i])

    # 表示用（欠損は NA）
    def display(self, i: int) -> str:
        if self.is_missing(i):
            return "NA"
        return self.cell(i)


class Frame:
    cols: list[Column]

    def init(self) -> None:
        self.cols = []

    # ── 形 ──────────────────────────────────────────────

    def rows(self) -> int:
        if len(self.cols) == 0:
            return 0
        c: Column = self.cols[0]
        return c.size()

    def width(self) -> int:
        return len(self.cols)

    def names(self) -> list[str]:
        out: list[str] = []
        for c in self.cols:
            out.append(copy(c.name))
        return out

    def index_of(self, name: str) -> int:
        i: int = 0
        while i < len(self.cols):
            c: Column = self.cols[i]
            if c.name == name:
                return i
            i = i + 1
        return -1

    def has(self, name: str) -> bool:
        return self.index_of(name) >= 0

    # 注意: 「無い列」は None を返さず、その場で panic します。
    #   綴りを間違えた列名が空のリストとして流れていくほうが危険です。
    def col(self, name: str) -> Column:
        i: int = self.index_of(name)
        if i < 0:
            panic(i18n.pick("frame: 列 '" + name + "' がありません（ある列: " +
                            strings.join(self.names(), ", ") + "）",
                            "frame: no column '" + name + "' (columns: " + strings.join(self.names(), ", ") + ")"))
        return self.cols[i]

    def is_num(self, name: str) -> bool:
        return self.col(name).kind == COL_NUM

    # ── 取り出す（型を名前で選ぶ）──────────────────────
    #
    # 注意: **欠損のある列は取り出せません**（panic）。先に fill_num / fill_text で
    #   埋めるか、drop_missing で行を捨ててください。黙って 0 や "" として渡すと、
    #   平均や合計が静かに変わります。

    def num(self, name: str) -> list[float]:
        c: Column = self.col(name)
        if c.kind != COL_NUM:
            panic(i18n.pick("frame: 列 '" + name + "' は文字列の列です（num では取れません）",
                            "frame: column '" + name + "' is a text column (num cannot read it)"))
        check_no_missing(c)
        out: list[float] = []
        for x in c.nums:
            out.append(x)
        return out

    def text(self, name: str) -> list[str]:
        c: Column = self.col(name)
        if c.kind != COL_TEXT:
            panic(i18n.pick("frame: 列 '" + name + "' は数値の列です（text では取れません）",
                            "frame: column '" + name + "' is a numeric column (text cannot read it)"))
        check_no_missing(c)
        out: list[str] = []
        for s in c.texts:
            out.append(copy(s))
        return out

    # ── 欠損 ────────────────────────────────────────────

    def count_missing(self, name: str) -> int:
        return self.col(name).nmiss

    def has_missing(self, name: str) -> bool:
        return self.col(name).nmiss > 0

    # 欠損の行が True の印（where に渡せます）
    def is_missing(self, name: str) -> list[bool]:
        c: Column = self.col(name)
        out: list[bool] = []
        for i in range(c.size()):
            out.append(c.is_missing(i))
        return out

    # 欠損を v で埋めた新しい表
    def fill_num(self, name: str, v: float) -> Frame:
        if not self.is_num(name):
            panic(i18n.pick("frame.fill_num: 列 '" + name + "' は文字列の列です（fill_text を使ってください）",
                            "frame.fill_num: column '" + name + "' is a text column (use fill_text)"))
        return self.fill_with(name, v, "")

    def fill_text(self, name: str, s: str) -> Frame:
        if self.is_num(name):
            panic(i18n.pick("frame.fill_text: 列 '" + name + "' は数値の列です（fill_num を使ってください）",
                            "frame.fill_text: column '" + name + "' is a numeric column (use fill_num)"))
        return self.fill_with(name, 0.0, s)

    def fill_with(self, name: str, v: float, s: str) -> Frame:
        out: Frame = Frame()
        for c in self.cols:
            d: Column = Column(c.name, c.kind)
            for i in range(c.size()):
                if c.name == name and c.is_missing(i):
                    if c.kind == COL_NUM:
                        d.push_num(v, False)
                    else:
                        d.push_text(s, False)
                else:
                    d.push_from(c, i)
            out.cols.append(d)
        return out

    # どれかの列が欠損の行を捨てた新しい表
    def drop_missing(self) -> Frame:
        return self.drop_missing_in(self.names())

    # names の列のどれかが欠損の行を捨てた新しい表
    def drop_missing_in(self, names: list[str]) -> Frame:
        keep: list[bool] = []
        for i in range(self.rows()):
            ok: bool = True
            for nm in names:
                if self.col(nm).is_missing(i):
                    ok = False
            keep.append(ok)
        return self.where(keep)

    # ── 組み立てる ──────────────────────────────────────

    def add_num(mut self, name: str, xs: list[float]) -> None:
        self.check_new(name, len(xs))
        c: Column = Column(name, COL_NUM)
        for x in xs:
            c.push_num(x, False)
        self.cols.append(c)

    def add_text(mut self, name: str, xs: list[str]) -> None:
        self.check_new(name, len(xs))
        c: Column = Column(name, COL_TEXT)
        for s in xs:
            c.push_text(s, False)
        self.cols.append(c)

    # 欠損つきで足す（miss[i] が True の行は欠損）
    def add_num_opt(mut self, name: str, xs: list[float], miss: list[bool]) -> None:
        self.check_new(name, len(xs))
        if len(miss) != len(xs):
            panic(i18n.pick("frame.add_num_opt: 値と欠損の印の数が違います",
                            "frame.add_num_opt: the numbers of values and missing marks differ"))
        c: Column = Column(name, COL_NUM)
        for i in range(len(xs)):
            c.push_num(xs[i], miss[i])
        self.cols.append(c)

    def add_text_opt(mut self, name: str, xs: list[str], miss: list[bool]) -> None:
        self.check_new(name, len(xs))
        if len(miss) != len(xs):
            panic(i18n.pick("frame.add_text_opt: 値と欠損の印の数が違います",
                            "frame.add_text_opt: the numbers of values and missing marks differ"))
        c: Column = Column(name, COL_TEXT)
        for i in range(len(xs)):
            c.push_text(xs[i], miss[i])
        self.cols.append(c)

    def check_new(self, name: str, n: int) -> None:
        if self.has(name):
            panic(i18n.pick("frame: 列 '" + name + "' は既にあります",
                            "frame: column '" + name + "' already exists"))
        if len(self.cols) > 0 and n != self.rows():
            panic(i18n.pick("frame: 行数が合いません（表は " + str(self.rows()) +
                            " 行、足そうとした列は " + str(n) + " 行）",
                            "frame: row counts do not match (the frame has " + str(self.rows()) + " rows, the new column has " + str(n) + ")"))

    # ── 列を選ぶ ────────────────────────────────────────

    # names の列だけを、その順で
    def select(self, names: list[str]) -> Frame:
        out: Frame = Frame()
        for nm in names:
            if out.has(nm):
                panic(i18n.pick("frame.select: 列 '" + nm + "' を 2 回選んでいます",
                                "frame.select: column '" + nm + "' is selected twice"))
            out.cols.append(copy_column(self.col(nm), nm))
        return out

    # names の列を除いて
    # 注意: 名前が drop でないのは、drop がクラスのデストラクタの名前だからです（仕様 §6.2）
    def drop_cols(self, names: list[str]) -> Frame:
        for nm in names:
            self.col(nm)        # 無い列は panic（綴りの間違いを見逃さない）
        out: Frame = Frame()
        for c in self.cols:
            gone: bool = False
            for nm2 in names:
                if c.name == nm2:
                    gone = True
            if not gone:
                out.cols.append(copy_column(c, c.name))
        return out

    # 列の名前を変えて
    def rename(self, old: str, new: str) -> Frame:
        self.col(old)
        if old != new and self.has(new):
            panic(i18n.pick("frame.rename: 列 '" + new + "' は既にあります",
                            "frame.rename: column '" + new + "' already exists"))
        out: Frame = Frame()
        for c in self.cols:
            if c.name == old:
                out.cols.append(copy_column(c, new))
            else:
                out.cols.append(copy_column(c, c.name))
        return out

    # ── 行を選ぶ ────────────────────────────────────────

    # keep[i] が True の行だけを集めた新しい表を返します
    def where(self, keep: list[bool]) -> Frame:
        if len(keep) != self.rows():
            panic(i18n.pick("frame.where: 印の数が行数と違います（" + str(len(keep)) +
                            " と " + str(self.rows()) + "）",
                            "frame.where: the number of marks differs from the number of rows (" + str(len(keep)) + " and " + str(self.rows()) + ")"))
        idx: list[int] = []
        i: int = 0
        while i < len(keep):
            if keep[i]:
                idx.append(i)
            i = i + 1
        return self.take(idx)

    # idx に並べた行番号のとおりに行を取り出します（並べ替えにも使います）
    def take(self, idx: list[int]) -> Frame:
        n: int = self.rows()
        for k in idx:
            if k < 0 or k >= n:
                panic(i18n.pick("frame.take: 行番号が範囲外です（" + str(k) + "）",
                                "frame.take: row index out of range (" + str(k) + ")"))
        return self.take_opt(idx)

    # 同じく。ただし -1 の行は「すべて欠損の行」にします（join の left で使います）
    def take_opt(self, idx: list[int]) -> Frame:
        out: Frame = Frame()
        for c in self.cols:
            d: Column = Column(c.name, c.kind)
            for k in idx:
                d.push_from(c, k)
            out.cols.append(d)
        return out

    def head(self, n: int) -> Frame:
        m: int = n
        if m > self.rows():
            m = self.rows()
        if m < 0:
            m = 0
        idx: list[int] = []
        for i in range(m):
            idx.append(i)
        return self.take(idx)

    def tail(self, n: int) -> Frame:
        m: int = n
        if m > self.rows():
            m = self.rows()
        if m < 0:
            m = 0
        idx: list[int] = []
        for i in range(m):
            idx.append(self.rows() - m + i)
        return self.take(idx)

    # ── 並べ替え ────────────────────────────────────────
    #
    # ★ **安定です**（同じ値なら元の順を保ちます）。数値の列も文字列の列も並べられます。
    #   欠損は昇順でも降順でも**最後**に置きます。

    def sort_by(self, name: str) -> Frame:
        return self.sort_by_keys([copy(name)], [True])

    def sort_by_desc(self, name: str) -> Frame:
        return self.sort_by_keys([copy(name)], [False])

    # 複数の列で並べ替える（names[0] が最優先。asc[i] が False ならその列は降順）
    def sort_by_keys(self, names: list[str], asc: list[bool]) -> Frame:
        if len(names) != len(asc) or len(names) == 0:
            panic(i18n.pick("frame.sort_by_keys: 列と向きの数が合いません（または空です）",
                            "frame.sort_by_keys: the numbers of columns and directions do not match (or are empty)"))
        ki: list[int] = []
        for nm in names:
            self.col(nm)
            ki.append(self.index_of(nm))
        idx: list[int] = []
        for i in range(self.rows()):
            idx.append(i)
        return self.take(self.msort_rows(ki, asc, idx))

    # 行 a と b を比べる（負なら a が先）
    def cmp_rows(self, ki: list[int], asc: list[bool], a: int, b: int) -> int:
        k: int = 0
        while k < len(ki):
            c: Column = self.cols[ki[k]]
            ma: bool = c.is_missing(a)
            mb: bool = c.is_missing(b)
            r: int = 0
            if ma and mb:
                r = 0
            elif ma:
                return 1          # 欠損は向きに関わらず最後
            elif mb:
                return -1
            elif c.kind == COL_NUM:
                if c.nums[a] < c.nums[b]:
                    r = -1
                elif c.nums[a] > c.nums[b]:
                    r = 1
            else:
                if c.texts[a] < c.texts[b]:
                    r = -1
                elif c.texts[a] > c.texts[b]:
                    r = 1
            if r != 0:
                if asc[k]:
                    return r
                return -r
            k = k + 1
        return 0

    def msort_rows(self, ki: list[int], asc: list[bool], idx: list[int]) -> list[int]:
        if len(idx) <= 1:
            out: list[int] = []
            for k in idx:
                out.append(k)
            return out
        mid: int = len(idx) // 2
        a: list[int] = []
        b: list[int] = []
        i: int = 0
        while i < len(idx):
            if i < mid:
                a.append(idx[i])
            else:
                b.append(idx[i])
            i = i + 1
        sa: list[int] = self.msort_rows(ki, asc, a)
        sb: list[int] = self.msort_rows(ki, asc, b)
        out2: list[int] = []
        x: int = 0
        y: int = 0
        while x < len(sa) and y < len(sb):
            if self.cmp_rows(ki, asc, sa[x], sb[y]) <= 0:
                out2.append(sa[x])
                x = x + 1
            else:
                out2.append(sb[y])
                y = y + 1
        while x < len(sa):
            out2.append(sa[x])
            x = x + 1
        while y < len(sb):
            out2.append(sb[y])
            y = y + 1
        return out2

    # ── 値の種類 ────────────────────────────────────────

    # 文字列の列の、異なる値（初出の順）
    def unique_text(self, name: str) -> list[str]:
        xs: list[str] = self.text(name)
        seen: dict.Dict[str, int] = dict.Dict()
        out: list[str] = []
        for s in xs:
            if not seen.has(s):
                seen.set(copy(s), 1)
                out.append(copy(s))
        return out

    # 数値の列の、異なる値（初出の順）
    def unique_num(self, name: str) -> list[float]:
        xs: list[float] = self.num(name)
        seen: dict.Dict[str, int] = dict.Dict()
        out: list[float] = []
        for x in xs:
            k: str = str(x)
            if not seen.has(k):
                seen.set(k, 1)
                out.append(x)
        return out

    # ── 見る ────────────────────────────────────────────

    def show(self) -> str:
        return self.show_head(20)

    # 先頭 n 行を桁を揃えて表にします（注意: 幅は**表示幅**で数えます。欠損は NA）
    def show_head(self, n: int) -> str:
        m: int = n
        if m > self.rows():
            m = self.rows()
        w: list[int] = []
        for c in self.cols:
            wi: int = strings.width(c.name)
            i: int = 0
            while i < m:
                cw: int = strings.width(c.display(i))
                if cw > wi:
                    wi = cw
                i = i + 1
            w.append(wi)

        out: list[str] = []
        j: int = 0
        while j < len(self.cols):
            c2: Column = self.cols[j]
            out.append(pad(c2.name, w[j]))
            if j + 1 < len(self.cols):
                out.append("  ")
            j = j + 1
        out.append("\n")

        r: int = 0
        while r < m:
            j2: int = 0
            while j2 < len(self.cols):
                c3: Column = self.cols[j2]
                out.append(pad(c3.display(r), w[j2]))
                if j2 + 1 < len(self.cols):
                    out.append("  ")
                j2 = j2 + 1
            out.append("\n")
            r = r + 1
        if self.rows() > m:
            out.append("… ほか " + str(self.rows() - m) + " 行\n")
        return strings.join(out, "")


def check_no_missing(c: Column) -> None:
    if c.nmiss > 0:
        panic(i18n.pick("frame: 列 '" + c.name + "' に欠損が " + str(c.nmiss) + " 個あります。" +
                        "先に fill_num / fill_text で埋めるか、drop_missing で行を捨ててください" +
                        "（黙って埋めると集計の数字が静かに変わります）",
                        "frame: column '" + c.name + "' has " + str(c.nmiss) + " missing values. " + "Fill them with fill_num / fill_text first, or drop the rows with drop_missing " + "(filling them silently would quietly change the aggregated numbers)"))

# 列を名前を付け替えて写す
def copy_column(c: Column, name: str) -> Column:
    d: Column = Column(name, c.kind)
    for i in range(c.size()):
        d.push_from(c, i)
    return d


# 表示幅で右詰めにします（strings.lpad は表示幅で数えます）
def pad(s: str, w: int) -> str:
    return strings.lpad(s, w)


# ── 比較（where に渡す印を作る）────────────────────────────

def gt(xs: list[float], k: float) -> list[bool]:
    out: list[bool] = []
    for x in xs:
        out.append(x > k)
    return out

def ge(xs: list[float], k: float) -> list[bool]:
    out: list[bool] = []
    for x in xs:
        out.append(x >= k)
    return out

def lt(xs: list[float], k: float) -> list[bool]:
    out: list[bool] = []
    for x in xs:
        out.append(x < k)
    return out

def le(xs: list[float], k: float) -> list[bool]:
    out: list[bool] = []
    for x in xs:
        out.append(x <= k)
    return out

def eq_num(xs: list[float], k: float) -> list[bool]:
    out: list[bool] = []
    for x in xs:
        out.append(x == k)
    return out

def eq_text(xs: list[str], k: str) -> list[bool]:
    out: list[bool] = []
    for s in xs:
        out.append(s == k)
    return out

# 文字列の列の値が ks のどれかと等しい
def in_text(xs: list[str], ks: list[str]) -> list[bool]:
    out: list[bool] = []
    for s in xs:
        hit: bool = False
        for k in ks:
            if s == k:
                hit = True
        out.append(hit)
    return out

def both(a: list[bool], b: list[bool]) -> list[bool]:
    same_len(a, b, "both")
    out: list[bool] = []
    for i in range(len(a)):
        out.append(a[i] and b[i])
    return out

def either(a: list[bool], b: list[bool]) -> list[bool]:
    same_len(a, b, "either")
    out: list[bool] = []
    for i in range(len(a)):
        out.append(a[i] or b[i])
    return out

def negate(a: list[bool]) -> list[bool]:
    out: list[bool] = []
    for x in a:
        out.append(not x)
    return out

def same_len(a: list[bool], b: list[bool], who: str) -> None:
    if len(a) != len(b):
        panic(i18n.pick("frame." + who + ": 印の数が違います（" + str(len(a)) + " と " +
                        str(len(b)) + "）",
                        "frame." + who + ": the numbers of marks differ (" + str(len(a)) + " and " + str(len(b)) + ")"))


# ── 並べ替えの順番を作る ───────────────────────────────────

# xs を昇順（asc が False なら降順）に並べる行番号を返します。
# 注意: **安定です**（同じ値なら元の順を保ちます）。併合整列。
def order_of(xs: list[float], asc: bool) -> list[int]:
    idx: list[int] = []
    for i in range(len(xs)):
        idx.append(i)
    return msort(xs, idx, asc)

def msort(xs: list[float], idx: list[int], asc: bool) -> list[int]:
    if len(idx) <= 1:
        out: list[int] = []
        for k in idx:
            out.append(k)
        return out
    mid: int = len(idx) // 2
    a: list[int] = []
    b: list[int] = []
    i: int = 0
    while i < len(idx):
        if i < mid:
            a.append(idx[i])
        else:
            b.append(idx[i])
        i = i + 1
    return mmerge(xs, msort(xs, a, asc), msort(xs, b, asc), asc)

def mmerge(xs: list[float], a: list[int], b: list[int],
           asc: bool) -> list[int]:
    out: list[int] = []
    i: int = 0
    j: int = 0
    while i < len(a) and j < len(b):
        take_a: bool = False
        if asc:
            take_a = xs[a[i]] <= xs[b[j]]
        else:
            take_a = xs[a[i]] >= xs[b[j]]
        if take_a:
            out.append(a[i])
            i = i + 1
        else:
            out.append(b[j])
            j = j + 1
    while i < len(a):
        out.append(a[i])
        i = i + 1
    while j < len(b):
        out.append(b[j])
        j = j + 1
    return out


# ── まとめる（groupby 相当）────────────────────────────────

# 鍵の列の値から、行の「組の名前」を作る（列の種類も入れて取り違えを防ぐ）。
# 注意: 欠損のある鍵の列は使えません（呼ぶ前に確かめます）
def row_key(df: Frame, ki: list[int], i: int) -> str:
    parts: list[str] = []
    for k in ki:
        c: Column = df.cols[k]
        if c.kind == COL_NUM:
            parts.append("n" + str(c.nums[i]))
        else:
            parts.append("t" + c.texts[i])
    return strings.join(parts, chr(31))

def key_indices(df: Frame, keys: list[str], who: str) -> list[int]:
    if len(keys) == 0:
        panic(i18n.pick("frame." + who + ": 鍵の列がありません",
                        "frame." + who + ": no key columns"))
    ki: list[int] = []
    for k in keys:
        c: Column = df.col(k)
        if c.nmiss > 0:
            panic(i18n.pick("frame." + who + ": 鍵の列 '" + k + "' に欠損があります。" +
                            "先に fill_num / fill_text で埋めるか、drop_missing_in で行を捨ててください",
                            "frame." + who + ": key column '" + k + "' has missing values. " + "Fill them with fill_num / fill_text first, or drop the rows with drop_missing_in"))
        ki.append(df.index_of(k))
    return ki

def valid_how(how: str) -> bool:
    return (how == "mean" or how == "sum" or how == "count" or how == "min" or
            how == "max" or how == "median" or how == "std")

# 鍵の列（keys）ごとに、values[i] の列を hows[i] で集計します。
#   hows: "mean" / "sum" / "count" / "min" / "max" / "median" / "std"（標本標準偏差）
# 返る表は「鍵の列（元の種類のまま）＋ 集計ごとに 1 列（名前は 値の列_集計）」で、
# **鍵の初出の順**に並びます。
#
# ★ 組はハッシュ表で探すので、行数に比例する時間で終わります。
# 注意: std は値が 1 つしかない組では決まらないので**欠損**になります（0 にはしません）。
def agg(df: Frame, keys: list[str], values: list[str], hows: list[str]) -> Frame:
    if len(values) != len(hows):
        panic(i18n.pick("frame.agg: 値の列と集計の数が合いません",
                        "frame.agg: the numbers of value columns and aggregations do not match"))
    for h in hows:
        if not valid_how(h):
            panic(i18n.pick("frame.agg: 知らない集計です '" + h +
                            "'（mean / sum / count / min / max / median / std）",
                            "frame.agg: unknown aggregation '" + h + "' (mean / sum / count / min / max / median / std)"))
    ki: list[int] = key_indices(df, keys, "agg")

    groups: dict.Dict[str, int] = dict.Dict()
    first: list[int] = []
    members: list[list[int]] = []
    for i in range(df.rows()):
        k: str = row_key(df, ki, i)
        g: int = groups.get_or(k, -1)
        if g < 0:
            groups.set(k, len(first))
            first.append(i)
            members.append([i])
        else:
            members[g].append(i)

    out: Frame = df.select(keys).take(first)
    j: int = 0
    while j < len(values):
        how: str = hows[j]
        # ★ 件数だけなら値は読みません（文字列の列でも、欠損があっても数えられます）
        vs: list[float] = []
        if how != "count":
            vs = df.num(values[j])
        else:
            df.col(values[j])     # 無い列は panic
        col: list[float] = []
        miss: list[bool] = []
        for mem in members:
            xs: list[float] = []
            if how != "count":
                for r in mem:
                    xs.append(vs[r])
            v: float = 0.0
            m: bool = False
            if how == "mean":
                v = sum_of(xs) / float(len(xs))
            elif how == "sum":
                v = sum_of(xs)
            elif how == "count":
                v = float(len(mem))
            elif how == "min":
                v = min_of(xs)
            elif how == "max":
                v = max_of(xs)
            elif how == "median":
                v = median_of(xs)
            else:
                if len(xs) < 2:
                    m = True
                else:
                    v = sample_std(xs)
            col.append(v)
            miss.append(m)
        out.add_num_opt(values[j] + "_" + how, col, miss)
        j = j + 1
    return out

# key の列ごとに value の列（数値）を集計します。
#   how: "mean" / "sum" / "count" / "min" / "max" / "median" / "std"
# 返るのは 2 列（key と value）の新しい表で、**key の初出の順**に並びます。
#
# ★ 鍵の列は**文字列でも数値でもかまいません**。返る表の鍵の列は、
#   元の列と同じ種類になります（数値の鍵なら数値の列）。
# 注意: 鍵も集計も複数にしたいときは agg を使ってください。
def group_by(df: Frame, key: str, value: str, how: str) -> Frame:
    if not valid_how(how):
        panic(i18n.pick("frame.group_by: 知らない集計です '" + how +
                        "'（mean / sum / count / min / max / median / std）",
                        "frame.group_by: unknown aggregation '" + how + "' (mean / sum / count / min / max / median / std)"))
    r: Frame = agg(df, [copy(key)], [copy(value)], [copy(how)])
    return r.rename(value + "_" + how, value)

# 値ごとの件数（多い順。同じ件数なら初出の順）。列は name と count の 2 つ。
def value_counts(df: Frame, name: str) -> Frame:
    g: Frame = agg(df, [copy(name)], [copy(name)], ["count"])
    # 鍵そのものを数えるので、値の列は鍵の列を数えた数です
    s: Frame = g.sort_by_desc(name + "_count")
    return s.rename(name + "_count", "count")


# ── 結合（merge 相当）─────────────────────────────────────

# on の列が等しい行どうしをつなぎます。
#   how: "inner"（両方にある行だけ）/ "left"（left の行はすべて残す）
#
# ★ 並びは left の行の順で、1 つの行に相手が複数あれば相手の順に並べます。
# ★ left で相手の無い行は、right から来た列が**欠損**になります
#   （0 や "" で埋めません。埋めると「相手が無かった」ことが消えるため）。
# 注意: 鍵の列は両方にあり、種類（数値か文字列か）が同じで、欠損が無いこと。
#   right の鍵以外の列が left と同じ名前なら、後ろに _right を付けます。
def join(left: Frame, right: Frame, on: list[str], how: str) -> Frame:
    if how != "inner" and how != "left":
        panic(i18n.pick("frame.join: how は \"inner\" か \"left\" です（'" + how + "'）",
                        "frame.join: how must be \"inner\" or \"left\" ('" + how + "')"))
    lk: list[int] = key_indices(left, on, "join")
    rk: list[int] = key_indices(right, on, "join")
    k: int = 0
    while k < len(on):
        if left.cols[lk[k]].kind != right.cols[rk[k]].kind:
            panic(i18n.pick("frame.join: 鍵の列 '" + on[k] + "' の種類が左右で違います（数値と文字列）",
                            "frame.join: key column '" + on[k] + "' has different kinds on the left and right (number and text)"))
        k = k + 1

    index: dict.Dict[str, int] = dict.Dict()
    rows_of: list[list[int]] = []
    for r in range(right.rows()):
        key: str = row_key(right, rk, r)
        g: int = index.get_or(key, -1)
        if g < 0:
            index.set(key, len(rows_of))
            rows_of.append([r])
        else:
            rows_of[g].append(r)

    li: list[int] = []
    ri: list[int] = []
    for i in range(left.rows()):
        g2: int = index.get_or(row_key(left, lk, i), -1)
        if g2 >= 0:
            for r2 in rows_of[g2]:
                li.append(i)
                ri.append(r2)
        elif how == "left":
            li.append(i)
            ri.append(-1)

    out: Frame = left.take(li)
    for c in right.cols:
        is_key: bool = False
        for nm in on:
            if c.name == nm:
                is_key = True
        if is_key:
            continue
        name: str = copy(c.name)
        if out.has(name):
            name = name + "_right"
        if out.has(name):
            panic(i18n.pick("frame.join: 列 '" + name + "' が重なります（名前を変えてから結合してください）",
                            "frame.join: column '" + name + "' appears on both sides (rename it before joining)"))
        d: Column = Column(name, c.kind)
        for r3 in ri:
            d.push_from(c, r3)
        out.cols.append(d)
    return out

# 縦につなぐ（列の名前・並び・種類が同じこと）
def concat(a: Frame, b: Frame) -> Frame:
    if a.width() != b.width():
        panic(i18n.pick("frame.concat: 列の数が違います（" + str(a.width()) + " と " +
                        str(b.width()) + "）",
                        "frame.concat: the numbers of columns differ (" + str(a.width()) + " and " + str(b.width()) + ")"))
    out: Frame = Frame()
    j: int = 0
    while j < a.width():
        ca: Column = a.cols[j]
        cb: Column = b.cols[j]
        if ca.name != cb.name or ca.kind != cb.kind:
            panic(i18n.pick("frame.concat: " + str(j + 1) + " 列目の名前か種類が違います（'" +
                            ca.name + "' と '" + cb.name + "'）",
                            "frame.concat: the name or kind of column " + str(j + 1) + " differs ('" + ca.name + "' and '" + cb.name + "')"))
        d: Column = Column(ca.name, ca.kind)
        for i in range(ca.size()):
            d.push_from(ca, i)
        for i2 in range(cb.size()):
            d.push_from(cb, i2)
        out.cols.append(d)
        j = j + 1
    return out


# ── まとめて眺める（describe 相当）─────────────────────────

def describe(df: Frame) -> str:
    out: list[str] = []
    out.append("行 " + str(df.rows()) + " / 列 " + str(df.width()) + "\n")
    for c in df.cols:
        tail: str = ""
        if c.nmiss > 0:
            tail = "  欠損 " + str(c.nmiss)
        if c.kind == COL_TEXT:
            out.append(strings.rpad(c.name, 12) + " 文字列  異なり " +
                       str(distinct_count(present_texts(c))) + tail + "\n")
        else:
            xs: list[float] = present_nums(c)
            n: int = len(xs)
            if n == 0:
                if c.nmiss > 0:
                    out.append(strings.rpad(c.name, 12) + " 数値    （すべて欠損）" + tail + "\n")
                else:
                    out.append(strings.rpad(c.name, 12) + " 数値    （空）\n")
            else:
                out.append(strings.rpad(c.name, 12) + " 数値    平均 " +
                           str(math.round_to(stats.mean(xs), 4)) +
                           "  最小 " + str(min_of(xs)) +
                           "  最大 " + str(max_of(xs)) +
                           "  標準偏差 " +
                           str(math.round_to(pstdev_safe(xs), 4)) + tail + "\n")
    return strings.join(out, "")

# 欠損でない値だけ（describe のため）
def present_nums(c: Column) -> list[float]:
    out: list[float] = []
    for i in range(c.size()):
        if not c.is_missing(i):
            out.append(c.nums[i])
    return out

def present_texts(c: Column) -> list[str]:
    out: list[str] = []
    for i in range(c.size()):
        if not c.is_missing(i):
            out.append(copy(c.texts[i]))
    return out

def pstdev_safe(xs: list[float]) -> float:
    if len(xs) < 2:
        return 0.0
    return stats.pstdev(xs)

def sum_of(xs: list[float]) -> float:
    s: float = 0.0
    for x in xs:
        s = s + x
    return s

def min_of(xs: list[float]) -> float:
    v: float = xs[0]
    for x in xs:
        if x < v:
            v = x
    return v

def max_of(xs: list[float]) -> float:
    v: float = xs[0]
    for x in xs:
        if x > v:
            v = x
    return v

def mean_of(xs: list[float]) -> float:
    return stats.mean(xs)

def median_of(xs: list[float]) -> float:
    o: list[int] = order_of(xs, True)
    n: int = len(o)
    if n % 2 == 1:
        return xs[o[n // 2]]
    return (xs[o[n // 2 - 1]] + xs[o[n // 2]]) / 2.0

# 標本標準偏差（n - 1 で割る。2 つ以上あること）
def sample_std(xs: list[float]) -> float:
    m: float = sum_of(xs) / float(len(xs))
    s: float = 0.0
    for x in xs:
        s = s + (x - m) * (x - m)
    return math.sqrt(s / float(len(xs) - 1))

def distinct_count(xs: list[str]) -> int:
    seen: dict.Dict[str, int] = dict.Dict()
    for s in xs:
        if not seen.has(s):
            seen.set(copy(s), 1)
    return seen.len()


# ── CSV ────────────────────────────────────────────────────

# CSV を読みます。1 行目を見出しとして扱います。
#
# ★ 列の型は**中身を見て決めます**：空でない値が全部数として読めるなら
#   数値の列（空の欄は**欠損**）、そうでなければ文字列の列（空の欄は ""）です。
# 注意: 引用符（"…"）に対応しています（"" は " 1 個）。改行を含む欄も読めます。
# 注意: 形が崩れた CSV は panic します。外から来る CSV は try_read_csv /
#   try_parse_csv で読み、FrameError を受けてください。
def read_csv(path: str) -> Frame:
    return parse_csv(io.read_file(path))

def parse_csv(text: str) -> Frame:
    try:
        return try_parse_csv(text)
    except FrameError as e:
        panic(e.message)
    return Frame()

# 外から来る CSV を読む（形の誤りは FrameError。sep は区切りの 1 文字。TSV なら "\t"）
def try_read_csv(path: str, sep: str = ",") -> Frame raises FrameError:
    if not io.exists(path):
        raise FrameError("frame: ファイル '" + path + "' がありません")
    return try_parse_csv(io.read_file(path), sep)

def try_parse_csv(text: str, sep: str = ",") -> Frame raises FrameError:
    if len(sep) != 1 or sep == "\"" or sep == "\n" or sep == "\r":
        raise FrameError("frame: 区切りは引用符・改行以外の 1 バイトの文字です（'" + sep + "'）")
    rows: list[list[str]] = split_rows(text, strings.byte_at(sep, 0), True)
    if len(rows) == 0:
        raise FrameError("frame: CSV が空です")

    head: list[str] = rows[0]
    ncol: int = len(head)
    seen: dict.Dict[str, int] = dict.Dict()
    for h in head:
        if seen.has(h):
            raise FrameError("frame: 見出し '" + h + "' が 2 回出てきます")
        seen.set(copy(h), 1)
    i0: int = 1
    while i0 < len(rows):
        r0: list[str] = rows[i0]
        if len(r0) != ncol:
            raise FrameError("frame: " + str(i0 + 1) + " 行目の欄の数が見出しと違います（" +
                             str(len(r0)) + " と " + str(ncol) + "）")
        i0 = i0 + 1

    df: Frame = Frame()
    j: int = 0
    while j < ncol:
        # その列の値を集める
        cells: list[str] = []
        i: int = 1
        while i < len(rows):
            r: list[str] = rows[i]
            cells.append(copy(r[j]))
            i = i + 1

        if numeric_with_blanks(cells):
            c: Column = Column(head[j], COL_NUM)
            for s in cells:
                if is_blank(s):
                    c.push_num(0.0, True)
                else:
                    c.push_num(float(strings.strip(s)), False)
            df.cols.append(c)
        else:
            df.add_text(head[j], cells)
        j = j + 1
    return df

def is_blank(s: str) -> bool:
    return len(strings.strip(s)) == 0

# 空でない値が 1 つ以上あり、それが全部数として読めるか（空の欄は欠損になる）
def numeric_with_blanks(cells: list[str]) -> bool:
    any_value: bool = False
    for s in cells:
        if is_blank(s):
            continue
        if not is_number(s):
            return False
        any_value = True
    return any_value

# 全部が数として読めるか（空の欄が 1 つでもあれば False）
def all_numeric(cells: list[str]) -> bool:
    if len(cells) == 0:
        return False
    for s in cells:
        if not is_number(s):
            return False
    return True

# 注意: float(s) は読めなければ panic するので、**先にここで確かめます**。
def is_number(s: str) -> bool:
    t: str = strings.strip(s)
    if len(t) == 0:
        return False
    i: int = 0
    if strings.byte_at(t, 0) == 43 or strings.byte_at(t, 0) == 45:
        i = 1
    digits: int = 0
    dots: int = 0
    while i < len(t):
        b: int = strings.byte_at(t, i)
        if b >= 48 and b <= 57:
            digits = digits + 1
        elif b == 46:
            dots = dots + 1
            if dots > 1:
                return False
        elif b == 101 or b == 69:
            # 指数部：e のあとは符号と数字だけ
            if digits == 0:
                return False
            i = i + 1
            if i < len(t) and (strings.byte_at(t, i) == 43 or
                               strings.byte_at(t, i) == 45):
                i = i + 1
            ed: int = 0
            while i < len(t):
                eb: int = strings.byte_at(t, i)
                if eb < 48 or eb > 57:
                    return False
                ed = ed + 1
                i = i + 1
            return ed > 0
        else:
            return False
        i = i + 1
    return digits > 0

# CSV を「行 × 欄」に切ります（引用符に対応）
def split_csv(text: str) -> list[list[str]]:
    try:
        return split_rows(text, 44, False)
    except FrameError as e:
        panic(e.message)
    return []

# 区切りを sep（1 バイト）にして切る。strict なら閉じていない引用符を誤りにします。
def split_rows(text: str, sep: int, strict: bool) -> list[list[str]] raises FrameError:
    rows: list[list[str]] = []
    row: list[str] = []
    cell: list[str] = []
    i: int = 0
    n: int = len(text)
    quoted: bool = False
    started: bool = False
    line: int = 1
    qline: int = 0

    while i < n:
        b: int = strings.byte_at(text, i)
        if quoted:
            if b == 34:
                if i + 1 < n and strings.byte_at(text, i + 1) == 34:
                    cell.append("\"")
                    i = i + 1
                else:
                    quoted = False
            else:
                if b == 10:
                    line = line + 1
                cell.append(strings.substr(text, i, 1))
        elif b == 34:
            quoted = True
            qline = line
            started = True
        elif b == sep:
            row.append(strings.join(cell, ""))
            cell = []
            started = True
        elif b == 10 or b == 13:
            if b == 13 and i + 1 < n and strings.byte_at(text, i + 1) == 10:
                i = i + 1
            line = line + 1
            if started or len(cell) > 0 or len(row) > 0:
                row.append(strings.join(cell, ""))
                rows.append(row)
                row = []
                cell = []
                started = False
        else:
            cell.append(strings.substr(text, i, 1))
            started = True
        i = i + 1

    if quoted and strict:
        raise FrameError("frame: " + str(qline) + " 行目で始まった引用符が閉じていません")
    if started or len(cell) > 0 or len(row) > 0:
        row.append(strings.join(cell, ""))
        rows.append(row)
    return rows


def write_csv(df: Frame, path: str) -> None:
    io.write_file(path, to_csv(df))

# 注意: 欠損は**空の欄**で書きます（読み直すと、数値の列なら欠損に戻ります）
def to_csv(df: Frame) -> str:
    out: list[str] = []
    j: int = 0
    while j < df.width():
        c: Column = df.cols[j]
        out.append(quote_csv(c.name))
        if j + 1 < df.width():
            out.append(",")
        j = j + 1
    out.append("\n")

    i: int = 0
    while i < df.rows():
        j2: int = 0
        while j2 < df.width():
            c2: Column = df.cols[j2]
            out.append(quote_csv(c2.cell(i)))
            if j2 + 1 < df.width():
                out.append(",")
            j2 = j2 + 1
        out.append("\n")
        i = i + 1
    return strings.join(out, "")

# , " 改行 のどれかを含むときだけ引用します
def quote_csv(s: str) -> str:
    need: bool = False
    i: int = 0
    while i < len(s):
        b: int = strings.byte_at(s, i)
        if b == 44 or b == 34 or b == 10 or b == 13:
            need = True
        i = i + 1
    if not need:
        return copy(s)
    return "\"" + strings.replace(copy(s), "\"", "\"\"") + "\""
