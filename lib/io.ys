# io — ファイル入出力
#
# ★ extern（C との境界）をこのファイルに閉じ込めます。
#   利用者は io.read_file を使い、pl_read_file を知りません。
#   ランタイム側の名前が変わっても、直すのはここだけです。
#
# 注意: strings を import しています（mkdir_all がパスを分けるため）。
#   strings は何も import しないので、循環にはなりません。
import strings

extern def pl_read_file(path: str) -> str
extern def pl_write_file(path: str, text: str) -> None
extern def pl_file_exists(path: str) -> int
extern def pl_eprint(s: str) -> None
extern def pl_print_raw(s: str) -> None
extern def pl_remove(path: str) -> None
extern def pl_read_line() -> str | None
extern def pl_read_all() -> str

# ── ディレクトリ ────────────────────────────────────────
extern def pl_mkdir(path: str) -> int
extern def pl_is_dir(path: str) -> int
extern def pl_rmdir(path: str) -> int
extern def pl_rename(from_: str, to: str) -> int
extern def pl_file_size(path: str) -> int
extern def pl_listdir(path: str) -> list[str]

# ファイル全体を読む（開けなければ実行時エラーで終了する）
def read_file(path: str) -> str:
    return pl_read_file(path)

def write_file(path: str, text: str) -> None:
    pl_write_file(path, text)

# 注意: bool は extern の境界を越えられないので、int で受けてここで bool にします
# ファイルを削除する（無ければ何もしない）
def remove(path: str) -> None:
    pl_remove(path)

# 標準出力に「そのまま」書く（改行を足さない）。
# ★ print は改行を足すので、IR のような「自分で改行を持つ文字列」には使えません。
def print_raw(s: str) -> None:
    pl_print_raw(s)

# 標準エラー出力に書く（改行は付けない）。
# ★ print は stdout。診断は stderr に出すのが約束です。
def eprint(s: str) -> None:
    pl_eprint(s)

def exists(path: str) -> bool:
    return pl_file_exists(path) == 1


# ── 標準入力 ────────────────────────────────────────────

# 1 行読む。**改行は含みません**。もう読めなければ None。
#
# 注意: 行末の '\r' は落とします（Windows で作った入力でも同じ結果になるように）。
def read_line() -> str | None:
    return pl_read_line()

# 標準入力を最後まで読む。何も無ければ空文字列。
def read_all() -> str:
    return pl_read_all()


# ── ディレクトリ ────────────────────────────────────────
#
# ★ ここまで io は「読む・書く・消す・あるか」の 4 つだけでした。
#   パッケージマネージャを書いたとき、ディレクトリを作るのも一覧するのも
#   `sys.run("mkdir -p …")` に頼るしかないことが分かったので足しました。
#   **シェルを介さない**ので、名前に空白や引用符が入っていても壊れません。

# ディレクトリか（無ければ False）
def is_dir(path: str) -> bool:
    return pl_is_dir(path) == 1

# ディレクトリを 1 つ作る。**既にあれば True**（作り直しません）。
#
# 注意: 途中の親が無いときは失敗します。まとめて作るなら mkdir_all を使ってください。
def mkdir(path: str) -> bool:
    return pl_mkdir(path) >= 0

# 途中の親ごと作る（mkdir -p 相当）
#
# 注意: 区切りは "/" だけを見ます。Windows でも "/" が使えます
#    （このコンパイラが扱うパスは全部 "/" 区切りです）。
def mkdir_all(path: str) -> bool:
    if len(path) == 0:
        return False
    parts: list[str] = strings.split(path, "/")
    cur: str = ""
    if strings.startswith(path, "/"):
        cur = ""
    i: int = 0
    while i < len(parts):
        if len(parts[i]) > 0:
            if len(cur) == 0:
                if strings.startswith(path, "/"):
                    cur = "/" + parts[i]
                else:
                    cur = parts[i]
            else:
                cur = cur + "/" + parts[i]
            if not mkdir(cur):
                return False
        i = i + 1
    return True

# 空のディレクトリを消す（中身が残っていれば False）
def rmdir(path: str) -> bool:
    return pl_rmdir(path) == 0

# 中身ごと消す（rm -rf 相当）。
#
# 注意: **シンボリックリンクの先はたどりません**（リンクそのものを消します）。
#    たどると、指してある場所の中身まで消してしまうためです。
def remove_all(path: str) -> bool:
    if not exists(path) and not is_dir(path):
        return True
    if not is_dir(path):
        remove(path)
        return True
    for name in listdir(path):
        if not remove_all(path + "/" + name):
            return False
    return rmdir(path)

# 名前を変える／移す（同じファイルシステムの中だけ）
def rename(from_: str, to: str) -> bool:
    return pl_rename(from_, to) == 0

# ファイルの大きさ（バイト）。無ければ -1。
def size(path: str) -> int:
    return pl_file_size(path)

# ディレクトリの中身（名前だけ。"." と ".." は含みません）。
#
# 注意: **並びは OS 任せです。** 同じ結果が欲しいときは呼び出し側で整列してください。
# 注意: 開けなかったときも空のリストです。区別したいときは先に is_dir を見てください。
def listdir(path: str) -> list[str]:
    return pl_listdir(path)
