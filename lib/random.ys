# random — 疑似乱数（Python の random 相当）
#
# ★ **自前の線形合同法（LCG）です。** 状態を 1 本の 64 ビット整数で持ちます。
#     s ← s · A + C   （2⁶⁴ で自動的に折り返す）
#
#   使う定数は数論的に選ばれた既知のもの（乗数は Knuth の MMIX と同じ族）で、
#   実装そのものはこのファイルで書き起こしています。
#
# 注意: **暗号には使えません。** 状態が見えれば次の値が完全に予測できます。
#   シミュレーション・サンプリング・テストデータ用です。
#
# 注意: **下位ビットは質が悪い**という LCG の弱点があるので、
#   出力には必ず**上位ビット**を使います（下の next53 を参照）。
#
# 注意: 状態はモジュールのグローバル変数 1 つです。並行実行は考えていません。

import math

# 状態。注意: グローバルの初期化式はリテラルだけ（言語仕様 6.2）
STATE: int = 88172645463325252

def seed(n: int) -> None:
    # ★ 0 を避けます。0 のままだと系列が縮退する種類の生成器があるためで、
    #   ここでも「同じ種で同じ系列」を保ちつつ 0 を弾いておきます。
    if n == 0:
        STATE = 88172645463325252
    else:
        STATE = n

# 次の 64 ビット状態へ進める
#
# ★ **ここは折り返すのが目的です。** 掛け算も足し算も 2 の補数で
#   折り返り、それが法 2⁶⁴ の計算そのものになります。
#
# 注意: ふつうの `*` と `+` は桁あふれで panic します。
#   折り返しが要る場所は `wrap_mul` / `wrap_add` と書いて、
#   **「あふれるのは承知のうえ」だと目に見えるようにします。**
def next_state() -> int:
    STATE = wrap_add(wrap_mul(STATE, 6364136223846793005),
                     1442695040888963407)
    return STATE

# 上位 53 ビットを取り出す
#
# 注意: '>>' は算術シフト（符号を伸ばす）なので、負の状態だと上位が 1 で
#   埋まります。**マスクを掛けて 53 ビットに切る**ことで、論理シフトと
#   同じ結果になります。
def next53() -> int:
    return (next_state() >> 11) & 9007199254740991      # 2⁵³ - 1

# ── 基本 ────────────────────────────────────────────────────

# [0.0, 1.0) の一様乱数
#
# ★ 53 ビットの整数を 2⁵³ で割ります。倍精度の仮数がちょうど 53 ビットなので、
#   表せる値を偏りなく使い切れます。
def random() -> float:
    return float(next53()) / 9007199254740992.0

# [a, b) の一様乱数
def uniform(a: float, b: float) -> float:
    return a + (b - a) * random()

# [a, b] の一様な整数（両端を含む）
#
# 注意: 単純な剰余（% (b-a+1)）は**わずかに偏ります**（範囲が 2 の冪でないとき、
#   小さい値が 1 回多く当たる）。当たったら引き直す方式で偏りを消します。
def randint(a: int, b: int) -> int:
    if a > b:
        panic("random.randint: a <= b にしてください")
    span: int = b - a + 1
    if span <= 0:
        panic("random.randint: 範囲が大きすぎます")
    limit: int = 9007199254740992 - (9007199254740992 % span)
    v: int = next53()
    while v >= limit:
        v = next53()
    return a + v % span

# True になる確率が p
def chance(p: float) -> bool:
    return random() < p


# ── 分布 ────────────────────────────────────────────────────

# 正規分布（ボックス＝ミュラー法）
#
# ★ 一様乱数 2 つから正規分布 1 つを作ります。
#     z = √(-2·ln u₁) · cos(2π·u₂)
#   注意: u₁ が 0 だと log(0) = -inf になるので、0 を引いたら取り直します。
def gauss(mu: float, sigma: float) -> float:
    u1: float = random()
    while u1 == 0.0:
        u1 = random()
    u2: float = random()
    z: float = math.sqrt(-2.0 * math.log(u1)) * math.cos(math.tau() * u2)
    return mu + sigma * z

# 指数分布（平均 1/rate）。逆関数法
def expovariate(rate: float) -> float:
    if rate <= 0.0:
        panic("random.expovariate: rate は正の数です")
    u: float = random()
    while u == 0.0:
        u = random()
    return -math.log(u) / rate


# ── 列を扱う ────────────────────────────────────────────────

# その場で並べ替える（フィッシャー＝イェーツ法）
#
# ★ 後ろから順に「自分より前（自分を含む）のどれか」と入れ替えます。
#   これで **すべての並びが等確率**になります。
#   注意: randint(0, i) の上限を i にすること。i-1 にすると偏ります。
def shuffle(a: mut list[float]) -> None:
    i: int = len(a) - 1
    while i > 0:
        j: int = randint(0, i)
        t: float = a[i]
        a[i] = a[j]
        a[j] = t
        i = i - 1

# 1 つ選ぶ
def choice(a: list[float]) -> float:
    if len(a) == 0:
        panic("random.choice: 空の列からは選べません")
    return a[randint(0, len(a) - 1)]

# n 個を復元ありで選ぶ
def sample_with_replacement(a: list[float], n: int) -> list[float]:
    if len(a) == 0:
        panic("random.sample_with_replacement: 空の列からは選べません")
    out: list[float] = []
    i: int = 0
    while i < n:
        out.append(choice(a))
        i = i + 1
    return out
