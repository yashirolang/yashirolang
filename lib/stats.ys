# stats — 統計（Python の statistics 相当）
#
# ★ 入力はすべて `list[float]` です。
#
# 注意: **標本と母集団の区別**に注意してください。Python と同じ命名にしてあります。
#     variance / stdev   … 標本（n-1 で割る。手元のデータが「全体からの抜き取り」）
#     pvariance / pstdev … 母集団（n で割る。手元のデータが「全体そのもの」）
#   どちらを使うべきかはデータの性質で決まります。既定はありません。

import math
import linalg

def need_data(a: list[float], n: int, who: str) -> None:
    if len(a) < n:
        panic("stats." + who + ": 要素が " + str(n) + " 個以上必要です（" +
              str(len(a)) + " 個しかありません）")


# ── 代表値 ──────────────────────────────────────────────────

def mean(a: list[float]) -> float:
    need_data(a, 1, "mean")
    return linalg.vsum(a) / float(len(a))

# 中央値。注意: **元のデータは並べ替えません**（複製してから並べ替えます）
def median(a: list[float]) -> float:
    need_data(a, 1, "median")
    s: list[float] = sorted(a)
    n: int = len(s)
    if n % 2 == 1:
        return s[n // 2]
    return (s[n // 2 - 1] + s[n // 2]) / 2.0

# 相乗平均（すべて正のとき）
def geometric_mean(a: list[float]) -> float:
    need_data(a, 1, "geometric_mean")
    s: float = 0.0
    for x in a:
        if x <= 0.0:
            panic("stats.geometric_mean: 正の数だけを渡してください")
        s = s + math.log(x)
    return math.exp(s / float(len(a)))

# 調和平均
def harmonic_mean(a: list[float]) -> float:
    need_data(a, 1, "harmonic_mean")
    s: float = 0.0
    for x in a:
        if x <= 0.0:
            panic("stats.harmonic_mean: 正の数だけを渡してください")
        s = s + 1.0 / x
    return float(len(a)) / s


# ── ばらつき ────────────────────────────────────────────────

# 母分散（n で割る）
def pvariance(a: list[float]) -> float:
    need_data(a, 1, "pvariance")
    m: float = mean(a)
    s: float = 0.0
    for x in a:
        d: float = x - m
        s = s + d * d
    return s / float(len(a))

# 標本分散（n-1 で割る）
#
# なぜ n-1 なのか
#   平均を「データから」求めた時点で自由度が 1 減っています。n で割ると
#   ばらつきを**小さく見積もりすぎる**（偏る）ので、n-1 で補正します。
def variance(a: list[float]) -> float:
    need_data(a, 2, "variance")
    m: float = mean(a)
    s: float = 0.0
    for x in a:
        d: float = x - m
        s = s + d * d
    return s / float(len(a) - 1)

def pstdev(a: list[float]) -> float:
    return math.sqrt(pvariance(a))

def stdev(a: list[float]) -> float:
    return math.sqrt(variance(a))


# ── 順序に関するもの ────────────────────────────────────────

# 昇順に並べ替えた**複製**を返す
#
# ★ マージソート。挿入ソートと違って n log n で、要素数が増えても崩れません。
# 注意: **元のリストは壊しません。** 並べ替えたい側が複製を作る手間を省くと、
#   「渡しただけなのに壊れた」という事故が起きるためです。
def sorted(a: list[float]) -> list[float]:
    if len(a) <= 1:
        return linalg.vcopy(a)
    mid: int = len(a) // 2
    left: list[float] = []
    right: list[float] = []
    i: int = 0
    while i < len(a):
        if i < mid:
            left.append(a[i])
        else:
            right.append(a[i])
        i = i + 1
    return merge(sorted(left), sorted(right))

# ★ 比較関数を渡せる版。
#   less(a, b) が True なら a を先に置きます。
#
#   例：降順にする
#       def desc(a: float, b: float) -> bool:
#           return a > b
#       stats.sorted_by(xs, desc)
def sorted_by(a: list[float], less: fn(float, float) -> bool) -> list[float]:
    if len(a) <= 1:
        return linalg.vcopy(a)
    mid: int = len(a) // 2
    left: list[float] = a[0:mid]
    right: list[float] = a[mid:]
    return merge_by(sorted_by(left, less), sorted_by(right, less), less)

def merge_by(x: list[float], y: list[float],
             less: fn(float, float) -> bool) -> list[float]:
    out: list[float] = []
    i: int = 0
    j: int = 0
    while i < len(x) and j < len(y):
        # 注意: **not less(y, x)** で比べます。less(x, y) だと同じ値のときに
        #   右を先に取ってしまい、安定でなくなります。
        if not less(y[j], x[i]):
            out.append(x[i])
            i = i + 1
        else:
            out.append(y[j])
            j = j + 1
    while i < len(x):
        out.append(x[i])
        i = i + 1
    while j < len(y):
        out.append(y[j])
        j = j + 1
    return out

def merge(x: list[float], y: list[float]) -> list[float]:
    out: list[float] = []
    i: int = 0
    j: int = 0
    while i < len(x) and j < len(y):
        if x[i] <= y[j]:
            out.append(x[i])
            i = i + 1
        else:
            out.append(y[j])
            j = j + 1
    while i < len(x):
        out.append(x[i])
        i = i + 1
    while j < len(y):
        out.append(y[j])
        j = j + 1
    return out

# 分位点（0.0 〜 1.0）。線形補間で求めます
def quantile(a: list[float], q: float) -> float:
    need_data(a, 1, "quantile")
    if q < 0.0 or q > 1.0:
        panic("stats.quantile: q は 0.0 〜 1.0 です")
    s: list[float] = sorted(a)
    if len(s) == 1:
        return s[0]
    pos: float = q * float(len(s) - 1)
    lo: int = int(math.floor(pos))
    hi: int = int(math.ceil(pos))
    if lo == hi:
        return s[lo]
    f: float = pos - float(lo)
    return s[lo] * (1.0 - f) + s[hi] * f

# 最頻値に近いもの：出現回数が最多の値（同数なら小さいほう）
#
# 注意: 浮動小数点数の「等しい」は危ういので、**完全一致**で数えます。
#   連続量に使うものではありません（度数分布を使ってください）。
def mode(a: list[float]) -> float:
    need_data(a, 1, "mode")
    s: list[float] = sorted(a)
    best: float = s[0]
    best_n: int = 0
    i: int = 0
    while i < len(s):
        j: int = i
        while j < len(s) and s[j] == s[i]:
            j = j + 1
        if j - i > best_n:
            best_n = j - i
            best = s[i]
        i = j
    return best


# ── 2 変数 ──────────────────────────────────────────────────

def covariance(x: list[float], y: list[float]) -> float:
    linalg.same_len(x, y, "covariance")
    need_data(x, 2, "covariance")
    mx: float = mean(x)
    my: float = mean(y)
    s: float = 0.0
    i: int = 0
    while i < len(x):
        s = s + (x[i] - mx) * (y[i] - my)
        i = i + 1
    return s / float(len(x) - 1)

# ピアソンの相関係数（-1.0 〜 1.0）
def correlation(x: list[float], y: list[float]) -> float:
    sx: float = stdev(x)
    sy: float = stdev(y)
    if sx == 0.0 or sy == 0.0:
        panic("stats.correlation: ばらつきが 0 の列とは相関を取れません")
    return covariance(x, y) / (sx * sy)

# 最小二乗法による直線あてはめ。傾きと切片を [a, b] で返す（y ≈ a·x + b）
def linear_regression(x: list[float], y: list[float]) -> list[float]:
    linalg.same_len(x, y, "linear_regression")
    need_data(x, 2, "linear_regression")
    mx: float = mean(x)
    my: float = mean(y)
    sxy: float = 0.0
    sxx: float = 0.0
    i: int = 0
    while i < len(x):
        dx: float = x[i] - mx
        sxy = sxy + dx * (y[i] - my)
        sxx = sxx + dx * dx
        i = i + 1
    if sxx == 0.0:
        panic("stats.linear_regression: x がすべて同じ値です")
    a: float = sxy / sxx
    out: list[float] = []
    out.append(a)
    out.append(my - a * mx)
    return out
