# ownck — 所有権・借用・可変性の検査（C 版 src/ownck.c と対）
#
# ★ なぜセルフホスト版にも要るのか（docs/roadmap.md A-21 ⑩）
#   解放の挿入（--drop）は「いつ・何を解放してよいか」の判断が要り、
#   その判断は**所有権の解析結果そのもの**です。C 版だけが所有権を知って
#   いる状態では、セルフホスト版は「解放しないコンパイラ」にしかなれません。
#   配る実行ファイルは stage1 由来なので、そのままでは**利用者に配られる
#   コンパイラが解放しない**ままです。自己ホストの意味を保つには、
#   検査ごと移すしかありません。
#
# ★ **移植は終わっています。** 0.16.0 で検査 7 種と解放の挿入、
#   0.18.0 で送出可能性の検査（E-SEND-1〜4。A-25）が揃いました。
#   注意: これで「どちらのコンパイラで建てたか」で保証が変わることは
#   無くなりました。
#
# ★ 対になる定義: src/ownck.c
#   ここを直したら向こうも直すこと。ずれると 2 実装の出力が食い違い、
#   `make selfhost-test` が落ちます（つまりテストが自動で見張ります）。
import ast
import strings
import token
import diag
import module

# ── 場所（Place）の種類 ─────────────────────────────────
#
# ★ 「移動したか」を追いかける単位です。変数そのものだけでなく、
#   フィールドや添字も 1 つの場所として扱います。
PL_LOCAL: int = 0
PL_FIELD: int = 1
PL_INDEX: int = 2
PL_GLOBAL: int = 3

# ★ 対になる定義: src/ownck.c の struct Place
class Place:
    kind: int
    base: rc[Place] | None   # FIELD / INDEX の親
    # 同一性の判定に使う名前
    #   LOCAL / GLOBAL … sema が振った IR 名（%x / @g.x）
    #   FIELD          … フィールド名
    key: str
    disp: str                # 診断に出す見た目（"xs" / "self.name" / "xs[…]"）

    def init(self, kind: int, base: rc[Place] | None, key: own str,
             disp: own str) -> None:
        self.kind = kind
        self.base = base
        self.key = key
        self.disp = disp

# ── 借用の根（誰から借りているか）────────────────────────
#
# ★ 対になる定義: src/ownck.c の struct BorrowRoot
class BorrowRoot:
    key: str                  # 借りている変数の IR 名（%xs）
    origin: rc[ast.Node]      # 貸し手の宣言（ND_PARAM または ND_VARDECL）
    is_param: bool            # 引数から借りているか（ローカルからもありうる）
    is_self: bool             # self か（仕様 §4.5 の例外）
    is_mut: bool              # 書き換えてよいか
    depth: int                # 貸し手が宣言されたスコープの深さ（寿命の検査）

    def init(self, key: own str, origin: rc[ast.Node], is_param: bool,
             is_self: bool, is_mut: bool, depth: int) -> None:
        self.key = key
        self.origin = origin
        self.is_param = is_param
        self.is_self = is_self
        self.is_mut = is_mut
        self.depth = depth


# ── 所有の状態 ──────────────────────────────────────────
ST_VALID: int = 0
ST_MAYBE: int = 1
ST_MOVED: int = 2

def st_join(a: int, b: int) -> int:
    if a == b:
        return a
    return ST_MAYBE

# ★ 対になる定義: src/ownck.c の struct Ent
class Ent:
    pl: rc[Place]
    st: int
    at: rc[ast.Node] | None   # 移動した位置（診断の note: に出す）
    # ★ 「借りていた先が書き換えられた」ことで使えなくなった別名なら、
    #   書き換えた場所を持ちます（E-BORROW-9。None なら普通の移動）。
    by: rc[Place] | None
    src: rc[Place] | None     # その別名が借りていた場所
    by_move: bool             # by は書き換えではなく「手放した」（移動）
    by_rc: bool               # 同じ物体を指しうる別の rc 越しの書き換え（E-BORROW-10）

    def init(self, pl: rc[Place], st: int, at: rc[ast.Node] | None) -> None:
        self.pl = pl
        self.st = st
        self.at = at
        self.by = None
        self.src = None
        self.by_move = False
        self.by_rc = False

# 別名の記録（by / src / by_move）を写す
def ent_copy_stale(dst: mut rc[Ent], src: rc[Ent]) -> None:
    dst.by = src.by
    dst.src = src.src
    dst.by_move = src.by_move
    dst.by_rc = src.by_rc

# ある時点での「全ての場所の状態」。
#
# ★ 表に無い場所は Valid です（移動されていないものを全部並べる必要はない）。
class Flow:
    ents: list[rc[Ent]]
    dead: bool   # この経路は return / break / continue で終わっている

    def init(self) -> None:
        self.ents = []
        self.dead = False

# ── 場所の比較 ──────────────────────────────────────────
#
# 注意: 添字（PL_INDEX）は**どれも同じ場所**として扱います。xs[0] と xs[1] は
#   コンパイル時に区別できないためです（設計 ownership.md §3）。
def place_eq(a: rc[Place], b: rc[Place]) -> bool:
    if a.kind != b.kind:
        return False
    if a.key != b.key:
        return False
    ab: rc[Place] | None = a.base
    bb: rc[Place] | None = b.base
    if ab is None and bb is None:
        return True
    if ab is None or bb is None:
        return False
    return place_eq(ab, bb)

# a が b の接頭辞か（xs は xs[…] の接頭辞）
def place_prefix_of(a: rc[Place], b: rc[Place]) -> bool:
    cur: rc[Place] | None = b
    while cur is not None:
        c: rc[Place] = cur
        if place_eq(a, c):
            return True
        cur = c.base
    return False

# 2 つの場所が重なるか（どちらかがもう一方の一部）
def place_overlaps(a: rc[Place], b: rc[Place]) -> bool:
    return place_prefix_of(a, b) or place_prefix_of(b, a)

# ── 型の分類（C 版 ty_is_rc / ty_is_owned と対）──────────────
def ty_is_rc(t: rc[ast.Type]) -> bool:
    if t.kind == ast.TY_RC:
        return True
    if t.kind == ast.TY_OPT:
        return ty_is_rc(ast.elem_of(t))
    return False

# 所有型か（解放の対象になりうる型か）
def unwrap_enum(e: rc[ast.EnumDef] | None) -> rc[ast.EnumDef]:
    if e is None:
        panic(diag.msg0("sownck.001", "ownck: 列挙の定義がありません"))
        return rc(ast.EnumDef("", None))
    else:
        return e


def ty_is_owned(t: rc[ast.Type]) -> bool:
    if (t.kind == ast.TY_STR or t.kind == ast.TY_LIST or
            t.kind == ast.TY_CLASS or t.kind == ast.TY_RC):
        return True
    # ★ 中身を持つ列挙（A-41）はヒープの物体です。名前だけの列挙は
    #   ただの i64 なので、後始末は要りません。
    if t.kind == ast.TY_ENUM:
        e0: rc[ast.EnumDef] | None = t.en
        if e0 is None:
            return False
        return unwrap_enum(e0).has_payload
    # T | None も中身が所有型なら所有型
    if t.kind == ast.TY_OPT:
        return ty_is_owned(ast.elem_of(t))
    return False


# ── Flow の操作（C 版 flow_* と対）─────────────────────────
#
# 注意: C 版は連結リストを継ぎ替えますが、こちらは list[rc[Ent]] を作り直します。
#   結果は同じです（表に無い場所は Valid、という約束が同じなので）。

def flow_copy(src: rc[Flow]) -> rc[Flow]:
    out: rc[Flow] = rc(Flow())
    out.dead = src.dead
    i: int = 0
    while i < len(src.ents):
        e: rc[Ent] = src.ents[i]
        c: rc[Ent] = rc(Ent(e.pl, e.st, e.at))
        ent_copy_stale(c, e)
        out.ents.append(c)
        i = i + 1
    return out

def flow_find(f: rc[Flow], p: rc[Place]) -> rc[Ent] | None:
    i: int = 0
    while i < len(f.ents):
        e: rc[Ent] = f.ents[i]
        if place_eq(e.pl, p):
            return e
        i = i + 1
    return None

# p（またはそれと重なる場所）の状態。いちばん悪いものを返す。
#
# ★ 重なりを見るのがここです。'a' を移動した後に 'a.f' を読むのも、
#   'a.f' を移動した後に 'a' を丸ごと読むのも、どちらもエラーです。
def state_of(f: rc[Flow], p: rc[Place]) -> int:
    worst: int = ST_VALID
    found: bool = False
    i: int = 0
    while i < len(f.ents):
        e: rc[Ent] = f.ents[i]
        if e.st != ST_VALID and place_overlaps(e.pl, p):
            if not found or e.st > worst:
                worst = e.st
                found = True
        i = i + 1
    if found:
        return worst
    return ST_VALID

# 「誰が移動したか」も要るとき（診断の note: 用）
def mover_of(f: rc[Flow], p: rc[Place]) -> rc[Ent] | None:
    worst: int = ST_VALID
    who: rc[Ent] | None = None
    i: int = 0
    while i < len(f.ents):
        e: rc[Ent] = f.ents[i]
        if e.st != ST_VALID and place_overlaps(e.pl, p):
            if who is None or e.st > worst:
                worst = e.st
                who = e
        i = i + 1
    return who

# p と重なる記録を消す（＝ふたたび Valid にする）
def flow_clear(f: mut rc[Flow], p: rc[Place]) -> None:
    keep: list[rc[Ent]] = []
    i: int = 0
    while i < len(f.ents):
        e: rc[Ent] = f.ents[i]
        if not place_overlaps(e.pl, p):
            keep.append(e)
        i = i + 1
    f.ents = keep

def flow_move(f: mut rc[Flow], p: rc[Place], at: rc[ast.Node] | None) -> None:
    flow_clear(f, p)
    f.ents.append(rc(Ent(p, ST_MOVED, at)))

# 別名 p が借りていた先（by）が at で書き換えられた、と記録する（E-BORROW-9）。
# ★ 対になる定義: src/ownck.c の flow_stale
def flow_stale(f: mut rc[Flow], p: rc[Place], by: rc[Place], src: rc[Place],
               by_move: bool, at: rc[ast.Node]) -> None:
    flow_move(f, p, at)
    e: rc[Ent] = f.ents[len(f.ents) - 1]
    e.by = by
    e.src = src
    e.by_move = by_move

# dst ← dst ⊔ src（合流）
def flow_join(dst: mut rc[Flow], src: rc[Flow]) -> None:
    if src.dead:
        return          # 到達しない経路は合流に参加しない（設計 4.2）
    if dst.dead:
        cp: rc[Flow] = flow_copy(src)
        # ★ move_out で持ち主ごと移す。ただの代入だと cp と dst が同じ
        #   リストを持ち、cp のスコープ出口で解放されて dst が宙に浮きます。
        dst.ents = move_out(cp.ents)
        dst.dead = cp.dead
        return

    # dst 側にある場所：src に記録が無ければ、src では Valid だったということ
    i: int = 0
    while i < len(dst.ents):
        e: rc[Ent] = dst.ents[i]
        sfound: rc[Ent] | None = flow_find(src, e.pl)
        other: int = ST_VALID
        if sfound is not None:
            other = sfound.st
        joined: int = st_join(e.st, other)
        if joined != e.st and sfound is not None:
            sf: rc[Ent] = sfound
            if sf.at is not None:
                e.at = sf.at   # 位置は「片方の枝」を指せれば足りる
                ent_copy_stale(e, sf)
        e.st = joined
        i = i + 1

    # src にしか無い場所：dst 側は Valid なので、必ず MaybeMoved になる
    k: int = 0
    while k < len(src.ents):
        se: rc[Ent] = src.ents[k]
        if se.st != ST_VALID and flow_find(dst, se.pl) is None:
            # 片方が Valid なので MaybeMoved
            ne: rc[Ent] = rc(Ent(se.pl, st_join(ST_VALID, se.st), se.at))
            ent_copy_stale(ne, se)
            dst.ents.append(ne)
        k = k + 1

def flow_eq(a: rc[Flow], b: rc[Flow]) -> bool:
    if a.dead != b.dead:
        return False
    i: int = 0
    while i < len(a.ents):
        e: rc[Ent] = a.ents[i]
        o: rc[Ent] | None = flow_find(b, e.pl)
        ost: int = ST_VALID
        if o is not None:
            ost = o.st
        if ost != e.st:
            return False
        i = i + 1
    k: int = 0
    while k < len(b.ents):
        be: rc[Ent] = b.ents[k]
        if be.st != ST_VALID and flow_find(a, be.pl) is None:
            return False
        k = k + 1
    return True


# ── 移動の文脈（借用のときに何と言うかが変わる）──────────────
# ★ 対になる定義: src/ownck.c の MoveCtx
MV_ASSIGN: int = 0    # ys = xs        変数への代入
MV_FIELD: int = 1     # self.xs = a    フィールドへ保存
MV_APPEND: int = 2    # xss.append(a)  コンテナへ保存
MV_RETURN: int = 3    # return a       返す
MV_OWN_ARG: int = 4   # take(a)        own 引数へ渡す

# ── 書き換えの種類（E-MUT-1 の文面が変わる）────────────────
# ★ 対になる定義: src/ownck.c の WriteKind
WR_ASSIGN: int = 0    # p.f = v / xs[i] = v
WR_METHOD: int = 1    # mut self のメソッドを呼んだ
WR_APPEND: int = 2    # append した
WR_ARG: int = 3       # mut 引数に渡した

# ── 1 つの呼び出しに渡す実引数の記録（E-BORROW-5 の判定に使う）──
# ★ 対になる定義: src/ownck.c の struct ArgRef
class ArgRef:
    expr: rc[ast.Node]   # 実引数の式（self なら受け手）
    is_mut: bool         # 可変借用として渡すか
    kind: int            # 診断の言い回し

    def init(self, expr: rc[ast.Node], is_mut: bool, kind: int) -> None:
        self.expr = expr
        self.is_mut = is_mut
        self.kind = kind


# ── 検査の設定と、報告の数え上げ ────────────────────────────
#
# ★ 対になる定義: src/ownck.c の OwnckOptions / Own
class Options:
    deny_move: bool
    deny_borrow: bool
    deny_mut: bool
    deny_store_borrow: bool
    explain_mut: bool
    quiet: bool
    max_report: int

    def init(self) -> None:
        # ★ 既定は **エラー**（A-24）。--warn-own を受け取った入口だけが
        #   False にします。注意: ここを False にしてしまうと、main 以外の
        #   入口（check / emit_ir）が **2 実装で食い違う**ことになります
        #   （tests/selfhost.sh の③ が「C=1 stage1=0」で落ちて気づきました）。
        self.deny_move = True
        self.deny_borrow = True
        self.deny_mut = True
        self.deny_store_borrow = True
        self.explain_mut = False
        self.quiet = False
        self.max_report = 20


# 報告を 1 件出す（deny なら error に上げて止める）
#
# 注意: 上限を超えたぶんは数えるだけにします（C 版 OWNCK_MAX_REPORT と同じ）。
#   ただし **error は必ず出します**（黙って通すわけにいかないため）。
class Reporter:
    opt: Options
    nreport: int
    nmore: int

    def init(self, opt: own Options) -> None:
        self.opt = opt
        self.nreport = 0
        self.nmore = 0

    def emit(mut self, d: mut diag.Diag, deny: bool) -> None:
        if self.opt.quiet:
            return
        if self.opt.explain_mut:
            return      # --explain-mut は一覧を出すだけの道具
        if not deny and self.nreport >= self.opt.max_report:
            self.nmore = self.nmore + 1
            return
        self.nreport = self.nreport + 1
        if deny:
            d.severity = "error"
            diag.fail(d)
        d.severity = "warning"
        diag.emit(d)

    # ── E-MOVE-1: 移動済みの値を使った ────────────────────
    #
    # ★ 対になる定義: src/ownck.c の report_use。
    #   注意: **文面を 1 文字でも変えたら向こうも変えること。**
    #     ずれると make selfhost-test が落ちます（それが見張りです）。
    def report_use(mut self, p: rc[Place], moved: rc[Ent],
                   at: rc[token.Token]) -> None:
        if self.opt.quiet:
            return
        maybe: bool = moved.st == ST_MAYBE
        # ★ 移動した場所と使った場所が同じなら、それはループの前の反復です。
        #   「分岐によっては」では読み手に意味が通らないので言い換えます。
        prev_round: bool = False
        mt: rc[token.Token] | None = tok_of_node(moved.at)
        if mt is not None:
            prev_round = same_tok(mt, at)

        msg: str = diag.msg("own.002", "移動済みの値 '{0}' を使っています", [copy(p.disp)])
        if maybe:
            msg = diag.msg("own.001", "移動済みかもしれない値 '{0}' を使っています", [copy(p.disp)])

        rel: str = diag.msg("own.005", "'{0}' はここで移動しました", [copy(moved.pl.disp)])
        if prev_round:
            rel = diag.msg("own.003", "'{0}' は前の繰り返しで、ここで移動しています", [copy(moved.pl.disp)])
        elif maybe:
            rel = diag.msg("own.004", "分岐によっては、'{0}' はここで移動しています", [copy(moved.pl.disp)])

        hint: str = diag.msg0("own.053", "移動した後も使うなら、値を作り直して代入してください（例: xs = [...]）")
        if prev_round:
            hint = (diag.msg0("own.051", "繰り返しのたびに移動するので、2 周目には値がありません（ループの中で作り直すか、借用で足りないか確かめてください）"))
        elif maybe:
            hint = diag.msg0("own.052", "どの経路を通っても有効になるように、分岐の後で代入し直してください")

        d: diag.Diag = diag.Diag(msg)
        d.code = "E-MOVE-1"
        d.primary = diag.Label(at, diag.msg0("own.050", "ここで使われています"))
        if mt is not None:
            d.related = diag.Label(mt, rel)
        d.hint = hint
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_move
        self.emit(d, deny)


    # ── E-BORROW-1/3/4: 借用した値を動かそうとした ───────────
    #
    # ★ 「なぜ駄目か」より「どう直すか」を先に出します（仕様 §12）。
    #   直し方はいつも同じ：**その引数を own にする**。
    #   対になる定義: src/ownck.c の report_borrow
    def report_borrow(mut self, br: rc[BorrowRoot], p: rc[Place],
                      at: rc[token.Token], ctx: int) -> None:
        if self.opt.quiet:
            return
        code: str = "E-BORROW-1"
        msg: str = diag.msg("own.006", "借用した値 '{0}' は移動できません", [copy(p.disp)])
        label: str = diag.msg0("own.054", "ここで移動しようとしています")
        if ctx == MV_FIELD:
            code = "E-BORROW-3"
            msg = diag.msg("own.007", "借用した値 '{0}' をフィールドに保存できません", [copy(p.disp)])
            label = diag.msg0("own.055", "保存すると、貸してくれた相手より長生きしてしまいます")
        elif ctx == MV_APPEND:
            code = "E-BORROW-3"
            msg = diag.msg("own.008", "借用した値 '{0}' をリストに保存できません", [copy(p.disp)])
            label = diag.msg0("own.055", "保存すると、貸してくれた相手より長生きしてしまいます")
        elif ctx == MV_RETURN:
            code = "E-BORROW-4"
            msg = diag.msg("own.009", "借用した値 '{0}' は返せません", [copy(p.disp)])
            label = diag.msg0("own.056", "返すと、呼び出しが終わった後も生き続けてしまいます")

        rel: str = diag.msg("own.011", "'{0}' が所有しています（借りているだけです）", [copy(br.origin.name)])
        if br.is_self:
            rel = diag.msg0("own.057", "'self' は借用です（メソッドはインスタンスを借りているだけです）")
        elif br.is_param:
            rel = diag.msg("own.010", "引数 '{0}' は借用です（既定）", [copy(br.origin.name)])

        tname: str = "T"
        ot: rc[ast.Type] | None = br.origin.type
        if ot is not None:
            tname = ast.type_name(ot)

        hint: str = (diag.msg("own.014", "引数を '{0}: own {1}' にすると、所有権を受け取れます", [copy(br.origin.name), copy(tname)]))
        if br.is_self:
            hint = (diag.msg0("own.058", "返してよいのは self のフィールドの借用だけです（仕様 §4.5）。値そのものが要るなら copy(...) を使ってください"))
        elif not br.is_param:
            hint = (diag.msg("own.012", "'{0}' が生きている間しか使えません。所有権ごと渡すなら、作った値を直接渡してください", [copy(br.origin.name)]))
        elif ctx == MV_ASSIGN:
            hint = (diag.msg("own.013", "別の名前を付けずに、そのまま使ってください（所有権ごと要るなら '{0}: own {1}' にします）", [copy(br.origin.name), copy(tname)]))

        d: diag.Diag = diag.Diag(msg)
        d.code = code
        d.primary = diag.Label(at, label)
        obt: rc[token.Token] | None = br.origin.tok
        if obt is not None:
            d.related = diag.Label(obt, rel)
        d.hint = hint
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_borrow
        self.emit(d, deny)

    # ── E-BORROW-8: 自分が所有しているものの一部を返した（A-21d）──
    def report_return_borrow(mut self, p: rc[Place], at: rc[token.Token],
                             lender: rc[ast.Node] | None) -> None:
        if self.opt.quiet:
            return
        d: diag.Diag = diag.Diag(diag.msg("own.015", "借用した値 '{0}' を返しています", [copy(p.disp)]))
        d.code = "E-BORROW-8"
        d.primary = diag.Label(at, diag.msg0("own.059", "返した先では所有になりますが、ここでは借りものです"))
        if lender is not None:
            ld: rc[ast.Node] = lender
            lt: rc[token.Token] | None = ld.tok
            if lt is not None:
                d.related = diag.Label(lt, diag.msg("own.016", "'{0}' が所有していて、この関数の出口で解放されます", [copy(ld.name)]))
        d.hint = (diag.msg0("own.060", "持ち主から取り上げるなら move_out(...)、複製するなら copy(...) を使ってください"))
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_store_borrow
        self.emit(d, deny)

    # ── E-SEND-1〜4: スレッドの境界を越えられるか（A-25 で移植）──
    #
    # ★ **新しい注釈は 1 つも足していません。** own / mut / 借用 / rc という
    #   すでにある区別に「スレッドをまたげるか」を尋ねるだけです。
    #   注意: **既定でエラーです**（deny には従いません）。--warn-own を付けても、
    #     データ競合が無いという保証だけは警告に落としません。
    #   対になる定義: src/ownck.c の check_spawn
    def report_send_borrow(mut self, disp: str, at: rc[token.Token]) -> None:
        d: diag.Diag = diag.Diag(diag.msg("own.043", "借りている値 '{0}' はスレッドに渡せません", [copy(disp)]))
        d.code = "E-SEND-1"
        d.primary = diag.Label(at, diag.msg0("own.084", "スレッドは、この呼び出しより長生きしえます"))
        d.hint = (diag.msg0("own.085", "scope: ブロックで囲む（出口で必ず join されます）か、所有ごと渡す（引数を 'own' で受ける）か、mutex[…] に入れてください"))
        self.emit(d, True)

    def report_send_rc(mut self, rcname: str, tname: str, direct: bool,
                       at: rc[token.Token]) -> None:
        msg: str = diag.msg("own.041", "'{0}' は中に {1} を持つので、スレッドに渡せません", [copy(tname), copy(rcname)])
        hint: str = (diag.msg0("own.081", "渡す値から rc[…] を外してください（必要なぶんを写して持たせる形にします）"))
        if direct:
            msg = diag.msg("own.040", "{0} はスレッドに渡せません", [copy(rcname)])
            hint = diag.msg0("own.080", "mutex[…] に入れるか、own で所有ごと渡してください")
        d: diag.Diag = diag.Diag(msg)
        d.code = "E-SEND-2"
        d.primary = diag.Label(at, diag.msg0("own.079", "参照数の増減が競合します（早すぎる解放になります）"))
        d.hint = hint
        self.emit(d, True)

    def report_send_global(mut self, fname: str, at: rc[token.Token],
                           hit: rc[token.Token] | None) -> None:
        d: diag.Diag = diag.Diag(diag.msg("own.044", "'{0}' はグローバル変数を書き換えるので、スレッドで始められません", [copy(fname)]))
        d.code = "E-SEND-3"
        d.primary = diag.Label(at, diag.msg0("own.086", "この関数をスレッドで始めようとしています"))
        if hit is not None:
            d.related = diag.Label(hit, diag.msg0("own.087", "ここでグローバルに書いています"))
        d.hint = diag.msg0("own.088", "書き換える値を mutex[…] に入れて、引数で渡してください")
        self.emit(d, True)

    # ── E-EXPORT-3 / 4: 外へ出す関数の検査。対になる定義: src/ownck.c の check_export
    def report_export_hazard(mut self, fname: str, at: rc[token.Token],
                             hit: rc[token.Token] | None, what: int) -> None:
        d: diag.Diag = diag.Diag("")
        if what == HZ_GLOBAL_WRITE:
            d = diag.Diag(diag.msg("own.047", "外へ出す関数 '{0}' はグローバル変数を書き換えます", [copy(fname)]))
            d.code = "E-EXPORT-3"
        else:
            d = diag.Diag(diag.msg("own.048", "外へ出す関数 '{0}' からスレッドを始めています", [copy(fname)]))
            d.code = "E-EXPORT-4"
        d.primary = diag.Label(at, diag.msg0("own.092", "外から、どのスレッドからでも呼ばれる関数です"))
        if hit is not None:
            if what == HZ_GLOBAL_WRITE:
                d.related = diag.Label(hit, diag.msg0("own.087", "ここでグローバルに書いています"))
            else:
                d.related = diag.Label(hit, diag.msg0("own.094", "ここで spawn（または scope:）を使っています"))
        if what == HZ_GLOBAL_WRITE:
            d.hint = (diag.msg0("own.093", "状態は引数と戻り値で受け渡してください（同時に呼ばれると競合し、panic したときに書きかけで残ります）"))
        else:
            d.hint = (diag.msg0("own.095", "いまは外へ出す関数からスレッドを使えません（panic したときに、動いているスレッドを安全に止められないためです）"))
        self.emit(d, True)

    def report_send_mut(mut self, disp: str, at: rc[token.Token]) -> None:
        d: diag.Diag = diag.Diag(diag.msg("own.042", "可変借用 '{0}' はスレッドに渡せません", [copy(disp)]))
        d.code = "E-SEND-4"
        d.primary = diag.Label(at, diag.msg0("own.082", "2 本のスレッドが同時に書き換えうるので、重なっていないことを静的に言えません"))
        d.hint = (diag.msg0("own.083", "own で所有ごと渡す（結果は join で受け取る）か、mutex[…] に入れてください"))
        self.emit(d, True)

    # ── E-BORROW-7: 借りものを所有する側へ渡した ─────────────
    def report_store_borrow(mut self, p: rc[Place], at: rc[token.Token],
                            ctx: int, lender: rc[ast.Node] | None) -> None:
        if self.opt.quiet:
            return
        msg: str = diag.msg("own.019", "借用した値 '{0}' をフィールドに保存しています", [copy(p.disp)])
        label: str = diag.msg0("own.062", "保存すると、所有者が 2 つになります")
        if ctx == MV_APPEND:
            msg = diag.msg("own.017", "借用した値 '{0}' をリストに保存しています", [copy(p.disp)])
        elif ctx == MV_OWN_ARG:
            msg = diag.msg("own.018", "借用した値 '{0}' を own 引数へ渡しています", [copy(p.disp)])
            label = diag.msg0("own.061", "渡すと、所有者が 2 つになります")

        d: diag.Diag = diag.Diag(msg)
        d.code = "E-BORROW-7"
        d.primary = diag.Label(at, label)
        if lender is not None:
            ld2: rc[ast.Node] = lender
            lt2: rc[token.Token] | None = ld2.tok
            if lt2 is not None:
                d.related = diag.Label(lt2, diag.msg("own.020", "'{0}' が所有しています（読んだだけでは借りものです）", [copy(ld2.name)]))
        d.hint = (diag.msg0("own.063", "入れる値をその場で作るか、copy(...) で複製してください（共有したままにするなら rc[T] です）"))
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_store_borrow
        self.emit(d, deny)





    # ── E-BORROW-9: 借りていた先が書き換えられた別名を使った ──
    #
    # ★ 対になる定義: src/ownck.c の report_stale。
    #   注意: **文面を 1 文字でも変えたら向こうも変えること。**
    def report_stale(mut self, p: rc[Place], who: rc[Ent],
                     at: rc[token.Token]) -> None:
        if self.opt.quiet:
            return
        by: rc[Place] = place_opt(who.by)
        src: rc[Place] = place_opt(who.src)
        maybe: bool = who.st == ST_MAYBE
        wt: rc[token.Token] | None = tok_of_node(who.at)
        d: diag.Diag = diag.Diag("")
        # ★ for の隠し変数（for.it.N）なら、回している最中に対象を入れ替えた形です。
        if strings.startswith(who.pl.disp, "for."):
            d = diag.Diag(diag.msg("own.030", "for で回している '{0}' を、回している途中で入れ替えています", [copy(by.disp)]))
            d.code = "E-BORROW-9"
            d.primary = diag.Label(at, diag.msg0("own.075", "次の周で、入れ替える前の（解放済みの）リストを読みます"))
            if wt is not None:
                d.related = diag.Label(wt, diag.msg("own.031", "ここで '{0}' を入れ替えています", [copy(by.disp)]))
            d.hint = (diag.msg0("own.076", "入れ替えた後のリストを回したいなら、ループを抜けてから回し直してください（回しながら作るなら、別のリストに append します）"))
            deny0: bool = self.opt.deny_borrow
            self.emit(d, deny0)
            return
        cond: str = ""
        if maybe:
            cond = diag.msg0("own.096", "分岐によっては")
        # ★ 同じ物体を指しうる別の rc 越しの書き換え（E-BORROW-10）。
        #   対になる定義: src/ownck.c の report_stale（文面も同じ）
        if who.by_rc:
            d = diag.Diag(diag.msg("own.032", "'{0}' が借りている '{1}' は、{2}解放されているかもしれません", [copy(who.pl.disp), copy(src.disp), copy(cond)]))
            d.code = "E-BORROW-10"
            d.primary = diag.Label(at, diag.msg0("own.050", "ここで使われています"))
            cond2: str = ""
            if maybe:
                cond2 = diag.msg0("own.097", "分岐によっては、")
            rel2: str = (diag.msg("own.034", "{0}ここで '{1}' を書き換えています（同じ物体を指しうる rc 越し）", [copy(cond2), copy(by.disp)]))
            if by.key == "<call>":
                rel2 = (diag.msg("own.033", "{0}この '{1}' の中で、同じ物体を指しうる rc 越しに書き換えられます", [copy(cond2), copy(by.disp)]))
            if wt is not None:
                d.related = diag.Label(wt, rel2)
            d.hint = (diag.msg("own.035", "rc は同じ物体を何か所からでも指せるので、別の名前からの書き換えでも '{0}' の古い値は解放されえます。書き換えた後で使うなら読み直し、書き換える前の値が要るなら copy(...) で手元に写してください", [copy(src.disp)]))
            deny1: bool = self.opt.deny_borrow
            self.emit(d, deny1)
            return
        verb: str = diag.msg0("own.078", "書き換えました")
        if who.by_move:
            verb = diag.msg0("own.077", "手放しました")
        d = diag.Diag(diag.msg("own.032", "'{0}' が借りている '{1}' は、{2}解放されているかもしれません", [copy(who.pl.disp), copy(src.disp), copy(cond)]))
        d.code = "E-BORROW-9"
        d.primary = diag.Label(at, diag.msg0("own.050", "ここで使われています"))
        rel: str = diag.msg("own.037", "ここで '{0}' を{1}（古い値は解放されえます）", [copy(by.disp), copy(verb)])
        if maybe:
            rel = diag.msg("own.036", "分岐によっては、ここで '{0}' を{1}", [copy(by.disp), copy(verb)])
        if wt is not None:
            d.related = diag.Label(wt, rel)
        if who.by_move:
            d.hint = (diag.msg("own.038", "'{0}' を手放す前に使い終えるか、copy(...) で手元に写してください", [copy(by.disp)]))
        else:
            d.hint = (diag.msg("own.039", "書き換えた後で使うなら、読み直してください（例: {0} = {1}）。書き換える前の値が要るなら copy(...) で手元に写してください", [copy(who.pl.disp), copy(src.disp)]))
        deny: bool = self.opt.deny_borrow
        self.emit(d, deny)

    # ── E-BORROW-5: 同じ場所を可変借用と他の借用で同時に渡した ──
    #
    # ★ 対になる定義: src/ownck.c の report_alias
    def report_alias(mut self, m: rc[ArgRef], other: rc[ArgRef],
                     p: rc[Place]) -> None:
        if self.opt.quiet:
            return
        msg: str = diag.msg("own.026", "'{0}' を可変借用と共有借用で同時に渡しています", [copy(p.disp)])
        rel: str = diag.msg0("own.071", "こちらは共有借用です")
        if other.is_mut:
            msg = diag.msg("own.025", "'{0}' を 2 つの可変借用として同時に渡しています", [copy(p.disp)])
            rel = diag.msg0("own.070", "こちらも可変借用です")
        d: diag.Diag = diag.Diag(msg)
        d.code = "E-BORROW-5"
        mt: rc[token.Token] | None = m.expr.tok
        if mt is not None:
            d.primary = diag.Label(mt, diag.msg0("own.069", "こちらは可変借用（書き換える側）です"))
        ot: rc[token.Token] | None = other.expr.tok
        if ot is not None:
            d.related = diag.Label(ot, rel)
        d.hint = (diag.msg0("own.072", "同じ値を同時に貸せるのは「共有借用を何個でも」か「可変借用を 1 つだけ」のどちらかです（仕様 §4.3）"))
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_borrow
        self.emit(d, deny)

    # ── E-MUT-1: 読み取り専用の借用を書き換えた ──────────────
    #
    # ★ 対になる定義: src/ownck.c の check_mut
    def report_mut(mut self, at: rc[token.Token], p: rc[Place],
                   br: rc[BorrowRoot], kind: int, fn_name: str) -> None:
        if self.opt.quiet:
            return
        label: str = diag.msg0("own.064", "この代入で書き換えています")
        if kind == WR_METHOD:
            label = diag.msg0("own.065", "このメソッドは self を書き換えます")
        elif kind == WR_APPEND:
            label = diag.msg0("own.066", "append はリストを書き換えます")
        elif kind == WR_ARG:
            label = diag.msg0("own.067", "この引数は 'mut' で受け取られます")

        rel: str = diag.msg("own.022", "引数 '{0}' は読み取り専用の借用です（既定）", [copy(br.origin.name)])
        if br.is_self:
            rel = diag.msg0("own.068", "'self' は読み取り専用で借りています")

        tname: str = "T"
        ot: rc[ast.Type] | None = br.origin.type
        if ot is not None:
            tname = ast.type_name(ot)
        hint: str = diag.msg("own.024", "引数を '{0}: mut {1}' にしてください", [copy(br.origin.name), copy(tname)])
        if br.is_self:
            nm: str = fn_name
            if len(nm) == 0:
                nm = diag.msg0("own.098", "メソッド名")
            hint = diag.msg("own.023", "メソッドの宣言を 'def {0}(mut self, ...)' にしてください", [copy(nm)])

        d: diag.Diag = diag.Diag(diag.msg("own.021", "読み取り専用の借用 '{0}' を書き換えています", [copy(p.disp)]))
        d.code = "E-MUT-1"
        d.primary = diag.Label(at, label)
        obt: rc[token.Token] | None = br.origin.tok
        if obt is not None:
            d.related = diag.Label(obt, rel)
        d.hint = hint
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_mut
        self.emit(d, deny)

    # ── E-BORROW-6: 借りものが貸し手より長生きする ───────────
    #
    # ★ 借用の寿命を「呼び出しの間」に固定した（仕様 §4.4）のと同じ考えを、
    #   ローカル変数どうしにも当てはめます。
    #   対になる定義: src/ownck.c の bind_alias の中
    def report_outlive(mut self, target: rc[ast.Node],
                       origin: rc[ast.Node]) -> None:
        if self.opt.quiet:
            return
        d: diag.Diag = diag.Diag(diag.msg("own.045", "借りたもの（'{0}' の一部）は、'{1}' より長く持てません", [copy(origin.name), copy(origin.name)]))
        d.code = "E-BORROW-6"
        tt: rc[token.Token] | None = target.tok
        if tt is not None:
            d.primary = diag.Label(tt, diag.msg0("own.089", "こちらのほうが長生きします"))
        ot: rc[token.Token] | None = origin.tok
        if ot is not None:
            d.related = diag.Label(ot, diag.msg("own.046", "'{0}' はこのスコープが終わると消えます", [copy(origin.name)]))
        d.hint = (diag.msg0("own.090", "内側で作った値は、内側で使い切ってください（外へ渡すなら所有権ごと渡します）"))
        # 注意: emit は self を可変で借ります。同じ式の中で self.opt を
        #   共有借用すると E-BORROW-5 になるので、先に読み出します。
        deny: bool = self.opt.deny_borrow
        self.emit(d, deny)
# ── 変数宣言の表 ────────────────────────────────────────
#
# ★ 「この変数は借りものを束縛している」という印は、代入した場所ではなく
#   **宣言のノード**に付けます。codegen は宣言を見て drop を出すからです。
# ★ 対になる定義: src/ownck.c の struct DeclEnt
class DeclEnt:
    key: str                 # IR 名
    decl: rc[ast.Node]       # 宣言のノード（ND_VARDECL / ND_PARAM）
    depth: int               # 宣言されたスコープの深さ

    def init(self, key: own str, decl: rc[ast.Node], depth: int) -> None:
        self.key = key
        self.decl = decl
        self.depth = depth


# ── 別名の借り先（E-BORROW-9）──────────────────────────
#
# ★ BorrowRoot が答えるのは「誰の持ち物か」だけです。`q: P = b.p` のあとで
#   `b.reset()` が b.p を解放すると q は宙に浮くので、「q が指しているのは
#   b.p だ」という**経路**を持ちます。別名の別名は貸し手までたどり直します。
# ★ 対になる定義: src/ownck.c の struct Loan
class Loan:
    key: str          # 別名の変数の IR 名（%q）
    disp: str         # 診断に出す名前（q）
    src: rc[Place]    # 借りている場所（b.p / xs[…]）
    hops: list[rc[RcHop]]  # 借りている場所が通る「ほかから指されうる物体」（E-BORROW-10）

    def init(self, key: own str, disp: own str, src: rc[Place],
             hops: own list[rc[RcHop]]) -> None:
        self.key = key
        self.disp = disp
        self.src = src
        self.hops = hops


# 借りている場所が「ほかから指されうる物体」の中を通っているとき、
# その物体の型と、そこから先の経路（E-BORROW-10）。
#
# ★ 名前の経路（Place）だけでは、同じ物体を指す**別の rc** が見えません。
#     a: rc[Box] = …;  b = a;  q = a.p;  b.p = P(7)   ← q が宙に浮く
#   そこで「a の指す物体（Box）の中の .p」という形でも覚えておき、
#   書き換えを**クラスとフィールド**で突き合わせます。
#
# ★ 対になる定義: src/ownck.c の struct RcStep / struct RcHop
class RcStep:
    cls: rc[ast.Type]   # フィールドを持つクラス
    field: str          # そのフィールド

    def init(self, cls: rc[ast.Type], field: own str) -> None:
        self.cls = cls
        self.field = field

class RcHop:
    t: rc[ast.Type]             # 物体の型（クラスか list）
    rest: rc[Place]             # 物体から先の経路（根は "<obj>"）
    steps: list[rc[RcStep]]     # 物体から先で通るフィールド（クラスごと）
    via_rc: bool                # rc[T] の中身として見つけたもの

    def init(self, t: rc[ast.Type], rest: rc[Place], steps: own list[rc[RcStep]],
             via_rc: bool) -> None:
        self.t = t
        self.rest = rest
        self.steps = steps
        self.via_rc = via_rc

# 呼び出しが書き換えうるフィールド（E-BORROW-10）。
# ★ 対になる定義: src/ownck.c の struct FnEff
class FnEff:
    fn: rc[ast.Node]
    direct: list[rc[RcStep]]       # 本体が直に書くフィールド
    callees: list[rc[ast.Node]]    # 本体から呼ぶ関数
    calls: list[rc[ast.Node]]      # その呼び出しのノード（callees と同じ並び）
    all: list[rc[RcStep]]          # 呼び先までたどった全体
    globals: list[rc[ast.Type]]    # 本体が触るグローバルの型
    gall: list[rc[ast.Type]]       # 呼び先までたどった全体
    done: bool

    def init(self, fn: rc[ast.Node]) -> None:
        self.fn = fn
        self.direct = []
        self.callees = []
        self.calls = []
        self.all = []
        self.globals = []
        self.gall = []
        self.done = False


# ── 検査中の文脈 ────────────────────────────────────────
#
# ★ 対になる定義: src/ownck.c の struct Own
class Own:
    rep: Reporter            # 報告（上限つき）
    quiet_depth: int         # >0 なら診断を出さない（while の不動点反復中）
    roots: list[rc[BorrowRoot]]  # いま検査中の関数で「借りている」変数
    decls: list[rc[DeclEnt]]     # いま検査中の関数の変数宣言
    loans: list[rc[Loan]]        # いま検査中の関数の別名と、その借り先（E-BORROW-9）
    depth: int               # 今いるスコープの深さ（借用の寿命の検査に使う）
    cur_fn: rc[ast.Node] | None  # いま検査中の関数（診断の「直し方」に名前が要る）
    scope_depth: int         # scope: の中にいる深さ（0 なら外）
    loop: rc[Loop] | None    # いま中にいるループ（break / continue の合流先）
    # 関数の定義を IR 名から引く表（この引数は own か、を知るのに要る）
    func_keys: list[str]
    func_nodes: list[rc[ast.Node]]
    # 呼び出しが書き換えうるフィールドの表（E-BORROW-10）
    effs: list[rc[FnEff]]
    all_globals: list[rc[ast.Type]]
    all_globals_done: bool

    def init(self, rep: own Reporter) -> None:
        self.rep = rep
        self.quiet_depth = 0
        self.roots = []
        self.decls = []
        self.loans = []
        self.depth = 0
        self.cur_fn = None
        self.scope_depth = 0
        self.loop = None
        self.func_keys = []
        self.func_nodes = []
        self.effs = []
        self.all_globals = []
        self.all_globals_done = False

    # 宣言を IR 名から引く
    def find_decl(self, ir_name: str) -> rc[DeclEnt] | None:
        if len(ir_name) == 0:
            return None
        i: int = 0
        while i < len(self.decls):
            d: rc[DeclEnt] = self.decls[i]
            if d.key == ir_name:
                return d
            i = i + 1
        return None

    # 関数を IR 名から引く
    def lookup_func(self, ir_name: str) -> rc[ast.Node] | None:
        if len(ir_name) == 0:
            return None
        i: int = 0
        while i < len(self.func_keys):
            if self.func_keys[i] == ir_name:
                return self.func_nodes[i]
            i = i + 1
        return None

    # 場所の根が借用引数なら、その根を返す。
    #
    # ★ self.name も t.text も、根をたどれば仮引数です。
    #   「借りたものの一部」もまた借りものである、という規則がこれです。
    def borrow_root_of(self, p: rc[Place]) -> rc[BorrowRoot] | None:
        root: rc[Place] = p
        # 注意: `root = root.base` とは書けません（rc[Place] | None が入るため）。
        #   いったん受けてから絞り込みます。
        nxt: rc[Place] | None = root.base
        while nxt is not None:
            root = nxt
            nxt = root.base
        # グローバルは常に生きている（設計 §5.3）
        if root.kind != PL_LOCAL:
            return None
        i: int = 0
        while i < len(self.roots):
            b: rc[BorrowRoot] = self.roots[i]
            if b.key == root.key:
                return b
            i = i + 1
        return None

# ── 式が「場所」なら Place を作る ───────────────────────────
#
# 注意: 呼び出しの戻り値やリテラルは場所ではありません（None を返します）。
# ★ 対になる定義: src/ownck.c の place_of
def place_of(n: rc[ast.Node] | None) -> rc[Place] | None:
    if n is None:
        return None
    nn: rc[ast.Node] = n

    if nn.kind == ast.ND_VAR:
        # ★ 名前ではなく IR 名で識別します。兄弟スコープの同名変数
        #   （%x と %x.1）を別の場所として扱うためです。
        if len(nn.ir_name) == 0:
            return None
        k: int = PL_LOCAL
        if strings.startswith(nn.ir_name, "@"):
            k = PL_GLOBAL
        return rc(Place(k, None, copy(nn.ir_name), copy(nn.name)))

    if nn.kind == ast.ND_FIELD:
        # ★ 'mod.g'（他モジュールのグローバル）は「常に生きている場所」。
        #   名前が一意なので、そのまま 1 つの Global にします。
        if len(nn.mod_name) > 0:
            if len(nn.ir_name) == 0:
                return None
            return rc(Place(PL_GLOBAL, None, copy(nn.ir_name), copy(nn.name)))
        fbase: rc[Place] | None = place_of(nn.lhs)
        if fbase is None:
            return None
        fb: rc[Place] = fbase
        return rc(Place(PL_FIELD, fb, copy(nn.name), fb.disp + "." + nn.name))

    if nn.kind == ast.ND_INDEX:
        # 注意: str の添字は「場所」ではありません。`s[i]` は 1 文字の
        #   **新しい文字列**を作って返すからです（runtime の pl_str_index）。
        #   list[T] の要素と違い、元の文字列を借りているわけではないので、
        #   `for c in s:` で取り出した文字は保存しても構いません。
        lh: rc[ast.Node] | None = nn.lhs
        if lh is not None:
            lt: rc[ast.Type] | None = node_type(lh)
            if lt is not None and lt.kind == ast.TY_STR:
                return None
        ibase: rc[Place] | None = place_of(nn.lhs)
        if ibase is None:
            return None
        ib: rc[Place] = ibase
        return rc(Place(PL_INDEX, ib, "[]", ib.disp + "[…]"))

    return None

# ── 小道具 ──────────────────────────────────────────────
def tok_of_node(n: rc[ast.Node] | None) -> rc[token.Token] | None:
    if n is None:
        return None
    nn: rc[ast.Node] = n
    return nn.tok

# ノードの型（未設定なら None）
def node_type(n: rc[ast.Node]) -> rc[ast.Type] | None:
    return n.type

# 同じ位置を指しているか（行と桁で見る。C 版はポインタ比較）
def same_tok(a: rc[token.Token], b: rc[token.Token]) -> bool:
    return a.line == b.line and a.col == b.col


# ── 式をたどる ──────────────────────────────────────────
#
# ★ 対になる定義: src/ownck.c の use_expr / move_expr / check_use。
#
# 注意: **移植の優先順位**（docs/roadmap.md A-21 ⑩）
#   メモリ安全性に直結する検査から移しています。
#     移植済み … E-MOVE-1（移動済みの使用）/ E-BORROW-1,3,4,7,8（借用の扱い）
#     未移植   … E-BORROW-5（同時の可変借用）/ E-SEND-1〜4（スレッド）
#   前者は「--drop したときに壊れるか」を決める検査で、後者は別の話です。

# 移動済みの場所を使っていないか
def check_use(o: mut Own, f: rc[Flow], p: rc[Place], at: rc[token.Token]) -> None:
    if state_of(f, p) != ST_VALID:
        who: rc[Ent] | None = mover_of(f, p)
        if who is not None:
            w: rc[Ent] = who
            if w.by is not None:
                o.rep.report_stale(p, w, at)
            else:
                o.rep.report_use(p, w, at)

# None でない前提で取り出す小道具（Place 版）
def place_opt(p: rc[Place] | None) -> rc[Place]:
    if p is None:
        panic(diag.msg0("sownck.005", "ownck: 場所がありません（呼び出し側の条件が誤っています）"))
    return p

# ── 別名の借り先（E-BORROW-9）の道具 ───────────────────────
#
# ★ 対になる定義: src/ownck.c の find_loan / splice_place / resolve_place /
#   forget_loan / record_loan / invalidate_loans
def find_loan(o: Own, key: str) -> rc[Loan] | None:
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        if l.key == key:
            return l
        i = i + 1
    return None

# p の根を root に差し替えた場所を作る（q.x で q → b.p なら b.p.x）
def splice_place(p: rc[Place], root: rc[Place]) -> rc[Place]:
    pb: rc[Place] | None = p.base
    if pb is None:
        return root
    base: rc[Place] = splice_place(place_opt(pb), root)
    disp: str = base.disp + "." + p.key
    if p.kind == PL_INDEX:
        disp = base.disp + "[…]"
    return rc(Place(p.kind, base, copy(p.key), disp))

# 別名を通した場所を、貸し手の場所に直す
def resolve_place(o: Own, p: rc[Place]) -> rc[Place]:
    root: rc[Place] = p
    nxt: rc[Place] | None = root.base
    while nxt is not None:
        root = nxt
        nxt = root.base
    if root.kind != PL_LOCAL:
        return p
    l: rc[Loan] | None = find_loan(o, root.key)
    if l is None:
        return p
    return splice_place(p, place_opt(l.src))

def forget_loan(o: mut Own, key: str) -> None:
    keep: list[rc[Loan]] = []
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        if l.key != key:
            keep.append(l)
        i = i + 1
    o.loans = keep

# target が rhs の場所を「借りて」束縛した、と記録する。
# 注意: 呼ぶのは**所有しなかった束縛**だけです。
def record_loan(o: mut Own, target: rc[ast.Node], rhs: rc[ast.Node] | None) -> None:
    if len(target.ir_name) == 0:
        return
    tt: rc[ast.Type] | None = node_type(target)
    if tt is not None and not ty_is_owned(tt):
        return          # コピー型
    if rhs is not None:
        rt: rc[ast.Type] | None = node_type(node_of_opt(rhs))
        if rt is not None and ty_is_rc(rt):
            return      # rc は独立した参照
    rp: rc[Place] | None = place_of(rhs)
    if rp is None:
        return
    # ★ 付け替える前の表で引く（q = q.next の形）
    src: rc[Place] = resolve_place(o, place_opt(rp))
    hops: list[rc[RcHop]] = hops_of(o, rhs)   # ★ 同じく付け替える前に
    forget_loan(o, target.ir_name)
    o.loans.append(rc(Loan(copy(target.ir_name), copy(target.name), src, hops)))

# 場所 w が書き換えられた。w（またはその中）を借りている別名を無効にする。
#   strict … w **そのもの**を借りている別名は残す（mut self は中身を変えるだけ）
def invalidate_loans(o: mut Own, f: mut rc[Flow], w0: rc[Place], strict: bool,
                     by_move: bool, at: rc[ast.Node]) -> None:
    w: rc[Place] = resolve_place(o, w0)
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        i = i + 1
        if not place_prefix_of(w, l.src):
            continue
        if strict and place_eq(w, l.src):
            continue
        alias: rc[Place] = rc(Place(PL_LOCAL, None, copy(l.key), copy(l.disp)))
        flow_stale(f, alias, w, l.src, by_move, at)
    rc_invalidate(o, f, w, strict, by_move, at)

# ── 同じ物体を指しうる別の rc 越しの書き換え（E-BORROW-10）─────────
#
# ★ 対になる定義: src/ownck.c の rc_target / obj_class / container_of /
#   hops_of / rc_stale / rc_invalidate

# rc[T] / rc[T] | None なら T
def rc_target(t0: rc[ast.Type] | None) -> rc[ast.Type] | None:
    if t0 is None:
        return None
    t: rc[ast.Type] = t0
    if t.kind == ast.TY_OPT:
        e: rc[ast.Type] | None = t.elem
        if e is None:
            return None
        t = e
    if t.kind == ast.TY_RC:
        return t.elem
    return None

# フィールドを持つ物体のクラス（T / rc[T] / その | None）
def obj_class(t0: rc[ast.Type] | None) -> rc[ast.Type] | None:
    if t0 is None:
        return None
    t: rc[ast.Type] = t0
    if t.kind == ast.TY_OPT:
        e: rc[ast.Type] | None = t.elem
        if e is None:
            return None
        t = e
    if t.kind == ast.TY_RC:
        e2: rc[ast.Type] | None = t.elem
        if e2 is None:
            return None
        t = e2
    if t.kind == ast.TY_CLASS:
        return t
    return None

# ほかから指されうる「入れ物」になる型（クラスか list。T | None は中身）。
# ★ rc[T] は含めません。rc は rc_target で中身として扱います。
def container_of(t0: rc[ast.Type] | None) -> rc[ast.Type] | None:
    if t0 is None:
        return None
    t: rc[ast.Type] = t0
    if t.kind == ast.TY_OPT:
        e: rc[ast.Type] | None = t.elem
        if e is None:
            return None
        t = e
    if t.kind == ast.TY_CLASS or t.kind == ast.TY_LIST:
        return t
    return None

def obj_root() -> rc[Place]:
    return rc(Place(PL_LOCAL, None, "<obj>", "<obj>"))

def steps_copy(xs: list[rc[RcStep]]) -> list[rc[RcStep]]:
    out: list[rc[RcStep]] = []
    for x in xs:
        out.append(x)
    return out

# 式 n の指す場所が通る「ほかから指されうる物体」を並べる。
def hops_of(o: Own, n0: rc[ast.Node] | None) -> list[rc[RcHop]]:
    hs: list[rc[RcHop]] = []
    if n0 is None:
        return hs
    n: rc[ast.Node] = n0
    if n.kind == ast.ND_VAR:
        if len(n.ir_name) > 0 and not strings.startswith(n.ir_name, "@"):
            # 別名なら、貸し手が通っていたものを引き継ぐ（r = q.x で q → a.p）
            l: rc[Loan] | None = find_loan(o, n.ir_name)
            if l is not None:
                ll: rc[Loan] = l
                for h in ll.hops:
                    hs.append(rc(RcHop(h.t, h.rest, steps_copy(h.steps), h.via_rc)))
            # 借りている引数は、呼び出し側では rc[T] の中身（か、その中）かもしれない。
            # ★ init の self だけは除きます。作ったばかりで、まだ誰も指していません。
            c: rc[ast.Type] | None = container_of(node_type(n))
            if c is not None:
                v: rc[Place] | None = place_of(n)
                if v is not None:
                    vv: rc[Place] = v
                    b: rc[BorrowRoot] | None = o.borrow_root_of(vv)
                    if b is not None and vv.base is None:
                        bb: rc[BorrowRoot] = b
                        in_init: bool = False
                        cf: rc[ast.Node] | None = o.cur_fn
                        if cf is not None:
                            in_init = node_of_opt(cf).name == "init"
                        if bb.is_param and not (bb.is_self and in_init):
                            hs.append(rc(RcHop(c, obj_root(), [], False)))
    elif n.kind == ast.ND_FIELD or n.kind == ast.ND_INDEX:
        skip: bool = False
        if n.kind == ast.ND_FIELD and len(n.mod_name) > 0:
            skip = True
        lhs: rc[ast.Node] | None = n.lhs
        if lhs is None:
            skip = True
        if not skip and n.kind == ast.ND_INDEX:
            lt: rc[ast.Type] | None = node_type(node_of_opt(lhs))
            if lt is not None and lt.kind == ast.TY_STR:
                skip = True
        if not skip:
            ln: rc[ast.Node] = node_of_opt(lhs)
            oc: rc[ast.Type] | None = None
            if n.kind == ast.ND_FIELD:
                oc = obj_class(node_type(ln))
            for h in hops_of(o, ln):
                r: rc[Place] = rc(Place(PL_INDEX, h.rest, "[]", h.rest.disp + "[…]"))
                if n.kind == ast.ND_FIELD:
                    r = rc(Place(PL_FIELD, h.rest, copy(n.name), h.rest.disp + "." + n.name))
                st: list[rc[RcStep]] = steps_copy(h.steps)
                if oc is not None:
                    st.append(rc(RcStep(oc, copy(n.name))))
                hs.append(rc(RcHop(h.t, r, st, h.via_rc)))
            # ほかから指されうる物体の中にあるクラス・list も、また指されえます
            # （借りている引数がこれを指しているかもしれません）。
            c2: rc[ast.Type] | None = container_of(node_type(n))
            if len(hs) > 0 and c2 is not None:
                hs.append(rc(RcHop(c2, obj_root(), [], False)))
    t: rc[ast.Type] | None = rc_target(node_type(n))
    if t is not None:
        hs.append(rc(RcHop(t, obj_root(), [], True)))
    return hs

# 別名 l を「rc 越しに書き換えられた」として無効にする。
def rc_stale(f: mut rc[Flow], l: rc[Loan], by: rc[Place], by_move: bool,
             at: rc[ast.Node]) -> None:
    alias: rc[Place] = rc(Place(PL_LOCAL, None, copy(l.key), copy(l.disp)))
    cur: rc[Ent] | None = flow_find(f, alias)
    if cur is not None:
        if node_of_ent(cur).st == ST_MOVED:
            return      # 名前の経路でもう捕まえている
    flow_stale(f, alias, by, l.src, by_move, at)
    e: rc[Ent] = f.ents[len(f.ents) - 1]
    e.by_rc = True

def node_of_ent(e: rc[Ent] | None) -> rc[Ent]:
    if e is None:
        panic(diag.msg0("sownck.006", "ownck: 記録がありません"))
    return e

# 場所 w（式 at）の書き換え。w が「ほかから指されうる物体」の中なら、
# 同じ型の物体の同じ場所（かその中）を借りている別名を無効にする。
def rc_invalidate(o: mut Own, f: mut rc[Flow], w: rc[Place], strict: bool,
                  by_move: bool, at: rc[ast.Node]) -> None:
    ws: list[rc[RcHop]] = hops_of(o, at)
    if len(ws) == 0:
        return
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        i = i + 1
        hit: bool = False
        for lh in l.hops:
            for wh in ws:
                if hit:
                    continue
                # ★ 代入・移動で rc の場所そのもの（`self.cur = n`）を書くのは、
                #   参照を差し替えるだけで、指している物体の中身は変えません。
                #   注意: クラス・list の場所の置き換えは、古い物体を**解放します**。
                if not strict and wh.rest.base is None and wh.via_rc:
                    continue
                if not ast.type_equal(lh.t, wh.t):
                    continue
                if not place_prefix_of(wh.rest, lh.rest):
                    continue
                if strict and place_eq(wh.rest, lh.rest):
                    continue
                hit = True
        if hit:
            rc_stale(f, l, w, by_move, at)

# 読むだけ（所有権は動かない）
def use_expr(o: mut Own, f: mut rc[Flow], n: rc[ast.Node] | None) -> None:
    if n is None:
        return
    nn: rc[ast.Node] = n
    k: int = nn.kind

    if k == ast.ND_VAR or k == ast.ND_FIELD:
        p1: rc[Place] | None = place_of(nn)
        if p1 is not None:
            t1: rc[token.Token] | None = nn.tok
            if t1 is not None:
                check_use(o, f, p1, t1)
            return          # 場所そのものなので、これ以上たどるものは無い
        use_expr(o, f, nn.lhs)
        return

    if k == ast.ND_INDEX:
        p2: rc[Place] | None = place_of(nn)
        if p2 is not None:
            t2: rc[token.Token] | None = nn.tok
            if t2 is not None:
                check_use(o, f, p2, t2)
        else:
            use_expr(o, f, nn.lhs)
        use_expr(o, f, nn.rhs)   # 添字の式（呼び出しかもしれない）
        return

    if k == ast.ND_BINOP or k == ast.ND_LOGICAL:
        use_expr(o, f, nn.lhs)
        use_expr(o, f, nn.rhs)
        return

    if k == ast.ND_UNARY or k == ast.ND_PRINT:
        use_expr(o, f, nn.lhs)
        return

    # ★ 内包表記 [E for x in xs if C]
    #
    # 注意: **ここを書かないと、警告が静かに消えます。** 同じことを for で
    #   書けば止まるのに、内包表記だと素通りしていました（移植時に実際に
    #   warn_listcomp_borrow が落ちて分かりました）。
    if k == ast.ND_LISTCOMP:
        if nn.args is not None:
            a0: rc[ast.Node] | None = nn.args
            while a0 is not None:
                an0: rc[ast.Node] = a0
                use_expr(o, f, an0)
                a0 = an0.next
        else:
            use_expr(o, f, nn.rhs)

        lv: rc[ast.Node] = node_of_opt(nn.body)   # ループ変数の宣言
        lv.binds_borrow = True   # 要素は借りもの（list が持ち主のまま）
        remember_decl(o, lv)

        # ★ 「対象の要素を借りている」ことを登録します。
        #   脱糖した for が `x = for.it.N[for.ix.N]` を作るのと同じ関係を、
        #   添字の節点を 1 つ組み立てて伝えます（それが無いと「誰から
        #   借りたか」が分からず、警告が出ません）。
        if nn.rhs is not None:
            lvt: rc[token.Token] | None = lv.tok
            elem_ref: rc[ast.Node] = ast.new_node(ast.ND_INDEX, lvt)
            elem_ref.lhs = nn.rhs
            elem_ref.rhs = nn.rhs   # 添字の中身は見ないので何でもよい
            bind_alias(o, lv, elem_ref)

        if nn.els is not None:
            use_expr(o, f, nn.els)
        move_expr(o, f, nn.lhs, MV_APPEND)
        return

    # ★ リテラルの要素は **リストへの移動**（A-26）。
    #   注意: ここを「ただの読み」にしていたのが穴でした。xs.append(v) は
    #     止まるのに [v] は素通りし、既定で解放する今は早すぎる解放になります。
    #   対になる定義: src/ownck.c の case ND_LIST
    if k == ast.ND_LIST:
        e: rc[ast.Node] | None = nn.body
        while e is not None:
            en: rc[ast.Node] = e
            move_expr(o, f, en, MV_APPEND)
            e = en.next
        return

    # ★ 範囲型の検査（A-28）は値を素通しするだけの包み。
    #   注意: **ここを書かないと、包んだ中の移動が記録されない**
    #     （p: Percent = f(xs) の xs が「渡していない」ことになる）。
    if k == ast.ND_RANGECHK:
        use_expr(o, f, node_of_opt(nn.lhs))
        return

    if k == ast.ND_CALL:
        mark_call_binds_borrow(o, nn)
        call_args(o, f, nn, nn.cls is not None)
        return

    if k == ast.ND_METHOD:
        mark_call_binds_borrow(o, nn)
        # xs.append(v) … コンテナが v の所有権を受け取る（仕様 v2 §3.1）
        lh: rc[ast.Node] | None = nn.lhs
        if lh is not None and nn.name == "append":
            lt: rc[ast.Type] | None = node_type(lh)
            if lt is not None and lt.kind == ast.TY_LIST:
                use_expr(o, f, nn.lhs)
                move_expr(o, f, nn.args, MV_APPEND)
                # ★ append はリストを書き換えます。読み取り専用の借用なら止めます。
                check_mut(o, lh, lh, WR_APPEND)
                # ★ xs.append(xs) のような自己参照も、ここで B1 に引っかかります。
                arefs: list[rc[ArgRef]] = [rc(ArgRef(lh, True, WR_APPEND))]
                if nn.args is not None:
                    arefs.append(rc(ArgRef(node_of_opt(nn.args), False, WR_ARG)))
                check_arg_aliases(o, arefs)
                return
        # xs.insert(i, v) … append と同じく、コンテナが v の所有権を受け取る。
        #   ★ ここが無かったので v が関数の出口で解放され、リストには
        #     解放済みの値が残っていました。
        if lh is not None and nn.name == "insert" and nn.args is not None:
            lt2: rc[ast.Type] | None = node_type(lh)
            a0: rc[ast.Node] = node_of_opt(nn.args)
            if lt2 is not None and lt2.kind == ast.TY_LIST and a0.next is not None:
                use_expr(o, f, nn.lhs)
                use_expr(o, f, a0)
                move_expr(o, f, a0.next, MV_APPEND)
                check_mut(o, lh, lh, WR_APPEND)
                arefs2: list[rc[ArgRef]] = [rc(ArgRef(lh, True, WR_APPEND))]
                arefs2.append(rc(ArgRef(node_of_opt(a0.next), False, WR_ARG)))
                check_arg_aliases(o, arefs2)
                return
        # 注意: 'mod.f(args)'（他モジュールの関数・クラス）は ND_METHOD ですが
        #   self を取りません。第 1 引数をずらすかは
        #   「モジュール修飾か」「インスタンス生成か」で決まります。
        #     obj.m(args)  → m(obj, args)。self を飛ばす
        #     mod.f(args)  → f(args)。飛ばさない
        #     mod.C(args)  → C.init(new, args)。self を飛ばす
        use_expr(o, f, nn.lhs)
        # ★ mut self を取るメソッドは、受け手を書き換えます。
        #   読み取り専用の借用に対して呼んでいたら止めます。
        if lh is not None and len(nn.mod_name) == 0:
            fnm: rc[ast.Node] | None = callee_of(o, nn)
            if fnm is not None:
                fp: rc[ast.Node] | None = node_of_opt(fnm).params
                if fp is not None:
                    self_pm: rc[ast.Node] = node_of_opt(fp)
                    if self_pm.mode == ast.PM_MUT:
                        check_mut(o, node_of_opt(lh), node_of_opt(lh), WR_METHOD)
        skip: bool = True
        if len(nn.mod_name) > 0:
            skip = nn.cls is not None
        call_args(o, f, nn, skip)
        return

    return          # リテラル・None・型注釈など


# 「この呼び出しの戻り値は借りものか」を呼び出しノードに書き写す。
#
# ★ move_expr でも同じ印を付けますが、あちらは**結果を束縛するとき**しか
#   通りません。二項演算のオペランドや引数の位置では通らないので、
#   ここで全部の呼び出しに付けます（A-21g）。
def mark_call_binds_borrow(o: mut Own, n: mut rc[ast.Node]) -> None:
    if n.binds_borrow:
        return
    fn: rc[ast.Node] | None = callee_of(o, n)
    if fn is not None:
        f2: rc[ast.Node] = fn
        if f2.binds_borrow:
            n.binds_borrow = True

# 呼び出し先の定義ノード（ND_FUNC）。組み込みなら None。
#
# 注意: **インスタンス生成も呼び出しです。** `Box(xs[0])` は Box.init の
#   仮引数と突き合わせないと、own 引数へ借りものを渡した形（E-BORROW-7）を
#   見逃します。移植時にここを落として、warn_store_borrow_own_arg が
#   出なくなっていました。
def callee_of(o: Own, n: rc[ast.Node]) -> rc[ast.Node] | None:
    if len(n.builtin) > 0:
        return None
    nc: rc[ast.Class] | None = n.cls
    if nc is not None:
        c: rc[ast.Class] = nc
        if not c.has_init or c.node is None:
            return None
        m: rc[ast.Node] | None = node_of_opt(c.node).body
        while m is not None:
            mm: rc[ast.Node] = m
            if mm.kind == ast.ND_FUNC and mm.name == "init":
                return mm
            m = mm.next
        return None
    return o.lookup_func(n.ir_name)

# ── 呼び出しが書き換えうるフィールド（E-BORROW-10）──────────────
#
# ★ rc の中身は、`mut` で受けていない関数からも書き換えられます
#   （`c: rc[Box] = b` と写せば、c は独立した参照なので書けます）。
#   だから「mut で渡したか」ではなく「呼び先が（呼び先までたどって）
#   どのクラスのどのフィールドを書くか」で決めます。
#
# ★ 対になる定義: src/ownck.c の step_has / eff_add_place / eff_scan / eff_of /
#   ty_reaches / call_reaches / eff_merge / eff_all / rc_invalidate_call /
#   program_globals / rc_invalidate_unknown
def step_has(xs: list[rc[RcStep]], cls: rc[ast.Type], field: str) -> bool:
    for s in xs:
        if s.field == field and ast.type_equal(s.cls, cls):
            return True
    return False

def type_in(xs: list[rc[ast.Type]], t: rc[ast.Type]) -> bool:
    for x in xs:
        if ast.type_equal(x, t):
            return True
    return False

# 書き込み先の式から「どのクラスのどのフィールドか」を取り出す（xs[i] は xs）。
def eff_add_place(e: mut rc[FnEff], lhs0: rc[ast.Node] | None, in_init: bool) -> None:
    cur: rc[ast.Node] | None = lhs0
    while cur is not None and node_of_opt(cur).kind == ast.ND_INDEX:
        cur = node_of_opt(cur).lhs
    if cur is None:
        return
    lhs: rc[ast.Node] = cur
    if lhs.kind != ast.ND_FIELD or len(lhs.mod_name) > 0 or lhs.lhs is None:
        return
    obj: rc[ast.Node] = node_of_opt(lhs.lhs)
    c: rc[ast.Type] | None = obj_class(node_type(obj))
    if c is None:
        return
    # ★ init の中の self.f = … は、作ったばかりの物体への書き込みです。
    if in_init and obj.kind == ast.ND_VAR and obj.name == "self":
        return
    cc: rc[ast.Type] = c
    if not step_has(e.direct, cc, lhs.name):
        e.direct.append(rc(RcStep(cc, copy(lhs.name))))

def eff_scan_list(o: Own, e: mut rc[FnEff], n: rc[ast.Node] | None, in_init: bool) -> None:
    cur: rc[ast.Node] | None = n
    while cur is not None:
        c: rc[ast.Node] = cur
        eff_scan(o, e, c, in_init)
        cur = c.next

def eff_scan_child(o: Own, e: mut rc[FnEff], n: rc[ast.Node] | None, in_init: bool) -> None:
    if n is not None:
        eff_scan(o, e, node_of_opt(n), in_init)

def eff_scan(o: Own, e: mut rc[FnEff], n: rc[ast.Node], in_init: bool) -> None:
    # グローバル（と他モジュールのグローバル）を触るなら、その型から届く物体も書けます
    if (n.kind == ast.ND_VAR or (n.kind == ast.ND_FIELD and len(n.mod_name) > 0)):
        if len(n.ir_name) > 0 and strings.startswith(n.ir_name, "@"):
            gt: rc[ast.Type] | None = node_type(n)
            if gt is not None and not type_in(e.globals, gt):
                e.globals.append(gt)
    if n.kind == ast.ND_ASSIGN and n.lhs is not None:
        eff_add_place(e, n.lhs, in_init)
    # list の組み込みメソッドのうち要素を手放すもの（E-BORROW-9 と同じ 3 つ）
    if n.kind == ast.ND_METHOD and n.lhs is not None:
        lt: rc[ast.Type] | None = node_type(node_of_opt(n.lhs))
        if lt is not None and lt.kind == ast.TY_LIST:
            if n.name == "pop" or n.name == "remove" or n.name == "clear":
                eff_add_place(e, n.lhs, in_init)
    if n.kind == ast.ND_CALL or n.kind == ast.ND_METHOD:
        callee: rc[ast.Node] | None = callee_of(o, n)
        if callee is not None and node_of_opt(callee).body is not None:
            e.callees.append(node_of_opt(callee))
            e.calls.append(n)
    eff_scan_child(o, e, n.lhs, in_init)
    eff_scan_child(o, e, n.rhs, in_init)
    eff_scan_child(o, e, n.incr, in_init)
    eff_scan_child(o, e, n.els, in_init)
    eff_scan_list(o, e, n.body, in_init)
    eff_scan_list(o, e, n.args, in_init)

def eff_of(o: mut Own, fn: rc[ast.Node]) -> rc[FnEff]:
    for x in o.effs:
        if x.fn == fn:
            return x
    e: rc[FnEff] = rc(FnEff(fn))
    o.effs.append(e)
    in_init: bool = fn.name == "init"
    if fn.body is not None:
        eff_scan_list(o, e, node_of_opt(fn.body).body, in_init)
    return e

# 型 t の値から（フィールド・要素・中身をたどって）クラス cls の物体に届くか。
# 注意: インタフェース・中身を持つ列挙・生ポインタは中が型から決まらないので、
#   届くものとして扱います。
def ty_reaches(t0: rc[ast.Type] | None, cls: rc[ast.Type], seen: mut list[str]) -> bool:
    if t0 is None:
        return False
    t: rc[ast.Type] = t0
    if t.kind == ast.TY_CLASS:
        if ast.type_equal(t, cls):
            return True
        c: rc[ast.Class] | None = t.cls
        if c is None:
            return False
        cc: rc[ast.Class] = c
        for k in seen:
            if k == cc.ir_name:
                return False
        seen.append(copy(cc.ir_name))
        fl: rc[ast.Field] | None = cc.fields
        while fl is not None:
            ff: rc[ast.Field] = fl
            if ty_reaches(ff.type, cls, seen):
                return True
            fl = ff.next
        return False
    if (t.kind == ast.TY_OPT or t.kind == ast.TY_LIST or t.kind == ast.TY_RC or
            t.kind == ast.TY_MUTEX or t.kind == ast.TY_THREAD):
        return ty_reaches(t.elem, cls, seen)
    if t.kind == ast.TY_TUPLE:
        for p in t.params:
            if ty_reaches(p, cls, seen):
                return True
        return False
    if t.kind == ast.TY_IFACE or t.kind == ast.TY_PTR:
        return True
    if t.kind == ast.TY_ENUM:
        en: rc[ast.EnumDef] | None = t.en
        return en is not None and node_of_enum(en).has_payload
    return False

def node_of_enum(e: rc[ast.EnumDef] | None) -> rc[ast.EnumDef]:
    if e is None:
        panic(diag.msg0("sownck.001", "ownck: 列挙の定義がありません"))
    return e

# 呼び出し n の引数（受け手を含む）か、呼び先が触るグローバルから cls に届くか。
def call_reaches(n: rc[ast.Node], globals: list[rc[ast.Type]], cls: rc[ast.Type]) -> bool:
    seen: list[str] = []
    if n.kind == ast.ND_METHOD and n.lhs is not None:
        if ty_reaches(node_type(node_of_opt(n.lhs)), cls, seen):
            return True
    a: rc[ast.Node] | None = n.args
    while a is not None:
        an: rc[ast.Node] = a
        if ty_reaches(node_type(an), cls, seen):
            return True
        a = an.next
    for g in globals:
        if ty_reaches(g, cls, seen):
            return True
    return False

# ★ 呼び先の書き込みは、その呼び出しの引数（とグローバル）から届く
#   クラスのものだけを引き上げます。段ごとに絞るので、不動点まで回します。
def eff_merge(dst: mut rc[FnEff], src: rc[FnEff], call: rc[ast.Node]) -> bool:
    changed: bool = False
    for s in src.all:
        if step_has(dst.all, s.cls, s.field):
            continue
        if not call_reaches(call, src.gall, s.cls):
            continue
        dst.all.append(s)
        changed = True
    for g in src.gall:
        if type_in(dst.gall, g):
            continue
        dst.gall.append(g)
        changed = True
    return changed

def eff_all(o: mut Own, fn: rc[ast.Node]) -> rc[FnEff]:
    root: rc[FnEff] = eff_of(o, fn)
    if root.done:
        return root
    # 呼び出しの木を集める（同じ関数は 1 回だけ。まだ求めていないものだけ）
    q: list[rc[FnEff]] = [root]
    i: int = 0
    while i < len(q):
        cur: rc[FnEff] = q[i]
        i = i + 1
        for cn in cur.callees:
            c: rc[FnEff] = eff_of(o, cn)
            if c.done:
                continue
            seen: bool = False
            for x in q:
                if x == c:
                    seen = True
            if seen:
                continue
            q.append(c)
    for e in q:
        for s in e.direct:
            e.all.append(s)
        for g in e.globals:
            e.gall.append(g)
    changed: bool = True
    while changed:
        changed = False
        for e2 in q:
            k: int = 0
            while k < len(e2.callees):
                src: rc[FnEff] = eff_of(o, e2.callees[k])
                call: rc[ast.Node] = e2.calls[k]
                if eff_merge(e2, src, call):
                    changed = True
                k = k + 1
    for e3 in q:
        e3.done = True
    return root

# 呼び出し n（呼び先 fn）が、借りている別名の通り道を書き換えうるなら無効にする。
def rc_invalidate_call(o: mut Own, f: mut rc[Flow], n: rc[ast.Node], fn: rc[ast.Node]) -> None:
    if len(o.loans) == 0:
        return
    got: bool = False
    eff: rc[FnEff] = rc(FnEff(fn))
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        i = i + 1
        hit: bool = False
        for h in l.hops:
            if hit or len(h.steps) == 0:
                continue
            if not got:
                eff = eff_all(o, fn)
                got = True
            for s in h.steps:
                if not hit and step_has(eff.all, s.cls, s.field) and call_reaches(n, eff.gall, s.cls):
                    hit = True
        if not hit:
            continue
        by: rc[Place] = rc(Place(PL_LOCAL, None, "<call>", fn.name + "(…)"))
        rc_stale(f, l, by, False, n)

# 呼び先が名前で決まらない呼び出し（インタフェース越し・関数の値）。
# ★ 中身が分からないので「引数（受け手を含む）か、プログラムのどこかで触る
#   グローバルから届く物体なら、どのフィールドでも書かれうる」とします。
def program_globals(o: mut Own) -> list[rc[ast.Type]]:
    if not o.all_globals_done:
        o.all_globals_done = True
        k: int = 0
        while k < len(o.func_nodes):
            fnk: rc[ast.Node] = o.func_nodes[k]
            e: rc[FnEff] = eff_of(o, fnk)
            k = k + 1
            for g in e.globals:
                if not type_in(o.all_globals, g):
                    o.all_globals.append(g)
    out: list[rc[ast.Type]] = []
    for g2 in o.all_globals:
        out.append(g2)
    return out

def rc_invalidate_unknown(o: mut Own, f: mut rc[Flow], n: rc[ast.Node]) -> None:
    if len(o.loans) == 0:
        return
    gl: list[rc[ast.Type]] = []
    got: bool = False
    i: int = 0
    while i < len(o.loans):
        l: rc[Loan] = o.loans[i]
        i = i + 1
        hit: bool = False
        for h in l.hops:
            for s in h.steps:
                if hit:
                    continue
                if not got:
                    gl = program_globals(o)
                    got = True
                if call_reaches(n, gl, s.cls):
                    hit = True
        if not hit:
            continue
        nm: str = "…"
        if len(n.name) > 0:
            nm = n.name
        by: rc[Place] = rc(Place(PL_LOCAL, None, "<call>", nm + "(…)"))
        rc_stale(f, l, by, False, n)

# 実引数を、仮引数の受け取り方（ParamMode）に従って評価する。
#
#   既定（借用）… 読むだけ。所有権は呼び出し側に残る
#   own         … 移動する
#   mut         … 借用（書き換えるが、所有権は移らない）
def call_args(o: mut Own, f: mut rc[Flow], n: rc[ast.Node], skip_self: bool) -> None:
    # ★ spawn(f, a) は「引数 1 つを別スレッドへ手放す」呼び出しです。
    #   ふつうの呼び出しとは渡し方が違うので、ここで分けます。
    #
    # 注意: **いまは「移動を記録する」ぶんだけ**移植しています。E-SEND-1〜4
    #   （スレッドに渡してよいかの検査）は後回しです（docs/roadmap.md A-21 ⑩）。
    #   移動の記録はメモリ安全性に直結する（spawn に渡した値を後から使うと
    #   E-MOVE-1）ので、そこだけ先に入れます。
    nt0: rc[ast.Type] | None = node_type(n)
    if n.kind == ast.ND_CALL and len(n.ir_name) == 0:
        if nt0 is not None and nt0.kind == ast.TY_THREAD:
            spawn_args(o, f, n)
            return

    fn: rc[ast.Node] | None = callee_of(o, n)
    pm: rc[ast.Node] | None = None
    if fn is not None:
        fnn: rc[ast.Node] = fn
        pm = fnn.params
        if skip_self and pm is not None:
            pmn: rc[ast.Node] = pm
            pm = pmn.next
    refs: list[rc[ArgRef]] = []
    # ★ メソッドの受け手（self）も「渡している実引数」の 1 つです。
    #   mut self なら可変借用なので、別名の判定に入れます。
    if n.kind == ast.ND_METHOD and n.lhs is not None and len(n.mod_name) == 0:
        recv_mut: bool = False
        fnr: rc[ast.Node] | None = callee_of(o, n)
        if fnr is not None:
            fpr: rc[ast.Node] | None = node_of_opt(fnr).params
            if fpr is not None:
                recv_mut = node_of_opt(fpr).mode == ast.PM_MUT
        refs.append(rc(ArgRef(node_of_opt(n.lhs), recv_mut, WR_METHOD)))

    a: rc[ast.Node] | None = n.args
    while a is not None:
        an: rc[ast.Node] = a
        is_own: bool = False
        is_mut_param: bool = False
        if pm is not None:
            pn: rc[ast.Node] = pm
            is_own = pn.mode == ast.PM_OWN
            is_mut_param = pn.mode == ast.PM_MUT
            pm = pn.next
        if is_own:
            move_expr(o, f, an, MV_OWN_ARG)
        else:
            use_expr(o, f, an)
            # ★ mut で受け取る引数へ、読み取り専用の借用を渡していないか（B3）
            #
            # 注意: ここは check_call_borrows の①だけです。②（同じ場所を
            #   可変借用と他の借用で同時に渡す＝E-BORROW-5）は未移植
            #   （docs/roadmap.md A-21 ⑩）。
            if is_mut_param:
                check_mut(o, an, an, WR_ARG)
        refs.append(rc(ArgRef(an, is_mut_param, WR_ARG)))
        a = an.next
    # ② 同じ場所を可変借用と他の借用で同時に渡していないか（B1）
    check_arg_aliases(o, refs)

    # ③ 可変で渡した場所の「中」を借りている別名は、呼び出しの後では使えない
    #   （E-BORROW-9）。対になる定義: src/ownck.c の check_call_borrows ③
    ri: int = 0
    while ri < len(refs):
        r: rc[ArgRef] = refs[ri]
        ri = ri + 1
        if r.is_mut and r.kind != WR_APPEND:
            rpl: rc[Place] | None = place_of(r.expr)
            if rpl is not None:
                invalidate_loans(o, f, place_opt(rpl), True, False, r.expr)

    # ★ list の組み込みメソッドのうち、要素を**手放す**もの（E-BORROW-9）。
    #   対になる定義: src/ownck.c の call_args（定義が引けない呼び出し）
    if fn is None and n.kind == ast.ND_METHOD and n.lhs is not None:
        ln: rc[ast.Node] = node_of_opt(n.lhs)
        lt: rc[ast.Type] | None = node_type(ln)
        if lt is not None and lt.kind == ast.TY_LIST:
            if n.name == "pop" or n.name == "remove" or n.name == "clear":
                lpl: rc[Place] | None = place_of(ln)
                if lpl is not None:
                    invalidate_loans(o, f, place_opt(lpl), True, False, ln)

    # ★ 呼び先が（呼び先までたどって）書くフィールドを、rc 越しに借りている
    #   別名は使えない（E-BORROW-10）。対になる定義: src/ownck.c の call_args
    if fn is not None:
        rc_invalidate_call(o, f, n, node_of_opt(fn))
    elif n.is_indirect or n.is_iface_call:
        rc_invalidate_unknown(o, f, n)


# ── 所有権を動かす（移動したら True）────────────────────────
#
# ★ 対になる定義: src/ownck.c の move_expr
def move_expr(o: mut Own, f: mut rc[Flow], n: rc[ast.Node] | None, ctx: int) -> bool:
    if n is None:
        return False
    nn: rc[ast.Node] = n

    # ── rc[T] は共有型。代入しても元は無効になりません ──
    #
    # ★ 「所有者を 1 つに決められない」ためにある型なので、移動として扱いません。
    #   束縛した側は**新しい参照**を持ちます（カウント +1）。
    #
    # 注意: **`rc[T] | None` も共有です。** ここを TY_RC だけで見ていたので、
    #   `lhs: rc[Node] | None` のような**いちばん普通の形**が移動と見なされ、
    #   移行しても指摘が減りませんでした（実測 345 → 340）。
    nt: rc[ast.Type] | None = node_type(nn)
    if nt is not None and ty_is_rc(nt):
        use_expr(o, f, nn)
        return True

    # ★ タプルのリテラル `(a, b)` は、要素ごとに移動です。
    #   タプルそのものは一時値なので、ここで要素を 1 つずつ動かさないと、
    #   `return (n, s)` の s が関数の出口で解放され、呼び出し側には
    #   解放済みの文字列が渡っていました。
    if nn.kind == ast.ND_TUPLE:
        el: rc[ast.Node] | None = nn.body
        while el is not None:
            e1: rc[ast.Node] = el
            move_expr(o, f, e1, ctx)
            el = e1.next
        return True

    p: rc[Place] | None = place_of(nn)
    owned: bool = False
    if nt is not None:
        owned = ty_is_owned(nt)

    if p is None or not owned:
        # 一時値、またはコピー型 → ただの読み
        use_expr(o, f, nn)
        if p is not None or not owned:
            return False
        # ★ 一時値（呼び出しの戻り値やリテラル）は、束縛した側が所有します。
        #   ただし「self の借用を返す関数」（仕様 §4.5）の戻り値は借りもの。
        if nn.kind == ast.ND_CALL or nn.kind == ast.ND_METHOD:
            fn: rc[ast.Node] | None = callee_of(o, nn)
            if fn is not None:
                fnn: rc[ast.Node] = fn
                if fnn.binds_borrow:
                    nn.binds_borrow = True  # codegen はこれを見て解放しない
                    return False
        return True

    pp: rc[Place] = p
    tk: rc[token.Token] | None = nn.tok

    # ── 借りものは、呼び出しより長生きする場所へ渡せない（仕様 §4.4）──
    #
    # ★ 局所変数への束縛（`t: str = s`）は**許します**。局所変数は呼び出しより
    #   長生きしないので、別名を作っても危険がありません。その代わり、
    #   束縛された側も「借用」として扱います（bind_alias）。
    #
    # ★ もう 1 つの例外：**self の借用を返すこと**（仕様 §4.5）。
    br: rc[BorrowRoot] | None = o.borrow_root_of(pp)
    if br is not None:
        brr: rc[BorrowRoot] = br
        exempt: bool = ctx == MV_RETURN and brr.is_self
        if ctx != MV_ASSIGN and not exempt and tk is not None:
            o.rep.report_borrow(brr, pp, tk, ctx)
        # 注意: 移動として記録しません。借りものは動いていないので、この後で
        #   使っても E-MOVE-1 にはなりません（1 つの問題は 1 回だけ報告する）。
        use_expr(o, f, nn)
        return False

    # 注意: 要素を 1 つだけ move out することは許しません（設計 ownership.md §3）。
    #   添字はコンパイル時に分からないので、xs[0] と xs[1] を区別できません。
    #   for のループ変数もここを通ります（仕様 v2 §3.1「for の要素は借用」）。
    if pp.kind == PL_INDEX or pp.kind == PL_GLOBAL or pp.kind == PL_FIELD:
        # 注意: グローバルはプログラムが終わるまで生きているので、読み出しは
        #   「借りているだけ」として扱います（解放もしません）。
        # 注意: フィールドの読み出しも借用です。当初は「取り出し禁止」に
        #   していましたが、それでは**コンパイラ自身が書けません**
        #   （`nx = cur.next` で連結リストをたどれない）。
        if tk is not None:
            if ctx == MV_FIELD or ctx == MV_APPEND or ctx == MV_OWN_ARG:
                o.rep.report_store_borrow(pp, tk, ctx, lender_of(o, pp))
            elif ctx == MV_RETURN and pp.kind != PL_GLOBAL:
                o.rep.report_return_borrow(pp, tk, lender_of(o, pp))
        use_expr(o, f, nn)
        return False

    if tk is not None:
        check_use(o, f, pp, tk)   # 移動済みのものを再び移動するのもエラー
    flow_move(f, pp, nn)
    # ★ 手放した値の中を借りている別名は、もう使えません（E-BORROW-9）。
    invalidate_loans(o, f, pp, False, True, nn)

    # ★ codegen はこの印を見て drop フラグを 0 にします。
    if nn.kind == ast.ND_VAR:
        nn.moved_out = True
    return True


# 場所の根がローカル変数なら、その宣言を返す（診断の note: に出す貸し手）
def lender_of(o: Own, p: rc[Place]) -> rc[ast.Node] | None:
    root: rc[Place] = p
    nxt: rc[Place] | None = root.base
    while nxt is not None:
        root = nxt
        nxt = root.base
    if root.kind != PL_LOCAL:
        return None
    d: rc[DeclEnt] | None = o.find_decl(root.key)
    if d is None:
        return None
    dd: rc[DeclEnt] = d
    return dd.decl


# ── 借用の登録（bind_alias）─────────────────────────────
#
# ★ これが無いと、`t: str = s` で**名前を変えるだけで検査をすり抜けます**。
#   `for x in xs:` の脱糖（`for.it.0 = xs` → `x = for.it.0[i]`）もここを通るので、
#   借用したリストの要素を保存しようとすると、ちゃんと止まります。
#   対になる定義: src/ownck.c の remember_decl / mark_borrow_bind / bind_alias

# 変数宣言を覚える（while の 2 周目は何もしない）
def remember_decl(o: mut Own, n: rc[ast.Node]) -> None:
    if len(n.ir_name) == 0:
        return
    if o.find_decl(n.ir_name) is not None:
        return
    o.decls.append(rc(DeclEnt(copy(n.ir_name), n, o.depth)))

# 「この変数は借りものを束縛している」と記録する。
#
# 注意: 印は**宣言のノード**に付けます（codegen は宣言を見て drop を出すため）。
def mark_borrow_bind(o: mut Own, ir_name: str) -> None:
    d: rc[DeclEnt] | None = o.find_decl(ir_name)
    if d is None:
        return
    dd: rc[DeclEnt] = d
    dd.decl.binds_borrow = True

# 借用の根の登録を外す（借用でない値を入れ直したら、もう借りものではない）
def unbind_root(o: mut Own, ir_name: str) -> None:
    keep: list[rc[BorrowRoot]] = []
    i: int = 0
    while i < len(o.roots):
        b: rc[BorrowRoot] = o.roots[i]
        if b.key != ir_name:
            keep.append(b)
        i = i + 1
    o.roots = keep

# 借用に根ざした値を局所変数に束縛したら、その変数も「借用」にする。
def bind_alias(o: mut Own, target: rc[ast.Node], rhs: rc[ast.Node] | None) -> None:
    if len(target.ir_name) == 0:
        return

    # 注意: **コピー型は借りものになりません。**
    #   `worst = e.st`（st は int）のように、借りた入れ物から**値をコピー**
    #   しているだけの代入は借用ではありません（C 版で誤検出を踏んだ箇所）。
    tt: rc[ast.Type] | None = node_type(target)
    if tt is not None and not ty_is_owned(tt):
        return

    # 注意: **rc[T] は借りものではありません。**
    #   `m = mm.next`（rc[Module] | None）のような**共有の付け替え**を
    #   「mm の一部を借りた」と記録していたので、内側で作った rc を外側の
    #   変数に入れると E-BORROW-6 が出ていました。rc は独立した参照です。
    if rhs is not None:
        rn0: rc[ast.Node] = rhs
        rt0: rc[ast.Type] | None = node_type(rn0)
        if rt0 is not None and ty_is_rc(rt0):
            unbind_root(o, target.ir_name)
            return

    # 右辺が「借りもの」なら、その根を引き継ぐ
    found: bool = False
    p_origin: rc[ast.Node] | None = None
    p_is_param: bool = False
    p_is_self: bool = False
    p_is_mut: bool = False
    p_depth: int = 0

    if rhs is not None:
        rn: rc[ast.Node] = rhs
        rp: rc[Place] | None = place_of(rn)
        if rp is not None:
            rpp: rc[Place] = rp
            src: rc[BorrowRoot] | None = o.borrow_root_of(rpp)
            if src is not None:
                sb: rc[BorrowRoot] = src
                p_origin = sb.origin
                p_is_param = sb.is_param
                p_is_self = sb.is_self
                p_is_mut = sb.is_mut
                p_depth = sb.depth
                found = True
            elif rpp.kind == PL_FIELD or rpp.kind == PL_INDEX:
                # ★ 自分が所有しているオブジェクトの一部を読んだ場合も
                #   「借用」です（そのオブジェクトが所有者のまま）。
                root: rc[Place] = rpp
                nxt: rc[Place] | None = root.base
                while nxt is not None:
                    root = nxt
                    nxt = root.base
                if root.kind == PL_LOCAL:
                    d2: rc[DeclEnt] | None = o.find_decl(root.key)
                    if d2 is not None:
                        dd2: rc[DeclEnt] = d2
                        p_origin = dd2.decl
                        p_is_param = False
                        p_is_self = False
                        p_is_mut = True   # 自分のものなので書き換えてよい
                        p_depth = dd2.depth
                        found = True

    # 既に登録されていれば付け替える（同じ関数の中で ir_name は一意）
    unbind_root(o, target.ir_name)
    if not found:
        return
    org: rc[ast.Node] = node_of_opt(p_origin)
    o.roots.append(rc(BorrowRoot(copy(target.ir_name), org, p_is_param,
                                 p_is_self, p_is_mut, p_depth)))
    mark_borrow_bind(o, target.ir_name)

    # ── 借りものが貸し手より長生きしないか（E-BORROW-6）──
    #
    # ★ 借用の寿命を「呼び出しの間」に固定した（仕様 §4.4）のと同じ考えを、
    #   ローカル変数どうしにも当てはめます。内側のスコープで作った値を、
    #   外側の変数に貸したままにはできません。
    tgt: rc[DeclEnt] | None = o.find_decl(target.ir_name)
    if tgt is not None and not p_is_param:
        tg: rc[DeclEnt] = tgt
        if tg.depth < p_depth:
            o.rep.report_outlive(target, org)


# None でない前提で取り出す小道具
#
# 注意: 呼ぶのは「found が True のときだけ」です。found が立つ経路では
#   必ず origin を入れているので、ここへ None は来ません。
def node_of_opt(n: rc[ast.Node] | None) -> rc[ast.Node]:
    if n is None:
        panic(diag.msg0("sownck.007", "ownck: 貸し手の宣言がありません（呼び出し側の条件が誤っています）"))
    return n


# ── ループの記録（break / continue の合流先）────────────────
#
# ★ 対になる定義: src/ownck.c の struct Loop
class Loop:
    brk: rc[Flow]      # break で抜けたときの状態の結合
    cont: rc[Flow]     # continue で戻るときの状態の結合
    outer: rc[Loop] | None

    def init(self, outer: rc[Loop] | None) -> None:
        self.brk = rc(Flow())
        self.brk.dead = True     # まだ誰も通っていない
        self.cont = rc(Flow())
        self.cont.dead = True
        self.outer = outer


# ── 文をたどる ──────────────────────────────────────────
#
# ★ 対になる定義: src/ownck.c の stmt / stmt_list / while_once / check_while

def stmt_list(o: mut Own, f: mut rc[Flow], first: rc[ast.Node] | None) -> None:
    n: rc[ast.Node] | None = first
    while n is not None:
        if f.dead:
            return          # return の後ろは実行されない
        nn: rc[ast.Node] = n
        stmt(o, f, nn)
        n = nn.next

# while を 1 周ぶん解析する。
#   back … 本体を通って入口へ戻るときの状態（逆辺）
#   exit … ループから抜けるときの状態（条件が偽 / break）
#
# 注意: この言語には「複数の値を返す」形が無いので、結果は WhileOnce に詰めます。
class WhileOnce:
    back: rc[Flow]
    exit_: rc[Flow]

    def init(self, back: rc[Flow], exit_: rc[Flow]) -> None:
        self.back = back
        self.exit_ = exit_

def while_once(o: mut Own, n: rc[ast.Node], entry: rc[Flow]) -> rc[WhileOnce]:
    cur: rc[Flow] = flow_copy(entry)
    use_expr(o, cur, n.lhs)          # 条件は毎周評価される
    exit_: rc[Flow] = flow_copy(cur)  # 条件が偽なら、ここで抜ける

    lp: rc[Loop] = rc(Loop(o.loop))
    o.loop = lp
    stmt(o, cur, n.body)
    flow_join(cur, lp.cont)          # continue は本体末尾と同じ場所へ合流
    if n.incr is not None:
        stmt(o, cur, n.incr)         # for の増分
    o.loop = lp.outer

    flow_join(exit_, lp.brk)
    return rc(WhileOnce(cur, exit_))

# while の解析。**CFG は作りません**（設計 ownership.md §4.2）。
def check_while(o: mut Own, f: mut rc[Flow], n: rc[ast.Node]) -> None:
    # ── ① 入口の状態を不動点まで下げる（診断は出さない）──
    #
    # なぜ 2 周で収束するのか
    #   格子の高さが 2（Valid → MaybeMoved → Moved）で、状態は単調にしか
    #   下がらないためです。3 周目で変化することはありません。
    #   崩れたらコンパイラの不具合なので、panic して落とします。
    entry: rc[Flow] = flow_copy(f)
    rnd: int = 0

    o.quiet_depth = o.quiet_depth + 1
    o.rep.opt.quiet = True
    while True:
        w: rc[WhileOnce] = while_once(o, n, entry)
        nxt: rc[Flow] = flow_copy(entry)
        flow_join(nxt, w.back)
        if flow_eq(nxt, entry):
            break
        entry = nxt
        rnd = rnd + 1
        if rnd >= 3:
            panic(diag.msg0("sownck.008", "ownck: while の所有権解析が収束しません（格子が壊れています）"))
    o.quiet_depth = o.quiet_depth - 1
    if o.quiet_depth == 0:
        o.rep.opt.quiet = False

    # ── ② 収束した入口で、もう一度だけ解析して診断を出す ──
    #
    # ★ 反復のたびに報告すると、同じ警告が何度も出てしまいます。
    w2: rc[WhileOnce] = while_once(o, n, entry)
    f.ents = move_out(w2.exit_.ents)   # ★ 持ち主ごと移す（下の flow_join と同じ理由）
    f.dead = w2.exit_.dead


# ── 隠し変数（脱糖が作った別名）────────────────────────────
#
# ★ for.it.0 = xs や aug.obj.0 = t は、対象を 1 回だけ評価するための別名です。
#   利用者が書いた代入ではないので、**移動ではなく借用**として扱います
#   （仕様 v2 §3.1「for の要素は移動しない」）。
#   名前に '.' が入るのは脱糖で作った変数だけなので、これで見分けられます。
def is_hidden_var(name: str) -> bool:
    return strings.find(name, ".") >= 0

# ★ 隠し変数のうち、`swap.N` だけは**所有します**。
#
#   注意: ほかの隠し変数は「対象を 1 回だけ評価するための借り」ですが、
#     `swap.N` は**右辺の値そのものを預かる場所**なので、借りにすると
#     `a, b = b, a` で二重解放になります（--drop 付きで実際に壊れました）。
def is_owning_hidden(name: str) -> bool:
    return strings.startswith(name, "swap.")

# 入れ物が読み取り専用の借用なら書き換えられません（B3）
#
# ★ 局所変数への代入（ND_VAR）は借用を作らないので対象外です（仕様 §5.1）。
def check_mut(o: mut Own, at: rc[ast.Node], target: rc[ast.Node],
              kind: int) -> None:
    p: rc[Place] | None = place_of(target)
    if p is None:
        return
    pp: rc[Place] = p
    br: rc[BorrowRoot] | None = o.borrow_root_of(pp)
    if br is None:
        return          # 借りものではない＝自分のもの。書き換え自由（仕様 §5.1）
    brr: rc[BorrowRoot] = br
    if brr.is_mut:
        return          # mut で借りている
    t: rc[token.Token] | None = at.tok
    if t is None:
        return
    fname: str = ""
    cf: rc[ast.Node] | None = o.cur_fn
    if cf is not None:
        fname = copy(node_of_opt(cf).name)
    o.rep.report_mut(t, pp, brr, kind, fname)

# 代入先の場所を「ふたたび Valid」にする
def assign_to(o: mut Own, f: mut rc[Flow], target: rc[ast.Node]) -> None:
    if target.kind != ast.ND_VAR:
        # self.f = v / xs[i] = v … 「入れ物」を読む必要がある
        use_expr(o, f, target.lhs)
        if target.kind == ast.ND_INDEX:
            use_expr(o, f, target.rhs)
        check_mut(o, target, target, WR_ASSIGN)
    p: rc[Place] | None = place_of(target)
    if p is not None:
        flow_clear(f, p)

# ── 文をたどる ──────────────────────────────────────────
def stmt(o: mut Own, f: mut rc[Flow], n: rc[ast.Node] | None) -> None:
    if n is None or f.dead:
        return
    nn: rc[ast.Node] = n
    k: int = nn.kind

    if k == ast.ND_VARDECL:
        # ★ 右辺を所有したかどうかで、この変数を解放するかが決まります。
        #   脱糖が作った隠し変数（for.it.0 など）は必ず借りものです。
        owns: bool = False
        if is_hidden_var(nn.name) and not is_owning_hidden(nn.name):
            use_expr(o, f, nn.rhs)
        else:
            owns = move_expr(o, f, nn.rhs, MV_ASSIGN)
        vt: rc[ast.Type] | None = node_type(nn)
        if not owns and vt is not None and ty_is_owned(vt):
            nn.binds_borrow = True
        remember_decl(o, nn)
        bind_alias(o, nn, nn.rhs)
        if owns:
            forget_loan(o, nn.ir_name)
        else:
            record_loan(o, nn, nn.rhs)
        if len(nn.ir_name) > 0:
            pk: int = PL_LOCAL
            if strings.startswith(nn.ir_name, "@"):
                pk = PL_GLOBAL
            flow_clear(f, rc(Place(pk, None, copy(nn.ir_name), copy(nn.name))))
        return

    if k == ast.ND_ASSIGN:
        lhs: rc[ast.Node] = node_of_opt(nn.lhs)
        # ── 書き換える場所の中を借りている別名を無効にする（E-BORROW-9）──
        #   対になる定義: src/ownck.c の stmt（ND_ASSIGN）
        w: rc[Place] | None = None
        if lhs.kind != ast.ND_VAR:
            w = place_of(lhs)
        elif (len(lhs.ir_name) > 0 and not is_hidden_var(lhs.name) and
                find_loan(o, lhs.ir_name) is None):
            v: rc[Place] | None = place_of(lhs)
            if v is not None and o.borrow_root_of(place_opt(v)) is None:
                w = v
        owns2: bool = False
        if lhs.kind == ast.ND_VAR and is_hidden_var(lhs.name):
            use_expr(o, f, nn.rhs)
        else:
            # ★ グローバルはプログラムが終わるまで残るので、
            #   フィールドへの保存と同じ扱いにします（B2）。
            ctx: int = MV_ASSIGN
            if lhs.kind == ast.ND_FIELD or strings.startswith(lhs.ir_name, "@"):
                ctx = MV_FIELD
            owns2 = move_expr(o, f, nn.rhs, ctx)
        # 借りものを入れ直した変数は、もう自分のものではない
        if lhs.kind == ast.ND_VAR and not owns2 and nn.rhs is not None:
            rt: rc[ast.Type] | None = node_type(node_of_opt(nn.rhs))
            if rt is not None and ty_is_owned(rt):
                mark_borrow_bind(o, lhs.ir_name)
        if w is not None:
            invalidate_loans(o, f, place_opt(w), False, False, lhs)
        if lhs.kind == ast.ND_VAR and len(lhs.ir_name) > 0:
            if owns2:
                forget_loan(o, lhs.ir_name)
            else:
                record_loan(o, lhs, nn.rhs)
        if lhs.kind == ast.ND_VAR:
            bind_alias(o, lhs, nn.rhs)
        assign_to(o, f, lhs)
        return

    if k == ast.ND_BLOCK:
        o.depth = o.depth + 1
        stmt_list(o, f, nn.body)
        o.depth = o.depth - 1
        return

    # ★ 契約（A-29）の式も「読み」としてたどる。
    #   注意: たどらないと、式の中の呼び出しに渡した値の扱いが記録されない。
    #   対になる定義: src/ownck.c の ND_REQUIRES / ND_ENSURES
    if k == ast.ND_REQUIRES or k == ast.ND_ENSURES:
        use_expr(o, f, nn.lhs)
        return

    if k == ast.ND_SCOPE:
        o.scope_depth = o.scope_depth + 1
        stmt(o, f, nn.body)
        o.scope_depth = o.scope_depth - 1
        return

    if k == ast.ND_IF:
        use_expr(o, f, nn.lhs)
        then_f: rc[Flow] = flow_copy(f)
        stmt(o, then_f, nn.body)
        else_f: rc[Flow] = flow_copy(f)
        if nn.els is not None:
            stmt(o, else_f, nn.els)
        # 注意: then 側を f に写してから else 側を合流させる（C 版と同じ順序）
        f.ents = move_out(then_f.ents)   # ★ 持ち主ごと移す
        f.dead = then_f.dead
        flow_join(f, else_f)
        return

    # ── 場合分け（A-37）──
    #
    # ★ **if の合流と同じ扱い。** どの case も「入る前の状態」から始まり、
    #   出たところで全部を合流させる。
    #
    #   注意: **調べる式は 1 回だけ使う**（codegen も 1 回しか評価しない）。
    #     case の数だけ数えると、`match xs.pop():` のような形で
    #     「何度も移動した」と誤って言うことになる。
    if k == ast.ND_MATCH:
        use_expr(o, f, nn.lhs)

        result_m: rc[Flow] = flow_copy(f)
        first_m: bool = True
        cm: rc[ast.Node] | None = nn.body
        while cm is not None:
            ccm: rc[ast.Node] = cm
            cf: rc[Flow] = flow_copy(f)
            # 注意: case の値（Color.Red / 48 / "ja"）は**定数**なので、
            #   use_expr に通す必要がない（sema がそう縛っている）。
            stmt(o, cf, ccm.body)
            if first_m:
                result_m.ents = move_out(cf.ents)
                result_m.dead = cf.dead
                first_m = False
            else:
                flow_join(result_m, cf)
            cm = ccm.next
        f.ents = move_out(result_m.ents)
        f.dead = result_m.dead
        return

    # ★ 列挙の宣言は実行時に何もしない（枝はただの定数。A-37）
    if k == ast.ND_ENUM:
        return

    if k == ast.ND_WHILE:
        check_while(o, f, nn)
        return

    if k == ast.ND_TRY:
        body: rc[Flow] = flow_copy(f)
        stmt(o, body, nn.body)
        result: rc[Flow] = flow_copy(body)
        ex: rc[ast.Node] | None = nn.els
        while ex is not None:
            exn: rc[ast.Node] = ex
            ef: rc[Flow] = flow_copy(f)
            stmt(o, ef, exn.body)
            flow_join(result, ef)
            ex = exn.next
        f.ents = move_out(result.ents)   # ★ 持ち主ごと移す
        f.dead = result.dead
        return

    if k == ast.ND_RAISE:
        # ★ エラーオブジェクトは呼び出し元へ渡る＝ return と同じ移動
        move_expr(o, f, nn.lhs, MV_RETURN)
        f.dead = True
        return

    if k == ast.ND_BREAK:
        lp: rc[Loop] | None = o.loop
        if lp is not None:
            flow_join(lp.brk, f)
        f.dead = True
        return

    if k == ast.ND_CONTINUE:
        lp2: rc[Loop] | None = o.loop
        if lp2 is not None:
            flow_join(lp2.cont, f)
        f.dead = True
        return

    if k == ast.ND_RETURN:
        # ★ return は移動です。戻り値の所有権は呼び出し側に渡ります。
        move_expr(o, f, nn.lhs, MV_RETURN)
        f.dead = True
        return

    if k == ast.ND_PASS or k == ast.ND_IMPORT or k == ast.ND_FIELDDECL:
        return

    use_expr(o, f, nn)   # 式文（呼び出し）


# ── 入口 ────────────────────────────────────────────────
#
# ★ 対になる定義: src/ownck.c の collect_funcs / check_func / ownck_program

# 代入ノードに、その変数の「借りものか」の印を写す。
#
# 注意: codegen は代入のときに**古い値を解放**します。借りものを束縛している
#   変数でそれをやると、他人の値を解放してしまいます。
#   印が付くのは解析の途中（後の行の代入かもしれない）なので、
#   **解析が終わってから**まとめて写します。
def propagate_borrow_binds(o: Own, n: rc[ast.Node] | None) -> None:
    if n is None:
        return
    nn: rc[ast.Node] = n
    if nn.kind == ast.ND_ASSIGN and nn.lhs is not None:
        lh: rc[ast.Node] = node_of_opt(nn.lhs)
        if lh.kind == ast.ND_VAR and len(lh.ir_name) > 0:
            d: rc[DeclEnt] | None = o.find_decl(lh.ir_name)
            if d is not None:
                dd: rc[DeclEnt] = d
                if dd.decl.binds_borrow:
                    nn.binds_borrow = True
    propagate_borrow_binds(o, nn.lhs)
    propagate_borrow_binds(o, nn.rhs)
    propagate_borrow_binds(o, nn.els)
    propagate_borrow_binds(o, nn.incr)
    st: rc[ast.Node] | None = nn.body
    while st is not None:
        sn: rc[ast.Node] = st
        propagate_borrow_binds(o, sn)
        st = sn.next

# この式は「引数に根ざした場所」か（self を含む）
def rooted_in_param(fn: rc[ast.Node], n: rc[ast.Node] | None) -> bool:
    cur: rc[ast.Node] | None = n
    while cur is not None:
        c: rc[ast.Node] = cur
        if c.kind != ast.ND_FIELD and c.kind != ast.ND_INDEX:
            break
        cur = c.lhs
    if cur is None:
        return False
    cn: rc[ast.Node] = cur
    if cn.kind != ast.ND_VAR:
        return False
    pm: rc[ast.Node] | None = fn.params
    while pm is not None:
        p: rc[ast.Node] = pm
        if len(p.ir_name) > 0 and len(cn.ir_name) > 0 and p.ir_name == cn.ir_name:
            return True
        pm = p.next
    return False

# この関数は「借りものを返す」か（仕様 §4.5）
def returns_borrow(fn: rc[ast.Node], n: rc[ast.Node] | None) -> bool:
    if n is None:
        return False
    nn: rc[ast.Node] = n
    if nn.kind == ast.ND_RETURN:
        return rooted_in_param(fn, nn.lhs)
    if returns_borrow(fn, nn.body):
        return True
    if returns_borrow(fn, nn.els):
        return True
    if nn.kind != ast.ND_FUNC and returns_borrow(fn, nn.next):
        return True
    return False

def mark_returns_borrow(fn: mut rc[ast.Node]) -> None:
    if fn.body is None:
        return
    b: rc[ast.Node] = node_of_opt(fn.body)
    fn.binds_borrow = returns_borrow(fn, b.body)

# 「借用を返す関数の戻り値を、そのまま返している」か。
#
# ★ なぜ要るか
#   `def header(self) -> str: return self.headers.get_or(k, "")` のように、
#   **借用を返す関数の戻り値をそのまま返す**関数があります。この関数の
#   戻り値も借りものですが、rooted_in_param は「self.x」の形しか見ないので
#   印が立ちません。すると呼び出し側が一時値として解放し、
#   **dict の中の文字列が消えます**。
#   対になる定義: src/ownck.c の returns_borrowed_call
def returns_borrowed_call(o: Own, n: rc[ast.Node] | None) -> bool:
    cur: rc[ast.Node] | None = n
    while cur is not None:
        nn: rc[ast.Node] = cur
        if nn.kind == ast.ND_RETURN and nn.lhs is not None:
            l: rc[ast.Node] = node_of_opt(nn.lhs)
            if l.kind == ast.ND_CALL or l.kind == ast.ND_METHOD:
                f: rc[ast.Node] | None = callee_of(o, l)
                if f is not None:
                    fn2: rc[ast.Node] = f
                    if fn2.binds_borrow:
                        return True
        if returns_borrowed_call(o, nn.body):
            return True
        if returns_borrowed_call(o, nn.els):
            return True
        if nn.kind == ast.ND_FUNC:
            return False
        cur = nn.next
    return False

# 「戻り値が借りもの」の印を、呼び出しの連なりに沿って広げる。
#
# ★ **増えなくなるまで回します。** 呼び出しの向きは定義の順とも
#   モジュールの依存順とも限らない（相互再帰もある）ためです。
#   対になる定義: src/ownck.c の propagate_binds_borrow
def propagate_binds_borrow(o: mut Own) -> None:
    changed: bool = True
    while changed:
        changed = False
        i: int = 0
        while i < len(o.func_nodes):
            fn: rc[ast.Node] = o.func_nodes[i]
            i = i + 1
            if fn.binds_borrow or fn.body is None:
                continue
            b: rc[ast.Node] = node_of_opt(fn.body)
            if returns_borrowed_call(o, b.body):
                fn.binds_borrow = True
                changed = True

# 関数の表を作る（★ 事前パス。呼び出し側が「戻り値は借りものか」を引ける）
def collect_funcs(o: mut Own, root: rc[ast.Node]) -> None:
    d: rc[ast.Node] | None = root.body
    while d is not None:
        dn: rc[ast.Node] = d
        if dn.kind == ast.ND_FUNC and len(dn.ir_name) > 0:
            mark_returns_borrow(dn)
            o.func_keys.append(copy(dn.ir_name))
            o.func_nodes.append(dn)
        elif dn.kind == ast.ND_CLASS:
            m: rc[ast.Node] | None = dn.body
            while m is not None:
                mm: rc[ast.Node] = m
                if mm.kind == ast.ND_FUNC and len(mm.ir_name) > 0:
                    mark_returns_borrow(mm)
                    o.func_keys.append(copy(mm.ir_name))
                    o.func_nodes.append(mm)
                m = mm.next
        d = dn.next

# 関数 1 つを検査する
def check_func(o: mut Own, fn: rc[ast.Node]) -> None:
    if fn.body is None:
        return          # extern 宣言には本体が無い

    # ── この関数が「借りている」ものを並べる ──
    #
    # ★ own の引数は借りものではありません（所有権を受け取っている）。
    #   コピー型（int / bool）はそもそも移動しないので、入れても意味がありません。
    o.roots = []
    o.decls = []
    o.loans = []
    o.depth = 0

    pm: rc[ast.Node] | None = fn.params
    while pm is not None:
        p: rc[ast.Node] = pm
        remember_decl(o, p)
        pm = p.next

    first: rc[ast.Node] | None = fn.params
    pm2: rc[ast.Node] | None = fn.params
    while pm2 is not None:
        p2: rc[ast.Node] = pm2
        pt: rc[ast.Type] | None = node_type(p2)
        ok: bool = p2.mode != ast.PM_OWN and len(p2.ir_name) > 0
        if ok and pt is not None and ty_is_owned(pt):
            # self は「型注釈の無い第 1 引数」（parser がそう作る）
            is_self: bool = False
            if first is not None:
                fp: rc[ast.Node] = node_of_opt(first)
                is_self = p2.ir_name == fp.ir_name and p2.type_ref is None
            # ★ init だけは self を可変として扱います。生成中のオブジェクトは
            #   まだ誰にも貸していない「自分のもの」だからです（仕様 §4.2）。
            is_mut: bool = p2.mode == ast.PM_MUT or (is_self and fn.name == "init")
            # ★ 借りている引数は所有していないので、解放しません。
            p2.binds_borrow = True
            o.roots.append(rc(BorrowRoot(copy(p2.ir_name), p2, True,
                                         is_self, is_mut, 0)))
        pm2 = p2.next

    # 引数は、借用でも own でも、関数に入った時点では必ず有効です。
    f: rc[Flow] = rc(Flow())
    o.cur_fn = fn
    body: rc[ast.Node] = node_of_opt(fn.body)
    stmt_list(o, f, body.body)
    propagate_borrow_binds(o, fn.body)
    o.cur_fn = None
    o.roots = []
    o.decls = []
    o.loans = []

# モジュール 1 つのトップレベルを検査する
# 外へ出す関数（本体つきの extern def）の検査（設計 ffi.md §5.3）。
# ★ spawn で始める関数と同じ立場なので、E-SEND-3 と同じ走査で確かめます。
#   対になる定義: src/ownck.c の check_export
def check_export(o: mut Own, fn: rc[ast.Node]) -> None:
    if fn.body is None:
        return
    k: int = 0
    while k < 2:
        what: int = HZ_GLOBAL_WRITE
        if k == 1:
            what = HZ_THREAD
        k = k + 1
        seen: list[str] = [copy(fn.ir_name)]
        blk: rc[ast.Node] = node_of_opt(fn.body)
        hit: rc[ast.Node] | None = scan_global_write_list(o, blk.body, seen, what)
        if hit is not None:
            hn: rc[ast.Node] = hit
            o.rep.report_export_hazard(fn.name, node_tok(fn), hn.tok, what)


def check_module(o: mut Own, root: rc[ast.Node]) -> None:
    d: rc[ast.Node] | None = root.body
    while d is not None:
        dn: rc[ast.Node] = d
        if dn.kind == ast.ND_FUNC and dn.is_export:
            check_export(o, dn)
        if dn.kind == ast.ND_FUNC:
            check_func(o, dn)
        elif dn.kind == ast.ND_CLASS:
            m: rc[ast.Node] | None = dn.body
            while m is not None:
                mm: rc[ast.Node] = m
                if mm.kind == ast.ND_FUNC:
                    check_func(o, mm)
                m = mm.next
        d = dn.next


# 型 t の中（たどれる範囲すべて）に rc[T] があるか。見つけたらその名前を返す。
#
# 注意: **これが無いと検査に穴が開きます。** `own Job` を渡すのは安全に見えても、
#    Job のフィールドに rc[Node] があれば、**その数え札は 2 つのスレッドから
#    増減されます**。渡すものの型だけを見て「クラスだから安全」とは言えません。
#
# ★ seen は再帰的なクラス（Node が Node を持つ）で止まるための記録です。
#   C 版は Class* のポインタ比較、こちらは IR 名で比べます。
#   対になる定義: src/ownck.c の rc_inside
def rc_inside(t: rc[ast.Type] | None, seen: mut list[str]) -> str:
    if t is None:
        return ""
    tt: rc[ast.Type] = t
    if tt.kind == ast.TY_RC:
        return ast.type_name(tt)
    # 注意: mutex に入っていても同じです。ロックが守るのは**中身**で、
    #    数え札は箱の外（rc が指す先）にあるためです。
    if tt.kind == ast.TY_LIST or tt.kind == ast.TY_OPT or tt.kind == ast.TY_MUTEX:
        return rc_inside(tt.elem, seen)
    if tt.kind == ast.TY_TUPLE:
        i: int = 0
        while i < len(tt.params):
            hit: str = rc_inside(tt.params[i], seen)
            if len(hit) > 0:
                return hit
            i = i + 1
        return ""
    if tt.kind == ast.TY_CLASS:
        c: rc[ast.Class] | None = tt.cls
        if c is None:
            return ""
        cc: rc[ast.Class] = c
        k: int = 0
        while k < len(seen):
            if seen[k] == cc.ir_name:
                return ""
            k = k + 1
        seen.append(copy(cc.ir_name))
        fl: rc[ast.Field] | None = cc.fields
        while fl is not None:
            ff: rc[ast.Field] = fl
            hit2: str = rc_inside(ff.type, seen)
            if len(hit2) > 0:
                return hit2
            fl = ff.next
        return ""
    return ""


# 関数の本体（と、そこから呼ぶ関数）がグローバルに書いていないか。
# 書いていれば、その代入のノードを返す。
#
# 注意: 呼び先までたどります。直下だけ見ると「1 枚かませば通る」検査になり、
#    保証として意味を持ちません。seen は再帰呼び出しで止まらないため。
#    対になる定義: src/ownck.c の scan_global_write
# ★ 同じ走査で「スレッドを始めているか」も探します（E-EXPORT-4）。
#   対になる定義: src/ownck.c の Hazard
HZ_GLOBAL_WRITE: int = 0   # グローバルへの代入（E-SEND-3 / E-EXPORT-3）
HZ_THREAD: int = 1         # spawn / scope:（E-EXPORT-4）

def scan_global_write_list(o: mut Own, n: rc[ast.Node] | None,
                           seen: mut list[str], what: int) -> rc[ast.Node] | None:
    cur: rc[ast.Node] | None = n
    while cur is not None:
        c: rc[ast.Node] = cur
        hit: rc[ast.Node] | None = scan_global_write(o, c, seen, what)
        if hit is not None:
            return hit
        cur = c.next
    return None


def scan_global_write(o: mut Own, n: rc[ast.Node],
                      seen: mut list[str], what: int) -> rc[ast.Node] | None:
    # ① グローバルへの代入そのもの
    if what == HZ_GLOBAL_WRITE and n.kind == ast.ND_ASSIGN and n.lhs is not None:
        p: rc[Place] | None = place_of(n.lhs)
        if p is not None:
            root: rc[Place] = p
            nxt: rc[Place] | None = root.base
            while nxt is not None:
                root = nxt
                nxt = root.base
            if root.kind == PL_GLOBAL:
                return n
    # ①' スレッドを始めるところ（spawn の呼び出しと scope: ブロック）
    if what == HZ_THREAD:
        if n.kind == ast.ND_SCOPE:
            return n
        if n.kind == ast.ND_CALL and len(n.ir_name) == 0:
            nt: rc[ast.Type] | None = node_type(n)
            if nt is not None and nt.kind == ast.TY_THREAD:
                return n

    # ② 呼び先へ降りる（同じ関数は 1 回だけ）
    if (n.kind == ast.ND_CALL or n.kind == ast.ND_METHOD) and len(n.ir_name) > 0:
        callee: rc[ast.Node] | None = o.lookup_func(n.ir_name)
        if callee is not None:
            cn: rc[ast.Node] = callee
            if cn.body is not None:
                done: bool = False
                i: int = 0
                while i < len(seen):
                    if seen[i] == cn.ir_name:
                        done = True
                    i = i + 1
                if not done:
                    seen.append(copy(cn.ir_name))
                    blk: rc[ast.Node] = node_of_opt(cn.body)
                    hit2: rc[ast.Node] | None = scan_global_write_list(o, blk.body, seen, what)
                    if hit2 is not None:
                        return hit2

    # ③ 子をたどる
    #
    # 注意: C 版は Node* の配列を 1 本作って回しますが、こちらは **1 つずつ**
    #   書きます。`[n.lhs, n.rhs, …]` と書くと借りものの rc[T] を所有する
    #   list に入れることになり（E-BORROW-7 の形）、寿命が合いません。
    hit3: rc[ast.Node] | None = scan_child(o, n.lhs, seen, what)
    if hit3 is not None:
        return hit3
    hit4: rc[ast.Node] | None = scan_child(o, n.rhs, seen, what)
    if hit4 is not None:
        return hit4
    hit5: rc[ast.Node] | None = scan_child(o, n.incr, seen, what)
    if hit5 is not None:
        return hit5
    hit6: rc[ast.Node] | None = scan_child(o, n.els, seen, what)
    if hit6 is not None:
        return hit6
    hit7: rc[ast.Node] | None = scan_global_write_list(o, n.body, seen, what)
    if hit7 is not None:
        return hit7
    return scan_global_write_list(o, n.args, seen, what)


# 子 1 つ（無いかもしれない）をたどる
def scan_child(o: mut Own, n: rc[ast.Node] | None,
               seen: mut list[str], what: int) -> rc[ast.Node] | None:
    if n is None:
        return None
    return scan_global_write(o, node_of_opt(n), seen, what)


# spawn(f, a...) の引数を、始める関数の受け取り方に従って評価する。
#
# ★ **新しい注釈は 1 つも足しません。** すでにある own / mut / 借用の規則に、
#   「スレッドの境界を越えられるか」という 1 つの問いを足すだけです。
#
#   own T      … 渡した側はもう触れない。競合しようがない
#   mutex[T]   … 触るにはロックが要る
#   借り        … 渡せない。借りは「呼び出しより長生きしない」規則で守られているが、
#                    スレッドは呼び出しより長生きしうる（E-SEND-1）
#   rc[T]      … 渡せない。参照数の増減が競合する（E-SEND-2）
#   グローバル書き込み … 渡せない。誰が触っているか静的に分からない（E-SEND-3）
#
# 注意: **検査の順序も C 版と同じです**（E-SEND-2 → 4 → 1 → 移動の記録 → 3）。
#   最初の 1 件でエラー終了するので、順序が違うと出る診断が変わります。
def spawn_args(o: mut Own, f: mut rc[Flow], n: rc[ast.Node]) -> None:
    fexpr: rc[ast.Node] | None = n.args
    if fexpr is None:
        return          # sema がすでに止めているはず
    fe: rc[ast.Node] = fexpr
    use_expr(o, f, fe)

    # 始める関数が分かれば、引数の受け取り方（own / 借り / mut）が分かります。
    spawned: rc[ast.Node] | None = o.lookup_func(fe.ir_name)
    pm: rc[ast.Node] | None = None
    if spawned is not None:
        pm = node_of_opt(spawned).params

    a: rc[ast.Node] | None = fe.next
    while a is not None:
        an: rc[ast.Node] = a
        is_own: bool = True     # 定義が引けないときは移動として扱う（安全側）
        is_mut: bool = False
        if pm is not None:
            p: rc[ast.Node] = pm
            is_own = p.mode == ast.PM_OWN
            is_mut = p.mode == ast.PM_MUT
            pm = p.next

        atok: rc[token.Token] | None = an.tok

        # ── E-SEND-2: rc[T] はスレッドをまたげない ──
        #
        # ★ 参照数はただの整数の増減で、競合すると数が壊れます
        #   （早すぎる解放＝解放後の使用）。原子的な増減にすれば直りますが、
        #   **すべての rc[T] が遅くなります**。コンパイラ自身が rc[T] だらけなので
        #   これは払えません（設計文書 2.2）。
        at0: rc[ast.Type] | None = an.type
        if at0 is not None and atok is not None:
            seen: list[str] = []
            rcname: str = rc_inside(at0, seen)
            if len(rcname) > 0:
                att: rc[ast.Type] = at0
                o.rep.report_send_rc(rcname, ast.type_name(att),
                                     att.kind == ast.TY_RC, node_tok(an))

        pl: rc[Place] | None = place_of(an)

        # ── E-SEND-4: 可変借用はスレッドに渡せない ──
        #
        # なぜ scope: の中でも許さないのか
        #   scope: が保証するのは**寿命**だけです。同じ値への可変借用を
        #   2 本のスレッドが持てば、寿命が足りていてもデータ競合になります。
        if is_mut and atok is not None:
            disp: str = diag.msg0("own.099", "この値")
            if pl is not None:
                pmut: rc[Place] = pl
                disp = copy(pmut.disp)
            o.rep.report_send_mut(disp, node_tok(an))

        # ── E-SEND-1: 借りは渡せない（scope: の中を除く）──
        #
        # ここが設計の要点です。借用検査がすでに持っている
        #   「借りは呼び出しより長生きしない」という不変条件が、そのまま
        #   「借りはスレッドに渡せない」に翻訳されます。**規則を足すのではなく、
        #   既にある規則の帰結として出てきます。**
        #
        # ★ **scope: の中だけは渡せます。** ブロックの出口で必ず
        #   join されるので、その不変条件が**成り立ったまま**になるためです。
        if pl is not None and o.scope_depth == 0 and atok is not None:
            pp: rc[Place] = pl
            br: rc[BorrowRoot] | None = o.borrow_root_of(pp)
            if br is not None:
                o.rep.report_send_borrow(pp.disp, node_tok(an))

        # ★ 渡し方は普通の呼び出しと同じです。own なら移動、借りなら借用。
        if is_own:
            move_expr(o, f, an, MV_OWN_ARG)
        else:
            use_expr(o, f, an)
        a = an.next

    # ── E-SEND-3: スレッドの中からグローバルを書き換えている ──
    if spawned is not None:
        sp: rc[ast.Node] = spawned
        if sp.body is not None:
            seen2: list[str] = [copy(sp.ir_name)]
            blk2: rc[ast.Node] = node_of_opt(sp.body)
            hit: rc[ast.Node] | None = scan_global_write_list(o, blk2.body, seen2,
                                                              HZ_GLOBAL_WRITE)
            if hit is not None:
                hn: rc[ast.Node] = hit
                o.rep.report_send_global(sp.name, node_tok(fe), hn.tok)


# 診断に使うトークン。
#
# ★ ownck は sema の後に走るので、式のノードには必ずトークンがあります。
#   （C 版は Node.tok をそのまま渡しますが、こちらは `| None` を外すのに
#     1 枚かませる必要があります）
def node_tok(n: rc[ast.Node]) -> rc[token.Token]:
    t: rc[token.Token] | None = n.tok
    if t is None:
        panic(diag.msg0("sownck.010", "ownck: 位置情報の無いノードを報告しようとしました"))
    return t


# 同じ場所を、可変借用と他の借用で同時に渡していないか（B1。仕様 §4.3）
#
# ★ 設計 ownership.md §5.1 に書いたとおり、これは**二重ループだけ**です。
#   借用の寿命が「呼び出しの間」に固定されているので、比べる範囲が
#   1 つの呼び出しの中に閉じています。
def check_arg_aliases(o: mut Own, args: list[rc[ArgRef]]) -> None:
    i: int = 0
    while i < len(args):
        a: rc[ArgRef] = args[i]
        k: int = i + 1
        while k < len(args):
            b: rc[ArgRef] = args[k]
            if a.is_mut or b.is_mut:
                pa: rc[Place] | None = place_of(a.expr)
                pb: rc[Place] | None = place_of(b.expr)
                if pa is not None and pb is not None:
                    ppa: rc[Place] = pa
                    ppb: rc[Place] = pb
                    # ★ 別名は借り先に直してから比べます（E-BORROW-9 と同じ表）。
                    if (place_overlaps(ppa, ppb) or
                            place_overlaps(resolve_place(o, ppa), resolve_place(o, ppb))):
                        if a.is_mut:
                            o.rep.report_alias(a, b, ppa)
                        else:
                            o.rep.report_alias(b, a, ppa)
            k = k + 1
        i = i + 1


# ── プログラム全体を検査する（C 版 ownck_program と対）────────
#
# ★ 既定は警告です。移動済みの値を使っていても、生成される IR は
#   変わりません（解放を挿すのは --drop のときだけ）。
#
# 注意: **2 パスです。** 先に全モジュールの関数表を作ってから検査します。
#   「この呼び出しの戻り値は借りものか」を引くのに、呼び先の解析が
#   先に終わっている必要があるためです。
# この式の木のどこかに spawn があるか。
#
# ★ 対になる定義: src/ownck.c の has_spawn
def has_spawn_node(n: rc[ast.Node] | None) -> bool:
    cur: rc[ast.Node] | None = n
    while cur is not None:
        c: rc[ast.Node] = cur
        ct: rc[ast.Type] | None = c.type
        if c.kind == ast.ND_CALL and len(c.ir_name) == 0:
            if ct is not None and ct.kind == ast.TY_THREAD:
                return True
        if has_spawn_node(c.lhs):
            return True
        if has_spawn_node(c.rhs):
            return True
        if has_spawn_node(c.incr):
            return True
        if has_spawn_node(c.els):
            return True
        if has_spawn_node(c.body):
            return True
        if has_spawn_node(c.args):
            return True
        cur = c.next
    return False


def ownck_program(mods: rc[module.Module] | None, opt: own Options) -> Own:
    # ── spawn を使ったら、--warn-own でも警告に落とさない ──
    #
    # ★ 所有権の指摘を警告へ落とすと、「データ競合が無い」という保証も
    #   一緒に警告どまりになります（E-SEND-* は借りか・所有か・rc かの
    #   判定に乗っているため）。逃げ道は逃げ道として要りますが、
    #   **並行実行のところだけは通しません**。
    #   対になる定義: src/ownck.c の ownck_program
    opt2: Options = opt
    m0: rc[module.Module] | None = mods
    while m0 is not None:
        mm0: rc[module.Module] = m0
        if mm0.ast is not None and has_spawn_node(node_of_opt(mm0.ast).body):
            opt2.deny_move = True
            opt2.deny_borrow = True
            opt2.deny_mut = True
            m0 = None
        else:
            m0 = mm0.next

    o: Own = Own(Reporter(opt2))
    # ① 事前パス：関数の表を作り、「借りものを返すか」を印す
    m: rc[module.Module] | None = mods
    while m is not None:
        mm: rc[module.Module] = m
        if mm.ast is not None:
            collect_funcs(o, node_of_opt(mm.ast))
        m = mm.next
    # ★ 表が揃ってから、「戻り値が借りもの」の印を呼び出しに沿って広げる
    propagate_binds_borrow(o)
    # ② 本検査
    m2: rc[module.Module] | None = mods
    while m2 is not None:
        mm2: rc[module.Module] = m2
        if mm2.ast is not None:
            check_module(o, node_of_opt(mm2.ast))
        m2 = mm2.next
    return o
