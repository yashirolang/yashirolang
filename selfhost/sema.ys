# sema — 意味解析・型検査
#
# ★ src/sema.c（2148 行）の移植です。**機械的に移しています。**
#   関数名・検査の順序・診断の文言を C 版と揃えてあるので、
#   エラーメッセージが食い違ったら diff で追えます。
#
# 注意: Type / Class / FuncSig / ModuleSyms は types にまとめてあります
#   （循環 import を禁止したため）。
import strings
import ast
import diag
import module
import token
import types


# 組み込み関数の表（C 版 BUILTINS と同じ順序）。
#
# 注意: 本言語のグローバルにはリストを書けないので、
#   Sema の init で 1 回だけ組み立てます（keywords と同じ）。
# 実引数に「own の仮引数へ渡す rc[T] か」を書き写す（A-21 ⑬）。
#
# 注意: **rc[T] を own の仮引数へ渡すときは、呼び出し側が参照を 1 つ増やします**
#   （ast.Node.arg_own_rc）。rc[T] は移動しないので、増やさないと受け取った
#   側の「出口で手放す」だけが残り、二重解放になります。
#
# 注意: arg_is_borrowed は**触りません**。あちらは既定（False＝解放しない）が
#   安全側なので、メソッドと生成では立てないままにしてあります。
#   対になる定義: src/sema.c の mark_arg_own_rc
def mark_arg_own_rc(arg: mut rc[ast.Node], f: rc[types.FuncSig], pi: int) -> None:
    if pi >= len(f.pmodes):
        return
    at: rc[ast.Type] | None = arg.type
    if at is None:
        arg.arg_own_rc = False
    else:
        arg.arg_own_rc = f.pmodes[pi] == ast.PM_OWN and ty_is_rc_shared(at)

# ── 名前で引数を渡せない呼び出しを断る（A-38）──
#
# ★ 名前で渡せるのは、**呼び先がソースから 1 つに決まる**ときだけです
#   （この言語で定義した関数・メソッド・生成）。組み込み・関数の値・
#   インタフェース越しの呼び出しには、引数の名前がありません。
#
# 注意: **黙って無視してはいけません。** 名前を書いた人は「その引数に
#   渡した」と思っているので、位置で渡ったまま通すと、静かに違う引数へ
#   入ります。
#   対になる定義: src/sema.c の reject_kwargs
def reject_kwargs(args: rc[ast.Node] | None, message: str, why: str) -> None:
    a: rc[ast.Node] | None = args
    while a is not None:
        arg: rc[ast.Node] = a
        if len(arg.arg_name) > 0:
            diag.error_full(unwrap_tok(arg.arg_name_tok), message,
                            diag.msg("sema.160", "'{0} = …' と書いています", [copy(arg.arg_name)]),
                            None, "", why)
        a = arg.next


# ── 呼び出しの引数を並べ替えて、足りないぶんを既定値で埋める（A-38）──
#
# ★ **ここで n.args を「ちょうど引数の数だけ・定義の順」に書き換えます。**
#   そうすれば、この先（型検査・codegen・所有権検査・証明）は今までどおり
#   「前から順に当てる」だけで済みます。**呼び出しの形を知るのは
#   この関数だけ**です。
#
# ★ 既定値は**呼び出しごとに複製**します。定義時に 1 つ作って共有すると、
#   Python の def f(xs=[]) のように呼び出しをまたいで同じ値を指します。
#
# ★ 引数の名前と既定値を**リストで**受け取ります。FuncSig を持たない
#   ジェネリック関数（テンプレート）からも同じ検査を使うためです。
#   pnames / defaults は self を飛ばした先頭から並べます。
#
# ★ **名前も既定値も出てこない呼び出しには手を触れません。** その形の
#   個数違いは、呼び出し側の検査が今までどおりの言葉で断ります。
#   対になる定義: src/sema.c の bind_args
def bind_args(n: mut rc[ast.Node], nparams: int, pnames: list[str],
              defaults: list[rc[ast.Node] | None],
              deftok: rc[token.Token] | None, subject: str,
              has_self: bool) -> None:
    any_kw: bool = False
    nargs: int = 0
    a0: rc[ast.Node] | None = n.args
    while a0 is not None:
        arg0: rc[ast.Node] = a0
        nargs = nargs + 1
        if len(arg0.arg_name) > 0:
            any_kw = True
        a0 = arg0.next

    has_default: bool = False
    i0: int = 0
    while i0 < nparams:
        if defaults[i0] is not None:
            has_default = True
        i0 = i0 + 1

    if not any_kw and not has_default:
        return
    if not any_kw and nargs == nparams:
        return

    slot: list[rc[ast.Node] | None] = []
    i1: int = 0
    while i1 < nparams:
        slot.append(None)
        i1 = i1 + 1

    # ── ① 位置引数を前から当てる ──
    pos: int = 0
    kw_first: rc[ast.Node] | None = None
    a: rc[ast.Node] | None = n.args
    while a is not None:
        arg: rc[ast.Node] = a
        if len(arg.arg_name) == 0:
            # ★ **位置引数はキーワード引数より前だけ**です。混ぜられると、
            #   読む人が「この値は何番目の引数か」を数え直すことになります。
            if kw_first is not None:
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg0("sema.487", "位置で渡す引数は、名前で渡す引数より前に書きます"),
                                diag.msg0("sema.488", "ここは名前つきの引数より後ろです"),
                                unwrap_node(kw_first).arg_name_tok,
                                diag.msg0("sema.489", "名前で渡し始めたのはここです"),
                                diag.msg0("sema.490", "名前を付けるか、この引数を前へ動かしてください"))
            if pos >= nparams:
                hint: str = ""
                if has_self:
                    hint = diag.msg0("sema.452", "self は自動的に渡されるので、書く必要はありません")
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.240", "{0} に渡せる引数は多くとも {1} 個です（{2} 個渡されました）", [copy(subject), copy(str(nparams)), copy(str(nargs))]),
                                diag.msg0("sema.491", "この引数に当たるものがありません"),
                                deftok, diag.msg0("sema.492", "この関数はここで定義されています"), hint)
            slot[pos] = arg
            pos = pos + 1
            a = arg.next
            continue

        if kw_first is None:
            kw_first = arg

        at: int = -1
        i2: int = 0
        while i2 < nparams:
            if at < 0 and pnames[i2] == arg.arg_name:
                at = i2
            i2 = i2 + 1
        if at < 0:
            diag.error_full(unwrap_tok(arg.arg_name_tok),
                            diag.msg("sema.242", "{0} に引数 '{1}' はありません", [copy(subject), copy(arg.arg_name)]),
                            diag.msg0("sema.493", "この名前の引数は定義されていません"),
                            deftok, diag.msg0("sema.492", "この関数はここで定義されています"),
                            diag.msg("ssema.001", "書ける名前は {0} です", [copy(strings.join(pnames, " / "))]))
        if slot[at] is not None:
            dup: str = diag.msg0("sema.497", "同じ名前を 2 回書いています")
            if at < pos:
                dup = diag.msg0("sema.496", "位置で渡したものに、名前でもう一度渡しています")
            diag.error_full(unwrap_tok(arg.arg_name_tok),
                            diag.msg("sema.243", "引数 '{0}' に 2 回渡しています", [copy(arg.arg_name)]),
                            diag.msg0("sema.494", "2 回目です"),
                            unwrap_node(slot[at]).tok, diag.msg0("sema.495", "1 回目はここです"), dup)
        slot[at] = arg
        a = arg.next

    # ── ② 空いているところを既定値で埋める ──
    i3: int = 0
    while i3 < nparams:
        if slot[i3] is None:
            d: rc[ast.Node] | None = defaults[i3]
            if d is None:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.244", "{0} の引数 '{1}' が渡されていません", [copy(subject), copy(pnames[i3])]),
                                diag.msg("sema.245", "引数 '{0}' に当たるものがありません", [copy(pnames[i3])]),
                                deftok, diag.msg0("sema.492", "この関数はここで定義されています"),
                                diag.msg0("sema.498", "この引数には既定値がないので、呼ぶときに必ず書きます"))
            # ★ **呼び出しごとに複製**します（共有しません）。
            slot[i3] = ast.ast_clone(d)
        i3 = i3 + 1

    # ── ③ 定義の順に繋ぎ直す ──
    head: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, n.tok)
    cur: rc[ast.Node] = head
    i4: int = 0
    while i4 < nparams:
        s: rc[ast.Node] = unwrap_node(slot[i4])
        s.next = None
        # ★ 印はもう要りません（並びが答えになったので）。
        s.arg_name = ""
        cur.next = s
        cur = s
        i4 = i4 + 1
    n.args = head.next


# FuncSig を持つ呼び先（関数・メソッド・生成）はこちらを通します。
def bind_args_sig(n: mut rc[ast.Node], f: rc[types.FuncSig], skip: int,
                  subject: str) -> None:
    pnames: list[str] = []
    defaults: list[rc[ast.Node] | None] = []
    i: int = skip
    while i < f.nparams:
        pnames.append(copy(f.pnames[i]))
        if i < len(f.defaults):
            defaults.append(f.defaults[i])
        else:
            defaults.append(None)
        i = i + 1
    bind_args(n, f.nparams - skip, pnames, defaults, f.tok, subject, skip > 0)


# rc[T] / rc[T] | None（ownck の ty_is_rc と同じ判定）
def ty_is_rc_shared(t: rc[ast.Type]) -> bool:
    if t.kind == ast.TY_RC or t.kind == ast.TY_WEAK:   # weak も共有型（A-50）
        return True
    if t.kind == ast.TY_OPT:
        return ty_is_rc_shared(ast.elem_of(t))
    return False

class Builtin:
    name: str
    arg: int    # 引数の TypeKind
    ret: int    # 戻り値の TypeKind
    impl: str   # 呼び出すランタイム関数

    def init(self, name: str, arg: int, ret: int, impl: str) -> None:
        self.name = copy(name)
        self.arg = arg
        self.ret = ret
        self.impl = copy(impl)


# ── ジェネリクス（単相化） ─────────────────────────────
#
# 型引数の束縛（K → str）。注意: タプルが無いので 2 本の list を並べて持ちます。
# ★ **割り当て済みの IR 名の入れ物**。
#
#   注意: `list[str]` を直接フィールドに置くと、実体化のたびの「退避して戻す」が
#     **借りたものをフィールドに保存**（E-BORROW-3）になります。
#     `rc[UsedNames]` にすると共有として筋が通り、複製も起きません
#     （`rc[list[str]]` とは書けないので、クラスで包みます）。
class UsedNames:
    names: list[str]

    def init(self) -> None:
        self.names = []


class TBinds:
    names: list[str]
    types_: list[rc[ast.Type]]

    def init(self) -> None:
        self.names = []
        self.types_ = []

    def find(self, name: str) -> rc[ast.Type] | None:
        i: int = 0
        while i < len(self.names):
            if self.names[i] == name:
                return self.types_[i]
            i = i + 1
        return None


# 実体化したクラス 1 つぶん（本体の検査を後回しにするための記録）
class Instance:
    node: rc[ast.Node] | None
    owner: rc[types.ModuleSyms] | None
    binds: rc[TBinds] | None
    # ★ どこで要求されたか（エラーに添える）
    site: rc[token.Token] | None
    iname: str
    # ★ 関数の実体か（クラスでなく）
    is_func: bool

    def init(self, node: rc[ast.Node], owner: rc[types.ModuleSyms],
             binds: own rc[TBinds], site: rc[token.Token], iname: own str,
             is_func: bool) -> None:
        self.node = node
        self.owner = owner
        self.binds = binds
        self.site = site
        self.iname = iname
        self.is_func = is_func


# ★ match のガードと入れ子のパターン（A-48）で使う読み替え表と落ち先。
#   対になる定義: src/sema.c の Rename / Fallback
class Rename:
    from_: str
    to: str
    tok: rc[token.Token] | None

    def init(self, from_: own str, to: own str, tok: own rc[token.Token] | None) -> None:
        self.from_ = from_
        self.to = to
        self.tok = tok


class Fallback:
    rest: rc[ast.Node] | None
    used: int

    def init(self, rest: own rc[ast.Node] | None) -> None:
        self.rest = rest
        self.used = 0

    def take(mut self) -> rc[ast.Node] | None:
        r: rc[ast.Node] | None = self.rest
        if r is None:
            return None
        self.used = self.used + 1
        if self.used > 1:
            return ast.ast_clone(r)
        return r


def case_refutable(c: rc[ast.Node]) -> bool:
    if c.rhs is not None:
        return True
    pl: rc[ast.Node] | None = c.lhs
    if pl is not None:
        p: rc[ast.Node] = pl
        if p.kind == ast.ND_METHOD:
            a: rc[ast.Node] | None = p.args
            while a is not None:
                an: rc[ast.Node] = a
                if an.kind != ast.ND_VAR:
                    return True
                a = an.next
    return False


def same_case_key(a: rc[ast.Node], b: rc[ast.Node]) -> bool:
    ea: bool = a.kind == ast.ND_FIELD or a.kind == ast.ND_METHOD
    eb: bool = b.kind == ast.ND_FIELD or b.kind == ast.ND_METHOD
    if ea or eb:
        return ea and eb and len(a.name) > 0 and a.name == b.name
    if a.kind == ast.ND_INT and b.kind == ast.ND_INT:
        return a.ival == b.ival
    if a.kind == ast.ND_STR and b.kind == ast.ND_STR:
        return a.sval == b.sval
    return False


def count_args(pat: rc[ast.Node] | None) -> int:
    k: int = 0
    if pat is not None:
        p: rc[ast.Node] = pat
        if p.kind == ast.ND_METHOD:
            a: rc[ast.Node] | None = p.args
            while a is not None:
                an: rc[ast.Node] = a
                k = k + 1
                a = an.next
    return k


def new_block_of(t: rc[token.Token] | None, body: rc[ast.Node] | None) -> rc[ast.Node]:
    b: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, t)
    b.body = body
    return b


# ガードの中の名前を読み替える
def rename_expr(n0: rc[ast.Node] | None, rn: list[rc[Rename]]) -> None:
    n: rc[ast.Node] | None = n0
    while n is not None:
        nn: rc[ast.Node] = n
        if nn.kind == ast.ND_VAR and len(nn.mod_name) == 0:
            for r in rn:
                if nn.name == r.from_:
                    nn.name = copy(r.to)
                    break
        rename_expr(nn.lhs, rn)
        rename_expr(nn.rhs, rn)
        rename_expr(nn.els, rn)
        rename_expr(nn.args, rn)
        rename_expr(nn.body, rn)
        n = nn.next


# ★ 失敗しうる関数の値は、別の場所で呼ばれる先（spawn / lock）へ渡せない（A-49）。
#   対になる定義: src/sema.c の reject_raising_fn
def reject_raising_fn(at: rc[ast.Node], ft: rc[ast.Type], where: str) -> None:
    if ft.kind != ast.TY_FN or len(ft.err_classes) == 0:
        return
    diag.error_full(unwrap_tok(at.tok),
                    diag.msg("sema.621", "'{0}' は失敗しうる関数なので、{1} に渡せません", [copy(ast.type_name(ft)), copy(where)]),
                    diag.msg0("sema.622", "渡した先には、エラーを受け止める相手がいません"), None, "",
                    diag.msg0("sema.623", "関数の中で try を使ってエラーを受け止めてください"))


# 値ごと写して捕まえる型（A-43）。対になる定義: src/sema.c の capture_by_value
def capture_by_value(t: rc[ast.Type]) -> bool:
    if t.kind == ast.TY_INT or t.kind == ast.TY_FLOAT or t.kind == ast.TY_BOOL:
        return True
    if t.kind == ast.TY_ENUM:
        e0: rc[ast.EnumDef] | None = t.en
        if e0 is None:
            return True
        return not unwrap_enumdef(e0).has_payload
    return False


# 関数型の「形」（引数・戻り型・raises）が同じか。fn と closure の違いは見ない（A-51）
#   対になる定義: src/sema.c の fn_shape_equal
def fn_shape_equal(a: rc[ast.Type], b: rc[ast.Type]) -> bool:
    tmp: rc[ast.Type] = rc(ast.Type(a.kind))
    for p in b.params:
        tmp.params.append(p)
    tmp.elem = b.elem
    for ec in b.err_classes:
        tmp.err_classes.append(ec)
    return ast.type_equal(a, tmp)


class Sema:
    prims: ast.Prims | None
    scope: rc[types.Scope] | None
    loop_depth: int
    scope_depth: int   # scope: の中にいる深さ（0 なら外）
    # ★ 'result' が「戻り値そのもの」を指すのは、**ensures の式の中だけ**
    #   （この処理系自身が result という局所変数を何か所も使っている）。
    #   対になる定義: src/sema.c の ensures_depth
    ensures_depth: int
    used: rc[UsedNames]                 # 割り当て済みの IR 名（関数ごとにリセット）
    cur_func: rc[types.FuncSig] | None
    cur: rc[types.ModuleSyms] | None        # 今検査中のモジュール
    mods: list[rc[types.ModuleSyms]]        # 全モジュール（依存順）
    expected: rc[ast.Type] | None         # 今この式に期待されている型
    builtins: list[Builtin]

    # ── エラー処理 ──
    # ★ 0 は「エラー無し」に予約し、1 から連番。割り当て順は
    #   「モジュールの依存順 → 出現順」（error-handling.md §4）。
    err_classes: list[rc[ast.Class]]
    try_stack: list[rc[ast.Node]]

    # ── ジェネリクス ──
    next_slot: int                # 次に振る vtable のスロット番号
    tbind: rc[TBinds] | None          # 今有効な型引数の束縛
    pending: list[Instance]       # 本体をあとで検査する実体
    # ★ いま検査しているのが「どこで要求された実体か」。
    #   注意: テンプレートの中で出たエラーはライブラリの中の行を指すので、
    #     使う側のどの行が発端かを添える。
    inst_site: rc[token.Token] | None
    inst_name: str

    # ★ sema が作る隠し変数の連番（A-41 の match）。
    #   注意: この言語は同名の変数を隠せないので、名前は**必ず一意**にします。
    hidden: int

    def init(self) -> None:
        self.prims = ast.Prims()
        self.hidden = 0
        self.loop_depth = 0
        self.scope_depth = 0
        self.ensures_depth = 0
        self.used = rc(UsedNames())
        self.mods = []
        self.err_classes = []
        self.try_stack = []
        self.tbind = None
        self.pending = []
        self.next_slot = 0
        self.inst_site = None
        self.inst_name = ""
        self.builtins = [
            Builtin("print", ast.TY_INT, ast.TY_NONE, "pl_print_int"),
            Builtin("print", ast.TY_STR, ast.TY_NONE, "pl_print_str"),
            Builtin("print", ast.TY_BOOL, ast.TY_NONE, "pl_print_bool"),
            Builtin("print", ast.TY_FLOAT, ast.TY_NONE, "pl_print_float"),
            Builtin("len", ast.TY_STR, ast.TY_INT, "pl_str_len"),
            Builtin("len", ast.TY_LIST, ast.TY_INT, "pl_list_len"),
            Builtin("str", ast.TY_INT, ast.TY_STR, "pl_str_from_int"),
            Builtin("str", ast.TY_BOOL, ast.TY_STR, "pl_str_from_bool"),
            Builtin("str", ast.TY_FLOAT, ast.TY_STR, "pl_str_from_float"),
            # ★ str(str) は複製。f-string が型を知らずに包めるように
            Builtin("str", ast.TY_STR, ast.TY_STR, "pl_str_copy"),
            Builtin("int", ast.TY_STR, ast.TY_INT, "pl_str_to_int"),
            # ★ float(str)。CSV を読むのに要ります
            Builtin("float", ast.TY_STR, ast.TY_FLOAT, "pl_str_to_float"),
            # int ↔ float。注意: 暗黙変換はしないので必ずここを通す
            Builtin("int", ast.TY_FLOAT, ast.TY_INT, "pl_int_from_float"),
            Builtin("float", ast.TY_INT, ast.TY_FLOAT, "pl_float_from_int"),
            Builtin("ord", ast.TY_STR, ast.TY_INT, "pl_ord"),
            # ★ range の増分が変数のとき、for の脱糖が 1 回だけ呼びます（A-46）。
            #   注意: 名前に '.' があるので、利用者のコードからは書けません。
            Builtin("range.step", ast.TY_INT, ast.TY_INT, "pl_range_step"),
            Builtin("chr", ast.TY_INT, ast.TY_STR, "pl_chr"),
            Builtin("exit", ast.TY_INT, ast.TY_NONE, "pl_exit"),
            Builtin("panic", ast.TY_STR, ast.TY_NONE, "pl_panic"),
            # ★ 借りたものを保存したいときの逃げ道（決定 D8）
            # ★ Python で最も使う組み込み
            Builtin("abs", ast.TY_INT, ast.TY_INT, "pl_iabs"),
            Builtin("abs", ast.TY_FLOAT, ast.TY_FLOAT, "pl_fabs"),
            Builtin("sum", ast.TY_LIST, ast.TY_INT, "pl_list_sum"),
            # ★ ハッシュ。**単相化のおかげで**ジェネリックなコードの
            #   中で hash(k) と書ける（K が確定してから型検査されるため）
            Builtin("hash", ast.TY_STR, ast.TY_INT, "pl_hash_str"),
            Builtin("hash", ast.TY_INT, ast.TY_INT, "pl_hash_i64"),
            Builtin("hash", ast.TY_FLOAT, ast.TY_INT, "pl_hash_f64"),
            Builtin("hash", ast.TY_BOOL, ast.TY_INT, "pl_hash_i64"),
            # ★ input(プロンプト) — Python と同じ形。
            #   注意: EOF では panic する。読めないかもしれない場面では
            #     io.read_line()（None が返る）を使うこと。
            Builtin("input", ast.TY_STR, ast.TY_STR, "pl_input"),
            # ★ copy は**型ごとに出すものが変わる**ので、この表では扱いません
            #   （A-44。check_call の中で 1 か所にまとめてあります）。
            Builtin("input", ast.TY_STR, ast.TY_STR, "pl_input")]

    # ── プリミティブ型のシングルトン ────────────────────────

    def prim(self, kind: int) -> rc[ast.Type]:
        p: ast.Prims | None = self.prims
        if p is None:
            panic(diag.msg0("ssema.002", "sema: prims が初期化されていません"))
            return rc(ast.Type(kind))
        if kind == ast.TY_INT:
            return unwrap_type(p.int_)
        if kind == ast.TY_BOOL:
            return unwrap_type(p.bool_)
        if kind == ast.TY_NONE:
            return unwrap_type(p.none_)
        if kind == ast.TY_STR:
            return unwrap_type(p.str_)
        if kind == ast.TY_FLOAT:
            return unwrap_type(p.float_)
        if kind == ast.TY_NULL:
            return unwrap_type(p.null_)
        panic(diag.msg0("ssema.003", "sema: 未知のプリミティブ型"))
        return rc(ast.Type(kind))

    def ty_int(self) -> rc[ast.Type]:
        return self.prim(ast.TY_INT)

    def ty_bool(self) -> rc[ast.Type]:
        return self.prim(ast.TY_BOOL)

    def ty_none(self) -> rc[ast.Type]:
        return self.prim(ast.TY_NONE)

    def ty_str(self) -> rc[ast.Type]:
        return self.prim(ast.TY_STR)

    def ty_float(self) -> rc[ast.Type]:
        return self.prim(ast.TY_FLOAT)

    def ty_null(self) -> rc[ast.Type]:
        return self.prim(ast.TY_NULL)

    def type_from_name(self, name: str) -> rc[ast.Type] | None:
        if name == "int":
            return self.ty_int()
        if name == "bool":
            return self.ty_bool()
        if name == "None":
            return self.ty_none()
        if name == "str":
            return self.ty_str()
        if name == "float":
            return self.ty_float()
        return None

    # ── モジュールの出入り ──────────────────────────

    def enter_module(mut self, ms: rc[types.ModuleSyms]) -> None:
        cur: rc[types.ModuleSyms] | None = self.cur
        if cur is not None:
            cur.globals = self.scope
        self.cur = ms
        self.scope = ms.globals

    def cur_syms(self) -> rc[types.ModuleSyms]:
        c: rc[types.ModuleSyms] | None = self.cur
        if c is None:
            panic(diag.msg0("ssema.004", "sema: 現在のモジュールがありません"))
            return rc(types.ModuleSyms(None))
        else:
            return c

    def cur_mod(self) -> rc[module.Module]:
        m: rc[module.Module] | None = self.cur_syms().mod
        if m is None:
            panic(diag.msg0("ssema.005", "sema: モジュールがありません"))
            return rc(module.Module("", "", ""))
        else:
            return m

    # import しているモジュールを名前で引く
    def lookup_import(self, name: str) -> rc[types.ModuleSyms] | None:
        m: rc[module.Module] = self.cur_mod()
        i: int = 0
        while i < len(m.deps):
            if m.deps[i].name == name:
                return self.syms_of(m.deps[i])
            i = i + 1
        return None

    def syms_of(self, m: rc[module.Module]) -> rc[types.ModuleSyms] | None:
        i: int = 0
        while i < len(self.mods):
            ms: rc[types.ModuleSyms] = self.mods[i]
            mm: rc[module.Module] | None = ms.mod
            if mm is not None:
                # ★ 絞り込みは「受け取った側で 1 回」。ここでは if を分ける
                if mm == m:
                    return ms
            i = i + 1
        return None

    # ── 表を引く ────────────────────────────────────────────

    def lookup_func_in(self, ms: rc[types.ModuleSyms], name: str) -> rc[types.FuncSig] | None:
        f: rc[types.FuncSig] | None = ms.funcs
        while f is not None:
            if f.name == name:
                return f
            f = f.next
        return None

    # ── インタフェースを引く ────────────────────────────
    def lookup_iface_in(self, ms: rc[types.ModuleSyms], name: str) -> rc[ast.Iface] | None:
        i: rc[ast.Iface] | None = ms.ifaces
        while i is not None:
            x: rc[ast.Iface] = i
            if x.name == name:
                return x
            i = x.next
        return None

    def lookup_iface(self, name: str) -> rc[ast.Iface] | None:
        return self.lookup_iface_in(self.cur_syms(), name)

    # ── 列挙（A-37）の表 ──────────────────────────────────
    #   対になる定義: src/sema.c の lookup_enum_in / lookup_enum
    def lookup_enum_in(self, ms: rc[types.ModuleSyms],
                       name: str) -> rc[ast.EnumDef] | None:
        e: rc[ast.EnumDef] | None = ms.enums
        while e is not None:
            ee: rc[ast.EnumDef] = e
            if ee.name == name:
                return ee
            e = ee.next
        return None

    def lookup_enum(self, name: str) -> rc[ast.EnumDef] | None:
        return self.lookup_enum_in(self.cur_syms(), name)

    # ── 範囲型（部分型。A-28）の表 ────────────────────────
    #   対になる定義: src/sema.c の lookup_range_in / lookup_range
    def lookup_range_in(self, ms: rc[types.ModuleSyms],
                        name: str) -> rc[types.RangeTy] | None:
        r: rc[types.RangeTy] | None = ms.ranges
        while r is not None:
            rr: rc[types.RangeTy] = r
            if rr.name == name:
                return rr
            r = rr.next
        return None

    def lookup_range(self, name: str) -> rc[types.RangeTy] | None:
        return self.lookup_range_in(self.cur_syms(), name)

    def lookup_class_in(self, ms: rc[types.ModuleSyms], name: str) -> rc[ast.Class] | None:
        c: rc[ast.Class] | None = ms.classes
        while c is not None:
            if c.name == name:
                return c
            c = c.next
        return None

    def lookup_global_in(self, ms: rc[types.ModuleSyms],
                         name: str) -> rc[types.VarEntry] | None:
        sc: rc[types.Scope] | None = ms.globals
        if sc is None:
            return None
        v: rc[types.VarEntry] | None = sc.vars
        while v is not None:
            if v.name == name:
                return v
            v = v.next
        return None

    def lookup_func(self, name: str) -> rc[types.FuncSig] | None:
        return self.lookup_func_in(self.cur_syms(), name)

    def lookup_func_by_ir(self, ir_name: str) -> rc[types.FuncSig] | None:
        f: rc[types.FuncSig] | None = self.cur_syms().funcs
        while f is not None:
            if f.ir_name == ir_name:
                return f
            f = f.next
        return None

    def lookup_class(self, name: str) -> rc[ast.Class] | None:
        return self.lookup_class_in(self.cur_syms(), name)

    def lookup_field(self, c: rc[ast.Class], name: str) -> rc[ast.Field] | None:
        f: rc[ast.Field] | None = c.fields
        while f is not None:
            if f.name == name:
                return f
            f = f.next
        return None

    def mangle(self, prefix: str, name: str) -> str:
        return prefix + "." + name

    def mod_mangle(self, name: str) -> str:
        return self.mangle(self.cur_mod().name, name)

    # ── スコープ ────────────────────────────────────────────

    def scope_push(mut self) -> None:
        self.scope = rc(types.Scope(self.scope))

    def scope_pop(mut self) -> None:
        sc: rc[types.Scope] | None = self.scope
        if sc is not None:
            self.scope = sc.parent

    def lookup_local(self, name: str) -> rc[types.VarEntry] | None:
        sc: rc[types.Scope] | None = self.scope
        if sc is None:
            return None
        v: rc[types.VarEntry] | None = sc.vars
        while v is not None:
            if v.name == name:
                return v
            v = v.next
        return None

    # 内側から外側へ順に探す（名前解決）
    def lookup(self, name: str) -> rc[types.VarEntry] | None:
        sc: rc[types.Scope] | None = self.scope
        while sc is not None:
            v: rc[types.VarEntry] | None = sc.vars
            while v is not None:
                if v.name == name:
                    return v
                v = v.next
            sc = sc.parent
        return None

    # ── IR 名の割り当て ───────────────────────────────

    def name_used(self, name: str) -> bool:
        # 注意: "entry" は予約する。LLVM はラベルとローカル値が
        #   同じ名前空間にいるので、関数先頭の `entry:` と衝突します。
        if name == "entry":
            return True
        i: int = 0
        while i < len(self.used.names):
            if self.used.names[i] == name:
                return True
            i = i + 1
        return False

    def unique_ir_name(mut self, name: str) -> str:
        if not self.name_used(name):
            self.used.names.append(copy(name))
            return copy(name)
        i: int = 1
        while True:
            cand: str = name + "." + str(i)
            if not self.name_used(cand):
                self.used.names.append(copy(cand))
                return cand
            i = i + 1
        return copy(name)

    # ★ モジュール名と同じ名前は宣言できない
    def reject_module_name(self, name: str, tok: rc[token.Token] | None,
                           what: str) -> None:
        if self.lookup_import(name) is None:
            return
        diag.error_full(unwrap_tok(tok),
                        diag.msg("sema.001", "'{0}' は import したモジュールの名前です", [copy(name)]),
                        diag.msg("sema.002", "この名前の{0}は宣言できません", [copy(what)]), None, "",
                        diag.msg("sema.003", "モジュール名と同じ名前を使うと '{0}.x' が曖昧になります", [copy(name)]))

    # ローカル変数として登録する（IR 名は %x 形式）
    def declare(mut self, name: str, t: rc[ast.Type],
                tok: rc[token.Token] | None) -> rc[types.VarEntry]:
        self.reject_module_name(name, tok, diag.msg0("sema.366", "変数"))

        v: rc[types.VarEntry] = rc(types.VarEntry(name, tok))
        v.ir_name = "%" + self.unique_ir_name(name)
        v.declared = t
        v.type = t

        sc: rc[types.Scope] | None = self.scope
        if sc is None:
            panic(diag.msg0("ssema.006", "sema: スコープがありません"))
        else:
            v.next = sc.vars
            sc.vars = v
        return v

    # ── 型注釈の解決 ────────────────────────────────────────

    # ★ T | None を包む層
    def resolve_type(mut self, tr: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ 関数型 fn(A, B) -> C
        # ★ closure(A, B) -> C も同じ形（A-51）
        if (tr.name == "fn" or tr.name == "closure") and len(tr.mod_name) == 0:
            fkind: int = ast.TY_FN
            if tr.name == "closure":
                fkind = ast.TY_CLOSURE
            ft: rc[ast.Type] = rc(ast.Type(fkind))
            a: rc[ast.Node] | None = tr.body
            while a is not None:
                an: rc[ast.Node] = a
                ft.params.append(self.resolve_type(an))
                a = an.next
            ft.elem = self.resolve_type(unwrap_node(tr.rhs))
            # ★ 投げうるエラー（A-49）。関数定義の raises と同じ規則で解決する
            #   対になる定義: src/sema.c の resolve_type
            if tr.err_types is not None:
                ftmp: rc[types.FuncSig] = rc(types.FuncSig("fn", tr.tok))
                self.resolve_raises(tr, ftmp)
                for ec in ftmp.raises_cls:
                    ft.err_classes.append(ec)
            return ft

        base: rc[ast.Type] = self.resolve_base_type(tr)
        if not tr.nullable:
            return base

        if not ast.type_can_be_opt(base):
            diag.error_full(unwrap_tok(tr.tok),
                            diag.msg("sema.006", "'{0} | None' は書けません", [copy(ast.type_name(base))]),
                            diag.msg0("sema.368", "この型は None になれません"), None, "",
                            diag.msg0("sema.369", "None はヌルポインタとして表すので、int や bool には付けられません（nullable にできるのは str / list[T] / class です）"))
        return ast.type_opt(base)

    # ── ジェネリクス（単相化） ─────────────────────────
    #
    # ★ 方針は design/generics-and-interfaces.md §1 のとおり **単相化**。
    #   Dict[str, int] と Dict[str, Symbol] は **別々のクラス**を作る。

    # ── ジェネリック関数 ──────────────────────────────
    #
    # ★ クラスと違い、**呼び出し側の実引数から型引数を決める**。
    #   左辺の型からは決められないため（f(xs) の左辺は戻り値の型しかない）。
    #
    # ★ 見るのは「T そのもの」「list[T] / rc[T] の中身」「fn(A) -> B」、
    #   そして **Box[T] のようなジェネリッククラスの型引数**。
    #   決められなければエラーにする。
    def unify_tparam(self, name: str, decl_tr: rc[ast.Node] | None,
                     actual: rc[ast.Type]) -> rc[ast.Type] | None:
        if decl_tr is None:
            return None
        tr: rc[ast.Node] = decl_tr

        # T そのもの
        if tr.name == name and tr.lhs is None:
            return actual
        # ★ 関数型 fn(A) -> B。**引数と戻り型の両方**を見る。
        #   これが無いと map_to[T, U](xs: list[T], f: fn(T) -> U) の U が
        #   決められない（U は f の戻り型にしか現れない）。
        if tr.name == "fn" and actual.kind == ast.TY_FN:
            fi: int = 0
            fa: rc[ast.Node] | None = tr.body
            while fa is not None:
                fan: rc[ast.Node] = fa
                if fi < len(actual.params):
                    got: rc[ast.Type] | None = self.unify_tparam(name, fan,
                                                             actual.params[fi])
                    if got is not None:
                        return got
                fi = fi + 1
                fa = fan.next
            if tr.rhs is not None and actual.elem is not None:
                return self.unify_tparam(name, tr.rhs, ast.elem_of(actual))
            return None

        # ★ ジェネリックなクラス Box[T] → 実体に渡された型引数を見る。
        #   これが無いと、集合演算のような「自分で作った容器を受け取る関数」が
        #   1 つも書けない（def union[T](a: Set[T], b: Set[T])）。
        # 注意: 突き合わせるのは**名前だけ**（モジュールは見ない）。
        #   対になる定義: src/sema.c の unify_tparam
        if tr.targs is not None and actual.kind == ast.TY_CLASS:
            acls: rc[ast.Class] | None = actual.cls
            if acls is not None:
                atmpl: rc[ast.Class] | None = acls.from_template
                if atmpl is not None and atmpl.name == tr.name:
                    ti: int = 0
                    ta: rc[ast.Node] | None = tr.targs
                    while ta is not None:
                        tan: rc[ast.Node] = ta
                        if ti < len(acls.targs_of):
                            g2: rc[ast.Type] | None = self.unify_tparam(
                                name, tan.lhs, acls.targs_of[ti])
                            if g2 is not None:
                                return g2
                        ti = ti + 1
                        ta = tan.next
                    return None

        # list[T] / rc[T] → 中身を見る
        if tr.lhs is not None and actual.elem is not None:
            return self.unify_tparam(name, tr.lhs, ast.elem_of(actual))
        return None

    # 型参照に書かれた型引数を並べる
    def collect_targs(mut self, tr: rc[ast.Node]) -> list[rc[ast.Type]]:
        out: list[rc[ast.Type]] = []
        a: rc[ast.Node] | None = tr.targs
        while a is not None:
            an: rc[ast.Node] = a
            out.append(self.resolve_type(unwrap_node(an.lhs)))
            a = an.next
        return out

    # 実体の名前を作る（Dict$str$int）
    #
    # 注意: 型名をそのまま使うと '[' や ',' が混ざって IR の名前に使えない。
    #   英数字と '.' 以外を '_' に潰す。
    def mangle_inst(self, base: str, args: list[rc[ast.Type]]) -> str:
        parts: list[str] = []
        parts.append(copy(base))
        for a in args:
            parts.append("$")
            nm: str = ast.type_name(a)
            i: int = 0
            while i < len(nm):
                ch: str = nm[i]
                b: int = strings.byte_at(nm, i)
                ok: bool = ((b >= 97 and b <= 122) or (b >= 65 and b <= 90) or
                            (b >= 48 and b <= 57) or ch == "." or ch == "_")
                if ok:
                    parts.append(ch)
                else:
                    parts.append("_")
                i = i + 1
        return strings.join(parts, "")

    # テンプレートから実体を 1 つ作る（既にあれば作らない）
    def instantiate_class(mut self, tmpl: rc[ast.Class], args: list[rc[ast.Type]],
                          at: rc[token.Token]) -> rc[ast.Type]:
        tnode: rc[ast.Node] = unwrap_node(tmpl.node)
        want: int = 0
        tp: rc[ast.Node] | None = tnode.targs
        while tp is not None:
            want = want + 1
            tp = unwrap_node(tp).next
        if len(args) != want:
            diag.error_full(at,
                            diag.msg("sema.007", "'{0}' は型引数を {1} 個取りますが、{2} 個書かれました", [copy(tmpl.name), copy(str(want)), copy(str(len(args)))]),
                            diag.msg0("sema.370", "型引数の個数が違います"), tmpl.tok,
                            diag.msg0("sema.371", "このクラスの定義です"), "")

        iname: str = self.mangle_inst(tmpl.name, args)

        owner: rc[types.ModuleSyms] = self.syms_by_name(tmpl.owner_name)

        # 既に作ってあれば、それを返す（同じ組み合わせは 1 個だけ）
        ex: rc[ast.Class] | None = self.lookup_class_in(owner, iname)
        if ex is not None:
            return unwrap_type(ex.type)

        # ★ テンプレートが定義されているモジュールに実体を作る。
        #   メソッドの本体はそのモジュールの名前しか参照しないため。
        #   注意: 型引数は **Type として**渡すので、名前解決は要らない。
        saved_mod: rc[types.ModuleSyms] = self.cur_syms()
        saved_scope: rc[types.Scope] | None = self.scope
        saved_tbind: rc[TBinds] | None = self.tbind
        saved_func: rc[types.FuncSig] | None = self.cur_func
        saved_used: rc[UsedNames] = self.used

        self.enter_module(owner)

        binds: rc[TBinds] = rc(TBinds())
        i2: int = 0
        tp2: rc[ast.Node] | None = tnode.targs
        while tp2 is not None:
            tpn: rc[ast.Node] = tp2
            binds.names.append(copy(tpn.name))
            binds.types_.append(args[i2])
            i2 = i2 + 1
            tp2 = tpn.next
        self.tbind = binds

        # 木を複製して、名前を実体のものに差し替える
        inst: rc[ast.Node] = unwrap_node(ast.ast_clone(tnode))
        inst.name = copy(iname)
        inst.targs = None            # ★ 実体はもうテンプレートではない
        inst.next = None

        self.declare_class(inst)
        icls: rc[ast.Class] | None = inst.cls
        if icls is not None:
            icls.from_template = tmpl
            # ★ 渡された型引数を覚える（unify_tparam が入れ子をたどる）
            ai: int = 0
            while ai < len(args):
                icls.targs_of.append(args[ai])
                ai = ai + 1
        self.declare_class_members(inst)
        ty: rc[ast.Type] = unwrap_type(inst.type)

        # ★ codegen が拾えるように、そのモジュールの AST に足す
        omod: rc[module.Module] | None = owner.mod
        root: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, None)
        if omod is None:
            panic(diag.msg0("ssema.005", "sema: モジュールがありません"))
        else:
            root = unwrap_node(omod.ast)
        last: rc[ast.Node] = unwrap_node(root.body)
        nx: rc[ast.Node] | None = last.next
        while nx is not None:
            last = nx
            nx = last.next
        last.next = inst

        self.pending.append(Instance(inst, owner, binds, at, copy(iname), False))

        self.enter_module(saved_mod)
        self.scope = saved_scope
        self.cur_func = saved_func
        self.used = saved_used
        self.tbind = saved_tbind
        return ty

    def resolve_base_type(mut self, tr: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ モジュール修飾された型注釈
        if len(tr.mod_name) > 0:
            ms: rc[types.ModuleSyms] | None = self.lookup_import(tr.mod_name)
            if ms is None:
                diag.error_full(unwrap_tok(tr.tok),
                                diag.msg("sema.009", "モジュール '{0}' を import していません", [copy(tr.mod_name)]),
                                diag.msg0("sema.372", "この修飾を解決できません"), None, "",
                                diag.msg("sema.010", "ファイルの先頭に 'import {0}' を書いてください", [copy(tr.mod_name)]))
                return self.ty_int()
            # ★ 他のモジュールの範囲型（A-28）
            mr: rc[types.RangeTy] | None = self.lookup_range_in(ms, tr.name)
            if mr is not None:
                mrr: rc[types.RangeTy] = mr
                if tr.lhs is not None:
                    diag.error_at_hint(unwrap_tok(tr.tok),
                                       diag.msg0("sema.012", "範囲型は要素型を取りません"),
                                       diag.msg("sema.011", "型 '{0}.{1}' は要素型を取りません", [copy(tr.mod_name), copy(tr.name)]))
                return unwrap_type(mrr.type)

            # ★ 他のモジュールの列挙（A-37）
            men: rc[ast.EnumDef] | None = self.lookup_enum_in(ms, tr.name)
            if men is not None:
                mene: rc[ast.EnumDef] = men
                if tr.lhs is not None:
                    diag.error_at_hint(unwrap_tok(tr.tok),
                                       diag.msg0("sema.013", "列挙は要素型を取りません"),
                                       diag.msg("sema.011", "型 '{0}.{1}' は要素型を取りません", [copy(tr.mod_name), copy(tr.name)]))
                return unwrap_type(mene.type)

            # ★ 他のモジュールのインタフェース
            mif: rc[ast.Iface] | None = self.lookup_iface_in(ms, tr.name)
            if mif is not None:
                return ast.type_iface(mif.name, mif)

            c: rc[ast.Class] | None = self.lookup_class_in(ms, tr.name)
            if c is None:
                diag.error_full(unwrap_tok(tr.tok),
                                diag.msg("sema.014", "モジュール '{0}' にクラス '{1}' はありません", [copy(tr.mod_name), copy(tr.name)]),
                                diag.msg0("sema.373", "このクラスは定義されていません"), None, "",
                                diag.msg0("sema.374", "他のモジュールから使えるのはクラスだけです（int や list はモジュール修飾なしで書きます）"))
                return self.ty_int()
            # ★ 他のモジュールのジェネリッククラスも実体化できる
            if c.node is not None and unwrap_node(c.node).targs is not None:
                return self.instantiate_class(c, self.collect_targs(tr),
                                              unwrap_tok(tr.tok))
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.037", "要素型を取るのは list と rc だけです"),
                                   diag.msg("sema.011", "型 '{0}.{1}' は要素型を取りません", [copy(tr.mod_name), copy(tr.name)]))
            return unwrap_type(c.type)

        if tr.name == "list":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.017", "要素型を書いてください（例: list[int]）"),
                                   diag.msg0("sema.016", "list には要素型が必要です"))
                return self.ty_int()
            elem: rc[ast.Type] = self.resolve_type(unwrap_node(tr.lhs))
            if elem.kind == ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.019", "None 型の値は存在しないので要素にできません"),
                                   diag.msg0("sema.018", "list の要素型に None は使えません"))
            return ast.type_list(elem)

        # ── rc[T]（共有所有）──
        #
        # ★ 中身に取れるのはクラスだけ（共有したくなるのは木やグラフの節点）
        if tr.name == "rc":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.025", "中身の型を書いてください（例: rc[Node]）"),
                                   diag.msg0("sema.024", "rc には中身の型が必要です"))
                return self.ty_int()
            rel: rc[ast.Type] = self.resolve_type(unwrap_node(tr.lhs))
            if rel.kind != ast.TY_CLASS:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.027", "rc に入れられるのはクラスだけです（例: rc[Node]）"),
                                   diag.msg("sema.026", "'{0}' は rc に入れられません", [copy(ast.type_name(rel))]))
            return ast.type_rc(rel)

        # ── weak[T]（弱参照。A-50）── rc[T] と同じく中身はクラスだけ
        #   対になる定義: src/sema.c の resolve_base_type
        if tr.name == "weak":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.627", "中身の型を書いてください（例: weak[Node]）"),
                                   diag.msg0("sema.626", "weak には中身の型が必要です"))
                return self.ty_int()
            wel: rc[ast.Type] = self.resolve_type(unwrap_node(tr.lhs))
            if wel.kind != ast.TY_CLASS:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.629", "weak に入れられるのはクラスだけです（例: weak[Node]）"),
                                   diag.msg("sema.628", "'{0}' は weak にできません", [copy(ast.type_name(wel))]))
            return ast.type_weak(wel)

        # ── Thread[R] / mutex[T]（A-18）──
        #
        # ★ Thread[R] の R は**戻り型**。spawn した関数が返すものを join が返す。
        if tr.name == "Thread":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.029", "戻り型を書いてください（例: Thread[int]）"),
                                   diag.msg0("sema.028", "Thread には戻り型が必要です"))
                return self.ty_int()
            return ast.type_thread(self.resolve_type(unwrap_node(tr.lhs)))

        # ★ mutex に入れられるのはクラスとリストだけ（取り出して書き換える
        #   ものだから。int を包んでも lock に渡した関数から書き戻せません）
        # ── ptr[T]（生ポインタ。A-33）──
        #
        # ★ 中身に取れるのは int だけ（C 版 src/sema.c と同じ）。
        #   注意: こちらは**受け渡しだけ**を扱います（unsafe: の中の読み書きは
        #     C 版だけが持ちます）。C のライブラリへ配列の先頭を渡すために要ります。
        if tr.name == "ptr":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.021", "中身の型を書いてください（例: ptr[int]）"),
                                   diag.msg0("sema.020", "ptr には中身の型が必要です"))
                return self.ty_int()
            pel: rc[ast.Type] = self.resolve_type(unwrap_node(tr.lhs))
            if pel.kind != ast.TY_INT:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.023", "いま ptr に書けるのは int だけです（例: ptr[int]）"),
                                   diag.msg("sema.022", "'{0}' は ptr に入れられません", [copy(ast.type_name(pel))]))
            return ast.type_ptr(pel)

        if tr.name == "mutex":
            if tr.lhs is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.031", "中身の型を書いてください（例: mutex[Counter]）"),
                                   diag.msg0("sema.030", "mutex には中身の型が必要です"))
                return self.ty_int()
            mel: rc[ast.Type] = self.resolve_type(unwrap_node(tr.lhs))
            if mel.kind != ast.TY_CLASS and mel.kind != ast.TY_LIST:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.033", "mutex に入れられるのはクラスかリストだけです（例: mutex[Counter] / mutex[list[float]]）"),
                                   diag.msg("sema.032", "'{0}' は mutex に入れられません", [copy(ast.type_name(mel))]))
            return ast.type_mutex(mel)

        # ★ タプル型 (A, B)
        if tr.name == "(tuple)":
            tt: rc[ast.Type] = rc(ast.Type(ast.TY_TUPLE))
            tai: rc[ast.Node] | None = tr.targs
            while tai is not None:
                tan: rc[ast.Node] = tai
                et: rc[ast.Type] = self.resolve_type(unwrap_node(tan.lhs))
                if et.kind == ast.TY_NONE:
                    diag.error_at_hint(unwrap_tok(tan.tok),
                                       diag.msg0("sema.019", "None 型の値は存在しないので要素にできません"),
                                       diag.msg0("sema.038", "タプルの要素に None は使えません"))
                tt.params.append(et)
                tai = tan.next
            return tt

        # ★ 型引数の名前（class Dict[K, V] の K）。
        #   注意: **クラス名より先に**引く。テンプレートを読む間だけ有効。
        tb: rc[TBinds] | None = self.tbind
        if tb is not None:
            tv: rc[ast.Type] | None = tb.find(tr.name)
            if tv is not None:
                if tr.lhs is not None:
                    diag.error_at_hint(unwrap_tok(tr.tok),
                                       diag.msg0("sema.035", "型引数そのものは型引数を取りません"),
                                       diag.msg("sema.034", "型 '{0}' は型引数を取りません", [copy(tr.name)]))
                return tv

        t: rc[ast.Type] | None = self.type_from_name(tr.name)
        if t is not None:
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.037", "要素型を取るのは list と rc だけです"),
                                   diag.msg("sema.036", "型 '{0}' は要素型を取りません", [copy(tr.name)]))
            return t

        # ★ 範囲型（部分型。A-28）。クラス名より先に引く
        rt: rc[types.RangeTy] | None = self.lookup_range(tr.name)
        if rt is not None:
            rtt: rc[types.RangeTy] = rt
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.012", "範囲型は要素型を取りません"),
                                   diag.msg("sema.036", "型 '{0}' は要素型を取りません", [copy(tr.name)]))
            return unwrap_type(rtt.type)

        # ★ 列挙（A-37）。クラス名より先に引く
        en1: rc[ast.EnumDef] | None = self.lookup_enum(tr.name)
        if en1 is not None:
            en1e: rc[ast.EnumDef] = en1
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.013", "列挙は要素型を取りません"),
                                   diag.msg("sema.036", "型 '{0}' は要素型を取りません", [copy(tr.name)]))
            return unwrap_type(en1e.type)

        # ★ インタフェース名も型として書ける（list[Show] など）
        ifc1: rc[ast.Iface] | None = self.lookup_iface(tr.name)
        if ifc1 is not None:
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.039", "インタフェースは型引数を取りません"),
                                   diag.msg("sema.034", "型 '{0}' は型引数を取りません", [copy(tr.name)]))
            return ast.type_iface(ifc1.name, ifc1)

        # ★ 組み込みの型名で無ければ、クラス名として引く
        c2: rc[ast.Class] | None = self.lookup_class(tr.name)
        if c2 is not None:
            # ★ ジェネリッククラスなら、ここで実体を作る
            if c2.node is not None and unwrap_node(c2.node).targs is not None:
                return self.instantiate_class(c2, self.collect_targs(tr),
                                              unwrap_tok(tr.tok))
            if tr.lhs is not None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.037", "要素型を取るのは list と rc だけです"),
                                   diag.msg("sema.036", "型 '{0}' は要素型を取りません", [copy(tr.name)]))
            return unwrap_type(c2.type)

        diag.error_full(unwrap_tok(tr.tok), diag.msg("sema.040", "未知の型名 '{0}' です", [copy(tr.name)]),
                        diag.msg0("sema.375", "この型は存在しません"), None, "",
                        diag.msg("sema.041", "現在使える型: {0}、および定義したクラス名", [copy(ast.type_name_list())]))
        return self.ty_int()

    # ★ 同名の別クラスだったときは、モジュール修飾つきで説明する
    def no_implicit_hint(self, got: rc[ast.Type], want: rc[ast.Type]) -> str:
        if got.kind == ast.TY_CLASS and want.kind == ast.TY_CLASS:
            gc: rc[ast.Class] | None = got.cls
            wc: rc[ast.Class] | None = want.cls
            # 注意: 'and' の左で絞った変数を、同じ条件式の右では使えません
            #    （絞り込みが効くのは本体から）。if を分けます。
            if gc is not None:
                if wc is not None:
                    if gc.name == wc.name:
                        return (diag.msg("sema.042", "'{0}' と '{1}' は名前が同じだけの別のクラスです（同じ型かどうかは名前ではなく定義で決まります）", [copy(gc.ir_name), copy(wc.ir_name)]))
        # ★ 関数型どうしなら、**どこが違うのか**を言う。
        #   「暗黙の型変換がありません」では何を直せばよいか分からない。
        # ★ closure と fn（A-51）。形が同じなら、違うのは「持ち運べるか」だけ
        gfn: bool = got.kind == ast.TY_FN or got.kind == ast.TY_CLOSURE
        wfn: bool = want.kind == ast.TY_FN or want.kind == ast.TY_CLOSURE
        if gfn and wfn and got.kind != want.kind and fn_shape_equal(got, want):
            if got.kind == ast.TY_CLOSURE:
                return (diag.msg0("sema.643", "closure は fn の変数・フィールドには入れられません（持ち主がいなくなるため）。fn を受け取る引数へは、そのまま渡せます"))
            return (diag.msg0("sema.644", "fn の値は closure にできません。closure にできるのは lambda と def で書いた関数の名前です"))
        if gfn and got.kind == want.kind:
            if len(got.params) != len(want.params):
                return (diag.msg("sema.043", "引数の数が違います（{0} 個と {1} 個）", [copy(str(len(got.params))), copy(str(len(want.params)))]))
            fi: int = 0
            while fi < len(got.params):
                if not ast.type_equal(got.params[fi], want.params[fi]):
                    return (diag.msg("sema.044", "{0} 番目の引数の型が違います（'{1}' と '{2}'）", [copy(str(fi + 1)), copy(ast.type_name(got.params[fi])), copy(ast.type_name(want.params[fi]))]))
                fi = fi + 1
            # ★ 投げうるエラーが違う（A-49）
            if ast.type_equal(ast.elem_of(got), ast.elem_of(want)):
                if len(want.err_classes) == 0:
                    return (diag.msg("sema.624", "この関数は失敗しえます（'{0}'）。失敗しない関数の型には入りません", [copy(ast.type_name(got))]))
                return (diag.msg("sema.625", "投げうるエラーが違います。ここには '{0}' が必要です", [copy(ast.type_name(want))]))
            return (diag.msg("sema.045", "戻り型が違います（'{0}' と '{1}'）", [copy(ast.type_name(ast.elem_of(got))), copy(ast.type_name(ast.elem_of(want)))]))

        # ★ クラス → インタフェースなら、実装宣言の書き忘れを疑う
        if want.kind == ast.TY_IFACE and got.kind == ast.TY_CLASS:
            gc2: rc[ast.Class] | None = got.cls
            wi2: rc[ast.Iface] | None = want.iface
            if gc2 is not None and wi2 is not None:
                return (diag.msg("sema.046", "'{0}' が '{1}' を実装すると宣言していません（'class {2}({3}):' と書きます）", [copy(gc2.name), copy(wi2.name), copy(gc2.name), copy(wi2.name)]))

        return diag.msg0("sema.376", "本言語には暗黙の型変換がありません（言語仕様 3.5）")

    # ── 式の検査 ────────────────────────────────────────────

    # x is None / x is not None の検査
    def check_is(mut self, n: rc[ast.Node]) -> rc[ast.Type]:
        lhs: rc[ast.Node] = unwrap_node(n.lhs)
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        l: rc[ast.Type] = self.check_expr(lhs)

        if rhs.kind != ast.ND_NONE:
            r: rc[ast.Type] = self.check_expr(rhs)
            diag.error_full(unwrap_tok(rhs.tok),
                            diag.msg("sema.047", "{0} は None との比較にだけ使えます", [copy(ast.op_symbol(n.op))]),
                            diag.msg("sema.048", "ここには None を書いてください（型 '{0}' の式です）", [copy(ast.type_name(r))]), None, "",
                            diag.msg0("sema.377", "値が等しいかを調べるには == を使ってください"))
        rhs.type = self.ty_null()

        if l.kind != ast.TY_OPT:
            hint: str = diag.msg0("sema.379", "None になれるのは str / list[T] / class だけです")
            if ast.type_can_be_opt(l):
                hint = (diag.msg("sema.050", "None を入れたいなら、型注釈を '{0} | None' にしてください", [copy(ast.type_name(l))]))
            diag.error_full(unwrap_tok(lhs.tok),
                            diag.msg("sema.049", "型 '{0}' の値が None になることはありません", [copy(ast.type_name(l))]),
                            diag.msg0("sema.378", "この式は必ず値を持ちます"), None, "", hint)
        return self.ty_bool()

    # 二項演算子が、その型に適用できるか
    def op_supports(self, op: int, t: rc[ast.Type]) -> bool:
        if t.kind == ast.TY_CLASS:
            return op == ast.OP_EQ or op == ast.OP_NE
        # ★ list は連結（+）と繰り返し（*）ができる
        if t.kind == ast.TY_LIST:
            return (op == ast.OP_EQ or op == ast.OP_NE or
                    op == ast.OP_ADD or op == ast.OP_MUL)
        if t.kind == ast.TY_OPT or t.kind == ast.TY_NULL:
            return False
        if ast.is_compare(op):
            return True
        if t.kind == ast.TY_INT:
            return op != ast.OP_TRUEDIV
        # ★ float は int のちょうど裏返し。'/' が使えて '//' '%' とビット演算が使えない
        #   ★ '**' は float でも使える。ランタイムに pl_fpow を自前で
        #     置いた（libc の pow はベアメタルで使えないため）。
        if t.kind == ast.TY_FLOAT:
            return (op == ast.OP_ADD or op == ast.OP_SUB or
                    op == ast.OP_MUL or op == ast.OP_TRUEDIV or
                    op == ast.OP_POW)
        # ★ str は連結（+）と繰り返し（*）
        if t.kind == ast.TY_STR:
            return op == ast.OP_ADD or op == ast.OP_MUL
        return False

    # 「ここには bool が必要」というエラー
    def bool_required(self, message: str, where_label: str,
                      where_tok: rc[token.Token] | None, operand: rc[ast.Node],
                      actual: rc[ast.Type]) -> rc[ast.Type]:
        diag.error_full(unwrap_tok(operand.tok), message,
                        diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(actual))]),
                        where_tok, where_label,
                        diag.msg0("sema.380", "本言語は int を真偽値として扱いません（言語仕様 4.4）。比較を書いてください（例: x != 0）"))
        return self.ty_bool()

    # x in xs / sub in s
    #
    # ★ 右辺の型で意味が変わります。list[T] なら要素に等しいものがあるか、
    #   str なら部分文字列として含まれるか。
    # 注意: dict には使えません（d.has(k) を使う）。
    def check_in(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        l: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
        r: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))

        # ★ `k in d` は `d.__contains__(k)` に読み替える。
        #   注意: ここだけは **右辺の型**で決まる（入れ物のほうが決める）。
        #     Python の __contains__ と同じで、in は「入れ物に聞く」演算子。
        if r.kind == ast.TY_CLASS:
            cc: rc[ast.Class] = unwrap_class(r.cls)
            if self.class_has_method(cc, "__contains__"):
                obj: rc[ast.Node] = unwrap_node(n.rhs)   # 入れ物
                arg: rc[ast.Node] = unwrap_node(n.lhs)   # 探すもの
                arg.next = None

                # 注意: ノードの中身を丸ごと写すと式の並び（実引数の next）が
                #   壊れる。**その場で作り替える。**
                if n.op == ast.OP_IN:
                    n.kind = ast.ND_METHOD
                    n.name = "__contains__"
                    n.lhs = obj
                    n.args = arg
                    n.rhs = None
                    rt: rc[ast.Type] = self.check_class_method(n, cc)
                    if rt.kind != ast.TY_BOOL:
                        diag.error_at(unwrap_tok(n.tok),
                                      diag.msg("sema.068", "'in' に使うには __contains__ が bool を返す必要があります（いまは '{0}' を返しています）", [copy(ast.type_name(rt))]))
                    return self.ty_bool()

                # not in は結果を反転させる
                call: rc[ast.Node] = ast.new_node(ast.ND_METHOD, n.tok)
                call.lhs = obj
                call.name = "__contains__"
                call.args = arg
                rt2: rc[ast.Type] = self.check_class_method(call, cc)
                if rt2.kind != ast.TY_BOOL:
                    diag.error_at(unwrap_tok(n.tok),
                                  diag.msg("sema.069", "'not in' に使うには __contains__ が bool を返す必要があります（いまは '{0}' を返しています）", [copy(ast.type_name(rt2))]))
                call.type = rt2
                n.kind = ast.ND_UNARY
                n.op = ast.OP_NOT
                n.lhs = call
                n.rhs = None
                return self.ty_bool()

        if r.kind == ast.TY_STR:
            if l.kind != ast.TY_STR:
                diag.error_at(unwrap_tok(n.tok),
                              diag.msg("sema.070", "str の 'in' には str が必要です（左辺は '{0}' 型です）", [copy(ast.type_name(l))]))
            return self.ty_bool()
        if r.kind == ast.TY_LIST:
            if not ast.type_assignable(l, ast.elem_of(r)):
                diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                                diag.msg0("sema.385", "'in' の左辺が要素の型と合いません"),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(l))]),
                                unwrap_node(n.rhs).tok,
                                diag.msg("sema.071", "こちらの要素は '{0}' 型です", [copy(ast.type_name(ast.elem_of(r)))]), "")
            return self.ty_bool()

        diag.error_full(unwrap_tok(unwrap_node(n.rhs).tok),
                        diag.msg("sema.072", "'{0}' 型に 'in' は使えません", [copy(ast.type_name(r))]),
                        diag.msg0("sema.386", "ここには list[T] か str が必要です"), None, "",
                        self.in_hint(r))
        return self.ty_bool()

    # 'in' が使えないときのヒント
    def in_hint(self, r: rc[ast.Type]) -> str:
        if r.kind == ast.TY_CLASS:
            return (diag.msg("sema.073", "クラス '{0}' に '__contains__(self, x) -> bool' を定義すると、'in' が使えます", [copy(unwrap_class(r.cls).name)]))
        return diag.msg0("sema.387", "dict の鍵を調べるには d.has(k) を使ってください")

    # 三項演算子 a if c else b
    def check_ternary(mut self, n: rc[ast.Node]) -> rc[ast.Type]:
        c: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
        if c.kind != ast.TY_BOOL:
            self.bool_required(diag.msg0("sema.388", "三項演算子の条件には bool が必要です"),
                               diag.msg0("sema.389", "この 'if' の条件です"), n.tok,
                               unwrap_node(n.lhs), c)

        a: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))
        b: rc[ast.Type] = self.check_expr(unwrap_node(n.els))

        # ★ どちらかが None リテラルなら、もう一方に合わせる
        if ast.type_assignable(b, a):
            return a
        if ast.type_assignable(a, b):
            return b

        diag.error_full(unwrap_tok(unwrap_node(n.els).tok),
                        diag.msg0("sema.390", "三項演算子の両側で型が違います"),
                        diag.msg("sema.074", "こちらは '{0}' 型です", [copy(ast.type_name(b))]),
                        unwrap_node(n.rhs).tok,
                        diag.msg("sema.074", "こちらは '{0}' 型です", [copy(ast.type_name(a))]),
                        diag.msg0("sema.391", "式の型は 1 つに決まらなければなりません（どちらかを合わせてください）"))
        return a

    # xs[a:b] / s[a:b]。注意: **新しい値を作ります**（借用ではない）
    # タプル式 a, b
    #
    # ★ 期待型（左辺や戻り型）が分かっていれば、それに合わせて要素を検査する。
    #   分からなければ、そのまま要素の型を並べたタプルになる。
    def check_tuple(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        want: rc[ast.Type] | None = self.expected
        n_elems: int = 0
        ei: rc[ast.Node] | None = n.body
        while ei is not None:
            en: rc[ast.Node] = ei
            n_elems = n_elems + 1
            ei = en.next

        has_want: bool = False
        wt: rc[ast.Type] = self.ty_int()
        if want is not None:
            wt = want
            if wt.kind == ast.TY_TUPLE:
                has_want = True

        if has_want and len(wt.params) != n_elems:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.060", "タプルの要素の数が違います（{0} 個と {1} 個）", [copy(str(n_elems)), copy(str(len(wt.params)))]),
                            diag.msg("sema.061", "ここは {0} 個です", [copy(str(n_elems))]), None, "",
                            diag.msg("sema.062", "'{0}' が必要です", [copy(ast.type_name(wt))]))

        t: rc[ast.Type] = rc(ast.Type(ast.TY_TUPLE))
        k: int = 0
        xi: rc[ast.Node] | None = n.body
        while xi is not None:
            xn: rc[ast.Node] = xi
            if has_want:
                self.expected = wt.params[k]
            else:
                self.expected = None
            et: rc[ast.Type] = self.check_expr(xn)
            self.expected = None
            if has_want:
                if not ast.type_assignable(et, wt.params[k]):
                    diag.error_full(unwrap_tok(xn.tok),
                                    diag.msg("sema.063", "タプルの {0} 番目の型が合いません", [copy(str(k + 1))]),
                                    diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(et))]),
                                    None, "",
                                    diag.msg("sema.064", "ここには '{0}' が必要です", [copy(ast.type_name(wt.params[k]))]))
                t.params.append(wt.params[k])
            else:
                t.params.append(et)
            k = k + 1
            xi = xn.next
        return t

    def check_slice(mut self, n: rc[ast.Node]) -> rc[ast.Type]:
        t: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
        if t.kind != ast.TY_STR and t.kind != ast.TY_LIST:
            diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                            diag.msg("sema.065", "'{0}' 型はスライスできません", [copy(ast.type_name(t))]),
                            diag.msg0("sema.384", "ここには str か list[T] が必要です"), None, "", "")
        if n.rhs is not None:
            a: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))
            if a.kind != ast.TY_INT:
                diag.error_at(unwrap_tok(unwrap_node(n.rhs).tok),
                              diag.msg("sema.066", "スライスの開始は int です（'{0}' 型でした）", [copy(ast.type_name(a))]))
        if n.els is not None:
            b: rc[ast.Type] = self.check_expr(unwrap_node(n.els))
            if b.kind != ast.TY_INT:
                diag.error_at(unwrap_tok(unwrap_node(n.els).tok),
                              diag.msg("sema.067", "スライスの終端は int です（'{0}' 型でした）", [copy(ast.type_name(b))]))
        return t

    # ── 演算子の多重定義 ──────────────────────────────
    #
    # ★ `a + b` の左辺がクラスで、そのクラスに `__add__` があれば
    #   **`a.__add__(b)` に読み替える。** 読み替えるのは意味解析だけで、
    #   codegen と IR は 1 行も変えていない（ふつうのメソッド呼び出しになる）。
    #
    # 注意: **反転（`__radd__`）は無い。** `2.0 * m` は書けない（`m * 2.0` と書く）。
    def op_method_name(self, op: int) -> str:
        if op == ast.OP_ADD:
            return "__add__"
        if op == ast.OP_SUB:
            return "__sub__"
        if op == ast.OP_MUL:
            return "__mul__"
        if op == ast.OP_TRUEDIV:
            return "__truediv__"
        if op == ast.OP_FLOORDIV:
            return "__floordiv__"
        if op == ast.OP_MOD:
            return "__mod__"
        if op == ast.OP_POW:
            return "__pow__"
        if op == ast.OP_EQ:
            return "__eq__"
        if op == ast.OP_NE:
            return "__ne__"
        if op == ast.OP_LT:
            return "__lt__"
        if op == ast.OP_LE:
            return "__le__"
        if op == ast.OP_GT:
            return "__gt__"
        if op == ast.OP_GE:
            return "__ge__"
        return ""

    # そのクラスにそのメソッドがあるか
    def class_has_method(mut self, c: rc[ast.Class], name: str) -> bool:
        owner: rc[types.ModuleSyms] = self.syms_by_name(c.owner_name)
        return self.lookup_func_in(owner, self.mangle(c.name, name)) is not None

    # n（ND_BINOP）を n.lhs.name(n.rhs) の呼び出しに作り替える
    def rewrite_to_method(mut self, n: mut rc[ast.Node], c: rc[ast.Class],
                          name: str) -> rc[ast.Type]:
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        rhs.next = None
        n.kind = ast.ND_METHOD
        n.name = copy(name)
        n.args = rhs
        n.rhs = None
        return self.check_class_method(n, c)

    def check_binop(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ in / not in は「両辺が同じ型」ではないので先に分岐
        if n.op == ast.OP_IN or n.op == ast.OP_NOTIN:
            return self.check_in(n)

        # ★ is / is not は型の合わせ方が違うので先に分岐
        if n.op == ast.OP_IS or n.op == ast.OP_ISNOT:
            return self.check_is(n)

        lhs: rc[ast.Node] = unwrap_node(n.lhs)
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        l: rc[ast.Type] = self.check_expr(lhs)

        # ★ 左辺がクラスなら、演算子は多重定義を探す。
        #   注意: 右辺はここでは検査しない。**メソッドの引数として**
        #     check_class_method が検査する（2 回検査しないため）。
        if l.kind == ast.TY_CLASS:
            lc: rc[ast.Class] = unwrap_class(l.cls)
            mn: str = self.op_method_name(n.op)
            if mn != "" and self.class_has_method(lc, mn):
                return self.rewrite_to_method(n, lc, mn)

            # ★ `!=` は `__ne__` が無ければ `not (a == b)` に読み替える
            #   （Python と同じ。`__eq__` だけ書けば両方使える）。
            if n.op == ast.OP_NE and self.class_has_method(lc, "__eq__"):
                call: rc[ast.Node] = ast.new_node(ast.ND_METHOD, n.tok)
                call.lhs = lhs
                call.name = "__eq__"
                rhs.next = None
                call.args = rhs
                rt: rc[ast.Type] = self.check_class_method(call, lc)
                if rt.kind != ast.TY_BOOL:
                    diag.error_at(unwrap_tok(n.tok),
                                  diag.msg("sema.052", "'!=' に使うには __eq__ が bool を返す必要があります（いまは '{0}' を返しています）", [copy(ast.type_name(rt))]))
                call.type = rt
                n.kind = ast.ND_UNARY
                n.op = ast.OP_NOT
                n.lhs = call
                n.rhs = None
                return self.ty_bool()

        r: rc[ast.Type] = self.check_expr(rhs)

        # ★ 繰り返し（"ab" * 3 / [0] * 3）だけは両辺の型が違う。
        #   注意: 3 * "ab"（左右が逆）は認めない（「何を何回」の順を固定する）
        if n.op == ast.OP_MUL and r.kind == ast.TY_INT:
            if l.kind == ast.TY_STR or l.kind == ast.TY_LIST:
                return l

        # ★ 検査は 2 段構え（型システム 5.3）
        if not ast.type_equal(l, r):
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.053", "型 '{0}' と '{1}' に演算子 '{2}' は適用できません", [copy(ast.type_name(l)), copy(ast.type_name(r)), copy(ast.op_symbol(n.op))]),
                            diag.msg0("sema.381", "この演算子の両辺の型が違います"), None, "",
                            self.no_implicit_hint(l, r))

        if not self.op_supports(n.op, l):
            if n.op == ast.OP_TRUEDIV:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.055", "切り捨て除算の '//' を使ってください（本言語には暗黙の型変換がないため、'/' は float 専用です）"),
                                   diag.msg0("sema.054", "整数の除算に '/' は使えません"))
            # ★ クラスなら「多重定義すれば書ける」ことを示す
            if l.kind == ast.TY_CLASS and self.op_method_name(n.op) != "":
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg("sema.057", "クラス '{0}' に '{1}(self, other) -> …' を定義すると、この演算子が使えます", [copy(unwrap_class(l.cls).name), copy(self.op_method_name(n.op))]),
                                   diag.msg("sema.056", "型 '{0}' に演算子 '{1}' は適用できません", [copy(ast.type_name(l)), copy(ast.op_symbol(n.op))]))
            diag.error_at(unwrap_tok(n.tok),
                          diag.msg("sema.056", "型 '{0}' に演算子 '{1}' は適用できません", [copy(ast.type_name(l)), copy(ast.op_symbol(n.op))]))

        # 0 除算のうち、右辺がリテラル 0 の場合はここで弾く
        if ((n.op == ast.OP_FLOORDIV or n.op == ast.OP_MOD) and
                rhs.kind == ast.ND_INT and rhs.ival == 0):
            diag.error_full(unwrap_tok(rhs.tok), diag.msg0("sema.382", "0 で除算しています"),
                            diag.msg0("sema.383", "この 0 で割ろうとしています"),
                            n.tok, diag.msg("sema.058", "演算子 '{0}' はここです", [copy(ast.op_symbol(n.op))]),
                            "")

        # ★ 比較は bool を返す。算術は両辺と同じ型を返す
        if ast.is_compare(n.op):
            return self.ty_bool()
        return l

    def check_logical(mut self, n: rc[ast.Node]) -> rc[ast.Type]:
        lhs: rc[ast.Node] = unwrap_node(n.lhs)
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        l: rc[ast.Type] = self.check_expr(lhs)

        # ★ 短絡評価するので、rhs は「lhs がある側に転んだとき」しか
        #   評価されません。その側の絞り込みを rhs の検査中だけ効かせます。
        #
        #     a is not None and a.v == 0   ← and の rhs は lhs が真のときだけ見る
        #     a is None     or  a.v == 0   ← or  の rhs は lhs が偽のときだけ見る
        #
        # 注意: 抜けたら必ず戻す（15.5 節と同じ「入る前に変えて、抜けたら戻す」）。
        svars: list[rc[types.VarEntry]] = []
        stypes: list[rc[ast.Type]] = []
        self.narrow_apply(lhs, n.op == ast.OP_AND, svars, stypes)
        r: rc[ast.Type] = self.check_expr(rhs)
        self.narrow_restore(svars, stypes)

        msg: str = diag.msg("sema.059", "演算子 '{0}' には bool が必要です", [copy(ast.op_symbol(n.op))])
        lbl: str = diag.msg("sema.058", "演算子 '{0}' はここです", [copy(ast.op_symbol(n.op))])
        if l.kind != ast.TY_BOOL:
            return self.bool_required(msg, lbl, n.tok, lhs, l)
        if r.kind != ast.TY_BOOL:
            return self.bool_required(msg, lbl, n.tok, rhs, r)
        return self.ty_bool()

    def check_unary(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        operand: rc[ast.Node] = unwrap_node(n.lhs)
        t: rc[ast.Type] = self.check_expr(operand)

        # not は bool を取り bool を返す
        if n.op == ast.OP_NOT:
            if t.kind != ast.TY_BOOL:
                return self.bool_required(
                    diag.msg("sema.059", "演算子 '{0}' には bool が必要です", [copy(ast.op_symbol(n.op))]),
                    diag.msg("sema.058", "演算子 '{0}' はここです", [copy(ast.op_symbol(n.op))]),
                    n.tok, operand, t)
            return self.ty_bool()

        # ★ クラスの単項マイナスは __neg__ に読み替える
        if t.kind == ast.TY_CLASS and n.op == ast.OP_NEG:
            uc: rc[ast.Class] = unwrap_class(t.cls)
            if self.class_has_method(uc, "__neg__"):
                n.kind = ast.ND_METHOD
                n.name = "__neg__"
                n.args = None
                return self.check_class_method(n, uc)

        # ★ float には - と + が使える（~ はビット演算なので int だけ）
        if t.kind == ast.TY_FLOAT:
            if n.op == ast.OP_NEG or n.op == ast.OP_POS:
                return t
            diag.error_at(unwrap_tok(n.tok),
                          diag.msg("sema.075", "型 '{0}' に単項演算子 '{1}' は適用できません", [copy(ast.type_name(t)), copy(ast.op_symbol(n.op))]))

        # - + ~ は int のみ
        if t.kind != ast.TY_INT:
            diag.error_at(unwrap_tok(n.tok),
                          diag.msg("sema.075", "型 '{0}' に単項演算子 '{1}' は適用できません", [copy(ast.type_name(t)), copy(ast.op_symbol(n.op))]))
        return t

    # FuncSig から関数型を作る
    def fn_type_of(self, f: rc[types.FuncSig]) -> rc[ast.Type]:
        t: rc[ast.Type] = rc(ast.Type(ast.TY_FN))
        for pt in f.params:
            t.params.append(pt)
        t.elem = f.ret
        # ★ raises する関数も値にできる（A-49）。投げうるエラーは型に載る
        for ec in f.raises_cls:
            t.err_classes.append(ec)
        return t

    def check_var(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        v: rc[types.VarEntry] | None = self.lookup(n.name)

        # ★ 契約（A-29）：ensures の式の中の 'result' は**戻り値そのもの**。
        #   注意: 局所変数のほうが先（result という名前の変数を壊さないため）。
        #   対になる定義: src/sema.c の check_var
        if v is None and self.ensures_depth > 0 and n.name == "result":
            cf: rc[types.FuncSig] | None = self.cur_func
            if cf is None:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("ssema.007", "関数の外では 'result' を書けません"),
                                   diag.msg0("ssema.008", "ここでは result を使えません"))
                return self.ty_int()
            cff: rc[types.FuncSig] = cf
            ret: rc[ast.Type] = unwrap_type(cff.ret)
            if ret.kind == ast.TY_NONE:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg0("sema.392", "戻り値の無い関数では 'result' を書けません"),
                                diag.msg0("sema.393", "この関数は値を返しません"), None, "",
                                diag.msg0("sema.394", "戻り値を見ない ensures（グローバルの条件など）にするか、戻り型を付けてください"))
            n.kind = ast.ND_RESULT   # ★ 箱は作らない（返す値をそのまま使う）
            n.type = ret
            return ret

        # ★ 変数に無ければ **関数を探す**（関数の名前を値にする）
        #   注意: 変数が先。同名の局所変数があればそちらが勝つ。
        if v is None:
            fs: rc[types.FuncSig] | None = self.lookup_func(n.name)
            # ★ lambda は**使う側の型**で実体になります（A-42）
            if fs is not None:
                fst: rc[ast.Node] | None = unwrap_sig(fs).tmpl
                if fst is not None and unwrap_node(fst).is_lambda:
                    shown: rc[ast.Type] | None = self.expected
                    fs = self.instantiate_lambda(unwrap_sig(fs), n)
                    if n.caps is not None:
                        # ★ 捕まえた値は**末尾の引数**として渡しますが、
                        #   **外から見える型には出しません**（A-43）。
                        n.ir_name = copy(unwrap_sig(fs).ir_name)
                        n.is_func_ref = True
                        n.type = shown
                        return unwrap_type(shown)
            if fs is not None and unwrap_sig(fs).tmpl is not None:
                # ジェネリック関数そのものは値にできません（型引数が決まらない）
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.076", "'{0}' は型引数を取る関数なので、値にできません", [copy(n.name)]),
                                diag.msg0("sema.395", "ここでは値として使えません"), None, "",
                                diag.msg0("sema.396", "値にするには型が 1 つに決まっている必要があります（呼び出しなら実引数から決まります）"))
            if fs is not None:
                n.ir_name = copy(fs.ir_name)
                n.is_func_ref = True
                fty: rc[ast.Type] = self.fn_type_of(fs)
                # ★ closure が要る場所なら、関数をヒープの記録に包む（A-51）
                ex: rc[ast.Type] | None = self.expected
                if ex is not None:
                    exn: rc[ast.Type] = ex
                    if exn.kind == ast.TY_CLOSURE and fn_shape_equal(fty, exn):
                        n.is_closure = True
                        return exn
                return fty

        if v is None:
            # ★ モジュール名そのものは値ではない
            if self.lookup_import(n.name) is not None:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.078", "モジュール '{0}' は値として使えません", [copy(n.name)]),
                                diag.msg0("sema.398", "ここにはモジュール名を書けません"), None, "",
                                diag.msg("sema.079", "モジュールの中身は '{0}.名前' の形で使います", [copy(n.name)]))

            # 同名のモジュールが存在するのに import していない場合
            if module.file_exists(self.cur_mod().dir, n.name):
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.009", "モジュール '{0}' を import していません", [copy(n.name)]),
                                diag.msg0("sema.399", "このモジュールはここからは見えません"), None, "",
                                diag.msg("sema.010", "ファイルの先頭に 'import {0}' を書いてください", [copy(n.name)]))

            # ★ lambda の中から外の変数を使おうとした場合（A-42）。
            #   持ち上げた先はトップレベルなので、外の名前は見えません。
            cf0: rc[types.FuncSig] | None = self.cur_func
            if cf0 is not None and unwrap_sig(cf0).is_lambda:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.080", "lambda の中から外の変数 '{0}' は使えません", [copy(n.name)]),
                                diag.msg0("sema.400", "この名前は lambda の外のものです"), None, "",
                                diag.msg0("sema.401", "捕獲（クロージャ）はまだありません。使う値は引数で受け取るか、def で書いた関数にしてください（グローバルなら使えます）"))
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.081", "未定義の名前 '{0}' です", [copy(n.name)]),
                            diag.msg0("sema.402", "この名前は宣言されていません"), None, "",
                            diag.msg("sema.082", "使う前に宣言してください（例: {0}: int = 0）", [copy(n.name)]))
            return self.ty_int()
        n.ir_name = copy(v.ir_name)
        # ★ 捕獲した lambda を入れた変数（A-51）。読んだ節点に捕獲を書き写す
        #   対になる定義: src/sema.c の check_var
        if v.caps is not None:
            n.caps = v.caps
        return unwrap_type(v.type)

    def check_expr(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        t: rc[ast.Type] = self.ty_int()
        if n.kind == ast.ND_ENUMTAG:
            # ★ 中身を持つ枝のタグ（A-41）。先頭の i64 を読むだけです。
            self.check_expr(unwrap_node(n.lhs))
            t = self.ty_int()
        elif n.kind == ast.ND_INT:
            # ★ 畳んだ列挙の枝（A-37）はここに来ます。**もう一度検査しても
            #   int に戻らない**ようにします（既定値は宣言の登録と本体の検査で
            #   2 度通ることがあり、2 度目に型が変わると「'int' を 'Level' に
            #   渡せません」という説明のつかないエラーになります）。
            en0: rc[ast.EnumDef] | None = n.en
            if en0 is None:
                t = self.ty_int()
            else:
                t = unwrap_type(en0.type)
        elif n.kind == ast.ND_FLOAT:
            t = self.ty_float()
        elif n.kind == ast.ND_COND:
            t = self.check_ternary(n)
        elif n.kind == ast.ND_SLICE:
            t = self.check_slice(n)
        elif n.kind == ast.ND_TUPLE:
            t = self.check_tuple(n)
        elif n.kind == ast.ND_BOOL:
            t = self.ty_bool()
        elif n.kind == ast.ND_STR:
            t = self.ty_str()
        elif n.kind == ast.ND_NONE:
            t = self.ty_null()
        elif n.kind == ast.ND_VAR:
            t = self.check_var(n)
        elif n.kind == ast.ND_BINOP:
            t = self.check_binop(n)
        elif n.kind == ast.ND_LOGICAL:
            t = self.check_logical(n)
        elif n.kind == ast.ND_CALL:
            t = self.check_call(n)
        elif n.kind == ast.ND_LIST:
            t = self.check_list_lit(n)
        elif n.kind == ast.ND_INDEX:
            t = self.check_index_expr(n)
        elif n.kind == ast.ND_METHOD:
            t = self.check_method(n)
        elif n.kind == ast.ND_FIELD:
            t = self.check_field(n)
        elif n.kind == ast.ND_UNARY:
            t = self.check_unary(n)
        elif n.kind == ast.ND_LISTCOMP:
            t = self.check_listcomp(n)
        else:
            panic(diag.msg0("ssema.009", "sema.check_expr: 式ではないノードです"))
        n.type = t
        return t

    # ── 文の検査 ────────────────────────────────────────────

    # ── 範囲型（部分型）の検査を挿す（A-28）────────────────
    #
    # ★ 「入れるとき」だけ確かめる（Ada と同じ）。途中の計算は基底型（int）で
    #   行うので、`p * 2` のたびに止まることはない。
    #
    # ★ 定数なら**コンパイル時に**断る。それ以外は ND_RANGECHK で包み、
    #   codegen が比較 2 つを出す。
    #
    # 注意: 仮引数はここでは包まない。呼び出し側は 5 通りあるので、関数の入口で
    #   1 回だけ確かめる（codegen の gen_func）。
    #   対になる定義: src/sema.c の range_coerce
    def range_coerce(mut self, val: rc[ast.Node] | None,
                     want: rc[ast.Type]) -> rc[ast.Node] | None:
        if val is None:
            return None
        if not ast.ty_is_range(want):
            return val
        v: rc[ast.Node] = val
        vt: rc[ast.Type] | None = v.type
        if vt is not None:
            vtt: rc[ast.Type] = vt
            # 同じ部分型なら確かめ済み（名前で見る。C 版はポインタ比較）
            if ast.ty_is_range(vtt) and vtt.name == want.name:
                return val

        # ★ 定数はコンパイル時に決まる
        if v.kind == ast.ND_INT:
            if v.ival < want.lo or v.ival > want.hi:
                diag.error_full(unwrap_tok(v.tok),
                                diag.msg("sema.004", "{0} は '{1}' の範囲（{2}..{3}）の外です", [copy(str(v.ival)), copy(want.name), copy(str(want.lo)), copy(str(want.hi))]),
                                diag.msg0("sema.367", "この値はこの型に入りません"), None, "",
                                diag.msg("sema.005", "'{0}' に入れられるのは {1} から {2} までです", [copy(want.name), copy(str(want.lo)), copy(str(want.hi))]))
            return val

        chk: rc[ast.Node] = ast.new_node(ast.ND_RANGECHK, v.tok)
        chk.lhs = v
        chk.type = want
        return chk

    def check_vardecl(mut self, n: mut rc[ast.Node]) -> None:
        # ① 型注釈を解決する（型注釈が無いのは for の脱糖）
        declared: rc[ast.Type] | None = None
        if n.type_ref is not None:
            d0: rc[ast.Type] = self.resolve_type(unwrap_node(n.type_ref))
            if d0.kind == ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.084", "None 型の値は存在しないので変数にできません"),
                                   diag.msg0("sema.083", "変数の型に None は使えません"))
            declared = d0

        # ② 同じスコープでの再宣言を禁止（言語仕様 5.1）
        prev: rc[types.VarEntry] | None = self.lookup_local(n.name)
        if prev is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.085", "変数 '{0}' は既に宣言されています", [copy(n.name)]),
                            diag.msg0("sema.403", "ここで再宣言されています"),
                            prev.decl_tok, diag.msg0("sema.404", "最初の宣言はここです"),
                            diag.msg0("sema.405", "既存の変数に代入するなら型注釈を外してください（例: x = 1）"))

        # ②' 外側のスコープの変数を隠していないか（シャドーイング禁止）
        outer: rc[types.VarEntry] | None = self.lookup(n.name)
        if outer is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.086", "変数 '{0}' は外側のスコープの変数を隠しています", [copy(n.name)]),
                            diag.msg0("sema.406", "シャドーイングは禁止されています（言語仕様 5.1）"),
                            outer.decl_tok, diag.msg0("sema.407", "外側の宣言はここです"),
                            diag.msg0("sema.408", "別の名前にするか、型注釈を外して既存の変数に代入してください（例: x = 1）"))

        # ③ 初期化式の型が宣言した型に代入できるか
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        self.expected = declared
        actual: rc[ast.Type] = self.check_expr(rhs)
        self.expected = None

        # 型注釈が無ければ、初期化式の型がそのまま変数の型になる
        if declared is None:
            if actual.kind == ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(rhs.tok),
                                   diag.msg0("sema.088", "値を返さない式は変数に入れられません"),
                                   diag.msg0("sema.087", "None 型の値は変数にできません"))
            declared = actual
        want: rc[ast.Type] = unwrap_type(declared)

        # ★ 見立て（A-41）。「enum の値を、当たった枝のクラスとして見る」宣言です。
        #   **ここだけ型検査を通します。** match が枝を確かめた直後にしか
        #   作らない（sema が組み立てる）ので、利用者は触れません。
        if n.is_enum_view and actual.kind == ast.TY_ENUM and want.kind == ast.TY_CLASS:
            vv0: rc[types.VarEntry] = self.declare(n.name, want, n.tok)
            n.ir_name = copy(vv0.ir_name)
            n.type = want
            return

        if not ast.type_assignable(actual, want):
            diag.error_full(unwrap_tok(rhs.tok), diag.msg0("sema.409", "型が一致しません"),
                            diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(actual))]),
                            n.tok,
                            diag.msg("sema.090", "変数 '{0}' は '{1}' 型として宣言されています", [copy(n.name), copy(ast.type_name(want))]),
                            self.no_implicit_hint(actual, want))

        # ★ 範囲型なら、入れる前に確かめる（A-28）
        n.rhs = self.range_coerce(n.rhs, want)

        # ④ スコープに登録する（★ 初期化式を検査した「後」に）
        v: rc[types.VarEntry] = self.declare(n.name, want, n.tok)
        n.ir_name = copy(v.ir_name)
        n.type = want
        rh: rc[ast.Node] | None = n.rhs
        if rh is not None:
            rhn: rc[ast.Node] = rh
            if rhn.caps is not None and not rhn.is_closure:
                v.caps = rhn.caps   # A-51

    def check_assign(mut self, n: mut rc[ast.Node]) -> None:
        target: rc[ast.Node] = unwrap_node(n.lhs)

        # 添字への代入 xs[i] = v
        if target.kind == ast.ND_INDEX:
            # ★ クラスへの代入は __setitem__ に読み替える。
            #   m[i, j] = v  →  m.__setitem__(i, j, v)
            #   注意: 読み替えるのは**代入文そのもの**（値まで実引数にするため）。
            tobj: rc[ast.Type] = self.check_expr(unwrap_node(target.lhs))
            if tobj.kind == ast.TY_CLASS:
                sc: rc[ast.Class] = unwrap_class(tobj.cls)
                if not self.class_has_method(sc, "__setitem__"):
                    diag.error_at_hint(unwrap_tok(target.tok),
                                       diag.msg("sema.092", "クラス '{0}' に '__setitem__(self, …, 値) -> None' を定義すると、添字への代入が使えます", [copy(sc.name)]),
                                       diag.msg("sema.091", "型 '{0}' の添字には代入できません", [copy(ast.type_name(tobj))]))
                args: rc[ast.Node] = unwrap_node(target.rhs)
                last: rc[ast.Node] = args
                while last.next is not None:
                    last = unwrap_node(last.next)
                val: rc[ast.Node] = unwrap_node(n.rhs)
                val.next = None
                last.next = val          # 最後の実引数は「代入する値」

                # 注意: **代入文のノードそのもの**を呼び出しにする
                #   （文の並び next を壊さないよう、入れ替えではなく上書き）。
                n.kind = ast.ND_METHOD
                n.tok = target.tok
                n.name = "__setitem__"
                n.lhs = target.lhs
                n.args = args
                n.rhs = None
                n.type = self.check_class_method(n, sc)
                return

            et: rc[ast.Type] = self.check_index_expr(target)
            target.type = et

            # 注意: タプルの要素には代入できない
            if tobj.kind == ast.TY_TUPLE:
                diag.error_at_hint(unwrap_tok(target.tok),
                                   diag.msg0("sema.094", "タプルは作ったら変わりません（新しいタプルを作ってください）"),
                                   diag.msg0("sema.093", "タプルの要素には代入できません"))

            # 注意: str は不変なので s[0] = "x" は書けない
            obj: rc[ast.Node] = unwrap_node(target.lhs)
            if unwrap_type(obj.type).kind == ast.TY_STR:
                diag.error_at_hint(unwrap_tok(target.tok),
                                   diag.msg0("sema.096", "str は不変（immutable）です。新しい文字列を作ってください"),
                                   diag.msg0("sema.095", "文字列の要素には代入できません"))

            self.expected = et
            av: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))
            self.reject_escaping_closure(n.rhs, diag.msg0("sema.410", "しまうことが"))   # A-43
            self.expected = None

            if not ast.type_assignable(av, et):
                diag.error_full(unwrap_tok(unwrap_node(n.rhs).tok),
                                diag.msg0("sema.409", "型が一致しません"),
                                diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(av))]),
                                target.tok,
                                diag.msg("sema.097", "この要素は '{0}' 型です", [copy(ast.type_name(et))]),
                                self.no_implicit_hint(av, et))
            n.rhs = self.range_coerce(n.rhs, et)   # A-28
            n.type = et
            return

        # フィールドへの代入 t.kind = v
        if target.kind == ast.ND_FIELD:
            ft: rc[ast.Type] = self.check_field(target)
            target.type = ft

            self.expected = ft
            av2: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))
            self.reject_escaping_closure(n.rhs, diag.msg0("sema.410", "しまうことが"))   # A-43
            self.expected = None

            if not ast.type_assignable(av2, ft):
                fld: rc[ast.Field] | None = target.field
                rel: rc[token.Token] | None = None
                rel_label: str = ""
                if fld is not None:
                    rel = fld.tok
                    rel_label = (diag.msg("sema.098", "フィールド '{0}' は '{1}' 型として宣言されています", [copy(fld.name), copy(ast.type_name(ft))]))
                diag.error_full(unwrap_tok(unwrap_node(n.rhs).tok),
                                diag.msg0("sema.409", "型が一致しません"),
                                diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(av2))]),
                                rel, rel_label, self.no_implicit_hint(av2, ft))
            n.rhs = self.range_coerce(n.rhs, ft)   # A-28
            n.type = ft
            return

        if target.kind != ast.ND_VAR:
            panic(diag.msg0("ssema.010", "sema: 代入先が変数ではありません"))

        v: rc[types.VarEntry] | None = self.lookup(target.name)
        if v is None:
            diag.error_full(unwrap_tok(target.tok),
                            diag.msg("sema.099", "未定義の名前 '{0}' に代入しています", [copy(target.name)]),
                            diag.msg0("sema.402", "この名前は宣言されていません"), None, "",
                            diag.msg("sema.100", "初めて使うときは型注釈が必要です（例: {0}: int = 0）", [copy(target.name)]))
            return
        target.type = v.type
        target.ir_name = copy(v.ir_name)

        # ★ 代入できるかは「宣言された型」で判定する
        declared2: rc[ast.Type] = unwrap_type(v.declared)
        self.expected = declared2
        actual2: rc[ast.Type] = self.check_expr(unwrap_node(n.rhs))
        # ★ グローバルは枠より長生きするので、捕獲した lambda は入れられません（A-43）
        gv0: rc[types.VarEntry] | None = self.lookup(target.name)
        if gv0 is not None and gv0.is_global:
            self.reject_escaping_closure(n.rhs, diag.msg0("sema.410", "しまうことが"))
        # ★ 借りて捕まえた lambda は**宣言でだけ**受け取れる（A-51）
        #   対になる定義: src/sema.c の check_assign
        arhs: rc[ast.Node] = unwrap_node(n.rhs)
        if arhs.caps is not None and not arhs.is_closure:
            cq: rc[ast.Node] | None = arhs.caps
            while cq is not None:
                cqn: rc[ast.Node] = cq
                if not capture_by_value(unwrap_type(cqn.type)):
                    diag.error_full(unwrap_tok(arhs.tok),
                                    diag.msg("sema.639", "'{0}' を借りて捕まえた lambda は、代入では受け取れません", [copy(cqn.name)]),
                                    diag.msg0("sema.640", "ここで既にある変数へ入れています"),
                                    cqn.tok, diag.msg("sema.251", "'{0}' を捕まえています", [copy(cqn.name)]),
                                    diag.msg0("sema.641", "新しい変数の宣言で受け取ってください（例: f2: fn(int) -> int = lambda x: …）"))
                cq = cqn.next
            if gv0 is not None:
                gvv: rc[types.VarEntry] = gv0
                gvv.caps = arhs.caps
        self.expected = None
        if not ast.type_assignable(actual2, declared2):
            diag.error_full(unwrap_tok(unwrap_node(n.rhs).tok), diag.msg0("sema.409", "型が一致しません"),
                            diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(actual2))]),
                            v.decl_tok,
                            diag.msg("sema.090", "変数 '{0}' は '{1}' 型として宣言されています", [copy(v.name), copy(ast.type_name(declared2))]),
                            self.no_implicit_hint(actual2, declared2))

        n.rhs = self.range_coerce(n.rhs, declared2)   # A-28

        # ★ 代入したら絞り込みは解除する（15.5 節）
        v.type = declared2
        target.type = declared2
        n.type = declared2

    # 条件式は bool でなければならない
    def check_cond(mut self, where: str, stmt_node: rc[ast.Node], cond: mut rc[ast.Node]) -> None:
        t: rc[ast.Type] = self.check_expr(cond)
        if t.kind != ast.TY_BOOL:
            self.bool_required(diag.msg("sema.101", "{0}には bool が必要です", [copy(where)]), diag.msg("sema.102", "{0}はここです", [copy(where)]),
                               stmt_node.tok, cond, t)

    # ── 絞り込み（narrowing） ───────────────────────────

    def narrow_one(self, var_node: rc[ast.Node], saved: mut list[rc[types.VarEntry]],
                   saved_types: mut list[rc[ast.Type]]) -> None:
        if var_node.kind != ast.ND_VAR:
            return
        v: rc[types.VarEntry] | None = self.lookup(var_node.name)
        if v is None:
            return
        if v.is_global:
            return                       # グローバルは絞らない
        vt: rc[ast.Type] = unwrap_type(v.type)
        if vt.kind != ast.TY_OPT:
            return
        saved.append(v)
        saved_types.append(vt)
        v.type = ast.elem_of(vt)         # ★ ここだけ Token になる

    def narrow_apply(self, cond: rc[ast.Node] | None, positive: bool,
                     saved: mut list[rc[types.VarEntry]],
                     saved_types: mut list[rc[ast.Type]]) -> None:
        if cond is None:
            return
        c: rc[ast.Node] = cond
        if c.kind == ast.ND_BINOP and c.op == ast.OP_ISNOT and positive:
            self.narrow_one(unwrap_node(c.lhs), saved, saved_types)
        elif c.kind == ast.ND_BINOP and c.op == ast.OP_IS and not positive:
            self.narrow_one(unwrap_node(c.lhs), saved, saved_types)
        elif c.kind == ast.ND_LOGICAL and c.op == ast.OP_AND and positive:
            self.narrow_apply(c.lhs, True, saved, saved_types)
            self.narrow_apply(c.rhs, True, saved, saved_types)
        elif c.kind == ast.ND_LOGICAL and c.op == ast.OP_OR and not positive:
            # ★ ド・モルガン。
            #   not(a or b) = (not a) and (not b) なので、成り立たない側では両方絞れる。
            #
            #     if b is None or c is None:
            #         return 0
            #     # ← ここでは b も c も None ではない
            #
            # 注意: 「成り立つ側」の or は相変わらず絞れない（一方しか保証されない）。
            self.narrow_apply(c.lhs, False, saved, saved_types)
            self.narrow_apply(c.rhs, False, saved, saved_types)

    def narrow_restore(self, saved: mut list[rc[types.VarEntry]],
                       saved_types: list[rc[ast.Type]]) -> None:
        i: int = 0
        while i < len(saved):
            saved[i].type = saved_types[i]
            i = i + 1

    # 文の並びを順に検査する（ガード節の絞り込みを含む）
    def check_stmt_list(mut self, first: mut rc[ast.Node] | None) -> None:
        gvars: list[rc[types.VarEntry]] = []
        gtypes: list[rc[ast.Type]] = []

        st: rc[ast.Node] | None = first
        while st is not None:
            self.check_stmt(st)
            if (st.kind == ast.ND_IF and st.els is None and
                    self.always_returns(st.body)):
                self.narrow_apply(st.lhs, False, gvars, gtypes)
            st = st.next

        self.narrow_restore(gvars, gtypes)

    def check_block(mut self, n: mut rc[ast.Node]) -> None:
        self.scope_push()
        self.check_stmt_list(n.body)
        self.scope_pop()


    # ── scope: から途中で抜けることを禁じる ──────────────────
    #
    # なぜ禁じるのか
    #   scope: の出口には「まだ待っていないスレッドを全部 join する」という
    #   仕事がある。**途中から抜ける道があると、その仕事が飛ぶ。**
    #   飛ぶと、まだ走っているスレッドが借りている値の寿命が切れる
    #   — つまり scoped spawn の根拠そのものが崩れる。
    #
    # 注意: ループの中の break / continue は、そのループが scope: の**中**に
    #    あるなら問題ない（外へは出ないため）。
    def scope_escape(mut self, first: rc[ast.Node] | None, loop_depth: int,
                     try_depth: int) -> None:
        q: rc[ast.Node] | None = first
        while q is not None:
            n: rc[ast.Node] = q
            what: str = ""
            if n.kind == ast.ND_RETURN:
                what = "return"
            elif n.kind == ast.ND_RAISE:
                what = "raise"
            elif n.kind == ast.ND_BREAK:
                if loop_depth == 0:
                    what = "break"
            elif n.kind == ast.ND_CONTINUE:
                if loop_depth == 0:
                    what = "continue"
            elif n.kind == ast.ND_CALL or n.kind == ast.ND_METHOD:
                # 注意: 失敗しうる呼び出しは、捕まえないと外へ飛ぶ
                if n.can_fail and try_depth == 0:
                    what = diag.msg0("sema.456", "失敗しうる呼び出し")
            if len(what) > 0:
                diag.error_code_full(unwrap_tok(n.tok), "E-SCOPE-1",
                                     diag.msg("sema.154", "scope: の中から '{0}' で抜けることはできません", [copy(what)]),
                                     diag.msg0("sema.457", "ここで scope: の外へ出ようとしています"),
                                     None, "",
                                     diag.msg0("sema.458", "scope: の出口では、始めたスレッドを全部 join します。途中で抜けるとそれが飛ぶので、結果を変数に受けてからブロックを出てください"))
            ld: int = loop_depth
            if n.kind == ast.ND_WHILE:
                ld = loop_depth + 1
            td: int = try_depth
            if n.kind == ast.ND_TRY:
                td = try_depth + 1
            self.scope_escape(n.lhs, ld, td)
            self.scope_escape(n.rhs, ld, td)
            self.scope_escape(n.incr, ld, td)
            self.scope_escape(n.body, ld, td)
            self.scope_escape(n.args, ld, td)
            # 注意: except 節の中は try の外（そこで失敗すればさらに外へ飛ぶ）
            etd: int = td
            if n.kind == ast.ND_TRY:
                etd = try_depth
            self.scope_escape(n.els, ld, etd)
            q = n.next

    # ── for の脱糖（A-39）───────────────────────────────────
    #
    # ★ **脱糖はここでします。** 0.1.0 からずっとパーサでやっていましたが、
    #   利用者のクラスを回せるようにすると、**型が決まるまで形が決まりません**。
    #
    #     対象が list / str  → 添字で回す（今までと同じ形。IR は変わりません）
    #     規約を持つクラス    → カーソルで回す
    #
    #   for x in xs:          for.it.N = xs            ← 対象は 1 回だけ評価
    #       BODY        →     for.ix.N: int = 0
    #                         while for.ix.N < len(for.it.N):
    #                             x = for.it.N[for.ix.N]
    #                             BODY
    #                           incr: for.ix.N += 1    ← continue の飛び先
    #
    #   for x in c:           for.it.N = c
    #       BODY        →     for.ix.N: int = for.it.N.__first__()
    #                         while for.ix.N >= 0:
    #                             x = for.it.N.__get__(for.ix.N)
    #                             BODY
    #                           incr: for.ix.N = for.it.N.__next__(for.ix.N)
    #
    # ★ カーソルは **int だけ**です。「イテレータ物体」を作る形にしません。
    #   この言語は**借用を構造体に保存できない**ので（寿命注釈を入れないと
    #   決めたため）、容器を指すイテレータを作るには容器を rc[T] にするか、
    #   寿命を書かせることになります。カーソルなら、容器は借りたままで、
    #   ループが持つのは int 1 つです。
    #   対になる定義: src/sema.c の check_foreach
    def iter_method(self, c: rc[ast.Class], name: str) -> rc[types.FuncSig] | None:
        owner: rc[types.ModuleSyms] = self.syms_by_name(c.owner_name)
        return self.lookup_func_in(owner, self.mangle(c.name, name))

    # 規約どおりの形か確かめる（ret が None なら戻り型は問わない＝ __get__）
    def check_iter_sig(mut self, f: rc[types.FuncSig], name: str, nparams: int,
                       want_int_ret: bool, at: rc[token.Token] | None,
                       c: rc[ast.Class]) -> None:
        ok: bool = f.nparams == nparams
        if ok and want_int_ret:
            ok = unwrap_type(f.ret).kind == ast.TY_INT
        if ok and nparams == 2:
            ok = f.params[1].kind == ast.TY_INT
        if ok:
            return

        hint: str = diag.msg("ssema.011", "def {0}(self) -> int の形で書いてください", [copy(name)])
        if name == "__get__":
            hint = diag.msg0("sema.520", "def __get__(self, cur: int) -> T の形で書いてください")
        elif nparams == 2:
            hint = diag.msg("ssema.012", "def {0}(self, cur: int) -> int の形で書いてください", [copy(name)])
        diag.error_full(unwrap_tok(at),
                        diag.msg("sema.263", "'{0}.{1}' の形が for の規約と違います", [copy(c.name), copy(name)]),
                        diag.msg0("sema.518", "この for がその規約を使います"),
                        f.tok, diag.msg0("sema.519", "このメソッドです"), hint)

    # 対象.名前(引数…) のメソッド呼び出しを組み立てる
    def iter_call(self, tok: rc[token.Token] | None, obj: str, name: str,
                  arg: rc[ast.Node] | None) -> rc[ast.Node]:
        m: rc[ast.Node] = ast.new_node(ast.ND_METHOD, tok)
        m.lhs = ast.new_var_node(tok, obj)
        m.name = copy(name)
        m.args = arg
        return m

    # 隠し変数の宣言（型注釈なし。型は右辺から決まります）
    def hidden_var(self, tok: rc[token.Token] | None, name: str,
                   init: rc[ast.Node] | None) -> rc[ast.Node]:
        n: rc[ast.Node] = ast.new_node(ast.ND_VARDECL, tok)
        n.name = copy(name)
        n.rhs = init
        return n

    def check_foreach(mut self, n: mut rc[ast.Node]) -> None:
        t: rc[token.Token] | None = n.tok
        iter_: rc[ast.Node] = unwrap_node(n.lhs)
        body: rc[ast.Node] = unwrap_node(n.body)

        # ★ 対象の型を先に決めます（形がこれで決まります）。
        #   注意: この式はこのあと組み立てる木の中でもう一度検査されます。
        ct: rc[ast.Type] = auto_deref(self.check_expr(iter_))

        head: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, t)
        cur: rc[ast.Node] = head

        # for.it.N = <対象>（★ 1 回だけ評価する）
        d0: rc[ast.Node] = self.hidden_var(t, n.hid_obj, iter_)
        cur.next = d0
        cur = d0

        cond: rc[ast.Node] = ast.new_int_node(t, 0)      # 下で必ず入れ替える
        bind: rc[ast.Node] = ast.new_node(ast.ND_PASS, t)
        inc: rc[ast.Node] = ast.new_node(ast.ND_PASS, t)

        if ct.kind == ast.TY_CLASS:
            c: rc[ast.Class] = unwrap_class(ct.cls)
            first: rc[types.FuncSig] | None = self.iter_method(c, "__first__")
            nextm: rc[types.FuncSig] | None = self.iter_method(c, "__next__")
            getm: rc[types.FuncSig] | None = self.iter_method(c, "__get__")
            if first is None or nextm is None or getm is None:
                diag.error_full(unwrap_tok(iter_.tok),
                                diag.msg("sema.265", "クラス '{0}' は for で回せません", [copy(c.name)]),
                                diag.msg("sema.156", "'{0}' 型です", [copy(ast.type_name(ct))]),
                                c.tok, diag.msg0("sema.444", "クラスの定義はここです"),
                                diag.msg0("sema.521", "for で回すには 3 つのメソッドが要ります:\n             def __first__(self) -> int          最初のカーソル（無ければ -1）\n             def __next__(self, cur: int) -> int 次のカーソル（無ければ -1）\n             def __get__(self, cur: int) -> T    そのカーソルの要素"))
                return
            self.check_iter_sig(unwrap_sig(first), "__first__", 1, True, t, c)
            self.check_iter_sig(unwrap_sig(nextm), "__next__", 2, True, t, c)
            self.check_iter_sig(unwrap_sig(getm), "__get__", 2, False, t, c)

            # for.ix.N: int = for.it.N.__first__()
            d1: rc[ast.Node] = self.hidden_var(
                t, n.hid_cur, self.iter_call(t, n.hid_obj, "__first__", None))
            cur.next = d1
            cur = d1

            # for.ix.N >= 0
            cond = ast.new_binop_node(t, ast.OP_GE,
                                      ast.new_var_node(t, n.hid_cur),
                                      ast.new_int_node(t, 0))

            # x = for.it.N.__get__(for.ix.N)
            bind = self.hidden_var(
                t, n.name,
                self.iter_call(t, n.hid_obj, "__get__",
                               ast.new_var_node(t, n.hid_cur)))

            # for.ix.N = for.it.N.__next__(for.ix.N)  ← continue の飛び先
            inc = ast.new_node(ast.ND_ASSIGN, t)
            inc.lhs = ast.new_var_node(t, n.hid_cur)
            inc.rhs = self.iter_call(t, n.hid_obj, "__next__",
                                     ast.new_var_node(t, n.hid_cur))
        elif ct.kind == ast.TY_LIST or ct.kind == ast.TY_STR:
            # for.ix.N: int = 0
            d2: rc[ast.Node] = self.hidden_var(t, n.hid_cur, ast.new_int_node(t, 0))
            cur.next = d2
            cur = d2

            # for.ix.N < len(for.it.N)
            lencall: rc[ast.Node] = ast.new_node(ast.ND_CALL, t)
            lencall.name = "len"
            lencall.args = ast.new_var_node(t, n.hid_obj)
            cond = ast.new_binop_node(t, ast.OP_LT,
                                      ast.new_var_node(t, n.hid_cur), lencall)

            # x = for.it.N[for.ix.N]
            idx: rc[ast.Node] = ast.new_node(ast.ND_INDEX, t)
            idx.lhs = ast.new_var_node(t, n.hid_obj)
            idx.rhs = ast.new_var_node(t, n.hid_cur)
            bind = self.hidden_var(t, n.name, idx)

            # for.ix.N += 1  ← continue の飛び先
            inc = ast.new_node(ast.ND_ASSIGN, t)
            inc.lhs = ast.new_var_node(t, n.hid_cur)
            inc.rhs = ast.new_binop_node(t, ast.OP_ADD,
                                         ast.new_var_node(t, n.hid_cur),
                                         ast.new_int_node(t, 1))
        else:
            diag.error_full(unwrap_tok(iter_.tok),
                            diag.msg("sema.266", "'{0}' 型は for で回せません", [copy(ast.type_name(ct))]),
                            diag.msg0("sema.522", "ここは回せる形ではありません"), None, "",
                            diag.msg0("sema.523", "回せるのは list / str / range(...) と、__first__ / __next__ / __get__ を持つクラスです"))
            return

        # 本体の先頭にループ変数の束縛を差し込む
        bind.next = body.body
        body.body = bind

        wh: rc[ast.Node] = ast.new_node(ast.ND_WHILE, t)
        wh.lhs = cond
        wh.body = body
        wh.incr = inc
        cur.next = wh

        # ★ 隠し変数を for のスコープに閉じ込めるため、ブロックにします。
        #   **このノード自身を書き換えます**（親から見た並びを崩さないため）。
        n.kind = ast.ND_BLOCK
        n.name = ""
        n.lhs = None
        n.body = head.next

    def check_stmt(mut self, n: mut rc[ast.Node]) -> None:
        if n.kind == ast.ND_VARDECL:
            self.check_vardecl(n)
        elif n.kind == ast.ND_UNPACK:
            self.check_unpack(n)
        elif n.kind == ast.ND_ASSIGN:
            self.check_assign(n)
        elif n.kind == ast.ND_BLOCK:
            self.check_block(n)
        elif n.kind == ast.ND_SCOPE:
            # ★ scope: ブロック（A-18 の scoped spawn）。
            #   型としては何もしない。意味を与えるのは所有権検査（借りを
            #   渡せる）と codegen（出口で join する）。
            self.scope_depth = self.scope_depth + 1
            self.check_block(unwrap_node(n.body))
            self.scope_depth = self.scope_depth - 1
            # 注意: 検査は**型検査のあと**。can_fail は検査中に付くため。
            self.scope_escape(n.body, 0, 0)
        elif n.kind == ast.ND_REQUIRES or n.kind == ast.ND_ENSURES:
            # ★ 契約（A-29）。置ける場所は関数の本体の先頭だけ（check_func が見る）。
            #   ここでは「bool か」と、ensures の中の 'result' を見る。
            if n.kind == ast.ND_ENSURES:
                self.ensures_depth = self.ensures_depth + 1
            ct: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
            if n.kind == ast.ND_ENSURES:
                self.ensures_depth = self.ensures_depth - 1
            if n.kind == ast.ND_ENSURES:
                self.check_old_types(n.lhs)
            if ct.kind != ast.TY_BOOL:
                kw: str = "ensures"
                if n.kind == ast.ND_REQUIRES:
                    kw = "requires"
                diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                                diag.msg("sema.280", "{0} には bool の式を書きます", [copy(kw)]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(ct))]),
                                None, "",
                                diag.msg0("sema.540", "比べる式を書いてください（例: requires b != 0）"))
        elif n.kind == ast.ND_RETURN:
            self.check_return(n)
        elif n.kind == ast.ND_PASS:
            return
        elif n.kind == ast.ND_IF:
            self.check_cond(diag.msg0("parse.171", "if の条件"), n, unwrap_node(n.lhs))

            # ★ then 節では条件が成り立っている
            tvars: list[rc[types.VarEntry]] = []
            ttypes: list[rc[ast.Type]] = []
            self.narrow_apply(n.lhs, True, tvars, ttypes)
            self.check_block(unwrap_node(n.body))
            self.narrow_restore(tvars, ttypes)

            if n.els is not None:
                evars: list[rc[types.VarEntry]] = []
                etypes: list[rc[ast.Type]] = []
                self.narrow_apply(n.lhs, False, evars, etypes)
                self.check_stmt(unwrap_node(n.els))
                self.narrow_restore(evars, etypes)
        elif n.kind == ast.ND_MATCH:
            self.check_match(n)
        elif n.kind == ast.ND_ENUM:
            return                      # 宣言は登録済み（declare_enum）
        elif n.kind == ast.ND_FOREACH:
            # ★ for は while へ書き換えてから検査します（A-39）
            self.check_foreach(n)
            self.check_stmt(n)     # 書き換えた自分（ND_BLOCK）を検査する
        elif n.kind == ast.ND_WHILE:
            self.check_cond(diag.msg0("parse.178", "while の条件"), n, unwrap_node(n.lhs))
            self.loop_depth = self.loop_depth + 1

            wvars: list[rc[types.VarEntry]] = []
            wtypes: list[rc[ast.Type]] = []
            self.narrow_apply(n.lhs, True, wvars, wtypes)
            self.check_block(unwrap_node(n.body))
            if n.incr is not None:
                self.check_stmt(unwrap_node(n.incr))
            self.narrow_restore(wvars, wtypes)

            self.loop_depth = self.loop_depth - 1
        elif n.kind == ast.ND_TRY:
            # ① except の型を先に解決する（本体を見るときに「捕まえられるか」が要る）
            ex: rc[ast.Node] | None = n.els
            while ex is not None:
                et: rc[ast.Type] = self.resolve_type(unwrap_node(ex.type_ref))
                if et.kind != ast.TY_CLASS:
                    diag.error_full(unwrap_tok(ex.tok),
                                    diag.msg("sema.281", "'{0}' はエラー型として使えません", [copy(ast.type_name(et))]),
                                    diag.msg0("sema.541", "except に書けるのはクラスだけです"), None, "",
                                    diag.msg0("sema.542", "エラーはふつうのクラスとして定義してください"))
                else:
                    ex.err_tag = self.err_tag_of(unwrap_class(et.cls))
                ex.type = et
                ex = ex.next

            # ② try の本体（この間に起きた失敗は、この try が受け止める）
            self.try_stack.append(n)
            self.check_block(unwrap_node(n.body))
            self.try_stack = try_pop(self.try_stack)

            # ③ except の本体（as で束縛する変数はその節の中だけ）
            ex2: rc[ast.Node] | None = n.els
            while ex2 is not None:
                self.scope_push()
                if len(ex2.name) > 0:
                    v: rc[types.VarEntry] = self.declare(ex2.name,
                                                     unwrap_type(ex2.type), ex2.tok)
                    ex2.ir_name = copy(v.ir_name)
                self.check_stmt_list(unwrap_node(ex2.body).body)
                self.scope_pop()
                ex2 = ex2.next

            # ④ 何も捕まえていない try は、書いた人の勘違い（R5。警告）
            if not n.can_fail:
                diag.warn_full(unwrap_tok(n.tok), "E-RAISE-5",
                               diag.msg0("sema.543", "この try の中に、失敗しうる呼び出しがありません"),
                               diag.msg0("sema.544", "except は決して実行されません"),
                               diag.msg0("sema.545", "raises を宣言した関数を呼んでいるか確かめてください"))
        elif n.kind == ast.ND_RAISE:
            rt: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
            if rt.kind != ast.TY_CLASS:
                diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                                diag.msg("sema.282", "'{0}' は raise できません", [copy(ast.type_name(rt))]),
                                diag.msg0("sema.546", "raise にはエラーオブジェクトを渡します"), None, "",
                                diag.msg0("sema.547", "エラーはふつうのクラスです（例: raise IOError(\"見つかりません\")）"))
            else:
                rc: rc[ast.Class] = unwrap_class(rt.cls)
                if not self.try_catches(rc) and not self.func_declares(rc):
                    cf2: rc[types.FuncSig] | None = self.cur_func
                    ndecl: int = 0
                    ftok: rc[token.Token] | None = None
                    if cf2 is not None:
                        ndecl = len(cf2.raises_cls)
                        ftok = cf2.tok
                    if ndecl == 0:
                        diag.error_code_full(unwrap_tok(n.tok), "E-RAISE-1",
                                        diag.msg("sema.283", "'{0}' を raise していますが、宣言がありません", [copy(rc.name)]),
                                        diag.msg0("sema.548", "この関数は失敗しないと宣言されています"),
                                        ftok, diag.msg0("sema.550", "関数の宣言はここです"),
                                        diag.msg("sema.284", "関数の宣言に 'raises {0}' を足してください", [copy(rc.name)]))
                    else:
                        diag.error_code_full(unwrap_tok(n.tok), "E-RAISE-2",
                                        diag.msg("sema.237", "エラー '{0}' が宣言されていません", [copy(rc.name)]),
                                        diag.msg0("sema.549", "raises に含まれていません"),
                                        ftok, diag.msg0("sema.550", "関数の宣言はここです"),
                                        diag.msg("sema.285", "この関数の raises に '{0}' を足してください", [copy(rc.name)]))
                n.err_tag = self.err_tag_of(rc)
                n.type = rt
        elif n.kind == ast.ND_BREAK or n.kind == ast.ND_CONTINUE:
            if self.loop_depth > 0:
                return
            kw: str = "continue"
            if n.kind == ast.ND_BREAK:
                kw = "break"
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.286", "'{0}' はループの外では使えません", [copy(kw)]),
                            diag.msg("sema.287", "この '{0}' を囲む while がありません", [copy(kw)]), None, "",
                            diag.msg("sema.288", "'{0}' は while の中でだけ使えます", [copy(kw)]))
        else:
            self.check_expr(n)   # 式文

    # ── 組み込み関数 ───────────────────────────────────

    # エラー型の ID を引く（無ければ割り当てる）
    def err_tag_of(mut self, c: rc[ast.Class]) -> int:
        i: int = 0
        while i < len(self.err_classes):
            if self.err_classes[i] == c:
                return i + 1
            i = i + 1
        self.err_classes.append(c)
        return len(self.err_classes)

    # いま入っている try のどれかが c を捕まえるか（捕まえた try に印を付ける）
    def try_catches(mut self, c: rc[ast.Class]) -> bool:
        i: int = len(self.try_stack) - 1
        while i >= 0:
            t: rc[ast.Node] = self.try_stack[i]
            ex: rc[ast.Node] | None = t.els
            while ex is not None:
                et: rc[ast.Type] | None = ex.type
                if et is not None:
                    ec: rc[ast.Class] | None = et.cls
                    # 注意: 'and' では絞り込みが効かないので、ガードを分けます（15.5 節）
                    if ec is not None and ec == c:
                        t.can_fail = True
                        return True
                ex = ex.next
            i = i - 1
        return False

    # 今検査中の関数が c を raises に宣言しているか
    def func_declares(self, c: rc[ast.Class]) -> bool:
        f: rc[types.FuncSig] | None = self.cur_func
        if f is None:
            return False
        i: int = 0
        while i < len(f.raises_cls):
            if f.raises_cls[i] == c:
                return True
            i = i + 1
        return False

    # raises 節を解決する
    def resolve_raises(mut self, fn: mut rc[ast.Node], f: mut rc[types.FuncSig]) -> None:
        r: rc[ast.Node] | None = fn.err_types
        while r is not None:
            t: rc[ast.Type] = self.resolve_type(r)
            if t.kind != ast.TY_CLASS:
                diag.error_full(unwrap_tok(r.tok),
                                diag.msg("sema.281", "'{0}' はエラー型として使えません", [copy(ast.type_name(t))]),
                                diag.msg0("sema.583", "raises に書けるのはクラスだけです"), None, "",
                                diag.msg0("sema.542", "エラーはふつうのクラスとして定義してください"))
            else:
                f.raises_cls.append(unwrap_class(t.cls))
                # ★ 外へ出す関数の入口がエラーを見分けるために、節のノードにも
                #   書き写します（ffi.md §5.1）。対になる定義: src/sema.c
                r.err_tag = self.err_tag_of(unwrap_class(t.cls))
            r.type = t
            r = r.next

    # 失敗しうる呼び出しを、誰が受け止めるかを決める（R1 / R2）
    def check_can_fail(mut self, n: mut rc[ast.Node], f: rc[types.FuncSig],
                       shown: str) -> None:
        if len(f.raises_cls) == 0:
            return
        n.can_fail = True

        i: int = 0
        while i < len(f.raises_cls):
            ec: rc[ast.Class] = f.raises_cls[i]
            if not self.try_catches(ec) and not self.func_declares(ec):
                cf: rc[types.FuncSig] | None = self.cur_func
                declared: int = 0
                if cf is not None:
                    declared = len(cf.raises_cls)
                if declared == 0:
                    diag.error_code_full(unwrap_tok(n.tok), "E-RAISE-1",
                                    diag.msg("sema.234", "失敗しうる呼び出し '{0}' を処理していません", [copy(shown)]),
                                    diag.msg("sema.235", "この呼び出しは '{0}' を返すことがあります", [copy(ec.name)]),
                                    f.tok, diag.msg("sema.233", "'{0}' はここで宣言されています", [copy(shown)]),
                                    diag.msg("sema.236", "try で捕まえるか、この関数に 'raises {0}' を足してください", [copy(ec.name)]))
                else:
                    diag.error_code_full(unwrap_tok(n.tok), "E-RAISE-2",
                                    diag.msg("sema.237", "エラー '{0}' が宣言されていません", [copy(ec.name)]),
                                    diag.msg("sema.238", "'{0}' は '{1}' を返すことがあります", [copy(shown), copy(ec.name)]),
                                    f.tok, diag.msg("sema.233", "'{0}' はここで宣言されています", [copy(shown)]),
                                    diag.msg("sema.239", "この関数の raises に '{0}' を足すか、try で捕まえてください", [copy(ec.name)]))
            i = i + 1

    def is_builtin_name(self, name: str) -> bool:
        # ★ move_out は表に載せられません（戻り型が引数と同じ型そのもので、
        #   表は TypeKind しか持てないため）。名前だけここで数えます。
        #   対になる定義: src/sema.c の is_builtin_name
        if name == "move_out":
            return True
        i: int = 0
        while i < len(self.builtins):
            if self.builtins[i].name == name:
                return True
            i = i + 1
        return False

    # 受け取れる型の一覧（エラーメッセージ用）
    def builtin_arg_types(self, name: str) -> str:
        parts: list[str] = []
        i: int = 0
        while i < len(self.builtins):
            b: Builtin = self.builtins[i]
            if b.name == name:
                if b.arg == ast.TY_LIST:
                    parts.append("list[T]")
                else:
                    parts.append(ast.type_name(self.prim(b.arg)))
            i = i + 1
        return strings.join(parts, ", ")

    def check_builtin_call(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        nargs: int = count_siblings(n.args)

        # ★ input() は引数なしでも書ける（Python と同じ）。
        #   注意: 引数を省いたときは、空のプロンプトを渡したことにする。
        if n.name == "input" and nargs == 0:
            empty: rc[ast.Node] = ast.new_str_node(n.tok, "", 0)
            empty.type = self.ty_str()
            n.args = empty
            nargs = 1

        if nargs != 1:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.103", "{0} は 1 個の引数を取りますが、{1} 個渡されました", [copy(n.name), copy(str(nargs))]),
                            diag.msg0("sema.197", "引数の個数が違います"), None, "",
                            diag.msg("sema.104", "{0}(値) の形で使ってください", [copy(n.name)]))

        arg: rc[ast.Node] = unwrap_node(n.args)
        at: rc[ast.Type] = self.check_expr(arg)

        # ★ print(xs) / str(xs) — list をそのまま表示できるようにする。
        #   注意: 要素の型ごとにランタイム関数を呼び分けるので、**要素が
        #     int / float / str / bool のときだけ**。入れ子（list[list[int]]）は
        #     要素をさらに文字列にする手立てが要るので、ここで弾く。
        if at.kind == ast.TY_LIST and (n.name == "print" or n.name == "str"):
            ek: int = ast.elem_of(at).kind
            if (ek != ast.TY_INT and ek != ast.TY_FLOAT and
                    ek != ast.TY_STR and ek != ast.TY_BOOL):
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.105", "'{0}' はそのまま {1} できません", [copy(ast.type_name(at)), copy(n.name)]),
                                diag.msg("sema.106", "要素が '{0}' 型です", [copy(ast.type_name(ast.elem_of(at)))]), None, "",
                                diag.msg0("sema.411", "そのまま出せるのは list[int] / list[float] / list[str] / list[bool] だけです。ほかは for でまわしてください"))
            n.is_list_str = True
            if n.name == "print":
                return self.ty_none()
            return self.ty_str()

        # ── move_out(場所) — 所有権を取り出し、その場所は空にする ──────
        #
        # ★ なぜ要るか（docs/ja/roadmap.md A-21d）
        #   `return self.out` は仕様 §4.5 が許しますが、**戻り値の型に
        #   「借用だ」と書く手段がありません**。呼ぶ側は所有として受け取り、
        #   自分でも解放するので、--drop すると二重解放になります。
        #
        # 注意: 戻り型は**引数と同じ型そのもの**です。
        #   対になる定義: src/sema.c の check_builtin_call
        if n.name == "move_out":
            is_place: bool = (arg.kind == ast.ND_FIELD or
                              arg.kind == ast.ND_INDEX or
                              (arg.kind == ast.ND_VAR and arg.is_global))
            if not is_place:
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg0("sema.412", "move_out は「場所」からしか取り出せません"),
                                diag.msg0("sema.413", "ここは書き戻せる場所ではありません"), None, "",
                                diag.msg0("sema.414", "move_out(self.xs) / move_out(obj.f) / move_out(xs[i]) の形で使ってください（局所変数は、そのまま返せば所有権ごと動きます）"))
            if at.kind != ast.TY_STR and at.kind != ast.TY_LIST:
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.107", "move_out は '{0}' 型を取り出せません", [copy(ast.type_name(at))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]), None, "",
                                diag.msg0("sema.415", "move_out が受け取れるのは str と list[T] です（取り出したあとに書き戻す「空の値」が要るためです）"))
            n.is_move_out = True        # ★ codegen はこれを見る
            return at

        i: int = 0
        while i < len(self.builtins):
            b: Builtin = self.builtins[i]
            if b.name == n.name and b.arg == at.kind:
                n.builtin = copy(b.impl)        # ★ codegen はこれを見る
                return self.prim(b.ret)
            i = i + 1

        # ★ 実体化の中で出たエラーには、発端の行を添える
        rtok: rc[token.Token] | None = self.inst_site
        rlab: str = ""
        if rtok is not None:
            rlab = diag.msg("sema.109", "この実体化（{0}）で使われました", [copy(self.inst_name)])
        diag.error_full(unwrap_tok(arg.tok),
                        diag.msg("sema.108", "{0} は '{1}' 型を受け取れません", [copy(n.name), copy(ast.type_name(at))]),
                        diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]), rtok, rlab,
                        diag.msg("sema.110", "{0} が受け取れるのは {1} です", [copy(n.name), copy(self.builtin_arg_types(n.name))]))
        return self.ty_int()

    # ── リテラル・添字 ──────────────────────────────────────

    def check_list_lit(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        want: rc[ast.Type] | None = self.expected   # ★ 使う前に控える

        if n.body is None:
            # 注意: 'or' では絞り込みが効かないので、判定を分けます
            want_is_list: bool = False
            if want is not None:
                if want.kind == ast.TY_LIST:
                    want_is_list = True
            if not want_is_list:
                diag.error_full(unwrap_tok(n.tok), diag.msg0("sema.416", "空のリストの要素型が決まりません"),
                                diag.msg0("sema.417", "この [] がどんなリストなのか分かりません"), None, "",
                                diag.msg0("sema.418", "型注釈を書いてください（例: xs: list[int] = []）。関数の引数に直接渡す場合は、いったん変数に入れてください"))
                return self.ty_int()
            return unwrap_type(want)

        # 要素があるなら、最初の要素の型を要素型にする（推論はしない）
        self.expected = None
        if want is not None:
            if want.kind == ast.TY_LIST:
                self.expected = want.elem
        first_node: rc[ast.Node] = unwrap_node(n.body)
        first: rc[ast.Type] = self.check_expr(first_node)
        self.reject_escaping_closure(n.body, diag.msg0("sema.410", "しまうことが"))   # A-43
        et: rc[ast.Type] = first
        if want is not None:
            w: rc[ast.Type] = want
            if w.kind == ast.TY_LIST:
                welem: rc[ast.Type] = ast.elem_of(w)
                if ast.type_assignable(first, welem):
                    et = welem

        # ★ 範囲型なら、要素も入れる前に確かめる（A-28）。
        #   注意: 並びの途中を差し替えるので、1 つ前を覚えながら進む。
        n.body = self.range_coerce(n.body, et)
        prev: rc[ast.Node] = unwrap_node(n.body)

        i: int = 2
        el: rc[ast.Node] | None = prev.next
        while el is not None:
            e: rc[ast.Node] = el
            self.expected = et
            t: rc[ast.Type] = self.check_expr(e)
            self.reject_escaping_closure(e, diag.msg0("sema.410", "しまうことが"))   # A-43
            if not ast.type_assignable(t, et):
                diag.error_full(unwrap_tok(e.tok),
                                diag.msg("sema.111", "リストの要素の型がそろっていません（第 {0} 要素）", [copy(str(i))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(t))]),
                                first_node.tok,
                                diag.msg("sema.112", "最初の要素は '{0}' 型です", [copy(ast.type_name(et))]),
                                diag.msg0("sema.419", "リストの要素はすべて同じ型でなければなりません"))
            # ★ A-28：差し替えたら、次の周回のために繋ぎ直す
            #   注意: 同じノードかどうかは**種別**で見ます（この言語には
            #     参照の同一性を比べる書き方がありません）。包んだときだけ
            #     ND_RANGECHK に変わります。
            co: rc[ast.Node] = unwrap_node(self.range_coerce(e, et))
            if co.kind == ast.ND_RANGECHK and e.kind != ast.ND_RANGECHK:
                co.next = e.next
                prev.next = co
            prev = co
            i = i + 1
            el = co.next
        self.expected = None
        return ast.type_list(et)

    # ── 内包表記 ──────────────────────────────────────
    #
    #   [ E for x in xs if C ]
    #
    # ★ **式の位置に現れるので、構文解析での脱糖にできない**（for やカンマ代入
    #   との違い）。ここで型を決め、codegen がその場でループを組み立てる。
    #
    # 注意: 隠し宣言 3 つ（ループ変数 / 結果の list / 添字）は構文解析器が並べている。
    #   ここで型を入れて宣言し、**alloca の名前**を用意する。
    # ── 旧値 old(式)（ensures の中だけ）──
    #
    # ★ ensures の中の old(e) を「入口で控える隠し変数 old.N」に書き換え、
    #   先頭の契約を「requires → 隠し変数 → ensures」に並べ直す。
    #   対になる定義: src/sema.c の rewrite_old / old_walk（番号の振り方も同じ）
    def old_walk(mut self, first: rc[ast.Node] | None, decls: mut list[rc[ast.Node]],
                 inside: bool) -> None:
        cur: rc[ast.Node] | None = first
        while cur is not None:
            n: rc[ast.Node] = cur
            if n.kind == ast.ND_CALL and n.name == "old" and len(n.mod_name) == 0:
                if inside:
                    diag.error_at_hint(unwrap_tok(n.tok), diag.msg0("sema.114", "old(...) の中に old は書けません"),
                                       diag.msg0("sema.113", "old の入れ子です"))
                a0: rc[ast.Node] | None = n.args
                if a0 is None:
                    diag.error_at_hint(unwrap_tok(n.tok),
                                       diag.msg0("sema.116", "old には式を 1 つだけ渡します（例: old(len(xs))）"),
                                       diag.msg0("sema.115", "old の引数の数が違います"))
                arg: rc[ast.Node] = unwrap_node(a0)
                if arg.next is not None:
                    diag.error_at_hint(unwrap_tok(n.tok),
                                       diag.msg0("sema.116", "old には式を 1 つだけ渡します（例: old(len(xs))）"),
                                       diag.msg0("sema.115", "old の引数の数が違います"))
                if len(decls) >= 256:
                    diag.error_at_hint(unwrap_tok(n.tok), diag.msg0("sema.118", "old は 1 つの関数に 256 個までです"),
                                       diag.msg0("sema.117", "old が多すぎます"))
                self.old_walk(arg, decls, True)   # 入れ子を見つけるため
                d: rc[ast.Node] = ast.new_node(ast.ND_VARDECL, unwrap_tok(n.tok))
                d.name = "old." + str(len(decls))
                d.rhs = arg
                decls.append(d)
                # 呼び出しの節点を、その場で隠し変数の参照に変える
                n.kind = ast.ND_VAR
                n.name = "old." + str(len(decls) - 1)
                n.args = None
            else:
                self.old_walk(n.lhs, decls, inside)
                self.old_walk(n.rhs, decls, inside)
                self.old_walk(n.els, decls, inside)
                self.old_walk(n.args, decls, inside)
            cur = n.next

    def rewrite_old(mut self, body: mut rc[ast.Node]) -> None:
        decls: list[rc[ast.Node]] = []
        st: rc[ast.Node] | None = body.body
        while st is not None:
            sn: rc[ast.Node] = st
            if sn.kind != ast.ND_REQUIRES and sn.kind != ast.ND_ENSURES:
                st = None
            else:
                if sn.kind == ast.ND_ENSURES:
                    self.old_walk(sn.lhs, decls, False)
                st = sn.next
        if len(decls) == 0:
            return

        # 先頭の契約を「requires → 隠し変数 → ensures」に並べ直す
        order: list[rc[ast.Node]] = []
        ens: list[rc[ast.Node]] = []
        rest: rc[ast.Node] | None = body.body
        going: bool = True
        while going:
            if rest is None:
                going = False
            else:
                rn: rc[ast.Node] = rest
                if rn.kind == ast.ND_REQUIRES:
                    order.append(rn)
                    rest = rn.next
                elif rn.kind == ast.ND_ENSURES:
                    ens.append(rn)
                    rest = rn.next
                else:
                    going = False
        for i in range(len(decls)):
            order.append(decls[i])
        for j in range(len(ens)):
            order.append(ens[j])
        for k in range(len(order) - 1):
            a: rc[ast.Node] = order[k]
            a.next = order[k + 1]
        last: rc[ast.Node] = order[len(order) - 1]
        last.next = rest
        body.body = order[0]

    # old(e) の e は値型（int / bool / float）に限る（list を控えると所有権が移るため）
    #   対になる定義: src/sema.c の check_old_types
    def check_old_types(self, first: rc[ast.Node] | None) -> None:
        cur: rc[ast.Node] | None = first
        while cur is not None:
            n: rc[ast.Node] = cur
            if n.kind == ast.ND_VAR and ast.is_old_name(n.name) and n.type is not None:
                t: rc[ast.Type] = unwrap_type(n.type)
                if t.kind != ast.TY_INT and t.kind != ast.TY_BOOL and t.kind != ast.TY_FLOAT:
                    diag.error_full(unwrap_tok(n.tok),
                                    diag.msg0("sema.119", "old(...) に書けるのは int / bool / float の式です"),
                                    diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(t))]), None, "",
                                    diag.msg0("sema.420", "list なら old(len(xs)) のように、比べたい数にして書いてください"))
            self.check_old_types(n.lhs)
            self.check_old_types(n.rhs)
            self.check_old_types(n.els)
            self.check_old_types(n.args)
            cur = n.next

    def check_listcomp(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        lv: rc[ast.Node] = unwrap_node(n.body)          # ループ変数
        res: rc[ast.Node] = unwrap_node(lv.next)        # 結果の list
        ix: rc[ast.Node] = unwrap_node(res.next)        # 添字

        # ── 対象の型を決める ──
        elem_t: rc[ast.Type] = self.ty_int()
        if n.args is not None:
            # range：構文解析器が「開始・終端」に正規化し、増分は ival にある
            a: rc[ast.Node] | None = n.args
            while a is not None:
                arg: rc[ast.Node] = unwrap_node(a)
                at: rc[ast.Type] = self.check_expr(arg)
                if at.kind != ast.TY_INT:
                    diag.error_at_hint(unwrap_tok(arg.tok),
                                       diag.msg0("sema.120", "range の引数は int です"),
                                       diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]))
                a = arg.next
        else:
            obj: rc[ast.Node] = unwrap_node(n.rhs)
            it: rc[ast.Type] = self.check_expr(obj)
            if it.kind != ast.TY_LIST:
                diag.error_full(unwrap_tok(obj.tok),
                                diag.msg("sema.121", "'{0}' 型は内包表記の対象にできません", [copy(ast.type_name(it))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(it))]),
                                None, "",
                                diag.msg0("sema.421", "対象にできるのは list[T] と range(...) です"))
            elem_t = ast.elem_of(it)

        # ── ループ変数の見えるところで、要素の式と条件を検査する ──
        self.scope_push()
        lv.type = elem_t
        vlv: rc[types.VarEntry] = self.declare(lv.name, elem_t, lv.tok)
        lv.ir_name = copy(vlv.ir_name)

        # ★ 受け取る名前の分解（A-47）。ループ変数の見えるところで宣言する
        u: rc[ast.Node] | None = n.incr
        while u is not None:
            un: rc[ast.Node] = u
            self.check_unpack(un)
            u = un.next

        et: rc[ast.Type] = self.check_expr(unwrap_node(n.lhs))
        if et.kind == ast.TY_NONE:
            diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                            diag.msg0("sema.422", "内包表記の要素が値を持ちません"),
                            diag.msg0("sema.423", "この式は None 型です"), None, "",
                            diag.msg0("sema.424", "値を返す式を書いてください"))

        if n.els is not None:
            cnd: rc[ast.Node] = unwrap_node(n.els)
            ct: rc[ast.Type] = self.check_expr(cnd)
            if ct.kind != ast.TY_BOOL:
                diag.error_at_hint(unwrap_tok(cnd.tok),
                                   diag.msg0("sema.122", "内包表記の 'if' には bool が必要です"),
                                   diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(ct))]))
        self.scope_pop()

        # ★ 量化子 all(E for …) / any(E for …)。E は bool で、結果も bool
        #   対になる定義: src/sema.c の check_listcomp
        if len(n.name) > 0:
            if et.kind != ast.TY_BOOL:
                diag.error_full(unwrap_tok(unwrap_node(n.lhs).tok),
                                diag.msg("sema.123", "{0}(...) の中の式は bool でなければなりません", [copy(n.name)]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(et))]), None, "",
                                diag.msg("sema.124", "例: {0}(xs[i] >= 0 for i in range(len(xs)))", [copy(n.name)]))
            res.type = self.ty_bool()
            vq: rc[types.VarEntry] = self.declare(res.name, self.ty_bool(), res.tok)
            res.ir_name = copy(vq.ir_name)
            ix.type = self.ty_int()
            vqi: rc[types.VarEntry] = self.declare(ix.name, self.ty_int(), ix.tok)
            ix.ir_name = copy(vqi.ir_name)
            return self.ty_bool()

        # ── 隠し変数（結果の list と添字）──
        lt: rc[ast.Type] = ast.type_list(et)
        res.type = lt
        vres: rc[types.VarEntry] = self.declare(res.name, lt, res.tok)
        res.ir_name = copy(vres.ir_name)
        ix.type = self.ty_int()
        vix: rc[types.VarEntry] = self.declare(ix.name, self.ty_int(), ix.tok)
        ix.ir_name = copy(vix.ir_name)
        return lt

    def check_index_expr(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        obj: rc[ast.Node] = unwrap_node(n.lhs)
        idx: rc[ast.Node] = unwrap_node(n.rhs)
        ot: rc[ast.Type] = self.check_expr(obj)

        # ★ クラスの添字は __getitem__ に読み替える（m[i, j] を含む）。
        #   注意: 添字は **並び**なので、そのまま実引数のリストになる。
        if ot.kind == ast.TY_CLASS:
            gc: rc[ast.Class] = unwrap_class(ot.cls)
            if not self.class_has_method(gc, "__getitem__"):
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg("sema.126", "クラス '{0}' に '__getitem__(self, …) -> …' を定義すると、添字が使えます", [copy(gc.name)]),
                                   diag.msg("sema.125", "型 '{0}' は添字を取れません", [copy(ast.type_name(ot))]))
            n.kind = ast.ND_METHOD
            n.name = "__getitem__"
            n.args = idx
            n.rhs = None
            return self.check_class_method(n, gc)

        # ★ タプルの添字 t[0]
        #
        #   注意: **添字は定数（整数リテラル）だけ**。(int, str) の要素は位置ごとに
        #     型が違うので、添字が実行時に決まると**式の型が決まらない**。
        if ot.kind == ast.TY_TUPLE:
            if idx.next is not None:
                diag.error_at_hint(unwrap_tok(unwrap_node(idx.next).tok),
                                   diag.msg0("sema.128", "タプルの添字は 1 つだけです"),
                                   diag.msg0("sema.127", "添字が 2 つ以上あります"))
            if idx.kind != ast.ND_INT:
                diag.error_full(unwrap_tok(idx.tok),
                                diag.msg0("sema.425", "タプルの添字は整数リテラルでなければなりません"),
                                diag.msg0("sema.426", "ここは定数である必要があります"), None, "",
                                diag.msg0("sema.427", "要素ごとに型が違うので、添字が実行時に決まると式の型が決められません（分解代入 a, b = t も使えます）"))
            k: int = idx.ival
            if k < 0 or k >= len(ot.params):
                diag.error_full(unwrap_tok(idx.tok),
                                diag.msg("sema.129", "タプルの添字が範囲外です（{0}）", [copy(str(k))]),
                                diag.msg("sema.130", "要素は {0} 個です（0 〜 {1}）", [copy(str(len(ot.params))), copy(str(len(ot.params) - 1))]), None, "", "")
                return self.ty_int()
            idx.type = self.ty_int()
            return ot.params[k]

        # list[T] と str の添字は 1 つだけ
        if idx.next is not None:
            diag.error_full(unwrap_tok(unwrap_node(idx.next).tok),
                            diag.msg("sema.131", "型 '{0}' に添字を 2 つ以上は書けません", [copy(ast.type_name(ot))]),
                            diag.msg0("sema.428", "2 つめの添字はここです"), None, "",
                            diag.msg0("sema.429", "2 次元の添字（m[i, j]）が使えるのは __getitem__ を定義したクラスだけです"))

        it: rc[ast.Type] = self.check_expr(idx)

        if it.kind != ast.TY_INT:
            diag.error_full(unwrap_tok(idx.tok), diag.msg0("sema.430", "添字は int でなければなりません"),
                            diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(it))]), None, "", "")

        if ot.kind == ast.TY_LIST:
            return ast.elem_of(ot)
        # ★ str の添字は 1 文字の str を返す
        if ot.kind == ast.TY_STR:
            return self.ty_str()

        diag.error_full(unwrap_tok(obj.tok),
                        diag.msg("sema.125", "型 '{0}' は添字を取れません", [copy(ast.type_name(ot))]),
                        diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(ot))]), None, "",
                        diag.msg0("sema.431", "添字が使えるのは list[T] と str です"))
        return self.ty_int()

    # ── フィールド・メソッド ────────────────────────

    # 「'.' の左がモジュールか」を判定する
    def dot_module(self, n: rc[ast.Node]) -> rc[types.ModuleSyms] | None:
        lhs: rc[ast.Node] = unwrap_node(n.lhs)
        if lhs.kind == ast.ND_VAR:
            if self.lookup(lhs.name) is not None:
                return None
            return self.lookup_import(lhs.name)

        # ★ パッケージ（A-32）：`pkg.mod.f()` の左側は `pkg.mod` という
        #   **ドットを含む 1 つのモジュール名**。
        #
        # 注意: 変数のフィールド（`obj.field.f()`）と見分けが要る。見分け方は
        #   「いちばん左が変数として宣言されていないこと」＋「繋げた名前が
        #   import されていること」の 2 つ。import は明示的に書くものなので、
        #   両方を満たす形は 1 つしかない。
        #   対になる定義: src/sema.c の dot_module
        if lhs.kind != ast.ND_FIELD:
            return None
        segs: list[str] = []
        cur: rc[ast.Node] = lhs
        root_ok: bool = False
        while len(segs) < 8:
            segs.append(copy(cur.name))
            if cur.kind == ast.ND_VAR:
                root_ok = True
                break
            if cur.kind != ast.ND_FIELD:
                return None
            nxt: rc[ast.Node] | None = cur.lhs
            if nxt is None:
                return None
            cur = unwrap_node(nxt)
        if not root_ok:
            return None
        # 注意: 集めた順は右からなので、繋ぐときに逆に並べ直す
        if self.lookup(segs[len(segs) - 1]) is not None:
            return None            # 変数が先（13.5 節）
        parts: list[str] = []
        i: int = len(segs) - 1
        while i >= 0:
            if len(parts) > 0:
                parts.append(".")
            parts.append(copy(segs[i]))
            i = i - 1
        return self.lookup_import(strings.join(parts, ""))

    # lexer.MAX_KIND — 他のモジュールのグローバル変数
    def check_module_global(self, n: mut rc[ast.Node],
                            ms: rc[types.ModuleSyms]) -> rc[ast.Type]:
        mod_name: str = mod_name_of(ms)
        v: rc[types.VarEntry] | None = self.lookup_global_in(ms, n.name)

        # ★ グローバル変数に無ければ **関数を探す**
        #   （math.sin のように、他モジュールの関数も値として渡せる）
        if v is None:
            mf: rc[types.FuncSig] | None = self.lookup_func_in(ms, n.name)
            if mf is not None and len(mf.raises_cls) == 0:
                n.ir_name = copy(mf.ir_name)
                n.is_func_ref = True
                n.is_extern = True     # 他モジュールなので declare が要る
                return self.fn_type_of(mf)

        if v is None:
            hint: str = (diag.msg0("sema.433", "モジュールから使えるのは、そのファイルのトップレベルの関数・クラス・グローバル変数です"))
            if self.lookup_func_in(ms, n.name) is not None:
                hint = (diag.msg("sema.133", "'{0}' は関数です。'{1}.{2}(...)' と呼んでください", [copy(n.name), copy(mod_name), copy(n.name)]))
            elif self.lookup_class_in(ms, n.name) is not None:
                hint = (diag.msg("sema.134", "'{0}' はクラスです。生成するには '{1}.{2}(...)' と書いてください", [copy(n.name), copy(mod_name), copy(n.name)]))
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.132", "モジュール '{0}' に '{1}' はありません", [copy(mod_name), copy(n.name)]),
                            diag.msg0("sema.432", "この名前は定義されていません"), None, "", hint)
            return self.ty_int()

        # ★ codegen への記録
        n.mod_name = copy(mod_name)
        n.ir_name = copy(v.ir_name)
        n.is_global = True
        n.is_extern = ms != self.cur_syms()
        return unwrap_type(v.type)

    # ★ T | None に '.' で触ろうとしたときの案内
    def reject_opt_access(self, obj: rc[ast.Node], at: rc[ast.Node], what: str,
                          ot: rc[ast.Type]) -> None:
        hint: str = (diag.msg0("sema.435", "一度ローカル変数に入れてから絞り込んでください:\n             x: T | None = ...\n             if x is not None:\n                 ..."))
        if obj.kind == ast.ND_VAR:
            hint = (diag.msg("sema.137", "先に None を除いてください:\n             if {0} is not None:\n                 ...", [copy(obj.name)]))
        diag.error_full(unwrap_tok(at.tok),
                        diag.msg("sema.135", "型 '{0}' の値には{1}がありません", [copy(ast.type_name(ot)), copy(what)]),
                        diag.msg0("sema.434", "None かもしれない値です"),
                        obj.tok, diag.msg("sema.136", "この式は '{0}' 型です", [copy(ast.type_name(ot))]),
                        hint)

    # `Color.Red` を、型のついた定数に畳む（A-37）。
    #
    # ★ **ND_INT に書き換える。** 値はただの i64 なので、codegen に新しい形を
    #   増やす必要がない。型だけ TY_ENUM にしておけば、`Color.Red + 1` は
    #   「int と Color は混ざりません」で止まる。
    #
    # 戻り値: 畳めたら型、そうでなければ None（ふつうのフィールドとして続ける）
    #   対になる定義: src/sema.c の fold_enum_value
    # ── 中身を持つ枝の隠しクラスを引く（A-41）────────────────
    #
    # ★ **遅れて引きます。** 列挙はクラスより先に登録する（クラスの
    #   フィールドに列挙を書けるようにするため）ので、列挙を登録する時点では
    #   枝のクラスがまだありません。最初に要ったときに引いて覚えます。
    #   対になる定義: src/sema.c の branch_class
    def branch_class(mut self, e: rc[ast.EnumDef],
                     ev: mut rc[ast.EnumVal]) -> rc[ast.Class]:
        c0: rc[ast.Class] | None = ev.cls
        if c0 is not None:
            return c0
        owner: rc[types.ModuleSyms] = self.syms_by_name(e.owner_name)
        got: rc[ast.Class] | None = self.lookup_class_in(owner,
                                                         e.name + "$" + ev.name)
        if got is None:
            panic(diag.msg0("ssema.013", "sema: 枝のクラスがありません"))   # parser が必ず作ります
            return rc(ast.Class("", None))
        ev.cls = got
        return got

    def make_enum_value(mut self, n: mut rc[ast.Node], e: rc[ast.EnumDef],
                        ev: mut rc[ast.EnumVal], args: rc[ast.Node] | None,
                        nargs: int) -> rc[ast.Type]:
        if nargs != ev.nfields:
            label: str = diag.msg0("sema.437", "中身の数が違います")
            hint: str = (diag.msg("sema.140", "'{0}.{1}(…)' に {2} 個書きます", [copy(e.name), copy(ev.name), copy(str(ev.nfields))]))
            if ev.nfields == 0:
                label = diag.msg0("sema.436", "この枝は中身を持ちません")
                hint = diag.msg("sema.139", "'{0}.{1}' とだけ書きます", [copy(e.name), copy(ev.name)])
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.138", "枝 '{0}.{1}' は {2} 個の中身を取りますが、{3} 個渡されました", [copy(e.name), copy(ev.name), copy(str(ev.nfields)), copy(str(nargs))]),
                            label, ev.tok, diag.msg0("sema.438", "枝の定義はここです"), hint)

        bc: rc[ast.Class] = self.branch_class(e, ev)

        # タグを先頭に足して、隠しクラスの生成に書き換えます
        tag: rc[ast.Node] = ast.new_int_node(n.tok, ev.val)
        tag.next = args

        n.kind = ast.ND_CALL
        n.name = copy(bc.name)
        n.lhs = None
        n.args = tag
        n.en = e
        self.check_new(n, bc)

        # ★ 静的な型は**列挙**です（枝のクラスではありません）。
        n.type = e.type
        return unwrap_type(e.type)

    # ── 中身を持つ枝を作る（A-41）────────────────────────────
    #
    # ★ `Shape.Circle(1.5)` を `Shape$Circle(0, 1.5)` に書き換えます
    #   （第 1 引数がタグ）。作るのは**ふつうのクラスの生成**なので、
    #   確保も解放も所有権の検査も、クラスのための仕組みがそのまま効きます。
    #   対になる定義: src/sema.c の make_enum_value
    def fold_enum_value(mut self, n: mut rc[ast.Node]) -> rc[ast.Type] | None:
        lhs0: rc[ast.Node] = unwrap_node(n.lhs)
        e0: rc[ast.EnumDef] | None = None

        # `Color.Red` … 左が変数として宣言されていない名前で、列挙なら
        if lhs0.kind == ast.ND_VAR and self.lookup(lhs0.name) is None:
            e0 = self.lookup_enum(lhs0.name)

        # `mod.Color.Red` … 左がモジュール修飾の列挙なら
        if e0 is None and lhs0.kind == ast.ND_FIELD:
            lm: rc[types.ModuleSyms] | None = self.dot_module(lhs0)
            if lm is not None:
                e0 = self.lookup_enum_in(unwrap_ms(lm), lhs0.name)
        if e0 is None:
            return None

        ed: rc[ast.EnumDef] = e0
        v0: rc[ast.EnumVal] | None = ed.find(n.name)
        if v0 is None:
            names: list[str] = []
            q: rc[ast.EnumVal] | None = ed.vals
            while q is not None:
                qq: rc[ast.EnumVal] = q
                names.append(copy(qq.name))
                q = qq.next
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.141", "列挙 '{0}' に枝 '{1}' はありません", [copy(ed.name), copy(n.name)]),
                            diag.msg0("sema.439", "この枝は定義されていません"),
                            ed.tok, diag.msg0("sema.440", "列挙の定義はここです"),
                            diag.msg("ssema.014", "書ける枝は {0} です", [copy(strings.join(names, " / "))]))
        vv: rc[ast.EnumVal] = unwrap_enumval(v0)

        # ★ 中身を持つ列挙なら、枝も**物体**です（A-41）。
        #   表現を枝ごとに変えないので、中身なしの枝も同じ形で作ります。
        if ed.has_payload:
            return self.make_enum_value(n, ed, vv, None, 0)

        # ★ ここで木を書き換える（畳み込み）
        n.kind = ast.ND_INT
        n.ival = vv.val
        n.lhs = None
        n.type = ed.type
        n.en = ed
        return ed.type

    def check_field(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ 列挙の枝はフィールドではない（A-37）。モジュール解決より先に見る
        #   ——`Color.Red` の `Color` は変数でもモジュールでもないため。
        fe: rc[ast.Type] | None = self.fold_enum_value(n)
        if fe is not None:
            return fe

        ms: rc[types.ModuleSyms] | None = self.dot_module(n)
        if ms is not None:
            return self.check_module_global(n, ms)

        obj: rc[ast.Node] = unwrap_node(n.lhs)
        ot: rc[ast.Type] = auto_deref(self.check_expr(obj))   # rc[T] は中身のように使える

        if ot.kind == ast.TY_OPT:
            self.reject_opt_access(obj, n, diag.msg0("sema.441", "フィールド"), ot)

        if ot.kind != ast.TY_CLASS:
            diag.error_full(unwrap_tok(obj.tok),
                            diag.msg("sema.144", "型 '{0}' にフィールドはありません", [copy(ast.type_name(ot))]),
                            diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(ot))]), None, "",
                            diag.msg0("sema.442", "'.' でフィールドを読めるのは class のインスタンスだけです"))
            return self.ty_int()

        c: rc[ast.Class] = unwrap_class(ot.cls)
        f: rc[ast.Field] | None = self.lookup_field(c, n.name)
        if f is None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.145", "クラス '{0}' にフィールド '{1}' はありません", [copy(c.name), copy(n.name)]),
                            diag.msg0("sema.443", "このフィールドは宣言されていません"),
                            c.tok, diag.msg0("sema.444", "クラスの定義はここです"),
                            diag.msg0("sema.445", "クラス本体の先頭に「名前: 型」の形で宣言してください"))
            return self.ty_int()

        n.field = f     # ★ codegen はこれ（の index）を getelementptr に渡す
        return unwrap_type(f.type)

    # クラスのメソッド呼び出しの検査
    def check_class_method(mut self, n: mut rc[ast.Node], c: rc[ast.Class]) -> rc[ast.Type]:
        # ★ メソッドは「クラスが定義されたモジュール」の表にいる
        mname: str = self.mangle(c.name, n.name)
        owner: rc[types.ModuleSyms] = self.syms_by_name(c.owner_name)
        f: rc[types.FuncSig] | None = self.lookup_func_in(owner, mname)
        if f is None:
            hint: str = ""
            if self.lookup_field(c, n.name) is not None:
                hint = diag.msg("sema.147", "'{0}' はフィールドです。'()' を外してください", [copy(n.name)])
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.146", "クラス '{0}' にメソッド '{1}' はありません", [copy(c.name), copy(n.name)]),
                            diag.msg0("sema.446", "このメソッドは定義されていません"),
                            c.tok, diag.msg0("sema.444", "クラスの定義はここです"), hint)
            return self.ty_int()

        # ★ drop は自分で呼べません（仕様 §6.2。E-DROP-2）。
        #   対になる定義: src/sema.c の check_class_method
        if n.name == "drop":
            diag.error_code_full(unwrap_tok(n.tok), "E-DROP-2",
                                 diag.msg0("sema.447", "drop は自分で呼べません（解放のときに自動で呼ばれます）"),
                                 diag.msg0("sema.448", "ここで呼ぶと、解放のときにもう一度呼ばれます"), None, "",
                                 diag.msg0("sema.449", "早く後始末をしたいときは、別の名前のメソッド（close など）に分けてください（仕様 §6.2）"))

        # ★ 並べ替えと既定値の穴埋め（A-38）。self のぶん 1 つ飛ばす。
        bind_args_sig(n, unwrap_sig(f), 1, diag.msg("sema.148", "メソッド '{0}'", [copy(mname)]))

        # 引数の個数（self は数えない）
        nargs: int = count_siblings(n.args)
        if nargs != f.nparams - 1:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.149", "メソッド '{0}' は {1} 個の引数を取りますが、{2} 個渡されました", [copy(mname), copy(str(f.nparams - 1)), copy(str(nargs))]),
                            diag.msg0("sema.450", "呼び出しの引数の個数が違います"),
                            f.tok, diag.msg0("sema.451", "このメソッドはここで定義されています"),
                            diag.msg0("sema.452", "self は自動的に渡されるので、書く必要はありません"))

        # ★ 第 1 引数は self なので、実引数は params[i + 1] と比べる
        i: int = 0
        a: rc[ast.Node] | None = n.args
        while a is not None:
            arg: rc[ast.Node] = a
            want: rc[ast.Type] = f.params[i + 1]
            self.expected = want
            at: rc[ast.Type] = self.check_expr(arg)
            self.expected = None
            # ★ 呼び先がしまうなら、捕獲した lambda は渡せません（A-43）
            if arg.caps is not None and not arg.is_closure:
                mnode: rc[ast.Node] | None = f.node
                mstores: bool = True
                if mnode is not None:
                    mstores = self.fn_param_escapes_at(unwrap_node(mnode).body,
                                                       f.pnames[i + 1], 0)
                if mstores:
                    self.reject_escaping_closure(arg, diag.msg0("sema.410", "しまうことが"))
            mark_arg_own_rc(arg, f, i + 1)
            # ★ closure を fn の引数へ（A-51）
            if not self.closure_to_fn_arg(arg, at, f, i + 1, mname) and not ast.type_assignable(at, want):
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.150", "メソッド '{0}' の第 {1} 引数: 型 '{2}' を '{3}' に渡せません", [copy(mname), copy(str(i + 1)), copy(ast.type_name(at)), copy(ast.type_name(want))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]),
                                f.tok,
                                diag.msg("sema.151", "引数 '{0}' は '{1}' 型です", [copy(f.pnames[i + 1]), copy(ast.type_name(want))]),
                                self.no_implicit_hint(at, want))
            i = i + 1
            a = arg.next

        n.ir_name = copy(f.ir_name)
        n.is_extern = self.is_extern_owner(f.owner)
        self.check_can_fail(n, f, mname)
        return unwrap_type(f.ret)

    def check_method(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ 中身を持つ枝の生成（A-41）。`Shape.Circle(1.5)` はメソッド呼び出しに
        #   見えますが、**枝を作る式**です。
        lh0: rc[ast.Node] | None = n.lhs
        if lh0 is not None:
            lhv: rc[ast.Node] = lh0
            if lhv.kind == ast.ND_VAR and self.lookup(lhv.name) is None:
                eb: rc[ast.EnumDef] | None = self.lookup_enum(lhv.name)
                if eb is not None:
                    ed0: rc[ast.EnumDef] = eb
                    vb: rc[ast.EnumVal] | None = ed0.find(n.name)
                    if vb is None:
                        diag.error_full(unwrap_tok(n.tok),
                                        diag.msg("sema.141", "列挙 '{0}' に枝 '{1}' はありません", [copy(ed0.name), copy(n.name)]),
                                        diag.msg0("sema.439", "この枝は定義されていません"), ed0.tok,
                                        diag.msg0("sema.440", "列挙の定義はここです"), "")
                        return self.ty_int()
                    vbb: rc[ast.EnumVal] = vb
                    if not ed0.has_payload:
                        diag.error_full(unwrap_tok(n.tok),
                                        diag.msg("sema.161", "枝 '{0}.{1}' は中身を持ちません", [copy(ed0.name), copy(vbb.name)]),
                                        diag.msg0("sema.462", "ここに '(' は書けません"), vbb.tok,
                                        diag.msg0("sema.438", "枝の定義はここです"),
                                        diag.msg("sema.139", "'{0}.{1}' とだけ書きます", [copy(ed0.name), copy(vbb.name)]))
                    # 注意: 実引数の並びを**先に受けてから**渡します。
                    #   n を可変で貸しながら n.args を共有で貸せません。
                    bargs: rc[ast.Node] | None = n.args
                    nb: int = 0
                    ab0: rc[ast.Node] | None = bargs
                    while ab0 is not None:
                        abn: rc[ast.Node] = ab0
                        nb = nb + 1
                        ab0 = abn.next
                    return self.make_enum_value(n, ed0, vbb, bargs, nb)

        ms: rc[types.ModuleSyms] | None = self.dot_module(n)
        if ms is not None:
            return self.check_module_call(n, ms)

        obj: rc[ast.Node] = unwrap_node(n.lhs)
        ot: rc[ast.Type] = auto_deref(self.check_expr(obj))
        if ot.kind == ast.TY_OPT:
            self.reject_opt_access(obj, n, diag.msg0("sema.463", "メソッド"), ot)

        if ot.kind == ast.TY_CLASS:
            return self.check_class_method(n, unwrap_class(ot.cls))

        # ★ ここから先は、引数の名前を持たない呼び先です（A-38）。
        #   インタフェース越しは**実行時に実装が決まる**ので、名前も既定値も
        #   使えません（どの実装の名前を見ればよいか決まらないため）。
        if ot.kind == ast.TY_IFACE:
            reject_kwargs(n.args,
                          diag.msg0("sema.464", "インタフェース越しの呼び出しでは、名前で引数を渡せません"),
                          diag.msg0("sema.465", "どの実装が呼ばれるかは実行時に決まります。名前と既定値が使えるのは、クラスの型が分かっているときだけです"))
        else:
            reject_kwargs(n.args,
                          diag.msg("sema.162", "'{0}' は名前で引数を受け取りません", [copy(n.name)]),
                          diag.msg0("sema.466", "名前で渡せるのは、この言語で定義した関数・メソッド・生成だけです"))

        # ★ インタフェース越しの呼び出し。
        #   どの実装が呼ばれるかは **実行時に**決まる（vtable を引く）。
        if ot.kind == ast.TY_IFACE:
            ifc: rc[ast.Iface] = unwrap_iface(ot.iface)
            found: bool = False
            slot: int = 0
            sig2: rc[ast.Node] = ast.new_node(ast.ND_FUNC, None)
            for q in ifc.methods:
                if q.name == n.name:
                    found = True
                    slot = q.slot + 0     # 注意: 借用ではなく値で受ける
                    sig2 = unwrap_node(q.sig)
            if not found:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.163", "インタフェース '{0}' に '{1}' はありません", [copy(ifc.name), copy(n.name)]),
                                diag.msg0("sema.467", "このメソッドは宣言されていません"), ifc.tok,
                                diag.msg0("sema.468", "インタフェースの定義はここです"),
                                diag.msg0("sema.469", "インタフェース越しに呼べるのは、そこに宣言したものだけです"))

            want2: int = count_siblings(sig2.params) - 1   # self は数えない
            na3: int = count_siblings(n.args)
            if na3 != want2:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg("sema.165", "'{0}.{1}' は {2} 個の引数を取ります", [copy(ifc.name), copy(n.name), copy(str(want2))]),
                                   diag.msg("sema.164", "引数の個数が違います（{0} 個渡されました）", [copy(str(na3))]))

            k2: int = 1
            pm2: rc[ast.Node] | None = unwrap_node(sig2.params).next
            a2: rc[ast.Node] | None = n.args
            while a2 is not None:
                an3: rc[ast.Node] = a2
                pn3: rc[ast.Node] = unwrap_node(pm2)
                wt2: rc[ast.Type] = self.resolve_type(unwrap_node(pn3.type_ref))
                self.expected = wt2
                at3: rc[ast.Type] = self.check_expr(an3)
                self.expected = None
                if not ast.type_assignable(at3, wt2):
                    diag.error_at_hint(unwrap_tok(an3.tok),
                                       diag.msg("sema.064", "ここには '{0}' が必要です", [copy(ast.type_name(wt2))]),
                                       diag.msg("sema.166", "{0} 番目の引数が '{1}' 型です", [copy(str(k2)), copy(ast.type_name(at3))]))
                k2 = k2 + 1
                pm2 = pn3.next
                a2 = an3.next

            n.iface_slot = slot
            n.is_iface_call = True

            # ★ 失敗しうるメソッド（A-40）。**宣言に書いてある raises** で見ます。
            #   どの実装が呼ばれるかは実行時に決まりますが、**投げうるエラーの
            #   集合は宣言で固定**してあるので（check_implements が実装に同じ
            #   raises を求めます）、呼ぶ側はここで決められます。
            if sig2.err_types is not None:
                tmp: rc[types.FuncSig] = rc(types.FuncSig(n.name, sig2.tok))
                self.resolve_raises(sig2, tmp)
                self.check_can_fail(n, tmp, ifc.name + "." + n.name)

            return self.resolve_type(unwrap_node(sig2.type_ref))

        # ── weak[T].upgrade() — 生きていれば rc[T]、無ければ None（A-50）──
        if ot.kind == ast.TY_WEAK:
            if n.name != "upgrade":
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.636", "weak にあるのは upgrade() だけです（中身を使うには upgrade() で rc[T] に戻します）"),
                                   diag.msg("sema.635", "'weak' に '{0}' はありません", [copy(n.name)]))
            if n.args is not None:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.638", "w.upgrade() の形で使ってください"),
                                   diag.msg0("sema.637", "upgrade は引数を取りません"))
            ur: rc[ast.Type] = ast.type_rc(ast.elem_of(ot))
            return ast.type_opt(ur)

        # ── Thread[R].join() — 終わるまで待って戻り値を受け取る ──
        #
        # 注意: join は所有を消費します（2 回 join できません）。それを保証するのは
        #    所有権検査（C 版 ownck）です。
        if ot.kind == ast.TY_THREAD:
            if n.name != "join":
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.168", "Thread にあるのは join() だけです"),
                                   diag.msg("sema.167", "'Thread' に '{0}' はありません", [copy(n.name)]))
            if n.args is not None:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.170", "t.join() の形で使ってください"),
                                   diag.msg0("sema.169", "join は引数を取りません"))
            return ast.elem_of(ot)

        # ── mutex[T].lock(f) — ロックを取り、f(中身) を呼び、必ず解く ──
        #
        # ★ 生の lock / unlock は出しません（解き忘れが起きえない形）。
        if ot.kind == ast.TY_MUTEX:
            if n.name != "lock":
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.172", "mutex にあるのは lock(関数) だけです"),
                                   diag.msg("sema.171", "'mutex' に '{0}' はありません", [copy(n.name)]))
            nlk: int = count_siblings(n.args)
            if nlk != 1:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.174", "m.lock(関数) の形で使ってください"),
                                   diag.msg("sema.173", "lock は 1 個の引数（関数）を取ります（{0} 個渡されました）", [copy(str(nlk))]))
                return self.ty_int()
            lan: rc[ast.Node] = unwrap_node(n.args)
            lft: rc[ast.Type] = self.check_expr(lan)
            if lft.kind != ast.TY_FN or len(lft.params) != 1:
                diag.error_at_hint(unwrap_tok(lan.tok),
                                   diag.msg("sema.176", "lock には 'fn({0}) -> R' の関数を渡してください", [copy(ast.type_name(ast.elem_of(ot)))]),
                                   diag.msg("sema.175", "'{0}' はその形の関数ではありません", [copy(ast.type_name(lft))]))
                return self.ty_int()
            reject_raising_fn(lan, lft, "lock")
            if not ast.type_assignable(ast.elem_of(ot), lft.params[0]):
                diag.error_at_hint(unwrap_tok(lan.tok),
                                   diag.msg("sema.178", "中身は '{0}' です", [copy(ast.type_name(ast.elem_of(ot)))]),
                                   diag.msg("sema.177", "この関数は '{0}' を受け取ります", [copy(ast.type_name(lft.params[0]))]))
            return ast.elem_of(lft)

        # ★ list のメソッド。C 版と同じ規則・同じ文言にすること。
        #   argk: "e"=要素型 / "i"=int / "l"=同じ list / "-"=引数なし
        #   retk: "e"=要素型 / "i"=int / "n"=None / "l"=同じ list
        if ot.kind == ast.TY_LIST:
            names: list[str] = ["pop", "insert", "remove", "index",
                                "reverse", "clear", "copy", "extend"]
            argks: list[str] = ["-", "i", "i", "e", "-", "-", "-", "l"]
            retks: list[str] = ["e", "n", "e", "i", "n", "n", "l", "n"]
            usages: list[str] = ["xs.pop()", diag.msg0("sema.470", "xs.insert(位置, 値)"),
                                 diag.msg0("sema.471", "xs.remove(位置)"), diag.msg0("sema.472", "xs.index(値)"),
                                 "xs.reverse()", "xs.clear()", "xs.copy()",
                                 diag.msg0("sema.473", "xs.extend(別のリスト)")]
            mi: int = 0
            while mi < len(names):
                if names[mi] == n.name:
                    el: rc[ast.Type] = ast.elem_of(ot)
                    want: int = 1
                    if argks[mi] == "-":
                        want = 0
                    if n.name == "insert":
                        want = 2
                    na: int = count_siblings(n.args)
                    if na != want:
                        diag.error_full(unwrap_tok(n.tok),
                                        diag.msg("sema.179", "{0} は {1} 個の引数を取りますが、{2} 個渡されました", [copy(n.name), copy(str(want)), copy(str(na))]),
                                        diag.msg0("sema.197", "引数の個数が違います"), None, "",
                                        diag.msg("sema.180", "{0} の形で使ってください", [copy(usages[mi])]))

                    if n.name == "insert":
                        a0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
                        if a0.kind != ast.TY_INT:
                            diag.error_at(unwrap_tok(unwrap_node(n.args).tok),
                                          diag.msg("sema.181", "insert の位置は int です（'{0}' 型でした）", [copy(ast.type_name(a0))]))
                        a1n: rc[ast.Node] = unwrap_node(unwrap_node(n.args).next)
                        self.expected = el
                        a1: rc[ast.Type] = self.check_expr(a1n)
                        self.expected = None
                        if not ast.type_assignable(a1, el):
                            diag.error_at(unwrap_tok(a1n.tok),
                                          diag.msg("sema.182", "'{0}' のリストに '{1}' は入れられません", [copy(ast.type_name(el)), copy(ast.type_name(a1))]))
                    elif argks[mi] == "i":
                        b0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
                        if b0.kind != ast.TY_INT:
                            diag.error_at(unwrap_tok(unwrap_node(n.args).tok),
                                          diag.msg("sema.183", "{0} の引数は int です（'{1}' 型でした）", [copy(n.name), copy(ast.type_name(b0))]))
                    elif argks[mi] == "e":
                        self.expected = el
                        c0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
                        self.expected = None
                        if not ast.type_assignable(c0, el):
                            diag.error_at(unwrap_tok(unwrap_node(n.args).tok),
                                          diag.msg("sema.184", "'{0}' のリストから '{1}' は探せません", [copy(ast.type_name(el)), copy(ast.type_name(c0))]))
                    elif argks[mi] == "l":
                        d0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
                        if not ast.type_assignable(d0, ot):
                            diag.error_at(unwrap_tok(unwrap_node(n.args).tok),
                                          diag.msg("sema.185", "extend には同じ型のリストが必要です（'{0}' でした）", [copy(ast.type_name(d0))]))

                    if retks[mi] == "e":
                        return el
                    if retks[mi] == "i":
                        return self.ty_int()
                    if retks[mi] == "l":
                        return ot
                    return self.ty_none()
                mi = mi + 1

        if ot.kind == ast.TY_LIST and n.name == "append":
            nargs: int = count_siblings(n.args)
            if nargs != 1:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.186", "append は 1 個の引数を取りますが、{0} 個渡されました", [copy(str(nargs))]),
                                diag.msg0("sema.197", "引数の個数が違います"), None, "",
                                diag.msg0("sema.474", "xs.append(値) の形で使ってください"))

            elem: rc[ast.Type] = ast.elem_of(ot)
            arg: rc[ast.Node] = unwrap_node(n.args)
            self.expected = elem
            at: rc[ast.Type] = self.check_expr(arg)
            self.expected = None

            if not ast.type_assignable(at, elem):
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.187", "'{0}' のリストに '{1}' を追加できません", [copy(ast.type_name(elem)), copy(ast.type_name(at))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]),
                                None, "", self.no_implicit_hint(at, elem))
            n.args = self.range_coerce(n.args, elem)   # A-28
            return self.ty_none()

        diag.error_full(unwrap_tok(n.tok),
                        diag.msg("sema.188", "型 '{0}' にメソッド '{1}' はありません", [copy(ast.type_name(ot)), copy(n.name)]),
                        diag.msg0("sema.475", "このメソッドは存在しません"), None, "",
                        diag.msg0("sema.476", "list[T] で使えるのは append / pop / insert / remove / index / reverse / clear / copy / extend です（class のメソッドは自分で定義できます）"))
        return self.ty_int()

    # lexer.make(1, "x") / lexer.Token(1, "x") — 他のモジュールの関数・クラス
    def check_module_call(mut self, n: mut rc[ast.Node], ms: rc[types.ModuleSyms]) -> rc[ast.Type]:
        mod_name: str = mod_name_of(ms)
        n.mod_name = copy(mod_name)

        # ★ 名前がクラスなら、これはインスタンス生成
        c: rc[ast.Class] | None = self.lookup_class_in(ms, n.name)
        if c is not None:
            n.is_extern = ms != self.cur_syms()
            return self.check_new(n, c)

        f: rc[types.FuncSig] | None = self.lookup_func_in(ms, n.name)

        # ★ 他のモジュールのジェネリック関数も実体化する。
        #   注意: 実体はテンプレートのモジュールに作られるので、呼ぶ側から見ると
        #     ふつうの「他モジュールの関数」になる。
        if f is not None and f.tmpl is not None:
            f = self.instantiate_func(f, n)

        if f is None:
            hint: str = diag.msg0("sema.454", "そのモジュールのトップレベルに def があるか確認してください")
            if self.lookup_global_in(ms, n.name) is not None:
                hint = (diag.msg("sema.153", "'{0}' はグローバル変数です。'()' を外してください", [copy(n.name)]))
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.152", "モジュール '{0}' に関数 '{1}' はありません", [copy(mod_name), copy(n.name)]),
                            diag.msg0("sema.453", "この関数は定義されていません"), None, "", hint)
            return self.ty_int()

        n.ir_name = copy(f.ir_name)
        n.is_extern = self.is_extern_owner(f.owner)
        return self.check_call_sig(n, f, diag.msg0("sema.455", "関数"))

    # インスタンス生成 Token(1, "x") の検査
    def check_new(mut self, n: mut rc[ast.Node], c0: rc[ast.Class]) -> rc[ast.Type]:
        c: rc[ast.Class] = c0

        # ★ ジェネリッククラスの生成。**どの実体を作るのかは
        #   「代入される先の型」から決める**（設計 §1：推論は左辺からだけ）。
        #
        #     d: Dict[str, int] = Dict()
        #                         ^^^^^^ ここには型引数を書かない
        if c.node is not None and unwrap_node(c.node).targs is not None:
            ok: bool = False
            want: rc[ast.Type] | None = self.expected
            if want is not None:
                w: rc[ast.Type] = want
                if w.kind == ast.TY_CLASS and w.cls is not None:
                    wc0: rc[ast.Class] = unwrap_cls(w.cls)
                    ft: rc[ast.Class] | None = wc0.from_template
                    if ft is not None and same_class(ft, c):
                        c = wc0
                        ok = True
            if not ok:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.189", "'{0}' のどの実体を作るのか決められません", [copy(c.name)]),
                                diag.msg0("sema.477", "型引数が決まりません"), c.tok,
                                diag.msg0("sema.478", "このクラスは型引数を取ります"),
                                diag.msg("sema.190", "変数の型から決めます。'x: {0}[型, ...] = {1}(...)' の形で書いてください", [copy(c.name), copy(c.name)]))

        n.cls = c    # ★ codegen はこれを見て「生成」だと分かる

        nargs: int = count_siblings(n.args)

        # init が無いクラスは、引数なしでしか作れない
        if not c.has_init:
            if nargs != 0:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.191", "クラス '{0}' には init が無いので引数を渡せません", [copy(c.name)]),
                                diag.msg("sema.192", "{0} 個の引数が渡されています", [copy(str(nargs))]),
                                c.tok, diag.msg0("sema.444", "クラスの定義はここです"),
                                diag.msg0("sema.479", "引数を受け取るには init メソッドを定義してください:\n             def init(self, ...) -> None:"))
            return unwrap_type(c.type)

        # init があるなら、その引数と突き合わせる（self は飛ばす）
        owner: rc[types.ModuleSyms] = self.syms_by_name(c.owner_name)
        f: rc[types.FuncSig] = unwrap_sig(
            self.lookup_func_in(owner, self.mangle(c.name, "init")))

        # ★ 並べ替えと既定値の穴埋め（A-38）。self のぶん 1 つ飛ばす。
        bind_args_sig(n, f, 1, diag.msg("sema.193", "クラス '{0}'", [copy(c.name)]))
        nargs = count_siblings(n.args)

        if nargs != f.nparams - 1:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.194", "'{0}' の生成には {1} 個の引数が必要ですが、{2} 個渡されました", [copy(c.name), copy(str(f.nparams - 1)), copy(str(nargs))]),
                            diag.msg0("sema.197", "引数の個数が違います"),
                            f.tok, diag.msg0("sema.480", "init はここで定義されています"),
                            diag.msg0("sema.452", "self は自動的に渡されるので、書く必要はありません"))

        i: int = 0
        a: rc[ast.Node] | None = n.args
        while a is not None:
            arg: rc[ast.Node] = a
            want: rc[ast.Type] = f.params[i + 1]
            self.expected = want
            at: rc[ast.Type] = self.check_expr(arg)
            self.expected = None
            # ★ 生成はふつう「しまう」ので、捕獲した lambda は渡せません（A-43）
            if arg.caps is not None and not arg.is_closure:
                cnode: rc[ast.Node] | None = f.node
                cstores: bool = True
                if cnode is not None:
                    cstores = self.fn_param_escapes_at(unwrap_node(cnode).body,
                                                       f.pnames[i + 1], 0)
                if cstores:
                    self.reject_escaping_closure(arg, diag.msg0("sema.410", "しまうことが"))
            mark_arg_own_rc(arg, f, i + 1)
            # ★ closure を fn の引数へ（A-51）
            if not self.closure_to_fn_arg(arg, at, f, i + 1, c.name) and not ast.type_assignable(at, want):
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.195", "'{0}' の生成の第 {1} 引数: 型 '{2}' を '{3}' に渡せません", [copy(c.name), copy(str(i + 1)), copy(ast.type_name(at)), copy(ast.type_name(want))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]),
                                f.tok,
                                diag.msg("sema.151", "引数 '{0}' は '{1}' 型です", [copy(f.pnames[i + 1]), copy(ast.type_name(want))]),
                                self.no_implicit_hint(at, want))
            i = i + 1
            a = arg.next
        return unwrap_type(c.type)

    # 関数呼び出しの検査（型システム 5.7 の順序）
    # ── 複製できる型か（A-44）────────────────────────────────
    #
    # ★ 「複製できる」は型ごとに意味が違います。
    #     値型・列挙 … そのまま／枝ごとに中身を複製
    #     str        … 新しい文字列
    #     list[T]    … 新しい list（要素も T の複製）
    #     クラス      … `__copy__` を書いたものだけ
    #   対になる定義: src/sema.c の check_copyable
    def check_copyable(mut self, t: rc[ast.Type], at: rc[token.Token] | None) -> None:
        if (t.kind == ast.TY_INT or t.kind == ast.TY_FLOAT or
                t.kind == ast.TY_BOOL or t.kind == ast.TY_STR or
                t.kind == ast.TY_ENUM):
            return
        if t.kind == ast.TY_LIST or t.kind == ast.TY_OPT:
            self.check_copyable(ast.elem_of(t), at)
            return
        if t.kind == ast.TY_CLASS:
            c: rc[ast.Class] = unwrap_class(t.cls)
            owner: rc[types.ModuleSyms] = self.syms_by_name(c.owner_name)
            f: rc[types.FuncSig] | None = self.lookup_func_in(
                owner, self.mangle(c.name, "__copy__"))
            if f is not None:
                ff: rc[types.FuncSig] = f
                if ff.nparams == 1 and ast.type_equal(unwrap_type(ff.ret), t):
                    return
            hint: str = (diag.msg("sema.158", "複製できるようにするには __copy__ を書きます:\n             def __copy__(self) -> {0}:\n                 return {1}(…)", [copy(c.name), copy(c.name)]))
            if f is not None:
                hint = (diag.msg("sema.157", "'__copy__' は 'def __copy__(self) -> {0}:' の形で書きます", [copy(c.name)]))
            diag.error_full(unwrap_tok(at),
                            diag.msg("sema.155", "クラス '{0}' は copy できません", [copy(c.name)]),
                            diag.msg("sema.156", "'{0}' 型です", [copy(ast.type_name(t))]),
                            c.tok, diag.msg0("sema.444", "クラスの定義はここです"), hint)
            return

        hint2: str = (diag.msg0("sema.461", "複製できるのは 値型 / str / list / __copy__ を持つクラス / 列挙 と、それらの T | None です"))
        if t.kind == ast.TY_RC:
            hint2 = (diag.msg0("sema.460", "rc[T] は「1 つの値を 2 か所から持つ」ための型です（複製ではありません）。中身を複製するなら copy(r.get()) のように中身を渡してください"))
        diag.error_full(unwrap_tok(at),
                        diag.msg("sema.159", "'{0}' 型は copy できません", [copy(ast.type_name(t))]),
                        diag.msg0("sema.459", "ここは複製できる型ではありません"), None, "", hint2)

    def check_call(mut self, n: mut rc[ast.Node]) -> rc[ast.Type]:
        # ★ 名前が **関数型の変数**なら間接呼び出し
        #   注意: 変数を先に見る（同名の関数があっても変数が勝つ）
        fv: rc[types.VarEntry] | None = self.lookup(n.name)
        if fv is not None and (unwrap_type(fv.type).kind == ast.TY_FN or
                               unwrap_type(fv.type).kind == ast.TY_CLOSURE):
            ftv: rc[ast.Type] = unwrap_type(fv.type)
            # ★ 関数型には引数の**名前が入っていません**（A-38）。
            reject_kwargs(n.args,
                          diag.msg("sema.205", "関数の値 '{0}' は名前で引数を受け取りません", [copy(n.name)]),
                          diag.msg("sema.206", "この変数の型は '{0}' です。関数の型には引数の名前が入らないので、位置で渡してください", [copy(ast.type_name(ftv))]))
            na2: int = count_siblings(n.args)
            if na2 != len(ftv.params):
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.207", "'{0}' は {1} 個の引数を取りますが、{2} 個渡されました", [copy(n.name), copy(str(len(ftv.params))), copy(str(na2))]),
                                diag.msg0("sema.197", "引数の個数が違います"), None, "",
                                diag.msg("sema.208", "この変数の型は '{0}' です", [copy(ast.type_name(ftv))]))
            ai: int = 0
            arg: rc[ast.Node] | None = n.args
            while arg is not None:
                an2: rc[ast.Node] = arg
                self.expected = ftv.params[ai]
                at2: rc[ast.Type] = self.check_expr(an2)
                self.expected = None
                if not ast.type_assignable(at2, ftv.params[ai]):
                    diag.error_full(unwrap_tok(an2.tok),
                                    diag.msg("sema.209", "{0} 番目の引数の型が合いません", [copy(str(ai + 1))]),
                                    diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at2))]),
                                    None, "",
                                    diag.msg("sema.064", "ここには '{0}' が必要です", [copy(ast.type_name(ftv.params[ai]))]))
                ai = ai + 1
                arg = an2.next
            n.ir_name = copy(fv.ir_name)
            n.is_indirect = True
            n.type = ast.elem_of(ftv)
            # ★ 失敗しうる関数の値（A-49）。**型に書いてある raises** で見る
            #   対になる定義: src/sema.c の check_call
            if len(ftv.err_classes) > 0:
                dt: rc[token.Token] | None = fv.decl_tok
                if dt is None:
                    dt = n.tok
                ctmp: rc[types.FuncSig] = rc(types.FuncSig(n.name, dt))
                for ec in ftv.err_classes:
                    ctmp.raises_cls.append(ec)
                shown_fv: str = copy(n.name)
                self.check_can_fail(n, ctmp, shown_fv)
            return ast.elem_of(ftv)

        # ★ 組み込み（print / len / append …）には引数の名前がありません（A-38）。
        #   注意: クラス名なら生成なので、ここでは断りません（init の名前が使えます）。
        if self.lookup_func(n.name) is None and self.lookup_class(n.name) is None:
            reject_kwargs(n.args,
                          diag.msg("sema.162", "'{0}' は名前で引数を受け取りません", [copy(n.name)]),
                          diag.msg0("sema.466", "名前で渡せるのは、この言語で定義した関数・メソッド・生成だけです"))

        # ★ min / max（2 引数なので組み込みの表では表せない）
        #   注意: Python の min([1,2,3]) は入れていない（linalg.vmin を使う）
        if (n.name == "min" or n.name == "max") and self.lookup_func(n.name) is None:
            nm: int = count_siblings(n.args)
            if nm != 2:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg("sema.210", "{0}(a, b) の形で使ってください", [copy(n.name)]),
                                   diag.msg("sema.211", "{0} は 2 個の引数を取ります", [copy(n.name)]))
            m0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
            m1n: rc[ast.Node] = unwrap_node(unwrap_node(n.args).next)
            m1: rc[ast.Type] = self.check_expr(m1n)
            if not ast.type_equal(m0, m1):
                diag.error_at(unwrap_tok(m1n.tok),
                              diag.msg("sema.212", "{0} の 2 つの引数は同じ型である必要があります（'{1}' と '{2}'）", [copy(n.name), copy(ast.type_name(m0)), copy(ast.type_name(m1))]))
            if m0.kind != ast.TY_INT and m0.kind != ast.TY_FLOAT:
                diag.error_at_hint(unwrap_tok(unwrap_node(n.args).tok),
                                   diag.msg0("sema.214", "min / max が使えるのは int と float です"),
                                   diag.msg("sema.213", "'{0}' 型には使えません", [copy(ast.type_name(m0))]))
            n.builtin = ""
            n.ir_name = ""
            n.is_minmax = True
            n.type = m0
            return m0

        # ★ wrap_add / wrap_sub / wrap_mul。
        #   **桁あふれを検査せず 2 の補数で折り返す**算術。
        #   注意: 既定の + - * は桁あふれで panic する。折り返しを
        #     「そういう計算だ」として使いたいところ（法 2⁶⁴ の線形合同法など）
        #     のための逃げ道で、**書いた人の意図が演算ごとに見える。**
        #   注意: min / max と同じく 2 引数なので、組み込みの表では表せない。
        if is_wrap_name(n.name) and self.lookup_func(n.name) is None:
            nargsw: int = count_siblings(n.args)
            if nargsw != 2:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg("sema.210", "{0}(a, b) の形で使ってください", [copy(n.name)]),
                                   diag.msg("sema.211", "{0} は 2 個の引数を取ります", [copy(n.name)]))
            w0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
            w1n: rc[ast.Node] = unwrap_node(unwrap_node(n.args).next)
            w1: rc[ast.Type] = self.check_expr(w1n)
            # 注意: **問題のある側の引数**を指す（2 つとも int でないときは左から）
            if w0.kind != ast.TY_INT:
                diag.error_at_hint(unwrap_tok(unwrap_node(n.args).tok),
                                   diag.msg0("sema.215", "折り返す算術が使えるのは int だけです"),
                                   diag.msg("sema.213", "'{0}' 型には使えません", [copy(ast.type_name(w0))]))
            if w1.kind != ast.TY_INT:
                diag.error_at_hint(unwrap_tok(w1n.tok),
                                   diag.msg0("sema.215", "折り返す算術が使えるのは int だけです"),
                                   diag.msg("sema.213", "'{0}' 型には使えません", [copy(ast.type_name(w1))]))
            n.builtin = ""
            n.ir_name = ""
            n.is_wrap = True
            n.type = self.ty_int()
            return self.ty_int()

        # ── rc(x) — 共有所有にくるむ ──
        #
        # ★ 型が「引数の型から作られる」ので、組み込み関数の表では表せません
        if n.name == "rc" and self.lookup_func("rc") is None:
            nargs0: int = count_siblings(n.args)
            if nargs0 != 1:
                diag.error_at_hint(unwrap_tok(n.tok), diag.msg0("sema.217", "rc(値) の形で使ってください"),
                                   diag.msg0("sema.216", "rc は 1 個の引数を取ります"))
                return self.ty_int()
            at0: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
            if at0.kind != ast.TY_CLASS:
                diag.error_at_hint(unwrap_tok(unwrap_node(n.args).tok),
                                   diag.msg0("sema.218", "rc に入れられるのはクラスのインスタンスだけです"),
                                   diag.msg("sema.026", "'{0}' は rc に入れられません", [copy(ast.type_name(at0))]))
            n.is_extern = False
            return ast.type_rc(at0)

        # ── weak(r) — 弱参照を作る（A-50）── r は借りるだけ
        #   対になる定義: src/sema.c の check_call
        if n.name == "weak" and self.lookup_func("weak") is None:
            nargsw: int = count_siblings(n.args)
            if nargsw != 1:
                diag.error_at_hint(unwrap_tok(n.tok), diag.msg0("sema.631", "weak(r) の形で使ってください（r は rc[T]）"),
                                   diag.msg0("sema.630", "weak は 1 個の引数を取ります"))
                return self.ty_int()
            atw: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
            if atw.kind != ast.TY_RC:
                diag.error_full(unwrap_tok(unwrap_node(n.args).tok),
                                diag.msg("sema.632", "'{0}' から弱参照は作れません", [copy(ast.type_name(atw))]),
                                diag.msg0("sema.633", "ここには rc[T] が必要です"), None, "",
                                diag.msg0("sema.634", "弱参照は共有している値（rc[T]）を指します。先に rc(...) で包んでください"))
                return self.ty_int()
            n.is_extern = False
            wt: rc[ast.Type] = ast.type_weak(ast.elem_of(atw))
            n.type = wt
            return wt

        # ── spawn(f, a…) — 別スレッドで f(a…) を始める（A-18）──
        #
        # ★ 新しい構文は作りません。**呼び出しの形のまま**です。
        # ★ 引数は**何個でも**渡せます。クロージャが無いので、もとは
        #   「関数 + 引数 1 つ」でしたが、その形だと複数の値を渡すのにクラスへ
        #   まとめるしかなく、**クラスは借りを保存できません**（E-BORROW-3）。
        #   scope: を入れても借りを共有する形が書けないままだった、
        #   というのが可変長にした理由です。
        if n.name == "spawn" and self.lookup_func("spawn") is None:
            nsp: int = count_siblings(n.args)
            if nsp < 1:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.220", "spawn(関数, 引数…) の形で使ってください"),
                                   diag.msg0("sema.219", "spawn には少なくとも関数が要ります"))
                return self.ty_int()
            fa: rc[ast.Node] = unwrap_node(n.args)
            ft: rc[ast.Type] = self.check_expr(fa)
            # ★ 別のスレッドは、作った枠より長生きしえます（A-43）
            self.reject_escaping_closure(n.args, diag.msg0("sema.483", "別のスレッドへ渡すことが"))
            if ft.kind != ast.TY_FN:
                diag.error_at_hint(unwrap_tok(fa.tok),
                                   diag.msg0("sema.222", "spawn の 1 つ目は関数です（例: spawn(work, job)）"),
                                   diag.msg("sema.221", "'{0}' は関数ではありません", [copy(ast.type_name(ft))]))
                return self.ty_int()
            reject_raising_fn(fa, ft, "spawn")
            if len(ft.params) != nsp - 1:
                diag.error_at_hint(unwrap_tok(fa.tok),
                                   diag.msg("sema.224", "'{0}' は {1} 個の引数を取ります", [copy(ast.type_name(ft)), copy(str(len(ft.params)))]),
                                   diag.msg("sema.223", "spawn に渡した引数が {0} 個です", [copy(str(nsp - 1))]))
                return self.ty_int()
            ai: rc[ast.Node] | None = fa.next
            kk: int = 0
            while ai is not None:
                an: rc[ast.Node] = ai
                self.expected = ft.params[kk]
                avt: rc[ast.Type] = self.check_expr(an)
                self.expected = None
                if not ast.type_assignable(avt, ft.params[kk]):
                    diag.error_at_hint(unwrap_tok(an.tok),
                                       diag.msg("sema.064", "ここには '{0}' が必要です", [copy(ast.type_name(ft.params[kk]))]),
                                       diag.msg("sema.166", "{0} 番目の引数が '{1}' 型です", [copy(str(kk + 1)), copy(ast.type_name(avt))]))
                kk = kk + 1
                ai = an.next
            n.is_extern = False
            return ast.type_thread(ast.elem_of(ft))

        # ── mutex(x) — 中身をロックの内側に閉じる ──
        if n.name == "mutex" and self.lookup_func("mutex") is None:
            nmx: int = count_siblings(n.args)
            if nmx != 1:
                diag.error_at_hint(unwrap_tok(n.tok), diag.msg0("sema.226", "mutex(値) の形で使ってください"),
                                   diag.msg0("sema.225", "mutex は 1 個の引数を取ります"))
                return self.ty_int()
            mat: rc[ast.Type] = self.check_expr(unwrap_node(n.args))
            if mat.kind != ast.TY_CLASS and mat.kind != ast.TY_LIST:
                diag.error_at_hint(unwrap_tok(unwrap_node(n.args).tok),
                                   diag.msg0("sema.227", "mutex に入れられるのはクラスかリストだけです"),
                                   diag.msg("sema.032", "'{0}' は mutex に入れられません", [copy(ast.type_name(mat))]))
            n.is_extern = False
            return ast.type_mutex(mat)

        # ── f-string の書式指定が作る呼び出し（A-45）──────────────
        #
        # ★ 利用者は書けない名前です（'.' が入っているので識別子になりません）。
        #   パーサが f"{x:>8}" を脱糖して作ります。
        if n.name == "fmt.pad" or n.name == "fmt.f64":
            is_pad: bool = n.name == "fmt.pad"
            fi: int = 0
            fa: rc[ast.Node] | None = n.args
            while fa is not None:
                faa: rc[ast.Node] = fa
                fat: rc[ast.Type] = self.check_expr(faa)
                need: rc[ast.Type] = self.ty_int()
                if fi == 0:
                    if is_pad:
                        need = self.ty_str()
                    else:
                        need = self.ty_float()
                if not ast.type_assignable(fat, need):
                    msg: str = (diag.msg("sema.229", "小数の書式は '{0}' 型には使えません", [copy(ast.type_name(fat))]))
                    fhint: str = (diag.msg0("sema.485", "'.2f' のような書式は float にだけ使えます（int なら float(x) にしてください）"))
                    if is_pad:
                        msg = (diag.msg("sema.228", "書式（桁揃え）は '{0}' 型には使えません", [copy(ast.type_name(fat))]))
                        fhint = diag.msg0("sema.484", "桁揃えは文字列にしてから行います")
                    diag.error_full(unwrap_tok(faa.tok), msg,
                                    diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(fat))]),
                                    None, "", fhint)
                fi = fi + 1
                fa = faa.next
            n.builtin = ""
            n.ir_name = "pl_fmt_f64"
            if is_pad:
                n.ir_name = "pl_str_pad"
            n.is_fmt = True
            n.type = self.ty_str()
            return self.ty_str()

        # ── copy(v) — 複製の抽象（A-44）────────────────────────
        #
        # ★ **どの型でも書けること**が値打ちです。型ごとに出すものを変えます。
        #   注意: クラスは `__copy__` を書いたものだけです（黙って浅く写すと、
        #     所有しているフィールドを 2 つの実体が指して二重解放になります）。
        if n.name == "copy" and self.lookup_func("copy") is None:
            ncp: int = count_siblings(n.args)
            if ncp != 1:
                diag.error_at_hint(unwrap_tok(n.tok),
                                   diag.msg0("sema.231", "copy(値) の形で使ってください"),
                                   diag.msg("sema.230", "copy は 1 個の引数を取りますが、{0} 個渡されました", [copy(str(ncp))]))
            cav: rc[ast.Node] = unwrap_node(n.args)
            ct: rc[ast.Type] = auto_deref(self.check_expr(cav))
            self.check_copyable(ct, cav.tok)
            n.builtin = ""
            n.ir_name = ""
            n.is_copy = True
            n.type = ct
            return ct

        if self.is_builtin_name(n.name):
            return self.check_builtin_call(n)

        # ★ 名前がクラスなら、これはインスタンス生成
        cls: rc[ast.Class] | None = self.lookup_class(n.name)
        if cls is not None:
            return self.check_new(n, cls)

        # ① 定義されているか
        f: rc[types.FuncSig] | None = self.lookup_func(n.name)

        # ★ ジェネリック関数なら、実引数から型引数を決めて実体を作る
        if f is not None and f.tmpl is not None:
            f = self.instantiate_func(f, n)

        if f is None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.232", "未定義の関数 '{0}' です", [copy(n.name)]),
                            diag.msg0("sema.453", "この関数は定義されていません"), None, "",
                            diag.msg0("sema.486", "関数名の綴りを確認してください（定義の順序は問いません。後ろで定義した関数も呼べます）"))
            return self.ty_int()

        # ★ 呼ぶ相手の IR 名（モジュール修飾済み）を codegen に渡す
        n.ir_name = copy(f.ir_name)
        n.is_extern = self.is_extern_owner(f.owner)

        # ③④ 引数の個数と型
        return self.check_call_sig(n, f, diag.msg0("sema.455", "関数"))

    # 呼び出しの引数を FuncSig と突き合わせる（③④）
    def check_call_sig(mut self, n: mut rc[ast.Node], f: rc[types.FuncSig],
                       what: str) -> rc[ast.Type]:
        shown: str = f.name
        if len(n.mod_name) > 0:
            shown = n.mod_name + "." + n.name

        self.check_can_fail(n, f, shown)

        # ★ 並べ替えと既定値の穴埋め（A-38）。ここを通ると n.args は
        #   「ちょうど引数の数だけ・定義の順」になります。
        bind_args_sig(n, f, 0, what + " '" + shown + "'")

        nargs: int = count_siblings(n.args)
        if nargs != f.nparams:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.246", "{0} '{1}' は {2} 個の引数を取りますが、{3} 個渡されました", [copy(what), copy(shown), copy(str(f.nparams)), copy(str(nargs))]),
                            diag.msg0("sema.450", "呼び出しの引数の個数が違います"),
                            f.tok, diag.msg0("sema.492", "この関数はここで定義されています"), "")

        i: int = 0
        a: rc[ast.Node] | None = n.args
        while a is not None:
            arg: rc[ast.Node] = a
            # 注意: 引数には期待型を渡さない
            # ★ 例外は**関数型**です（A-42）。lambda はここから型をもらいます。
            self.expected = None
            if f.params[i].kind == ast.TY_FN or f.params[i].kind == ast.TY_CLOSURE:
                self.expected = f.params[i]
            at: rc[ast.Type] = self.check_expr(arg)
            self.expected = None
            # ★ 捕獲した lambda は、**しまわない**相手にだけ渡せます（A-43）
            if arg.caps is not None and not arg.is_closure:
                fnode: rc[ast.Node] | None = f.node
                stores: bool = True
                if fnode is not None:
                    stores = self.fn_param_escapes_at(unwrap_node(fnode).body,
                                                      f.pnames[i], 0)
                if stores:
                    diag.error_full(unwrap_tok(arg.tok),
                                    diag.msg("sema.247", "捕獲した lambda を '{0}' に渡せません", [copy(shown)]),
                                    diag.msg0("sema.499", "この lambda は外の変数を捕まえています"),
                                    f.tok,
                                    diag.msg("sema.248", "'{0}' は受け取った関数をしまいます", [copy(f.pnames[i])]),
                                    diag.msg0("sema.500", "捕まえた値は作った関数の枠の上にあるので、しまわれると読めなくなります。捕獲しない lambda か、def で書いた関数を渡してください"))
            # ★ codegen へ「この実引数は借用で渡すと**分かっている**」ことを
            #   伝えます。借用なら相手は所有権を受け取らないので、呼び出し後に
            #   一時値を解放できます（A-21e）。
            # 注意: ここは check_call_sig ＝**通常の関数**だけを通ります。
            #   メソッドは別経路なので旗が立たず、解放しません（安全側）。
            if i < len(f.pmodes):
                arg.arg_is_borrowed = f.pmodes[i] != ast.PM_OWN
            mark_arg_own_rc(arg, f, i)
            want: rc[ast.Type] = f.params[i]
            # ★ closure を fn の引数へ（A-51）
            if not self.closure_to_fn_arg(arg, at, f, i, shown) and not ast.type_assignable(at, want):
                diag.error_full(unwrap_tok(arg.tok),
                                diag.msg("sema.249", "{0} '{1}' の第 {2} 引数: 型 '{3}' を '{4}' に渡せません", [copy(what), copy(shown), copy(str(i + 1)), copy(ast.type_name(at)), copy(ast.type_name(want))]),
                                diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(at))]),
                                f.tok,
                                diag.msg("sema.151", "引数 '{0}' は '{1}' 型です", [copy(f.pnames[i]), copy(ast.type_name(want))]),
                                self.no_implicit_hint(at, want))
            i = i + 1
            a = arg.next
        return unwrap_type(f.ret)

    # ★ closure を fn を受け取る引数へ渡す（A-51）。渡せたら True
    #   対になる定義: src/sema.c の closure_to_fn_arg
    def closure_to_fn_arg(mut self, a: rc[ast.Node], at: rc[ast.Type], f: rc[types.FuncSig],
                          pi: int, shown: str) -> bool:
        pt: rc[ast.Type] = f.params[pi]
        if at.kind != ast.TY_CLOSURE or pt.kind != ast.TY_FN or not fn_shape_equal(at, pt):
            return False
        stores: bool = True
        fnode: rc[ast.Node] | None = f.node
        if fnode is not None:
            stores = self.fn_param_escapes_at(unwrap_node(fnode).body, f.pnames[pi], 0)
        if stores:
            diag.error_full(unwrap_tok(a.tok),
                            diag.msg("sema.645", "closure を '{0}' の fn の引数に渡せません", [copy(shown)]),
                            diag.msg0("sema.646", "呼び先がこの関数をしまいます"),
                            f.tok,
                            diag.msg("sema.248", "'{0}' は受け取った関数をしまいます", [copy(f.pnames[pi])]),
                            diag.msg0("sema.647", "しまう相手には、引数の型を closure(...) にして所有ごと渡してください（own closure(...)）"))
        return True

    # return の検査
    # 分解代入 q, r = f()
    #
    # ★ **宣言も兼ねる。** 型は右辺のタプルから決まるので書かせない
    #   （roadmap.md §0 の ③：右辺から決まるものは書かせない）。
    def check_unpack(mut self, n: mut rc[ast.Node]) -> None:
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        rt: rc[ast.Type] = self.check_expr(rhs)
        if rt.kind != ast.TY_TUPLE:
            diag.error_full(unwrap_tok(rhs.tok),
                            diag.msg0("sema.506", "分解代入の右辺がタプルではありません"),
                            diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(rt))]), None, "",
                            diag.msg0("sema.507", "分解できるのは (A, B) を返すものだけです（複数の値を返す関数を書いてください）"))

        nvars: int = count_siblings(n.params)
        if nvars != len(rt.params):
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.255", "受け取る数が合いません（{0} 個と {1} 個）", [copy(str(nvars)), copy(str(len(rt.params)))]),
                            diag.msg("sema.061", "ここは {0} 個です", [copy(str(nvars))]), None, "",
                            diag.msg("sema.256", "右辺は '{0}' です", [copy(ast.type_name(rt))]))

        k: int = 0
        vi: rc[ast.Node] | None = n.params
        while vi is not None:
            vn: rc[ast.Node] = vi
            e: rc[types.VarEntry] = self.declare(vn.name, rt.params[k], vn.tok)
            vn.ir_name = copy(e.ir_name)
            vn.type = rt.params[k]
            k = k + 1
            vi = vn.next
        n.type = rt

    # ── 場合分け（A-37）──────────────────────────────────
    #
    # ★ 見るのは 4 つ。
    #     ① 調べる式の型（列挙 / int / str だけ）
    #     ② どの case の値も同じ型か
    #     ③ 同じ値を 2 回書いていないか
    #     ④ **枝が全部あるか**（列挙）／ case _ があるか（int / str）
    #
    # ★ ④ が本体。枝を足したとき「直す場所をコンパイラに挙げさせる」ために
    #   この機能を入れた。網羅を確かめないなら if の連なりと同じ。
    #   対になる定義: src/sema.c の case ND_MATCH
    # ── 中身を持つ枝の match（A-41）──────────────────────────
    #
    # ★ **ここで形を書き換えます。** 調べるのは「先頭のタグ（i64）」で、
    #   当たった枝の中身は**フィールドの読み出し**に落とします。
    #   そうすれば、網羅の検査（A-37）も codegen も今までどおりです。
    #
    #   match s:                    __m.0: Shape = s           ← 1 回だけ評価
    #       case Shape.Circle(r):   match tag(__m.0):
    #           BODY            →       case 0:
    #                                       __v.1: Shape$Circle = __m.0  ← 見立て
    #                                       r: float = __v.1.r
    #                                       BODY
    #   対になる定義: src/sema.c の lower_match_payload
    def sema_hidden(mut self, tag: str) -> str:
        name: str = tag + "." + str(self.hidden)
        self.hidden = self.hidden + 1
        return name

    # パターン（`Shape.Circle(r)` / `Shape.Empty`）から枝を取り出す
    def pattern_branch(mut self, pat: rc[ast.Node],
                       e: rc[ast.EnumDef]) -> rc[ast.EnumVal]:
        owner: rc[ast.Node] | None = pat.lhs
        if owner is None or (pat.kind != ast.ND_FIELD and pat.kind != ast.ND_METHOD):
            diag.error_full(unwrap_tok(pat.tok), diag.msg0("sema.508", "case には枝を書きます"),
                            diag.msg0("sema.509", "ここは枝ではありません"), None, "",
                            diag.msg("sema.257", "'{0}.枝名' か '{1}.枝名(中身…)' の形で書きます", [copy(e.name), copy(e.name)]))
            return rc(ast.EnumVal("", 0, None))
        ow: rc[ast.Node] = owner
        if ow.name != e.name:
            diag.error_full(unwrap_tok(pat.tok),
                            diag.msg("sema.258", "'{0}' の match に、別の列挙の枝は書けません", [copy(e.name)]),
                            diag.msg0("sema.510", "ここは違う列挙です"), e.tok,
                            diag.msg0("sema.511", "調べている列挙はこれです"), "")
        v: rc[ast.EnumVal] | None = e.find(pat.name)
        if v is None:
            diag.error_full(unwrap_tok(pat.tok),
                            diag.msg("sema.141", "列挙 '{0}' に枝 '{1}' はありません", [copy(e.name), copy(pat.name)]),
                            diag.msg0("sema.439", "この枝は定義されていません"), e.tok,
                            diag.msg0("sema.440", "列挙の定義はここです"), "")
            return rc(ast.EnumVal("", 0, None))
        return v

    # case の本体の先頭に「見立て」と「中身の束縛」を差し込む
    def bind_pattern(mut self, c: mut rc[ast.Node], pat: rc[ast.Node],
                     e: rc[ast.EnumDef], v: mut rc[ast.EnumVal],
                     mname: str) -> None:
        nargs: int = 0
        if pat.kind == ast.ND_METHOD:
            a0: rc[ast.Node] | None = pat.args
            while a0 is not None:
                aa: rc[ast.Node] = a0
                nargs = nargs + 1
                a0 = aa.next

        if nargs != v.nfields:
            label: str = diag.msg0("sema.512", "中身の数が合っていません")
            hint: str = (diag.msg("sema.261", "'case {0}.{1}(…)' に {2} 個の名前を書きます", [copy(e.name), copy(v.name), copy(str(v.nfields))]))
            if v.nfields == 0:
                label = diag.msg0("sema.436", "この枝は中身を持ちません")
                hint = diag.msg("sema.260", "'case {0}.{1}:' と書きます", [copy(e.name), copy(v.name)])
            diag.error_full(unwrap_tok(pat.tok),
                            diag.msg("sema.259", "枝 '{0}.{1}' の中身は {2} 個です（{3} 個書かれています）", [copy(e.name), copy(v.name), copy(str(v.nfields)), copy(str(nargs))]),
                            label, v.tok, diag.msg0("sema.438", "枝の定義はここです"), hint)
        if nargs == 0:
            return

        # 束縛の名前は「ただの名前」だけです（式は書けません）
        seen: list[str] = []
        a1: rc[ast.Node] | None = pat.args
        while a1 is not None:
            ab: rc[ast.Node] = a1
            if ab.kind != ast.ND_VAR:
                diag.error_full(unwrap_tok(ab.tok), diag.msg0("sema.513", "case の中身には名前を書きます"),
                                diag.msg0("sema.514", "ここは名前ではありません"), None, "",
                                diag.msg0("sema.515", "束縛する名前を書きます（例: case Shape.Circle(r):）。値で絞りたいときはガードを使ってください（例: case Shape.Circle(r) if r > 0:）"))
            for s0 in seen:
                if s0 == ab.name:
                    diag.error_full(unwrap_tok(ab.tok),
                                    diag.msg("sema.262", "束縛する名前 '{0}' が 2 回あります", [copy(ab.name)]),
                                    diag.msg0("sema.516", "2 つめです"), None, "", "")
            seen.append(copy(ab.name))
            a1 = ab.next

        bc: rc[ast.Class] = self.branch_class(e, v)
        t: rc[token.Token] | None = pat.tok

        # __v.N: <枝のクラス> = __m.N（見立て。IR では何も起きません）
        vname: str = self.sema_hidden("match.b")
        view: rc[ast.Node] = ast.new_node(ast.ND_VARDECL, t)
        view.name = copy(vname)
        vtr: rc[ast.Node] = ast.new_node(ast.ND_TYPEREF, t)
        vtr.name = copy(bc.name)
        view.type_ref = vtr
        view.rhs = ast.new_var_node(t, mname)
        view.is_enum_view = True

        head: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, t)
        cur: rc[ast.Node] = head
        cur.next = view
        cur = view

        # 中身を順に束縛（__tag は飛ばします）
        f: rc[ast.Field] | None = bc.fields
        if f is not None:
            f = unwrap_field(f).next
        a3: rc[ast.Node] | None = pat.args
        while a3 is not None:
            ad: rc[ast.Node] = a3
            ff: rc[ast.Field] = unwrap_field(f)
            fld: rc[ast.Node] = ast.new_node(ast.ND_FIELD, ad.tok)
            fld.lhs = ast.new_var_node(ad.tok, vname)
            fld.name = copy(ff.name)
            bind: rc[ast.Node] = ast.new_node(ast.ND_VARDECL, ad.tok)
            bind.name = copy(ad.name)
            bind.rhs = fld            # 型は右辺から決まります
            cur.next = bind
            cur = bind
            f = ff.next
            a3 = ad.next

        cbody: rc[ast.Node] = unwrap_node(c.body)
        cur.next = cbody.body
        cbody.body = head.next

    # match 全体を「タグで調べる形」に書き換える
    # ── match のガードと入れ子のパターン（A-48）──────────────
    #   同じ枝の case を 1 つにまとめ、中身を if と match で組み立てる。
    #   対になる定義: src/sema.c の lower_match_refine（説明はそちら）
    #   注意: 隠し変数の番号の振り方は C 版と 1 つも違えないこと。

    # 入れ子のパターンの中の名前を、隠し変数に置き換える（深さ優先・左から）
    def rename_pattern(mut self, pat: rc[ast.Node], rn: mut list[rc[Rename]]) -> None:
        if pat.kind != ast.ND_METHOD:
            return
        a: rc[ast.Node] | None = pat.args
        while a is not None:
            an: rc[ast.Node] = a
            if an.kind == ast.ND_VAR:
                h: str = self.sema_hidden("match.n")
                rn.append(rc(Rename(copy(an.name), copy(h), an.tok)))
                an.name = copy(h)
            else:
                self.rename_pattern(an, rn)
            a = an.next

    def refine_chain(mut self, mem: list[rc[ast.Node]], i: int, dflt: rc[ast.Node] | None,
                     hid: list[str], used_default: mut list[bool]) -> rc[ast.Node] | None:
        if i == len(mem):
            if dflt is None:
                return None
            used_default[0] = True
            dd: rc[ast.Node] = dflt
            return ast.ast_clone(dd.body)
        c: rc[ast.Node] = mem[i]
        t: rc[token.Token] | None = c.tok

        # ① この case の名前を読み替える
        rn: list[rc[Rename]] = []
        argv: list[rc[ast.Node]] = []
        pl: rc[ast.Node] | None = c.lhs
        if pl is not None:
            pat: rc[ast.Node] = pl
            if pat.kind == ast.ND_METHOD:
                k: int = 0
                a: rc[ast.Node] | None = pat.args
                while a is not None:
                    an: rc[ast.Node] = a
                    argv.append(an)
                    if an.kind == ast.ND_VAR:
                        rn.append(rc(Rename(copy(an.name), copy(hid[k]), an.tok)))
                    else:
                        self.rename_pattern(an, rn)
                    k = k + 1
                    a = an.next

        # ② 後ろの case（落ち先）
        fb: Fallback = Fallback(self.refine_chain(mem, i + 1, dflt, hid, used_default))

        # ③ 当たったときの本体：利用者の名前を宣言してから本体
        head: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, t)
        cur: rc[ast.Node] = head
        for r in rn:
            d: rc[ast.Node] = self.hidden_var(r.tok, r.from_, ast.new_var_node(r.tok, r.to))
            cur.next = d
            cur = d
        cur.next = c.body
        inner: rc[ast.Node] = new_block_of(t, head.next)

        # ④ ガード（いちばん内側）
        gl: rc[ast.Node] | None = c.rhs
        if gl is not None:
            g: rc[ast.Node] = gl
            rename_expr(g, rn)
            iff: rc[ast.Node] = ast.new_node(ast.ND_IF, g.tok)
            iff.lhs = g
            iff.body = inner
            iff.els = fb.take()
            if iff.els is None:
                diag.error_full(unwrap_tok(g.tok),
                                diag.msg0("sema.617", "ガードが外れたときに当たる case がありません"),
                                diag.msg0("sema.618", "この条件が偽のとき、どこへも行けません"),
                                None, "",
                                diag.msg0("sema.619", "後ろに同じ枝の case か case _: を書いてください"))
            inner = new_block_of(t, iff)

        # ⑤ 入れ子のパターン（後ろから包む）
        j: int = len(argv) - 1
        while j >= 0:
            av: rc[ast.Node] = argv[j]
            if av.kind != ast.ND_VAR:
                av.next = None
                m: rc[ast.Node] = ast.new_node(ast.ND_MATCH, av.tok)
                m.lhs = ast.new_var_node(av.tok, hid[j])
                cp: rc[ast.Node] = ast.new_node(ast.ND_CASE, av.tok)
                cp.lhs = av
                cp.body = inner
                rest: rc[ast.Node] | None = fb.take()
                if rest is not None:
                    cd: rc[ast.Node] = ast.new_node(ast.ND_CASE, av.tok)
                    cd.body = rest
                    cd.is_fallback = True
                    cp.next = cd
                m.body = cp
                inner = new_block_of(t, m)
            j = j - 1
        return inner

    def lower_match_refine(mut self, n: mut rc[ast.Node]) -> None:
        any_: bool = False
        dflt: rc[ast.Node] | None = None
        cs: list[rc[ast.Node]] = []
        c: rc[ast.Node] | None = n.body
        while c is not None:
            cc: rc[ast.Node] = c
            if cc.lhs is None:
                # 注意: case _ が最後でないときは、何もしないで今までの検査に断らせる
                if cc.next is not None:
                    return
                dflt = cc
            else:
                cs.append(cc)
                if case_refutable(cc):
                    any_ = True
            c = cc.next
        if not any_:
            return

        done: list[bool] = []
        for x in cs:
            done.append(False)

        used_default: list[bool] = [False]
        head: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, n.tok)
        cur: rc[ast.Node] = head
        i: int = 0
        while i < len(cs):
            if done[i]:
                i = i + 1
                continue
            # 同じ枝（同じ値）の case を、書いた順に集める
            mem: list[rc[ast.Node]] = []
            j: int = i
            while j < len(cs):
                if not done[j] and same_case_key(unwrap_node(cs[i].lhs), unwrap_node(cs[j].lhs)):
                    # ★ 外れない case の後ろの同じ枝は、決して選ばれない
                    if len(mem) > 0 and not case_refutable(mem[len(mem) - 1]):
                        diag.error_full(unwrap_tok(unwrap_node(cs[j].lhs).tok),
                                        diag.msg0("sema.533", "同じ値の case が 2 つあります"),
                                        diag.msg0("sema.534", "2 つめは決して選ばれません"),
                                        unwrap_node(mem[len(mem) - 1].lhs).tok,
                                        diag.msg0("sema.535", "最初の case はここです"), "")
                    if len(mem) > 0 and count_args(cs[j].lhs) != count_args(mem[0].lhs):
                        diag.error_full(unwrap_tok(unwrap_node(cs[j].lhs).tok),
                                        diag.msg0("sema.620", "同じ枝の case で、中身の数が違います"),
                                        diag.msg0("sema.512", "中身の数が合っていません"),
                                        unwrap_node(mem[0].lhs).tok,
                                        diag.msg0("sema.535", "最初の case はここです"), "")
                    mem.append(cs[j])
                    done[j] = True
                j = j + 1

            # まとめた case：中身は隠し変数で受け取る
            first: rc[ast.Node] = mem[0]
            fl: rc[ast.Node] = unwrap_node(first.lhs)
            nargs: int = count_args(fl)
            hid: list[str] = []
            k: int = 0
            while k < nargs:
                hid.append(self.sema_hidden("match.h"))
                k = k + 1
            mc: rc[ast.Node] = ast.new_node(ast.ND_CASE, first.tok)
            if fl.kind == ast.ND_METHOD:
                pat: rc[ast.Node] = ast.new_node(ast.ND_METHOD, fl.tok)
                pat.lhs = fl.lhs
                pat.name = copy(fl.name)
                pat.mod_name = copy(fl.mod_name)
                ah: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, fl.tok)
                at: rc[ast.Node] = ah
                k = 0
                a: rc[ast.Node] | None = fl.args
                while a is not None:
                    an: rc[ast.Node] = a
                    nv: rc[ast.Node] = ast.new_var_node(an.tok, hid[k])
                    at.next = nv
                    at = nv
                    k = k + 1
                    a = an.next
                pat.args = ah.next
                mc.lhs = pat
            else:
                mc.lhs = fl
            mc.body = self.refine_chain(mem, 0, dflt, hid, used_default)
            cur.next = mc
            cur = mc
            i = i + 1
        # ★ 落ち先に使った case _ は届く（枝を全部書いてあっても断らない）
        if dflt is not None:
            dd: rc[ast.Node] = dflt
            if used_default[0]:
                dd.is_fallback = True
            cur.next = dd
        n.body = head.next

    def lower_match_payload(mut self, n: mut rc[ast.Node],
                            e: rc[ast.EnumDef]) -> None:
        t: rc[token.Token] | None = n.tok

        # ① 調べる式を 1 回だけ評価して、隠し変数に入れる
        mname: str = self.sema_hidden("match.v")
        decl: rc[ast.Node] = ast.new_node(ast.ND_VARDECL, t)
        decl.name = copy(mname)
        decl.rhs = n.lhs

        # ② それぞれの case を「タグの比較 ＋ 中身の束縛」にする
        c: rc[ast.Node] | None = n.body
        while c is not None:
            cc: rc[ast.Node] = c
            if cc.lhs is not None:
                pat: rc[ast.Node] = unwrap_node(cc.lhs)
                v: rc[ast.EnumVal] = self.pattern_branch(pat, e)
                self.bind_pattern(cc, pat, e, v, mname)
                cc.lhs = ast.new_int_node(pat.tok, v.val)   # 比べるのはタグだけ
            c = cc.next

        # ③ match を「タグを調べる match」にして、宣言と並べる
        m: rc[ast.Node] = ast.new_node(ast.ND_MATCH, t)
        tagn: rc[ast.Node] = ast.new_node(ast.ND_ENUMTAG, t)
        tagn.lhs = ast.new_var_node(t, mname)
        m.lhs = tagn
        m.body = n.body
        m.en = e                                  # 網羅の検査に使います

        decl.next = m

        n.kind = ast.ND_BLOCK
        n.lhs = None
        n.body = decl
        n.en = None

    def check_match(mut self, n: mut rc[ast.Node]) -> None:
        subj: rc[ast.Node] = unwrap_node(n.lhs)
        st: rc[ast.Type] = auto_deref(self.check_expr(subj))

        # ★ ガードと入れ子のパターン（A-48）。同じ枝の case をまとめる
        self.lower_match_refine(n)

        # ★ 中身を持つ列挙（A-41）。**タグで調べる形に書き換えて**から
        #   検査し直します。書き換えたあとは今までの match と同じ形です。
        if st.kind == ast.TY_ENUM:
            en0: rc[ast.EnumDef] = unwrap_enumdef(st.en)
            if en0.has_payload:
                self.lower_match_payload(n, en0)
                self.check_stmt(n)     # 書き換えた自分（ND_BLOCK）を検査する
                return

        # ★ タグを調べる match（A-41 が作った形）は、列挙として扱います。
        men: rc[ast.EnumDef] | None = n.en
        if st.kind == ast.TY_ENUM:
            men = st.en

        is_enum: bool = men is not None
        if not is_enum and st.kind != ast.TY_INT and st.kind != ast.TY_STR:
            diag.error_full(unwrap_tok(subj.tok),
                            diag.msg("sema.267", "'{0}' は match で調べられません", [copy(ast.type_name(st))]),
                            diag.msg0("sema.524", "ここに書けるのは 列挙 / int / str です"), None, "",
                            diag.msg0("sema.525", "クラスの場合分けはインタフェースで書きます（どの枝かを型が持ちます）"))
        if is_enum:
            n.en = men

        has_default: bool = False
        default_at: rc[ast.Node] | None = None

        c: rc[ast.Node] | None = n.body
        while c is not None:
            cc: rc[ast.Node] = c
            if cc.lhs is None:
                # ★ `case _`。**2 つ書けない**し、**最後でなければならない**
                #   （後ろの case は決して選ばれないため）。
                if has_default:
                    diag.error_full(unwrap_tok(cc.tok),
                                    diag.msg0("sema.526", "case _ が 2 つあります"), diag.msg0("sema.516", "2 つめです"),
                                    unwrap_node(default_at).tok,
                                    diag.msg0("sema.527", "最初の case _ はここです"), "")
                has_default = True
                default_at = cc
                if cc.next is not None:
                    diag.error_at_hint(unwrap_tok(unwrap_node(cc.next).tok),
                                       diag.msg0("sema.269", "case _ より後ろの case は決して選ばれません"),
                                       diag.msg0("sema.268", "この case は届きません"))
                self.check_block(unwrap_node(cc.body))
                c = cc.next
                continue

            pat: rc[ast.Node] = unwrap_node(cc.lhs)
            ct: rc[ast.Type] = self.check_expr(pat)
            if not ast.type_equal(ct, st):
                diag.error_full(unwrap_tok(pat.tok),
                                diag.msg("sema.270", "case の値の型が違います（'{0}' を調べているのに '{1}' です）", [copy(ast.type_name(st)), copy(ast.type_name(ct))]),
                                diag.msg("sema.271", "ここは '{0}' です", [copy(ast.type_name(ct))]), None, "",
                                diag.msg0("sema.528", "match は暗黙の変換をしません（言語全体と同じです）"))

            # ★ **値がコンパイル時に決まらないものは断る。** 変数を書ける
            #   ようにすると、上から順に比べるだけの「if の連なり」と同じに
            #   なり、網羅を確かめられない。
            if pat.kind != ast.ND_INT and pat.kind != ast.ND_STR:
                hint2: str = diag.msg0("sema.532", "リテラルを書いてください（変えられる値は if で比べます）")
                if is_enum:
                    hint2 = diag.msg0("sema.531", "列挙の枝（例: Color.Red）を書いてください")
                diag.error_full(unwrap_tok(pat.tok),
                                diag.msg0("sema.529", "case には決まった値を書きます"),
                                diag.msg0("sema.530", "ここはコンパイル時に決まりません"), None, "", hint2)

            # ★ 同じ値を 2 回書いていないか。通すと、2 つめは決して選ばれない
            #   のに黙って通る。
            q: rc[ast.Node] | None = n.body
            while q is not None and q != cc:
                qq: rc[ast.Node] = q
                if qq.lhs is not None:
                    qp: rc[ast.Node] = unwrap_node(qq.lhs)
                    same: bool = False
                    if pat.kind == ast.ND_INT:
                        same = qp.kind == ast.ND_INT and qp.ival == pat.ival
                    else:
                        same = qp.kind == ast.ND_STR and qp.sval == pat.sval
                    if same:
                        diag.error_full(unwrap_tok(pat.tok),
                                        diag.msg0("sema.533", "同じ値の case が 2 つあります"),
                                        diag.msg0("sema.534", "2 つめは決して選ばれません"),
                                        qp.tok, diag.msg0("sema.535", "最初の case はここです"), "")
                q = qq.next

            self.check_block(unwrap_node(cc.body))
            c = cc.next

        # ── ④ 網羅 ──
        if is_enum:
            ed: rc[ast.EnumDef] = unwrap_enumdef(men)
            if not has_default:
                missing: list[str] = []
                v: rc[ast.EnumVal] | None = ed.vals
                while v is not None:
                    vv: rc[ast.EnumVal] = v
                    found: bool = False
                    c2: rc[ast.Node] | None = n.body
                    while c2 is not None:
                        cc2: rc[ast.Node] = c2
                        if cc2.lhs is not None and unwrap_node(cc2.lhs).ival == vv.val:
                            found = True
                        c2 = cc2.next
                    if not found:
                        missing.append(ed.name + "." + vv.name)
                    v = vv.next
                if len(missing) > 0:
                    diag.error_full(unwrap_tok(n.tok),
                                    diag.msg("sema.272", "match に書いていない枝があります: {0}", [copy(strings.join(missing, " / "))]),
                                    diag.msg0("sema.536", "ここで全部の枝を扱ってください"),
                                    ed.tok, diag.msg0("sema.440", "列挙の定義はここです"),
                                    diag.msg0("sema.537", "どれにも当たらないときの動きが要るなら case _: を書いてください"))
            else:
                # 枝を全部書いたうえでの case _ は届かない
                ncase: int = 0
                c3: rc[ast.Node] | None = n.body
                while c3 is not None:
                    cc3: rc[ast.Node] = c3
                    if cc3.lhs is not None:
                        ncase = ncase + 1
                    c3 = cc3.next
                if ncase == ed.nvals and not unwrap_node(default_at).is_fallback:
                    diag.error_at_hint(unwrap_tok(unwrap_node(default_at).tok),
                                       diag.msg0("sema.274", "枝を全部書いてあるので case _ は届きません"),
                                       diag.msg0("sema.273", "この case は選ばれません"))
        elif not has_default:
            # ★ int / str は値が無限にあるので、網羅を静的に示せない。
            #   **case _ を必須にする** — 無いと「どれにも当たらない」ときの
            #   動きが書かれていないことになる。
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.275", "'{0}' の match には case _ が要ります", [copy(ast.type_name(st))]),
                            diag.msg0("sema.538", "どれにも当たらないときの動きがありません"), None, "",
                            diag.msg0("sema.539", "最後に case _: を書いてください（値が無限にあるので、全部を書き尽くせません）"))

    # ── 捕獲した lambda を逃がさない（A-43）──────────────────
    #
    # ★ 捕獲した lambda は**作った関数の枠の上**にあります。枠が畳まれたあとに
    #   呼ばれたら、読むのは他人の場所です。だから**逃がす形を断ります**。
    #   対になる定義: src/sema.c の reject_escaping_closure
    def reject_escaping_closure(self, v: rc[ast.Node] | None, what: str) -> None:
        if v is None:
            return
        vv: rc[ast.Node] = v
        if vv.is_closure:
            return   # ★ closure はヒープにあり、持ち運べる（A-51）
        c0: rc[ast.Node] | None = vv.caps
        if c0 is None:
            return
        cc: rc[ast.Node] = c0
        diag.error_full(unwrap_tok(vv.tok),
                        diag.msg("sema.250", "捕獲した lambda は{0}できません", [copy(what)]),
                        diag.msg0("sema.499", "この lambda は外の変数を捕まえています"),
                        cc.tok, diag.msg("sema.251", "'{0}' を捕まえています", [copy(cc.name)]),
                        diag.msg0("sema.501", "捕まえた値は**作った関数の枠の上**にあるので、その関数より長生きできません。引数として渡す（呼んでもらう）のは できます"))

    # この関数は、受け取った関数の値を**しまう**か（A-43）。
    #
    # ★ しまうのは「返す」「フィールド・グローバル・list に入れる」の 3 つです。
    #   注意: **分からないときは「しまう」と答えます**（安全側）。
    #   対になる定義: src/sema.c の fn_param_escapes_at
    def fn_param_escapes_at(mut self, body: rc[ast.Node] | None, pname: str,
                            hops: int) -> bool:
        cur: rc[ast.Node] | None = body
        while cur is not None:
            n: rc[ast.Node] = cur
            if n.kind == ast.ND_RETURN and n.lhs is not None:
                l0: rc[ast.Node] = unwrap_node(n.lhs)
                if l0.kind == ast.ND_VAR and l0.name == pname:
                    return True
            if n.kind == ast.ND_ASSIGN and n.rhs is not None:
                r0: rc[ast.Node] = unwrap_node(n.rhs)
                if r0.kind == ast.ND_VAR and r0.name == pname:
                    return True
            if n.kind == ast.ND_LIST:
                el: rc[ast.Node] | None = n.body
                while el is not None:
                    e0: rc[ast.Node] = el
                    if e0.kind == ast.ND_VAR and e0.name == pname:
                        return True
                    el = e0.next

            # ★ 別の関数へ渡している場合は、**その先も見ます**
            if n.kind == ast.ND_CALL or n.kind == ast.ND_METHOD:
                ai: int = 0
                a0: rc[ast.Node] | None = n.args
                while a0 is not None:
                    aa: rc[ast.Node] = a0
                    if aa.kind == ast.ND_VAR and aa.name == pname:
                        if hops >= 4:
                            return True      # たどりすぎ（安全側）
                        g: rc[types.FuncSig] | None = None
                        if n.kind == ast.ND_CALL:
                            g = self.lookup_func(n.name)
                        if g is None:
                            return True      # 分からない（安全側）
                        gg: rc[types.FuncSig] = g
                        if gg.node is None or ai >= gg.nparams:
                            return True
                        if self.fn_param_escapes_at(unwrap_node(gg.node).body,
                                                    gg.pnames[ai], hops + 1):
                            return True
                    ai = ai + 1
                    a0 = aa.next

            if self.fn_param_escapes_at(n.lhs, pname, hops):
                return True
            if self.fn_param_escapes_at(n.rhs, pname, hops):
                return True
            if self.fn_param_escapes_at(n.els, pname, hops):
                return True
            if self.fn_param_escapes_at(n.body, pname, hops):
                return True
            if self.fn_param_escapes_at(n.incr, pname, hops):
                return True
            if self.fn_param_escapes_at(n.args, pname, hops):
                return True
            cur = n.next
        return False

    def check_return(mut self, n: mut rc[ast.Node]) -> None:
        fn: rc[types.FuncSig] = unwrap_sig(self.cur_func)
        want: rc[ast.Type] = unwrap_type(fn.ret)

        if n.lhs is None:      # return（値なし）
            if want.kind != ast.TY_NONE:
                diag.error_full(unwrap_tok(n.tok),
                                diag.msg("sema.252", "関数 '{0}' は '{1}' を返さなければなりません", [copy(fn.name), copy(ast.type_name(want))]),
                                diag.msg0("sema.502", "この return には値がありません"),
                                fn.tok, diag.msg0("sema.503", "戻り型はここで宣言されています"), "")
            return

        val: rc[ast.Node] = unwrap_node(n.lhs)
        self.expected = want     # ★ return [] のため
        got: rc[ast.Type] = self.check_expr(val)
        self.expected = None
        self.reject_escaping_closure(n.lhs, diag.msg0("sema.504", "返すことが"))   # A-43

        if want.kind == ast.TY_NONE:
            diag.error_full(unwrap_tok(val.tok),
                            diag.msg("sema.253", "戻り型が None の関数 '{0}' は値を返せません", [copy(fn.name)]),
                            diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(got))]),
                            fn.tok, diag.msg0("sema.503", "戻り型はここで宣言されています"), "")
        if not ast.type_assignable(got, want):
            diag.error_full(unwrap_tok(val.tok),
                            diag.msg0("sema.505", "return の型が戻り型と一致しません"),
                            diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(got))]),
                            fn.tok,
                            diag.msg("sema.254", "関数 '{0}' の戻り型は '{1}' です", [copy(fn.name), copy(ast.type_name(want))]),
                            self.no_implicit_hint(got, want))
        n.lhs = self.range_coerce(n.lhs, want)   # A-28

    # この while から抜ける break があるか
    #
    # 注意: 入れ子のループの中には降りない。そこの break は内側のループのもの。
    #    if の中には降りる（break は条件付きで書くのが普通なので）。
    def has_break(self, n: rc[ast.Node] | None) -> bool:
        if n is None:
            return False
        node: rc[ast.Node] = n

        if node.kind == ast.ND_BREAK:
            return True

        if node.kind == ast.ND_WHILE:
            return False        # ★ 内側のループの break は、こちらには効かない

        if node.kind == ast.ND_IF:
            return self.has_break(node.body) or self.has_break(node.els)

        if node.kind == ast.ND_BLOCK:
            st: rc[ast.Node] | None = node.body
            while st is not None:
                if self.has_break(st):
                    return True
                st = st.next
            return False

        return False

    # 戻らない組み込み（panic / exit）の呼び出しか
    #
    # ★ ランタイム側で _Noreturn が付いている 2 つと、ここの判定は対になっている。
    #   片方だけ変えると「sema は通すのに実行時には戻ってくる」ことになる。
    def never_returns_call(self, node: rc[ast.Node]) -> bool:
        if node.kind != ast.ND_CALL:
            return False
        return node.builtin == "pl_panic" or node.builtin == "pl_exit"

    # この文を実行したら、必ず関数から抜けるか（型システム 6.1）
    def always_returns(self, n: rc[ast.Node] | None) -> bool:
        if n is None:
            return False
        node: rc[ast.Node] = n

        if node.kind == ast.ND_RETURN:
            return True

        # ★ raise もその経路を終わらせます（呼び出し元へ戻る）
        if node.kind == ast.ND_RAISE:
            return True

        if node.kind == ast.ND_IF:
            # else が無ければ、条件が偽のときに素通りする
            if node.els is None:
                return False
            return self.always_returns(node.body) and self.always_returns(node.els)

        if node.kind == ast.ND_BLOCK:
            st: rc[ast.Node] | None = node.body
            while st is not None:
                if self.always_returns(st):
                    return True
                st = st.next
            return False

        if node.kind == ast.ND_WHILE:
            # ★ while True: は break が無ければ抜けない。
            #   条件が「True というリテラルそのもの」のときだけ見る。
            #   変数や式は追わない（保守的でよい）。
            if node.lhs is None:
                return False
            cond: rc[ast.Node] = unwrap_node(node.lhs)
            if cond.kind != ast.ND_BOOL or cond.ival == 0:
                return False
            return not self.has_break(node.body)

        # ★ match は「どの case も抜けるなら」抜ける（A-37）。
        #
        #   注意: **これが無いと、全部の case で return しているのに
        #     「値を返さない経路があります」と言われる**（try で同じ穴を
        #     踏んだ。0.17.0 の記録を参照）。
        #
        #   注意: 素通りする経路が残っていないと言えるのは、**列挙で
        #     網羅されている**か **case _ がある**ときだけ。
        if node.kind == ast.ND_MATCH:
            hasdef: bool = False
            cm: rc[ast.Node] | None = node.body
            while cm is not None:
                ccm: rc[ast.Node] = cm
                if not self.always_returns(ccm.body):
                    return False
                if ccm.lhs is None:
                    hasdef = True
                cm = ccm.next
            # 列挙は網羅を強制済み（check_match）。int / str は case _ 必須。
            return hasdef or node.en is not None

        if node.kind == ast.ND_TRY:
            # ★ try の中身と、**すべての** except が抜けるなら、この try は抜ける。
            #
            #   注意: else が無い if と同じ話。1 つでも素通りする except が
            #     あれば、そこから下へ落ちる。
            #
            #   注意: どの except にも当たらないエラーは呼び出し元へ伝播する
            #     ので、**これも「抜ける」ほうに数える**（伝播を except の
            #     漏れと混同しないこと）。
            #
            #   except の並びは els に next で繋がっている（if の else と
            #     違って複数あるので、リストとしてたどる）。
            if not self.always_returns(node.body):
                return False
            ex: rc[ast.Node] | None = node.els
            while ex is not None:
                exx: rc[ast.Node] = ex
                if not self.always_returns(exx.body):
                    return False
                ex = exx.next
            return True

        if node.kind == ast.ND_CALL:
            # ★ panic() / exit() を呼んだら、その先へは進まない。
            return self.never_returns_call(node)

        return False

    # ── パス 1：宣言の登録 ──────────────────────────────────

    # 1a：クラス名と Type を作る。中身はまだ見ない
    def declare_class(self, n: mut rc[ast.Node]) -> None:
        self.reject_module_name(n.name, n.tok, diag.msg0("sema.551", "クラス"))
        if self.type_from_name(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg("sema.290", "'{0}' は組み込みの型名です", [copy(n.name)]),
                               diag.msg("sema.289", "クラス名 '{0}' は使えません", [copy(n.name)]))
        if self.is_builtin_name(n.name):
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg("sema.291", "'{0}' は組み込み関数の名前です", [copy(n.name)]),
                               diag.msg("sema.289", "クラス名 '{0}' は使えません", [copy(n.name)]))

        prev: rc[ast.Class] | None = self.lookup_class(n.name)
        if prev is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.292", "クラス '{0}' は既に定義されています", [copy(n.name)]),
                            diag.msg0("sema.552", "ここで再定義されています"),
                            prev.tok, diag.msg0("parse.224", "最初の定義はここです"), "")

        c: rc[ast.Class] = rc(ast.Class(n.name, n.tok))
        c.ir_name = self.mod_mangle(n.name)      # ★ %lexer.Token.type になる
        c.owner_name = self.cur_mod().name       # メソッドはこのモジュールの表
        c.node = n
        c.type = ast.type_class(n.name, c)       # ★ クラスにつき Type は 1 個

        ms: rc[types.ModuleSyms] = self.cur_syms()
        c.next = ms.classes
        ms.classes = c

        n.cls = c
        n.type = c.type

    # フィールドを並べて、オフセットとサイズを決める
    def layout_class(self, c: mut rc[ast.Class]) -> None:
        # ★ インタフェースを 1 つでも実装するなら、**先頭に隠しフィールド**
        #   （vtable へのポインタ）を 1 つ置く。おかげでクラス → インタフェースの
        #   変換が「何もしない」で済む。
        #   注意: codegen の gen_class_type と **並びを揃えること**。
        offset: int = 0
        max_align: int = 1
        index: int = 0
        if len(c.impls) > 0:
            offset = 8
            max_align = 8
            index = 1
        f: rc[ast.Field] | None = c.fields
        while f is not None:
            ft: rc[ast.Type] = unwrap_type(f.type)
            a: int = ast.type_align(ft)
            offset = align_up(offset, a)      # ★ パディングはここで入る
            f.offset = offset
            f.index = index
            index = index + 1
            offset = offset + ast.type_size(ft)
            if a > max_align:
                max_align = a
            f = f.next
        c.nfields = index
        c.align = max_align
        c.size = align_up(offset, max_align)

    # メソッドを FuncSig として登録する（名前は "Token.show"）
    def declare_method(mut self, c: mut rc[ast.Class],
                       fn: mut rc[ast.Node]) -> None:
        mname: str = self.mangle(c.name, fn.name)

        prev: rc[types.FuncSig] | None = self.lookup_func(mname)
        if prev is not None:
            diag.error_full(unwrap_tok(fn.tok),
                            diag.msg("sema.293", "メソッド '{0}' は既に定義されています", [copy(mname)]),
                            diag.msg0("sema.552", "ここで再定義されています"),
                            prev.tok, diag.msg0("parse.224", "最初の定義はここです"), "")

        clash: rc[ast.Field] | None = self.lookup_field(c, fn.name)
        if clash is not None:
            diag.error_full(unwrap_tok(fn.tok),
                            diag.msg("sema.294", "'{0}' はフィールドと同じ名前です", [copy(fn.name)]),
                            diag.msg0("sema.553", "メソッド名がフィールド名と衝突しています"),
                            clash.tok, diag.msg0("sema.554", "同名のフィールドはここです"),
                            diag.msg0("sema.555", "t.f が「フィールド」か「メソッド」か決められなくなるため禁止です"))

        ret: rc[ast.Type] = self.resolve_type(unwrap_node(fn.type_ref))

        f: rc[types.FuncSig] = rc(types.FuncSig(mname, fn.tok))
        f.ret = ret
        f.node = fn                 # A-43

        pm: rc[ast.Node] | None = fn.params
        while pm is not None:
            p: rc[ast.Node] = pm
            # ★ 第 1 引数 self には型注釈がない（parser が保証している）
            pt: rc[ast.Type] = unwrap_type(c.type)
            if p.type_ref is not None:
                pt = self.resolve_type(unwrap_node(p.type_ref))
            if pt.kind == ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(p.tok),
                                   diag.msg0("sema.296", "None 型の値は存在しないので引数にできません"),
                                   diag.msg0("sema.295", "引数の型に None は使えません"))
            f.params.append(pt)
            f.pnames.append(copy(p.name))
            f.pmodes.append(p.mode)        # A-21e
            f.defaults.append(p.rhs)       # A-38（無ければ None）
            f.nparams = f.nparams + 1
            p.type = pt
            pm = p.next

        self.check_defaults(f, fn)

        # コンストラクタ init は値を返せない
        if fn.name == "init":
            if ret.kind != ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(fn.tok),
                                   diag.msg0("sema.298", "init は戻り値を持てません（-> None と書いてください）"),
                                   diag.msg0("sema.297", "init の戻り型は None でなければなりません"))
            c.has_init = True

        self.resolve_raises(fn, f)
        if fn.name == "init" and len(f.raises_cls) > 0:
            diag.error_at_hint(unwrap_tok(fn.tok),
                               diag.msg0("sema.300", "init は失敗できません（生成に失敗した値は誰も受け取れません）"),
                               diag.msg0("sema.299", "init に raises は書けません"))

        # ★ drop はデストラクタです（仕様 §6.2。E-DROP-1）。
        #   対になる定義: src/sema.c の declare_method
        if fn.name == "drop":
            dlabel: str = ""
            if f.nparams != 1:
                dlabel = diag.msg0("sema.557", "引数を取れません（解放のときは self だけで呼ばれます）")
            elif ret.kind != ast.TY_NONE:
                dlabel = diag.msg0("sema.558", "値を返せません（解放のときに受け取る相手がいません）")
            elif len(f.raises_cls) > 0:
                dlabel = diag.msg0("sema.559", "失敗できません（解放の途中の失敗は誰も受け取れません）")
            if len(dlabel) > 0:
                diag.error_code_full(unwrap_tok(fn.tok), "E-DROP-1",
                                     diag.msg0("sema.556", "drop はデストラクタです。形は 'def drop(self) -> None' か 'def drop(mut self) -> None' だけです"),
                                     dlabel, None, "",
                                     diag.msg0("sema.560", "解放とは別の処理なら、別の名前にしてください（仕様 §6.2）"))

        f.ir_name = self.mangle(c.ir_name, fn.name)   # "lexer.Token.show"
        f.owner = self.cur_syms()
        ms: rc[types.ModuleSyms] = self.cur_syms()
        f.next = ms.funcs
        ms.funcs = f

        fn.ir_name = copy(f.ir_name)
        fn.type = ret

    # ── 未初期化フィールドの検査 ──────────────────────
    #
    # ★ **どの経路でも代入するか**を見ます（A-27。0.18.0）。
    #   それまでは「init のどこかに self.f = ... と書いてあるか」だけを
    #   見ていたので、`if` の中にしか代入が無い形がすり抜けていました。
    #   Ada / SPARK の definite assignment にあたる検査です。
    #   対になる定義: src/sema.c の definitely_assigns
    #
    # 注意: ランタイム検査（pl_check_not_none）は**残します**。ここで見られるのは
    #   init の中だけだからです（代入の**前に**読む形は残ります）。

    # この文（部分木）のどこかに return があるか。
    #
    # 注意: panic() / exit() は数えません。**戻らない**ので、そこから
    #   オブジェクトが観測されることがないためです。
    def contains_return(self, n: rc[ast.Node] | None) -> bool:
        if n is None:
            return False
        node: rc[ast.Node] = n
        if node.kind == ast.ND_RETURN:
            return True
        if self.contains_return(node.lhs):
            return True
        if self.contains_return(node.rhs):
            return True
        if self.contains_return(node.els):
            return True
        if self.contains_return(node.incr):
            return True
        st: rc[ast.Node] | None = node.body
        while st is not None:
            sn: rc[ast.Node] = st
            if self.contains_return(sn):
                return True
            st = sn.next
        return False

    # 文の並びが「どの経路でも必ず self.<fname> に代入する」か。
    #
    # 注意: 途中に return がありうる文を見つけたら打ち切ります
    #   （代入せずに出ていく経路があるということなので）。
    def definitely_assigns(self, first: rc[ast.Node] | None, fname: str) -> bool:
        st: rc[ast.Node] | None = first
        while st is not None:
            sn: rc[ast.Node] = st
            if self.definitely_assigns_stmt(sn, fname):
                return True
            if self.contains_return(sn):
                return False
            st = sn.next
        return False

    def definitely_assigns_stmt(self, n: rc[ast.Node] | None, fname: str) -> bool:
        if n is None:
            return False
        node: rc[ast.Node] = n

        if node.kind == ast.ND_ASSIGN and node.lhs is not None:
            lhs: rc[ast.Node] = unwrap_node(node.lhs)
            if lhs.kind == ast.ND_FIELD and lhs.lhs is not None:
                obj: rc[ast.Node] = unwrap_node(lhs.lhs)
                if (obj.kind == ast.ND_VAR and obj.name == "self" and
                        lhs.name == fname):
                    return True
            return False

        if node.kind == ast.ND_BLOCK:
            return self.definitely_assigns(node.body, fname)

        # ★ else が無ければ「条件が偽のときに素通りする」経路が残ります
        if node.kind == ast.ND_IF:
            if node.els is None:
                return False
            if not self.definitely_assigns_stmt(node.body, fname):
                return False
            return self.definitely_assigns_stmt(node.els, fname)

        # 注意: ループは 0 回かもしれません（保守的に「代入しない」と見ます）
        if node.kind == ast.ND_WHILE:
            return False

        if node.kind == ast.ND_TRY:
            if not self.definitely_assigns_stmt(node.body, fname):
                return False
            ex: rc[ast.Node] | None = node.els
            while ex is not None:
                exx: rc[ast.Node] = ex
                if not self.definitely_assigns_stmt(exx.body, fname):
                    return False
                ex = exx.next
            return True

        return False

    def find_init(self, c: rc[ast.Class]) -> rc[ast.Node] | None:
        node: rc[ast.Node] = unwrap_node(c.node)
        m: rc[ast.Node] | None = node.body
        while m is not None:
            mm: rc[ast.Node] = m
            if mm.kind == ast.ND_FUNC and mm.name == "init":
                return mm
            m = mm.next
        return None

    def check_fields_initialized(self, c: rc[ast.Class]) -> None:
        init: rc[ast.Node] | None = self.find_init(c)

        f: rc[ast.Field] | None = c.fields
        while f is not None:
            fld: rc[ast.Field] = f
            ft: rc[ast.Type] = unwrap_type(fld.type)
            # ★ 既定値を作れる型は対象外（int / str / list / T | None）
            if ft.kind == ast.TY_CLASS:
                assigned: bool = False
                if init is not None:
                    ini: rc[ast.Node] = init
                    assigned = self.definitely_assigns_stmt(ini.body, fld.name)
                if not assigned:
                    rel: rc[token.Token] | None = c.tok
                    rel_label: str = diag.msg0("sema.563", "このクラスには init がありません")
                    if init is not None:
                        rel = init.tok
                        rel_label = diag.msg0("sema.562", "init はここです")
                    diag.error_full(unwrap_tok(fld.tok),
                                    diag.msg("sema.301", "フィールド '{0}' は init で代入されていません", [copy(fld.name)]),
                                    diag.msg0("sema.561", "このフィールドは None から始まってしまいます"),
                                    rel, rel_label,
                                    diag.msg("sema.302", "次のどちらかにしてください:\n             ・型を '{0} | None' にする\n             ・init の中で self.{1} = ... と代入する", [copy(ast.type_name(ft)), copy(fld.name)]))
            f = fld.next

    # 1b：フィールドとメソッドを解決する
    # ── インタフェース ──────────────────────────────────
    #
    # ★ 表現：**vtable へのポインタをオブジェクトの先頭に隠しフィールドとして
    #   持たせる**方式。ファットポインタ（2 語）にすると「値はどれも 8 バイト」
    #   という前提が全部崩れるため。おかげでクラス → インタフェースの変換が
    #   **何もしないで済む**（同じポインタ）。
    #
    # 注意: メソッドのスロット番号は **プログラム全体で一意**。1 つのクラスが
    #   複数のインタフェースを実装できるようにするため。
    def declare_iface(mut self, n: mut rc[ast.Node]) -> None:
        if self.lookup_iface(n.name) is not None or self.lookup_class(n.name) is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.303", "'{0}' は既に定義されています", [copy(n.name)]),
                            diag.msg0("sema.552", "ここで再定義されています"), None, "", "")

        ifc: rc[ast.Iface] = rc(ast.Iface(n.name, n.tok))
        ifc.ir_name = self.mod_mangle(n.name)
        ifc.owner_name = self.cur_mod().name

        m: rc[ast.Node] | None = n.body
        while m is not None:
            mn: rc[ast.Node] = m
            for q in ifc.methods:
                if q.name == mn.name:
                    diag.error_at_hint(unwrap_tok(mn.tok),
                                       diag.msg0("sema.305", "同じ名前のメソッドを 2 度書くことはできません"),
                                       diag.msg("sema.304", "メソッド '{0}' が重複しています", [copy(mn.name)]))
            # ★ インタフェースの宣言に既定値は書けません（A-38）。
            #   呼ぶ側はどの実装が入るか知らないので、既定値を埋める人が
            #   決まりません（実装ごとに違う既定値を書けてしまいます）。
            ip: rc[ast.Node] | None = mn.params
            while ip is not None:
                ipp: rc[ast.Node] = ip
                if ipp.rhs is not None:
                    diag.error_full(unwrap_tok(unwrap_node(ipp.rhs).tok),
                                    diag.msg0("sema.564", "インタフェースの宣言に既定値は書けません"),
                                    diag.msg0("sema.565", "ここには既定値を書けません"), None, "",
                                    diag.msg0("sema.566", "どの実装が呼ばれるかは実行時に決まるので、既定値を埋める人が決まりません。既定値はクラス側のメソッドに書いてください（インタフェース越しには使えません）"))
                ip = ipp.next

            # ★ インタフェースに drop は置けません（E-DROP-2）。
            #   対になる定義: src/sema.c の declare_iface
            if mn.name == "drop":
                diag.error_code_full(unwrap_tok(mn.tok), "E-DROP-2",
                                     diag.msg0("sema.567", "インタフェースに drop は宣言できません（drop はデストラクタの名前です）"),
                                     diag.msg0("sema.568", "インタフェース越しに呼べると、解放のときにもう一度呼ばれます"), None, "",
                                     diag.msg0("sema.449", "早く後始末をしたいときは、別の名前のメソッド（close など）に分けてください（仕様 §6.2）"))
            ifc.methods.append(rc(ast.IMethod(mn.name, mn, self.next_slot)))
            self.next_slot = self.next_slot + 1
            m = mn.next

        cs: rc[types.ModuleSyms] = self.cur_syms()
        ifc.next = cs.ifaces
        cs.ifaces = ifc
        n.type = ast.type_iface(n.name, ifc)

    # 型注釈に書かれたインタフェース名を引く
    def resolve_iface_ref(mut self, tr: rc[ast.Node]) -> rc[ast.Iface]:
        if len(tr.mod_name) > 0:
            ms: rc[types.ModuleSyms] | None = self.lookup_import(tr.mod_name)
            if ms is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg("sema.010", "ファイルの先頭に 'import {0}' を書いてください", [copy(tr.mod_name)]),
                                   diag.msg("sema.009", "モジュール '{0}' を import していません", [copy(tr.mod_name)]))
                return rc(ast.Iface("", None))
            mi: rc[ast.Iface] | None = self.lookup_iface_in(ms, tr.name)
            if mi is None:
                diag.error_at_hint(unwrap_tok(tr.tok),
                                   diag.msg0("sema.307", "インタフェース名を確認してください"),
                                   diag.msg("sema.306", "モジュール '{0}' にインタフェース '{1}' はありません", [copy(tr.mod_name), copy(tr.name)]))
                return rc(ast.Iface("", None))
            return mi

        i2: rc[ast.Iface] | None = self.lookup_iface(tr.name)
        if i2 is None:
            h: str = diag.msg0("sema.570", "interface で宣言してから使ってください")
            if self.lookup_class(tr.name) is not None:
                h = diag.msg("sema.309", "'{0}' はクラスです。継承はありません", [copy(tr.name)])
            diag.error_full(unwrap_tok(tr.tok),
                            diag.msg("sema.308", "インタフェース '{0}' が見つかりません", [copy(tr.name)]),
                            diag.msg0("sema.569", "ここに書けるのはインタフェース名だけです"), None, "", h)
            return rc(ast.Iface("", None))
        return i2

    # クラスが宣言どおりのメソッドを持っているかを確かめる
    def check_implements(mut self, c: rc[ast.Class], ifc: rc[ast.Iface],
                         at: rc[token.Token]) -> None:
        for im in ifc.methods:
            f: rc[types.FuncSig] | None = self.lookup_func(c.name + "." + im.name)
            if f is None:
                diag.error_full(at,
                                diag.msg("sema.310", "クラス '{0}' に '{1}' がありません", [copy(c.name), copy(im.name)]),
                                diag.msg("sema.311", "'{0}' を実装すると宣言しています", [copy(ifc.name)]),
                                unwrap_node(im.sig).tok, diag.msg0("sema.571", "このメソッドが必要です"), "")
                # 注意: ここには来ません（error_full は戻りません）。
                #   絞り込みを続けるために、型を合わせて返します。
                return

            fs: rc[types.FuncSig] = f
            sig: rc[ast.Node] = unwrap_node(im.sig)

            want: int = count_siblings(sig.params)
            if len(fs.params) != want:
                diag.error_full(unwrap_tok(fs.tok),
                                diag.msg("sema.312", "'{0}.{1}' の引数の数が宣言と違います", [copy(c.name), copy(im.name)]),
                                diag.msg("sema.313", "{0} 個です", [copy(str(len(fs.params)))]), sig.tok,
                                diag.msg("sema.314", "宣言では {0} 個です", [copy(str(want))]), "")
                return

            k: int = 0
            pm: rc[ast.Node] | None = sig.params
            while pm is not None:
                pn: rc[ast.Node] = pm
                if k > 0:
                    # ★ 引数の**名前**も宣言と同じであること（A-38 の続き）。
                    #   名前は呼び出し側から見える約束です（キーワード引数）。
                    if fs.pnames[k] != pn.name:
                        diag.error_full(unwrap_tok(fs.tok),
                                        diag.msg("sema.315", "'{0}.{1}' の {2} 番目の引数の名前が宣言と違います", [copy(c.name), copy(im.name), copy(str(k))]),
                                        diag.msg("sema.316", "実装では '{0}' です", [copy(fs.pnames[k])]),
                                        pn.tok,
                                        diag.msg("sema.317", "宣言では '{0}' です", [copy(pn.name)]),
                                        diag.msg0("sema.572", "引数の名前は呼び出し側から見える約束です（名前で渡すときに使います）。宣言に合わせてください"))
                    wt: rc[ast.Type] = self.resolve_type(unwrap_node(pn.type_ref))
                    if not ast.type_equal(fs.params[k], wt):
                        diag.error_full(unwrap_tok(fs.tok),
                                        diag.msg("sema.318", "'{0}.{1}' の {2} 番目の引数の型が宣言と違います", [copy(c.name), copy(im.name), copy(str(k))]),
                                        diag.msg("sema.156", "'{0}' 型です", [copy(ast.type_name(fs.params[k]))]),
                                        pn.tok,
                                        diag.msg("sema.319", "宣言では '{0}' 型です", [copy(ast.type_name(wt))]),
                                        "")
                k = k + 1
                pm = pn.next

            wr: rc[ast.Type] = self.resolve_type(unwrap_node(sig.type_ref))
            if not ast.type_equal(unwrap_type(fs.ret), wr):
                diag.error_full(unwrap_tok(fs.tok),
                                diag.msg("sema.320", "'{0}.{1}' の戻り型が宣言と違います", [copy(c.name), copy(im.name)]),
                                diag.msg("sema.321", "'{0}' を返します", [copy(ast.type_name(unwrap_type(fs.ret)))]),
                                sig.tok,
                                diag.msg("sema.317", "宣言では '{0}' です", [copy(ast.type_name(wr))]), "")
            # ★ raises も宣言の一部です（A-40）。
            #   実装だけが失敗しうる、という形は通せません——呼ぶ側は
            #   インタフェースの宣言しか見ないので、try を書く手がかりが
            #   無くなります。逆に、宣言にあって実装に無いのも断ります。
            decl: rc[types.FuncSig] = rc(types.FuncSig(im.name, sig.tok))
            self.resolve_raises(sig, decl)
            if len(fs.raises_cls) != len(decl.raises_cls):
                diag.error_full(unwrap_tok(fs.tok),
                                diag.msg("sema.322", "'{0}.{1}' の raises が宣言と違います", [copy(c.name), copy(im.name)]),
                                diag.msg("sema.323", "実装は {0} 個のエラーを宣言しています", [copy(str(len(fs.raises_cls)))]),
                                sig.tok,
                                diag.msg("sema.314", "宣言では {0} 個です", [copy(str(len(decl.raises_cls)))]),
                                diag.msg0("sema.573", "インタフェース越しに呼ぶ側は宣言しか見ません。同じ raises を書いてください"))
            di: int = 0
            while di < len(decl.raises_cls):
                found: bool = False
                fj: int = 0
                while fj < len(fs.raises_cls):
                    if same_class(fs.raises_cls[fj], decl.raises_cls[di]):
                        found = True
                    fj = fj + 1
                if not found:
                    diag.error_full(unwrap_tok(fs.tok),
                                    diag.msg("sema.324", "'{0}.{1}' が '{2}' を宣言していません", [copy(c.name), copy(im.name), copy(decl.raises_cls[di].name)]),
                                    diag.msg0("sema.574", "このエラーが raises にありません"),
                                    sig.tok,
                                    diag.msg("sema.325", "宣言では '{0}' を投げます", [copy(decl.raises_cls[di].name)]),
                                    diag.msg0("sema.573", "インタフェース越しに呼ぶ側は宣言しか見ません。同じ raises を書いてください"))
                di = di + 1

    def declare_class_members(mut self, n: mut rc[ast.Node]) -> None:
        c: rc[ast.Class] = unwrap_class(n.cls)

        # ★ 実装するインタフェースを先に決める。
        #   レイアウト（隠しフィールドの有無）がこれで変わるため。
        #   注意: メソッドの照合は、メソッドを登録した**後**に行う。
        ir: rc[ast.Node] | None = n.ifaces
        while ir is not None:
            irn: rc[ast.Node] = ir
            ifc0: rc[ast.Iface] = self.resolve_iface_ref(irn)
            for prev in c.impls:
                if prev == ifc0:
                    diag.error_at_hint(unwrap_tok(irn.tok),
                                       diag.msg0("sema.327", "同じインタフェースを 2 度書けません"),
                                       diag.msg("sema.326", "'{0}' は既に書かれています", [copy(ifc0.name)]))
            c.impls.append(ifc0)
            ir = irn.next

        # ① フィールド（宣言順に末尾へ足す。並び順がレイアウトになる）
        head: rc[ast.Field] = rc(ast.Field("", None))
        cur: rc[ast.Field] = head
        m: rc[ast.Node] | None = n.body
        while m is not None:
            mm: rc[ast.Node] = m
            if mm.kind == ast.ND_FIELDDECL:
                prev: rc[ast.Field] | None = self.lookup_field(c, mm.name)
                if prev is not None:
                    diag.error_full(unwrap_tok(mm.tok),
                                    diag.msg("sema.328", "フィールド '{0}' は既に宣言されています", [copy(mm.name)]),
                                    diag.msg0("sema.403", "ここで再宣言されています"),
                                    prev.tok, diag.msg0("sema.404", "最初の宣言はここです"), "")

                ft: rc[ast.Type] = self.resolve_type(unwrap_node(mm.type_ref))
                if ft.kind == ast.TY_NONE:
                    diag.error_at_hint(unwrap_tok(mm.tok),
                                       diag.msg0("sema.330", "None 型の値は存在しないのでフィールドにできません"),
                                       diag.msg0("sema.329", "フィールドの型に None は使えません"))

                f: rc[ast.Field] = rc(ast.Field(mm.name, mm.tok))
                f.type = ft
                cur.next = f
                cur = f
                c.fields = head.next    # ★ lookup_field を回すためつなぎ直す
                mm.type = ft
            m = mm.next
        c.fields = head.next
        self.layout_class(c)

        # ② メソッド
        m2: rc[ast.Node] | None = n.body
        while m2 is not None:
            mm2: rc[ast.Node] = m2
            if mm2.kind == ast.ND_FUNC:
                self.declare_method(c, mm2)
            m2 = mm2.next

        # ③ クラス型のフィールドが None から始まらないか
        self.check_fields_initialized(c)

        # ④ 宣言したインタフェースを本当に実装しているか
        ir2: rc[ast.Node] | None = n.ifaces
        while ir2 is not None:
            irn2: rc[ast.Node] = ir2
            self.check_implements(c, self.resolve_iface_ref(irn2),
                                  unwrap_tok(irn2.tok))
            ir2 = irn2.next

    # 境界に出せる型か（設計 ffi.md §3）。対になる定義: src/sema.c の export_type_ok
    def export_scalar_ok(self, t: rc[ast.Type]) -> bool:
        if ast.ty_is_range(t):
            return False
        return (t.kind == ast.TY_INT or t.kind == ast.TY_FLOAT or
                t.kind == ast.TY_BOOL or t.kind == ast.TY_STR)

    def export_type_ok(self, t: rc[ast.Type], is_ret: bool) -> bool:
        if is_ret and t.kind == ast.TY_NONE:
            return True
        if t.kind == ast.TY_LIST:
            el: rc[ast.Type] | None = t.elem
            if el is None:
                return False
            return self.export_scalar_ok(unwrap_type(el))
        return self.export_scalar_ok(t)

    def check_export_type(self, t: rc[ast.Type], tok: rc[token.Token] | None,
                          what: str) -> None:
        # 注意: what は訳された文字列なので、比べる側も同じ鍵で引きます
        if self.export_type_ok(t, what == diag.msg0("sema.579", "戻り値")):
            return
        diag.error_code_full(unwrap_tok(tok), "E-EXPORT-1",
                             diag.msg("sema.332", "'{0}' は外へ出す関数の{1}に使えません", [copy(ast.type_name(t)), copy(what)]),
                             diag.msg0("sema.577", "この型は境界を越えられません"), None, "",
                             diag.msg0("sema.578", "使えるのは int / float / bool / str と、その list です（クラスなどは外へ出さず、この関数の中で使ってください）"))

    def check_export_sig(self, n: rc[ast.Node], f: rc[types.FuncSig]) -> None:
        self.check_export_type(unwrap_type(f.ret), n.tok, diag.msg0("sema.579", "戻り値"))
        i: int = 0
        pm: rc[ast.Node] | None = n.params
        while pm is not None:
            p: rc[ast.Node] = pm
            self.check_export_type(f.params[i], p.tok, diag.msg0("sema.580", "引数"))
            # ★ 境界では写すので、書き換えても外には戻りません（ffi.md §3.1）
            if p.mode == ast.PM_MUT:
                diag.error_code_full(unwrap_tok(p.tok), "E-EXPORT-2",
                                     diag.msg("sema.333", "外へ出す関数の引数 '{0}' は mut にできません", [copy(p.name)]),
                                     diag.msg0("sema.581", "外から来た値は写しなので、書き換えても呼んだ側には戻りません"),
                                     None, "", diag.msg0("sema.582", "書き換えた結果は戻り値で返してください"))
            i = i + 1
            pm = p.next

    # extern の引数と戻り値に使える型か
    def check_extern_type(self, t: rc[ast.Type], tok: rc[token.Token] | None,
                          what: str) -> None:
        if t.kind != ast.TY_BOOL:
            return
        diag.error_full(unwrap_tok(tok),
                        diag.msg("sema.331", "extern の{0}に bool は使えません", [copy(what)]),
                        diag.msg0("sema.575", "この型は C との境界を越えられません"), None, "",
                        diag.msg0("sema.576", "int で受け取り、本言語側で 'n == 1' と書いてください"))

    # ── ジェネリック関数の実体化 ──────────────────────
    #
    # ★ **実引数の型から型引数を決める。** クラスと違い、左辺の型からは
    #   決められない（f(xs) の左辺には戻り値の型しかない）。
    # ── lambda を実体にする（A-42）───────────────────────────
    #
    # ★ lambda には**型が書いてありません**。どんな関数になるかは
    #   「置かれた場所」で決まります。
    #
    #     p: fn(int) -> bool = lambda x: x > 0
    #        ^^^^^^^^^^^^^^^ これが答え
    #
    #   ジェネリック関数の単相化と同じ道を通します——パーサが .T0 / .R という
    #   型引数を作っておき、ここで fn(int) -> bool の中身を束ねます。
    #   **新しい仕組みを足していません。**
    #   対になる定義: src/sema.c の instantiate_lambda
    # lambda の本体から「外の変数」を集める（A-43）。
    #
    # ★ **ここが捕獲の入口です。** lambda はトップレベルへ持ち上げるので、
    #   外の名前はそのままでは見えません。**作った場所で**どれを捕まえるか
    #   決め、**引数として渡す**形に書き換えます。
    #
    # 注意: グローバルと関数は捕まえません（持ち上げた先からも見えます）。
    #   対になる定義: src/sema.c の collect_captures
    def collect_captures(mut self, n: rc[ast.Node] | None,
                         params: rc[ast.Node] | None,
                         out: mut list[rc[ast.Node]]) -> None:
        cur: rc[ast.Node] | None = n
        while cur is not None:
            c: rc[ast.Node] = cur
            if c.kind == ast.ND_VAR:
                is_param: bool = False
                pm: rc[ast.Node] | None = params
                while pm is not None:
                    p: rc[ast.Node] = pm
                    if p.name == c.name:
                        is_param = True
                    pm = p.next
                if not is_param:
                    v: rc[types.VarEntry] | None = self.lookup(c.name)
                    if v is not None:
                        vv: rc[types.VarEntry] = v
                        seen: bool = not vv.is_global
                        seen = not seen      # グローバルなら捕まえません
                        for q in out:
                            if q.name == c.name:
                                seen = True
                        if not seen:
                            cap: rc[ast.Node] = ast.new_var_node(c.tok, c.name)
                            cap.ir_name = copy(vv.ir_name)
                            cap.type = vv.type
                            out.append(cap)
            self.collect_captures(c.lhs, params, out)
            self.collect_captures(c.rhs, params, out)
            self.collect_captures(c.els, params, out)
            self.collect_captures(c.body, params, out)
            self.collect_captures(c.incr, params, out)
            self.collect_captures(c.args, params, out)
            cur = c.next

    # 捕まえられる型か（A-43）。**値型だけ**です。
    # ★ A-51 から str / list / クラスなども**借りて**捕まえられる。
    #   対になる定義: src/sema.c の capturable / capture_by_value
    def capturable(self, t: rc[ast.Type]) -> bool:
        if capture_by_value(t):
            return True
        k: int = t.kind
        if (k == ast.TY_STR or k == ast.TY_LIST or k == ast.TY_CLASS or k == ast.TY_IFACE or
                k == ast.TY_TUPLE or k == ast.TY_RC or k == ast.TY_WEAK or k == ast.TY_ENUM):
            return True
        if k == ast.TY_OPT:
            return self.capturable(ast.elem_of(t))
        # 注意: fn の値は捕まえない（その値がさらに借りているものを追えなくなる）
        return False

    def instantiate_lambda(mut self, tmpl: rc[types.FuncSig],
                           ref: mut rc[ast.Node]) -> rc[types.FuncSig]:
        tn: rc[ast.Node] = unwrap_node(tmpl.tmpl)

        np: int = 0
        pm0: rc[ast.Node] | None = tn.params
        while pm0 is not None:
            p0: rc[ast.Node] = pm0
            np = np + 1
            pm0 = p0.next

        want0: rc[ast.Type] | None = self.expected
        if want0 is None:
            diag.error_full(unwrap_tok(ref.tok),
                            diag.msg0("sema.590", "この lambda がどんな関数になるのか決められません"),
                            diag.msg0("sema.591", "ここでは引数と戻り値の型が決まりません"), None, "",
                            diag.msg0("sema.592", "型注釈のある変数に入れるか、関数型の引数に渡してください:\n             p: fn(int) -> bool = lambda x: x > 0\n             count_if(xs, lambda x: x > 0)"))
            return tmpl
        want: rc[ast.Type] = want0
        if want.kind != ast.TY_FN and want.kind != ast.TY_CLOSURE:
            diag.error_full(unwrap_tok(ref.tok),
                            diag.msg0("sema.590", "この lambda がどんな関数になるのか決められません"),
                            diag.msg0("sema.591", "ここでは引数と戻り値の型が決まりません"), None, "",
                            diag.msg0("sema.592", "型注釈のある変数に入れるか、関数型の引数に渡してください:\n             p: fn(int) -> bool = lambda x: x > 0\n             count_if(xs, lambda x: x > 0)"))
            return tmpl
        if len(want.params) != np:
            diag.error_full(unwrap_tok(ref.tok),
                            diag.msg("sema.340", "この lambda は {0} 個の引数を取りますが、'{1}' が要ります", [copy(str(np)), copy(ast.type_name(want))]),
                            diag.msg("sema.341", "引数が {0} 個です", [copy(str(np))]), None, "",
                            diag.msg("sema.342", "ここに置けるのは {0} 引数の lambda です", [copy(str(len(want.params)))]))
            return tmpl

        # ★ 外の変数を集めます（A-43）。**いまの scope が生きているうち**に
        #   決めます（この後で持ち上げ先のモジュールへ移ります）。
        caps: list[rc[ast.Node]] = []
        self.collect_captures(tn.body, tn.params, caps)
        heap: bool = want.kind == ast.TY_CLOSURE
        ref.is_closure = heap
        for c in caps:
            # ★ closure（A-51）は借りて捕まえない。値型は写し、rc / weak は共有、
            #   str / list / クラスは copy で写す。対になる定義: src/sema.c
            if heap:
                ct: rc[ast.Type] = unwrap_type(c.type)
                cb: rc[ast.Type] = ct
                if ct.kind == ast.TY_OPT:
                    cb = ast.elem_of(ct)
                if not capture_by_value(ct) and cb.kind != ast.TY_RC and cb.kind != ast.TY_WEAK:
                    self.check_copyable(ct, c.tok)
                continue
            if not self.capturable(unwrap_type(c.type)):
                diag.error_full(unwrap_tok(ref.tok),
                                diag.msg("sema.343", "'{0}' は捕まえられません（'{1}' 型）", [copy(c.name), copy(ast.type_name(unwrap_type(c.type)))]),
                                diag.msg0("sema.593", "この lambda が外の変数を使っています"), None, "",
                                diag.msg0("sema.642", "関数の値・Thread・mutex・ptr は捕まえられません。引数で受け取るか、def で書いた関数にしてください"))

        # 束ねる型の並び（引数 … と戻り型 … と捕まえた値の型）
        args: list[rc[ast.Type]] = []
        i: int = 0
        while i < np:
            args.append(want.params[i])
            i = i + 1
        args.append(ast.elem_of(want))
        for c2 in caps:
            args.append(unwrap_type(c2.type))

        iname: str = self.mangle_inst(tmpl.name, args)

        ow0: rc[types.ModuleSyms] | None = tmpl.owner
        owner: rc[types.ModuleSyms] = self.cur_syms()
        if ow0 is not None:
            owner = ow0
        ex: rc[types.FuncSig] | None = self.lookup_func_in(owner, iname)
        if ex is not None:
            return ex

        saved_mod: rc[types.ModuleSyms] = self.cur_syms()
        saved_scope: rc[types.Scope] | None = self.scope
        saved_tbind: rc[TBinds] | None = self.tbind
        saved_func: rc[types.FuncSig] | None = self.cur_func
        saved_used: rc[UsedNames] = self.used
        saved_expected: rc[ast.Type] | None = self.expected

        self.enter_module(owner)
        self.expected = None

        binds: rc[TBinds] = rc(TBinds())
        ti: int = 0
        tp2: rc[ast.Node] | None = tn.targs
        while tp2 is not None:
            tpn2: rc[ast.Node] = tp2
            binds.names.append(copy(tpn2.name))
            binds.types_.append(args[ti])
            ti = ti + 1
            tp2 = tpn2.next
        self.tbind = binds

        inst: rc[ast.Node] = unwrap_node(ast.ast_clone(tn))
        inst.name = copy(iname)
        inst.targs = None
        inst.next = None

        # ★ 捕まえた値は**末尾の引数**として受け取ります（A-43）。
        #   本体の名前解決は今までどおりで済みます——捕まえた名前がそのまま
        #   引数の名前になるので、書き換えるところがありません。
        if len(caps) > 0:
            ptail: rc[ast.Node] | None = inst.params
            last_p: rc[ast.Node] | None = None
            while ptail is not None:
                lp: rc[ast.Node] = ptail
                last_p = lp
                ptail = lp.next
            ci: int = 0
            for c3 in caps:
                tname: str = tmpl.name + ".C" + str(ci)
                binds.names.append(copy(tname))
                binds.types_.append(unwrap_type(c3.type))

                pm2: rc[ast.Node] = ast.new_node(ast.ND_PARAM, ref.tok)
                pm2.name = copy(c3.name)
                # ★ closure（A-51）の記録は捕まえた値を所有するので、mut で借りて渡す
                if heap:
                    pm2.mode = ast.PM_MUT
                tr2: rc[ast.Node] = ast.new_node(ast.ND_TYPEREF, ref.tok)
                tr2.name = copy(tname)
                pm2.type_ref = tr2
                if last_p is None:
                    inst.params = pm2
                else:
                    unwrap_node(last_p).next = pm2
                last_p = pm2
                ci = ci + 1

            # 捕獲の並びを ref に覚えさせます（codegen が記録を作ります）
            head_c: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, ref.tok)
            cc: rc[ast.Node] = head_c
            for c4 in caps:
                cc.next = c4
                cc = c4
            ref.caps = head_c.next

        self.declare_func(inst)

        # codegen が拾えるように、そのモジュールの AST に足します
        omod: rc[module.Module] | None = owner.mod
        root: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, None)
        if omod is None:
            panic(diag.msg0("ssema.005", "sema: モジュールがありません"))
        else:
            root = unwrap_node(omod.ast)
        last: rc[ast.Node] = unwrap_node(root.body)
        nx: rc[ast.Node] | None = last.next
        while nx is not None:
            last = nx
            nx = last.next
        last.next = inst

        self.pending.append(Instance(inst, owner, binds, unwrap_tok(ref.tok),
                                     copy(iname), True))

        made: rc[types.FuncSig] | None = self.lookup_func(iname)

        self.enter_module(saved_mod)
        self.scope = saved_scope
        self.cur_func = saved_func
        self.used = saved_used
        self.tbind = saved_tbind
        self.expected = saved_expected
        if made is None:
            panic(diag.msg0("ssema.015", "sema: 実体化した lambda が見つかりません"))
            return tmpl
        return made

    def instantiate_func(mut self, tmpl: rc[types.FuncSig],
                         call: mut rc[ast.Node]) -> rc[types.FuncSig]:
        tn: rc[ast.Node] = unwrap_node(tmpl.tmpl)

        want: int = count_siblings(tn.params)

        # ★ 並べ替えと既定値の穴埋め（A-38）。**型引数を決める前に**やります。
        #   型引数は「何番目の引数が何型か」から決まるので、並びが定義どおりに
        #   なっていないと、T が別の引数から決まってしまいます。
        #   名前と既定値はテンプレートの引数リストから取ります（この関数には
        #   まだ FuncSig がありません）。
        if want > 0:
            tpnames: list[str] = []
            tdefaults: list[rc[ast.Node] | None] = []
            tpm: rc[ast.Node] | None = tn.params
            while tpm is not None:
                tp0: rc[ast.Node] = tpm
                tpnames.append(copy(tp0.name))
                tdefaults.append(tp0.rhs)
                tpm = tp0.next
            bind_args(call, want, tpnames, tdefaults, tn.tok,
                      diag.msg("sema.345", "関数 '{0}'", [copy(tmpl.name)]), False)

        nargs: int = count_siblings(call.args)
        if nargs != want:
            diag.error_at_hint(unwrap_tok(call.tok),
                               diag.msg("sema.224", "'{0}' は {1} 個の引数を取ります", [copy(tmpl.name), copy(str(want))]),
                               diag.msg("sema.164", "引数の個数が違います（{0} 個渡されました）", [copy(str(nargs))]))

        # ── 実引数の型を先に求める ──
        atypes: list[rc[ast.Type]] = []
        a: rc[ast.Node] | None = call.args
        while a is not None:
            an: rc[ast.Node] = a
            atypes.append(self.check_expr(an))
            a = an.next

        # ── 型引数を決める ──
        args: list[rc[ast.Type]] = []
        tp: rc[ast.Node] | None = tn.targs
        while tp is not None:
            tpn: rc[ast.Node] = tp
            got: rc[ast.Type] | None = None
            pi: int = 0
            pm: rc[ast.Node] | None = tn.params
            while pm is not None and got is None:
                pmn: rc[ast.Node] = pm
                got = self.unify_tparam(tpn.name, pmn.type_ref, atypes[pi])
                pi = pi + 1
                pm = pmn.next
            if got is None:
                diag.error_full(unwrap_tok(call.tok),
                                diag.msg("sema.347", "型引数 '{0}' を決められません", [copy(tpn.name)]),
                                diag.msg0("sema.595", "実引数から決まりません"), tn.tok,
                                diag.msg0("sema.596", "この関数の定義です"),
                                diag.msg0("sema.597", "型引数は **引数の型から**決まります（戻り型にしか現れない型引数は書けません）"))
            else:
                args.append(got)
            tp = tpn.next

        iname: str = self.mangle_inst(tmpl.name, args)

        ow0: rc[types.ModuleSyms] | None = tmpl.owner
        owner: rc[types.ModuleSyms] = self.cur_syms()
        if ow0 is not None:
            owner = ow0
        ex: rc[types.FuncSig] | None = self.lookup_func_in(owner, iname)
        if ex is not None:
            return ex

        saved_mod: rc[types.ModuleSyms] = self.cur_syms()
        saved_scope: rc[types.Scope] | None = self.scope
        saved_tbind: rc[TBinds] | None = self.tbind
        saved_func: rc[types.FuncSig] | None = self.cur_func
        saved_used: rc[UsedNames] = self.used

        self.enter_module(owner)

        binds: rc[TBinds] = rc(TBinds())
        ti: int = 0
        tp2: rc[ast.Node] | None = tn.targs
        while tp2 is not None:
            tpn2: rc[ast.Node] = tp2
            binds.names.append(copy(tpn2.name))
            binds.types_.append(args[ti])
            ti = ti + 1
            tp2 = tpn2.next
        self.tbind = binds

        inst: rc[ast.Node] = unwrap_node(ast.ast_clone(tn))
        inst.name = copy(iname)
        inst.targs = None
        inst.next = None

        self.declare_func(inst)

        omod: rc[module.Module] | None = owner.mod
        root: rc[ast.Node] = ast.new_node(ast.ND_BLOCK, None)
        if omod is None:
            panic(diag.msg0("ssema.005", "sema: モジュールがありません"))
        else:
            root = unwrap_node(omod.ast)
        last: rc[ast.Node] = unwrap_node(root.body)
        nx: rc[ast.Node] | None = last.next
        while nx is not None:
            last = nx
            nx = last.next
        last.next = inst

        self.pending.append(Instance(inst, owner, binds, unwrap_tok(call.tok),
                                     copy(iname), True))

        made: rc[types.FuncSig] | None = self.lookup_func(iname)

        self.enter_module(saved_mod)
        self.scope = saved_scope
        self.cur_func = saved_func
        self.used = saved_used
        self.tbind = saved_tbind
        if made is None:
            panic(diag.msg0("ssema.016", "sema: 実体化した関数が見つかりません"))
            return tmpl
        return made

    # 既定値の並びと型を確かめる（A-38）。
    #
    # ★ 見るのは 2 つです。
    #   ① **既定値のある引数は後ろにまとめる。** 途中に置けると
    #      「前から順に当てて、余りは既定値」で済まなくなります。
    #   ② **既定値の型が引数の型に入るか。** ここで確かめておかないと、
    #      呼び出しごとに同じエラーが出ます（間違っているのは定義側です）。
    #   対になる定義: src/sema.c の check_defaults
    def check_defaults(mut self, f: mut rc[types.FuncSig], fn: rc[ast.Node]) -> None:
        first_default: int = -1
        i: int = 0
        pm: rc[ast.Node] | None = fn.params
        while pm is not None:
            p: rc[ast.Node] = pm
            d0: rc[ast.Node] | None = f.defaults[i]
            if d0 is None:
                if first_default >= 0:
                    diag.error_full(unwrap_tok(p.tok),
                                    diag.msg("sema.357", "既定値のある引数より後ろに、既定値の無い引数 '{0}' があります", [copy(p.name)]),
                                    diag.msg0("sema.613", "この引数にも既定値が要ります"),
                                    unwrap_node(f.defaults[first_default]).tok,
                                    diag.msg("sema.358", "'{0}' に既定値が付いています", [copy(f.pnames[first_default])]),
                                    diag.msg0("sema.614", "既定値のある引数は後ろにまとめてください（そうしないと、前から順に当てられません）"))
            else:
                if first_default < 0:
                    first_default = i
                d: rc[ast.Node] = d0
                # ★ 既定値の型を確かめます。**列挙の枝はここで定数に畳まれます**。
                dt: rc[ast.Type] = self.check_expr(d)
                want: rc[ast.Type] = f.params[i]
                if not ast.type_assignable(dt, want):
                    diag.error_full(unwrap_tok(d.tok),
                                    diag.msg("sema.359", "引数 '{0}' の既定値の型が違います（'{1}' に '{2}' は入りません）", [copy(p.name), copy(ast.type_name(want)), copy(ast.type_name(dt))]),
                                    diag.msg("sema.051", "これは '{0}' 型です", [copy(ast.type_name(dt))]),
                                    None, "", self.no_implicit_hint(dt, want))
                f.defaults[i] = self.range_coerce(d, want)   # A-28
            i = i + 1
            pm = p.next

    def declare_func(mut self, n: mut rc[ast.Node]) -> None:
        self.reject_module_name(n.name, n.tok, diag.msg0("sema.455", "関数"))
        clash: rc[ast.Class] | None = self.lookup_class(n.name)
        if clash is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.334", "'{0}' はクラス名として使われています", [copy(n.name)]),
                            diag.msg0("sema.585", "この名前の関数は定義できません"),
                            clash.tok, diag.msg0("sema.444", "クラスの定義はここです"),
                            diag.msg0("sema.586", "クラス名は「インスタンス生成」の呼び出しに使われます（例: Token(1, \"x\")）"))
        if self.is_builtin_name(n.name):
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg("sema.336", "{0} は組み込み関数です。別の名前を使ってください", [copy(n.name)]),
                               diag.msg("sema.335", "'{0}' は再定義できません", [copy(n.name)]))

        prev: rc[types.FuncSig] | None = self.lookup_func(n.name)
        if prev is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.337", "関数 '{0}' は既に定義されています", [copy(n.name)]),
                            diag.msg0("sema.552", "ここで再定義されています"),
                            prev.tok, diag.msg0("parse.224", "最初の定義はここです"), "")

        # ★ ジェネリックなテンプレートは **型を解決しない**。
        #   T が何なのかまだ決まっていない。名前だけ登録して、呼ばれたときに
        #   実引数から決めて実体を作る。
        if n.targs is not None:
            if n.is_export:
                diag.error_code_full(unwrap_tok(n.tok), "E-EXPORT-1",
                                     diag.msg0("sema.587", "型引数を持つ関数は外へ出せません"),
                                     diag.msg0("sema.588", "外から見ると、型が決まりません"), None, "",
                                     diag.msg0("sema.589", "型を決めた関数を extern def で書き、その中からこの関数を呼んでください"))
            t0: rc[types.FuncSig] = rc(types.FuncSig(n.name, n.tok))
            t0.ir_name = copy(n.name)
            t0.owner = self.cur_syms()
            t0.tmpl = n
            cs0: rc[types.ModuleSyms] = self.cur_syms()
            t0.next = cs0.funcs
            cs0.funcs = t0
            return

        ret: rc[ast.Type] = self.resolve_type(unwrap_node(n.type_ref))

        f: rc[types.FuncSig] = rc(types.FuncSig(n.name, n.tok))
        f.ret = ret
        f.is_lambda = n.is_lambda   # A-42
        f.node = n                  # A-43

        pm: rc[ast.Node] | None = n.params
        while pm is not None:
            p: rc[ast.Node] = pm
            pt: rc[ast.Type] = self.resolve_type(unwrap_node(p.type_ref))
            if pt.kind == ast.TY_NONE:
                diag.error_at_hint(unwrap_tok(p.tok),
                                   diag.msg0("sema.296", "None 型の値は存在しないので引数にできません"),
                                   diag.msg0("sema.295", "引数の型に None は使えません"))
            f.params.append(pt)
            f.pnames.append(copy(p.name))
            f.pmodes.append(p.mode)        # A-21e
            f.defaults.append(p.rhs)       # A-38（無ければ None）
            f.nparams = f.nparams + 1
            p.type = pt
            pm = p.next

        self.check_defaults(f, n)

        # ★ extern は C 側で名前が決まっているので修飾しない
        is_extern_decl: bool = n.body is None
        if is_extern_decl:
            self.check_extern_type(ret, n.tok, diag.msg0("sema.579", "戻り値"))
            pm2: rc[ast.Node] | None = n.params
            while pm2 is not None:
                p2: rc[ast.Node] = pm2
                self.check_extern_type(unwrap_type(p2.type), p2.tok, diag.msg0("sema.580", "引数"))
                pm2 = p2.next

        if n.is_export:
            self.check_export_sig(n, f)

        self.resolve_raises(n, f)
        if is_extern_decl and len(f.raises_cls) > 0:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg0("sema.339", "extern の関数は C 側の約束に従うので raises は書けません"),
                               diag.msg0("sema.338", "extern に raises は書けません"))

        if is_extern_decl:
            f.ir_name = copy(n.name)
        else:
            f.ir_name = self.mod_mangle(n.name)
        f.owner = self.cur_syms()
        ms: rc[types.ModuleSyms] = self.cur_syms()
        f.next = ms.funcs
        ms.funcs = f
        n.ir_name = copy(f.ir_name)
        n.type = ret

    # グローバル変数の登録（言語仕様 6.2）
    def declare_global(mut self, n: mut rc[ast.Node]) -> None:
        self.reject_module_name(n.name, n.tok, diag.msg0("sema.598", "グローバル変数"))
        declared: rc[ast.Type] = self.resolve_type(unwrap_node(n.type_ref))
        if declared.kind == ast.TY_NONE:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg0("sema.084", "None 型の値は存在しないので変数にできません"),
                               diag.msg0("sema.083", "変数の型に None は使えません"))

        prev: rc[types.VarEntry] | None = self.lookup_local(n.name)
        if prev is not None:
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.085", "変数 '{0}' は既に宣言されています", [copy(n.name)]),
                            diag.msg0("sema.403", "ここで再宣言されています"),
                            prev.decl_tok, diag.msg0("sema.404", "最初の宣言はここです"), "")

        # 注意: 初期化式はコンパイル時定数のみ（言語仕様 6.2 の v1 制限）
        rhs: rc[ast.Node] = unwrap_node(n.rhs)
        if (rhs.kind != ast.ND_INT and rhs.kind != ast.ND_BOOL and
                rhs.kind != ast.ND_STR and rhs.kind != ast.ND_FLOAT):
            diag.error_full(unwrap_tok(rhs.tok),
                            diag.msg0("sema.599", "グローバル変数の初期化式は定数でなければなりません"),
                            diag.msg0("sema.600", "ここには整数・浮動小数点数・True / False・文字列リテラルだけが書けます"), None, "",
                            diag.msg0("sema.601", "計算が必要なら main の中でローカル変数にしてください"))

        actual: rc[ast.Type] = self.check_expr(rhs)
        if not ast.type_assignable(actual, declared):
            diag.error_full(unwrap_tok(rhs.tok), diag.msg0("sema.409", "型が一致しません"),
                            diag.msg("sema.089", "型 '{0}' の式", [copy(ast.type_name(actual))]),
                            n.tok,
                            diag.msg("sema.090", "変数 '{0}' は '{1}' 型として宣言されています", [copy(n.name), copy(ast.type_name(declared))]),
                            "")

        # ★ グローバルは定数だけなので、ここはコンパイル時の判定になる（A-28）
        n.rhs = self.range_coerce(n.rhs, declared)

        # グローバルの IR 名は @g.<モジュール>.<名前>
        v: rc[types.VarEntry] = rc(types.VarEntry(n.name, n.tok))
        v.ir_name = "@g." + self.cur_mod().name + "." + n.name
        v.is_global = True
        v.declared = declared
        v.type = declared

        sc: rc[types.Scope] = unwrap_scope(self.scope)
        v.next = sc.vars
        sc.vars = v

        n.ir_name = copy(v.ir_name)
        n.is_global = True
        n.type = declared

    # ── パス 2：本体の検査 ──────────────────────────────────

    def check_func(mut self, n: mut rc[ast.Node]) -> None:
        self.cur_func = self.lookup_func_by_ir(n.ir_name)
        self.used = rc(UsedNames())   # IR 名は関数ごとに振り直す

        self.scope_push()

        # 引数をローカル変数として登録する
        pm: rc[ast.Node] | None = n.params
        while pm is not None:
            p: rc[ast.Node] = pm
            v: rc[types.VarEntry] = self.declare(p.name, unwrap_type(p.type), p.tok)
            p.ir_name = copy(v.ir_name)
            pm = p.next

        body: rc[ast.Node] = unwrap_node(n.body)

        # ★ 契約は**本体の先頭**にしか置けない（A-29）。
        #   requires は入口で、ensures は出口で確かめるので、途中に書けると
        #   「書いた場所と確かめる場所が違う」ことになり、読む人が誤解する。
        #   対になる定義: src/sema.c の check_func
        seen_other: bool = False
        cs: rc[ast.Node] | None = body.body
        while cs is not None:
            cn: rc[ast.Node] = cs
            is_contract: bool = (cn.kind == ast.ND_REQUIRES or
                                 cn.kind == ast.ND_ENSURES)
            if is_contract and seen_other:
                kw2: str = "ensures"
                if cn.kind == ast.ND_REQUIRES:
                    kw2 = "requires"
                diag.error_full(unwrap_tok(cn.tok),
                                diag.msg("sema.348", "{0} は関数の本体の先頭に書きます", [copy(kw2)]),
                                diag.msg0("parse.063", "ここには書けません"), None, "",
                                diag.msg0("sema.602", "requires / ensures は def の直後に並べてください（入口と出口で確かめるものだからです）"))
            if not is_contract:
                seen_other = True
            cs = cn.next

        self.rewrite_old(body)

        self.check_stmt_list(body.body)
        self.scope_pop()

        # 全経路で return するか（型システム 6.1）
        rt: rc[ast.Type] = unwrap_type(n.type)
        if rt.kind != ast.TY_NONE and not self.always_returns(n.body):
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.349", "関数 '{0}' は値を返さずに終わる経路があります", [copy(n.name)]),
                            diag.msg("sema.350", "戻り型は '{0}' です", [copy(ast.type_name(rt))]), None, "",
                            diag.msg0("sema.603", "すべての経路で return してください（if に else が無いと、条件が偽のとき素通りします）"))
        self.cur_func = None

    # main の検査（言語仕様 6.1）
    def check_main(self, root: rc[ast.Node]) -> None:
        m: rc[types.FuncSig] | None = self.lookup_func("main")
        # ★ 外へ出す関数があれば、それはライブラリです（設計 ffi.md §6）
        if m is None:
            d: rc[ast.Node] | None = root.body
            while d is not None:
                dn: rc[ast.Node] = d
                if dn.kind == ast.ND_FUNC and dn.is_export:
                    return
                d = dn.next
        if m is None:
            diag.error_full(unwrap_tok(root.tok), diag.msg0("sema.607", "main 関数がありません"),
                            diag.msg0("sema.608", "このファイルには入口がありません"), None, "",
                            diag.msg0("sema.609", "プログラムの入口として次を定義してください:\n             def main() -> int:\n                 return 0"))
            return
        if m.nparams != 0:
            diag.error_at_hint(unwrap_tok(m.tok),
                               diag.msg0("sema.354", "main は引数なしで定義してください（def main() -> int:）"),
                               diag.msg0("sema.353", "main は引数を取れません"))
        if unwrap_type(m.ret).kind != ast.TY_INT:
            diag.error_at_hint(unwrap_tok(m.tok),
                               diag.msg0("sema.356", "main の戻り値がプロセスの終了コードになります"),
                               diag.msg0("sema.355", "main の戻り型は int でなければなりません"))
        # ★ R4：main の失敗を受け取る相手はいません
        if len(m.raises_cls) > 0:
            diag.error_code_full(unwrap_tok(m.tok), "E-RAISE-4",
                                 diag.msg0("sema.610", "main は raises を宣言できません"),
                                 diag.msg0("sema.611", "この失敗を受け取る相手がいません"), None, "",
                                 diag.msg0("sema.612", "main の中で try で捕まえるか、panic で終わらせてください"))

    # 列挙を登録する（パス 1 のいちばん最初。A-37）
    #
    # ★ **範囲型やクラスより先に**登録する。クラスのフィールドやメソッドの
    #   型注釈に列挙を書けるようにするため（列挙は何にも依存しない）。
    #   対になる定義: src/sema.c の declare_enum
    def declare_enum(mut self, n: mut rc[ast.Node]) -> None:
        if self.type_from_name(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg("sema.290", "'{0}' は組み込みの型名です", [copy(n.name)]),
                               diag.msg0("sema.360", "この名前は使えません"))
        old_e: rc[ast.EnumDef] | None = self.lookup_enum(n.name)
        if old_e is not None:
            olde: rc[ast.EnumDef] = old_e
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.361", "型 '{0}' はすでに定義されています", [copy(n.name)]),
                            diag.msg0("sema.615", "同じ名前の列挙が 2 つあります"),
                            olde.tok, diag.msg0("parse.224", "最初の定義はここです"), "")
        if self.lookup_class(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg0("sema.362", "クラスと同じ名前の列挙は作れません"),
                               diag.msg("sema.334", "'{0}' はクラス名として使われています", [copy(n.name)]))
        if self.lookup_range(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg0("sema.364", "範囲型と同じ名前の列挙は作れません"),
                               diag.msg("sema.363", "'{0}' は範囲型として使われています", [copy(n.name)]))

        e: rc[ast.EnumDef] = rc(ast.EnumDef(n.name, n.tok))
        ms0: rc[types.ModuleSyms] = self.cur_syms()
        e.owner_name = copy(self.cur_mod().name)

        # 枝を宣言した順に並べる（番号は parser が振ってある）
        tail: rc[ast.EnumVal] | None = None
        v: rc[ast.Node] | None = n.body
        while v is not None:
            nv: rc[ast.Node] = v
            ev: rc[ast.EnumVal] = rc(ast.EnumVal(nv.name, nv.ival, nv.tok))
            # ★ 中身の数だけ数えておきます（A-41）。隠しクラスは**あとで**
            #   結びます（branch_class）——列挙は**クラスより先に**登録するので、
            #   この時点ではまだありません。
            pf: rc[ast.Node] | None = nv.params
            while pf is not None:
                pff: rc[ast.Node] = pf
                ev.nfields = ev.nfields + 1
                pf = pff.next
            if tail is None:
                e.vals = ev
            else:
                unwrap_enumval(tail).next = ev
            tail = ev
            e.nvals = e.nvals + 1
            v = nv.next

        e.has_payload = n.has_payload   # A-41
        e.type = ast.type_enum(e.name, e)
        e.next = ms0.enums
        ms0.enums = e
        n.en = e
        n.type = e.type

    # モジュール 1 つぶんの宣言を登録する（パス 1a / 1b / 1c）
    # 範囲型を登録する（パス 1 の最初。A-28）
    #
    # ★ **クラスより先に**登録する。クラスのフィールドやメソッドの型注釈に
    #   範囲型を書けるようにするため。
    #   対になる定義: src/sema.c の declare_range
    def declare_range(mut self, n: mut rc[ast.Node]) -> None:
        if self.type_from_name(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg("sema.290", "'{0}' は組み込みの型名です", [copy(n.name)]),
                               diag.msg0("sema.360", "この名前は使えません"))
        old_r: rc[types.RangeTy] | None = self.lookup_range(n.name)
        if old_r is not None:
            oldr: rc[types.RangeTy] = old_r
            diag.error_full(unwrap_tok(n.tok),
                            diag.msg("sema.361", "型 '{0}' はすでに定義されています", [copy(n.name)]),
                            diag.msg0("sema.616", "同じ名前の範囲型が 2 つあります"),
                            oldr.tok, diag.msg0("parse.224", "最初の定義はここです"), "")
        if self.lookup_class(n.name) is not None:
            diag.error_at_hint(unwrap_tok(n.tok),
                               diag.msg0("sema.365", "クラスと同じ名前の範囲型は作れません"),
                               diag.msg("sema.334", "'{0}' はクラス名として使われています", [copy(n.name)]))

        lo: rc[ast.Node] = unwrap_node(n.lhs)
        hi: rc[ast.Node] = unwrap_node(n.rhs)
        ty: rc[ast.Type] = ast.type_range(n.name, lo.ival, hi.ival)
        r: rc[types.RangeTy] = rc(types.RangeTy(n.name, ty, n.tok))
        ms: rc[types.ModuleSyms] = self.cur_syms()
        r.next = ms.ranges
        ms.ranges = r
        n.type = ty

    def declare_module(mut self, root: mut rc[ast.Node]) -> None:
        # ★ 列挙を最初に登録する（クラスのフィールドにも書けるように。A-37）
        de: rc[ast.Node] | None = root.body
        while de is not None:
            ne: rc[ast.Node] = de
            if ne.kind == ast.ND_ENUM:
                self.declare_enum(ne)
            de = ne.next

        # ★ 範囲型を次に登録する（クラスのフィールドにも書けるように）
        dr: rc[ast.Node] | None = root.body
        while dr is not None:
            nr: rc[ast.Node] = dr
            if nr.kind == ast.ND_RANGEDECL:
                self.declare_range(nr)
            dr = nr.next

        # ★ インタフェースを最初に登録する（クラスが実装を宣言するため）
        di: rc[ast.Node] | None = root.body
        while di is not None:
            ni: rc[ast.Node] = di
            if ni.kind == ast.ND_IFACE:
                self.declare_iface(ni)
            di = ni.next

        d: rc[ast.Node] | None = root.body
        while d is not None:
            n: rc[ast.Node] = d
            if n.kind == ast.ND_CLASS:
                self.declare_class(n)
            d = n.next

        d2: rc[ast.Node] | None = root.body
        while d2 is not None:
            n2: rc[ast.Node] = d2
            # 注意: **ジェネリックなテンプレートはここでは並べない**。
            #   K や V が何なのかまだ決まっていないので、大きさが決められない。
            if n2.kind == ast.ND_CLASS and n2.targs is None:
                self.declare_class_members(n2)
            d2 = n2.next

        d3: rc[ast.Node] | None = root.body
        while d3 is not None:
            n3: rc[ast.Node] = d3
            if n3.kind == ast.ND_FUNC:
                self.declare_func(n3)
            elif n3.kind == ast.ND_VARDECL:
                self.declare_global(n3)
            d3 = n3.next

    # モジュール 1 つぶんの本体を検査する（パス 2）
    def check_module(mut self, root: mut rc[ast.Node]) -> None:
        d: rc[ast.Node] | None = root.body
        while d is not None:
            n: rc[ast.Node] = d
            if n.kind == ast.ND_FUNC:
                # 注意: extern は本体を持たない。
                #   ジェネリックなテンプレートも検査しない。
                if n.body is not None and n.targs is None:
                    self.check_func(n)
            # 注意: ジェネリックなテンプレートの本体は検査しない。
            #   実体ができてから、その実体の本体を検査する。
            elif n.kind == ast.ND_CLASS and n.targs is None:
                m: rc[ast.Node] | None = n.body
                while m is not None:
                    mm: rc[ast.Node] = m
                    if mm.kind == ast.ND_FUNC:
                        self.check_func(mm)
                    m = mm.next
            d = n.next

    # ★ 「別のモジュールのものか」を 1 か所で判定する。
    #   f.owner は型の上では None かもしれないので、ここで開きます。
    def is_extern_owner(self, owner: rc[types.ModuleSyms] | None) -> bool:
        if owner is None:
            return False
        return owner != self.cur_syms()

    def syms_by_name(self, name: str) -> rc[types.ModuleSyms]:
        i: int = 0
        while i < len(self.mods):
            ms: rc[types.ModuleSyms] = self.mods[i]
            if mod_name_of(ms) == name:
                return ms
            i = i + 1
        panic(diag.msg("ssema.017", "sema: モジュール '{0}' のシンボル表がありません", [copy(name)]))
        return rc(types.ModuleSyms(None))


# ── 入口 ───────────────────────────────────────────────────

def unwrap_iface(i: rc[ast.Iface] | None) -> rc[ast.Iface]:
    if i is None:
        panic(diag.msg0("ssema.018", "sema: インタフェースがありません"))
        return rc(ast.Iface("", None))
    return i


def unwrap_cls(c: rc[ast.Class] | None) -> rc[ast.Class]:
    if c is None:
        panic(diag.msg0("ssema.019", "sema: クラスがありません"))
        return rc(ast.Class("", None))
    return c


# 2 つのクラスが同じ定義かを比べる
# 注意: 名前ではなく **定義そのもの**で比べます。
def same_class(a: rc[ast.Class], b: rc[ast.Class]) -> bool:
    return a == b


def sema_program(mods: rc[module.Module] | None, entry: rc[module.Module] | None) -> None:
    s: Sema = Sema()

    # 各モジュールのシンボル表を用意する（この時点では空）
    m: rc[module.Module] | None = mods
    while m is not None:
        mm: rc[module.Module] = m
        s.mods.append(rc(types.ModuleSyms(mm)))
        m = mm.next

    # パス 1：依存が先に並んでいるので、この順で登録すれば
    #         「他モジュールの型注釈」は必ず解決できる
    i: int = 0
    while i < len(s.mods):
        ms: rc[types.ModuleSyms] = s.mods[i]
        s.enter_module(ms)
        s.declare_module(unwrap_node(mod_ast(ms)))
        i = i + 1

    # パス 2：本体
    j: int = 0
    while j < len(s.mods):
        ms2: rc[types.ModuleSyms] = s.mods[j]
        s.enter_module(ms2)
        s.check_module(unwrap_node(mod_ast(ms2)))
        j = j + 1

    # ★ パス 3：実体化したクラスの本体を検査する
    #
    # 注意: 検査の途中で **さらに実体が増える**ことがある
    #   （Dict[str, Box[int]] のように入れ子の場合）。増えなくなるまで繰り返す。
    while len(s.pending) > 0:
        # 注意: move_out で**持ち主ごと**取り出します。ただの代入だと次の行の
        #   `s.pending = []` が古いリストを解放し、batch が宙に浮きます
        #   （A-21f。--drop を既定にして stage1 が落ちて見つかりました）。
        batch: list[Instance] = move_out(s.pending)
        s.pending = []                  # ★ 先に外す（この回の分だけを処理する）
        # 注意: **新しく積んだものから**処理する。C 版は連結リストの先頭に
        #   足して先頭から辿るので、この向きでないと実体を出す順番が
        #   C 版とずれる（IR が 1 バイト単位で一致しなくなる）。
        k: int = len(batch) - 1
        while k >= 0:
            it: Instance = batch[k]
            io2: rc[types.ModuleSyms] | None = it.owner
            if io2 is not None:
                s.enter_module(io2)
            s.tbind = it.binds          # 型引数を戻してから本体を読む
            s.inst_site = it.site       # ★ 発端を控える
            s.inst_name = copy(it.iname)
            inode: rc[ast.Node] = unwrap_node(it.node)
            if it.is_func:
                s.check_func(inode)          # 関数の実体
            else:
                mm3: rc[ast.Node] | None = inode.body
                while mm3 is not None:
                    m3: rc[ast.Node] = mm3
                    if m3.kind == ast.ND_FUNC:
                        s.check_func(m3)
                    mm3 = m3.next
            s.tbind = None
            s.inst_site = None
            k = k - 1

    # ★ vtable の長さを codegen に伝える
    ast.set_iface_slots(s.next_slot)

    # main は入口モジュールにだけ要る
    if entry is not None:
        s.enter_module(s.syms_by_name(entry.name))
        s.check_main(unwrap_node(entry.ast))

    check_export_names(mods)


# 外へ出す名前が重ならないか（E-EXPORT-5）。対になる定義: src/sema.c
def check_export_names(mods: rc[module.Module] | None) -> None:
    m: rc[module.Module] | None = mods
    while m is not None:
        mm: rc[module.Module] = m
        d: rc[ast.Node] | None = unwrap_node(mm.ast).body
        while d is not None:
            dn: rc[ast.Node] = d
            if dn.kind == ast.ND_FUNC and dn.is_export:
                check_export_one(mods, mm, dn)
            d = dn.next
        m = mm.next

# dn を、それより前に出てくる外へ出す関数と比べる
def check_export_one(mods: rc[module.Module] | None, dm: rc[module.Module],
                     dn: rc[ast.Node]) -> None:
    sym: str = ast.export_symbol(dm.name, dn.name)
    m2: rc[module.Module] | None = mods
    while m2 is not None:
        mm2: rc[module.Module] = m2
        e: rc[ast.Node] | None = unwrap_node(mm2.ast).body
        while e is not None:
            en: rc[ast.Node] = e
            if en.kind == ast.ND_FUNC and same_node_tok(en, dn):
                return      # 自分より前だけ比べる（1 回だけ報告する）
            if en.kind == ast.ND_FUNC and en.is_export:
                same_sym: bool = sym == ast.export_symbol(mm2.name, en.name)
                if same_sym or dn.name == en.name:
                    msg: str = diag.msg("sema.352", "外へ出す関数 '{0}' が 2 つあります", [copy(dn.name)])
                    if same_sym:
                        msg = diag.msg("sema.351", "外へ出す名前 '{0}' が重なっています", [copy(sym)])
                    diag.error_code_full(unwrap_tok(dn.tok), "E-EXPORT-5", msg,
                                         diag.msg0("sema.604", "こちらと"), en.tok,
                                         diag.msg0("sema.605", "こちらが同じ名前になります"),
                                         diag.msg0("sema.606", "どちらかの名前を変えてください（Python からは関数名で、C からは「モジュール名_関数名」で呼びます）"))
            e = en.next
        m2 = mm2.next

# 同じ宣言か（位置で見る。C 版はポインタ比較）
def same_node_tok(a: rc[ast.Node], b: rc[ast.Node]) -> bool:
    at: rc[token.Token] = unwrap_tok(a.tok)
    bt: rc[token.Token] = unwrap_tok(b.tok)
    return at.line == bt.line and at.col == bt.col and at.src.file == bt.src.file


# ── 小道具 ─────────────────────────────────────────────────
#
# ★ 「型の上では None かもしれないが、実際には必ずある」ものを 1 か所で開きます。
#   C 版の UNREACHABLE() と同じ役目です。

# ★ 折り返す算術の名前か（wrap_add / wrap_sub / wrap_mul）
def is_wrap_name(name: str) -> bool:
    return name == "wrap_add" or name == "wrap_sub" or name == "wrap_mul"

def count_siblings(first: rc[ast.Node] | None) -> int:
    n: int = 0
    cur: rc[ast.Node] | None = first
    while cur is not None:
        c: rc[ast.Node] = cur
        n = n + 1
        cur = c.next
    return n

def align_up(offset: int, align: int) -> int:
    return (offset + align - 1) // align * align

def mod_name_of(ms: rc[types.ModuleSyms]) -> str:
    m: rc[module.Module] | None = ms.mod
    if m is None:
        panic(diag.msg0("ssema.005", "sema: モジュールがありません"))
        return ""
    else:
        return copy(m.name)

def mod_ast(ms: rc[types.ModuleSyms]) -> rc[ast.Node] | None:
    m: rc[module.Module] | None = ms.mod
    if m is None:
        return None
    else:
        return m.ast

# try のスタックから最後の 1 つを外す。
#
# 注意: list には pop がまだ無いので、module と同じ手（作り直す）を使います。
def try_pop(xs: list[rc[ast.Node]]) -> list[rc[ast.Node]]:
    out: list[rc[ast.Node]] = []
    i: int = 0
    while i < len(xs) - 1:
        out.append(xs[i])
        i = i + 1
    return out

# rc[T] は「中身のように」使える（Rust の Deref と同じ考え）
def auto_deref(t: rc[ast.Type]) -> rc[ast.Type]:
    if t.kind == ast.TY_RC:
        return ast.elem_of(t)
    return t

def unwrap_node(n: rc[ast.Node] | None) -> rc[ast.Node]:
    if n is None:
        panic(diag.msg0("ssema.020", "sema: ノードがありません"))
        return ast.new_node(ast.ND_PASS, None)
    else:
        return n

def unwrap_type(t: rc[ast.Type] | None) -> rc[ast.Type]:
    if t is None:
        panic(diag.msg0("ssema.021", "sema: 型がありません"))
        return rc(ast.Type(ast.TY_INT))
    else:
        return t

def unwrap_ms(m: rc[types.ModuleSyms] | None) -> rc[types.ModuleSyms]:
    if m is None:
        panic(diag.msg0("ssema.022", "sema: モジュールの表がありません"))
        return rc(types.ModuleSyms(None))
    else:
        return m

def unwrap_enumdef(e: rc[ast.EnumDef] | None) -> rc[ast.EnumDef]:
    if e is None:
        panic(diag.msg0("ssema.023", "sema: 列挙の定義がありません"))
        return rc(ast.EnumDef("", None))
    else:
        return e

def unwrap_field(f: rc[ast.Field] | None) -> rc[ast.Field]:
    if f is None:
        panic(diag.msg0("ssema.024", "sema: フィールドがありません"))
        return rc(ast.Field("", None))
    else:
        return f


def unwrap_enumval(v: rc[ast.EnumVal] | None) -> rc[ast.EnumVal]:
    if v is None:
        panic(diag.msg0("ssema.025", "sema: 列挙の枝がありません"))
        return rc(ast.EnumVal("", 0, None))
    else:
        return v

def unwrap_class(c: rc[ast.Class] | None) -> rc[ast.Class]:
    if c is None:
        panic(diag.msg0("ssema.019", "sema: クラスがありません"))
        return rc(ast.Class("", None))
    else:
        return c

def unwrap_sig(f: rc[types.FuncSig] | None) -> rc[types.FuncSig]:
    if f is None:
        panic(diag.msg0("ssema.026", "sema: 関数のシグネチャがありません"))
        return rc(types.FuncSig("", None))
    else:
        return f

def unwrap_scope(sc: rc[types.Scope] | None) -> rc[types.Scope]:
    if sc is None:
        panic(diag.msg0("ssema.006", "sema: スコープがありません"))
        return rc(types.Scope(None))
    else:
        return sc

def unwrap_tok(t: rc[token.Token] | None) -> rc[token.Token]:
    if t is None:
        panic(diag.msg0("ssema.027", "sema: トークンがありません"))
        return rc(token.Token(0, rc(token.SrcText("", "")), 0, 0, 0, 0))
    else:
        return t
