# types — シンボル表
#
# ★ C 版の src/sema.c 前半（rc[FuncSig] / rc[VarEntry] / rc[Scope] / rc[ModuleSyms]）にあたります。
#
# 注意: Type / Class / Field は **ast** に置きました。C 版では types.h と ast.h に
#   分かれていますが、本言語は**循環 import を禁止している**ため
#   （判断 150）、Node ↔ Type ↔ Class を相互に参照させるには
#   同じモジュールに置くしかありません。
#
#   さらに Class は「定義されたモジュール」を指す必要がありますが、
#   rc[ModuleSyms] はこちら側にあるので、**モジュール名（str）で持ちます**。
#   ポインタの代わりに名前で引く——これも循環を切るための形です。
#
#   ★ 「言語の制限が設計を決めた」例です。
import strings
import ast
import module
import token

# 関数のシグネチャ表
class FuncSig:
    name: str        # 表を引く鍵（"add" / "Token.show"）
    ir_name: str     # IR 上の名前（"lexer.add" / "lexer.Token.show"）
    ret: rc[ast.Type] | None
    params: list[rc[ast.Type]]
    pnames: list[str]
    # ★ 引数の受け取り方（own か、借用か）。
    #   codegen が「実引数の一時値を呼び出し後に解放してよいか」を
    #   判断するのに使います（A-21e）。対になる定義: src/sema.c の pmodes
    pmodes: list[int]
    # ★ 既定値（A-38）。書かれていない引数は None。
    #   注意: **リテラルの木そのもの**を持ちます。sema が呼び出し側へ
    #     複製して入れるので、呼び出しごとに 1 つずつ作られます
    #     （Python のように「定義時に 1 つ作って共有」しません）。
    #   対になる定義: src/sema.c の defaults
    defaults: list[rc[ast.Node] | None]
    # ★ lambda から作った実体か（A-42）。エラーの言葉を変えるために持ちます。
    #   対になる定義: src/sema.c の is_lambda
    is_lambda: bool
    nparams: int
    tok: rc[token.Token] | None
    owner: rc[ModuleSyms] | None
    next: rc[FuncSig] | None

    # ★ ジェネリック関数のテンプレート（実体なら None）
    tmpl: rc[ast.Node] | None
    # ★ 定義の木（A-43）。捕獲した lambda を渡してよいか——つまり
    #   「この関数は受け取った関数の値をしまうか」——を見るのに使います。
    #   対になる定義: src/sema.c の node
    node: rc[ast.Node] | None

    # ── raises 節（宣言されたエラーのクラス）──
    raises_cls: list[rc[ast.Class]]

    def init(self, name: str, tok: rc[token.Token] | None) -> None:
        self.pmodes = []
        self.name = copy(name)
        self.ir_name = ""
        self.nparams = 0
        self.params = []
        self.pnames = []
        self.defaults = []
        self.is_lambda = False
        self.tok = tok
        self.raises_cls = []


class VarEntry:
    name: str
    ir_name: str     # LLVM 上の名前（記号 % / @ まで含む）
    is_global: bool

    # ★ 型が 2 つ（宣言された型と、絞り込まれた今の型）
    declared: rc[ast.Type] | None
    type: rc[ast.Type] | None

    decl_tok: rc[token.Token] | None
    next: rc[VarEntry] | None

    def init(self, name: str, tok: rc[token.Token] | None) -> None:
        self.name = copy(name)
        self.ir_name = ""
        self.is_global = False
        self.decl_tok = tok


class Scope:
    parent: rc[Scope] | None
    vars: rc[VarEntry] | None

    def init(self, parent: rc[Scope] | None) -> None:
        self.parent = parent


# モジュールごとのシンボル表
# 範囲型（部分型。A-28）の表。
#
# ★ クラスと同じ「モジュールごとの名前の表」。型そのものは名前つきの int
#   （ast.type_range）なので、ここでは名前と型の対応だけを持つ。
#   対になる定義: src/sema.c の struct RangeTy
class RangeTy:
    name: str
    type: rc[ast.Type] | None
    tok: rc[token.Token] | None     # 定義位置（「ここで定義されています」用）
    next: rc[RangeTy] | None

    def init(self, name: str, ty: rc[ast.Type], tok: rc[token.Token] | None) -> None:
        self.name = copy(name)
        self.type = ty
        self.tok = tok


class ModuleSyms:
    mod: rc[module.Module] | None
    funcs: rc[FuncSig] | None
    classes: rc[ast.Class] | None
    ifaces: rc[ast.Iface] | None
    ranges: rc[RangeTy] | None      # 範囲型（A-28）
    enums: rc[ast.EnumDef] | None   # 列挙（A-37）
    globals: rc[Scope] | None
    next: rc[ModuleSyms] | None

    def init(self, mod: rc[module.Module] | None) -> None:
        self.mod = mod
        self.globals = rc(Scope(None))


