# STAGE0-ONLY: 借用検査は C 版だけ
# ERROR: error[E-BORROW-10]: 'q' が借りている 'a.p' は、解放されているかもしれません
# ERROR: この 'poke(…)' の中で、同じ物体を指しうる rc 越しに書き換えられます
# mut で受けていない関数でも、中で rc を写せば書き換えられる。
#         ★ だから「mut で渡したか」ではなく「呼び先が何を書くか」で見ます
class P:
    v: int

    def init(self, v: int) -> None:
        self.v = v

class Box:
    p: P

    def init(self, p: own P) -> None:
        self.p = p

def poke(b: rc[Box]) -> None:
    c: rc[Box] = b
    c.p = P(9)

def main() -> int:
    a: rc[Box] = rc(Box(P(1)))
    q: P = a.p
    poke(a)
    x: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]
    return q.v
