# STAGE0-ONLY: 借用検査は C 版だけ
# ERROR: error[E-BORROW-10]: 'q' が借りている 'a.p' は、解放されているかもしれません
# ERROR: この 'poke(…)' の中で、同じ物体を指しうる rc 越しに書き換えられます
# インタフェース越しの呼び出しは呼び先が決まらないので、
#         引数から届く物体はどのフィールドでも書かれうるとして扱う
class P:
    v: int

    def init(self, v: int) -> None:
        self.v = v

class Box:
    p: P

    def init(self, p: own P) -> None:
        self.p = p

interface Poker:
    def poke(self, b: rc[Box]) -> None

class Hard(Poker):
    def init(self) -> None:
        pass

    def poke(self, b: rc[Box]) -> None:
        c: rc[Box] = b
        c.p = P(9)

def main() -> int:
    a: rc[Box] = rc(Box(P(1)))
    k: Poker = Hard()
    q: P = a.p
    k.poke(a)
    x: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]
    return q.v
