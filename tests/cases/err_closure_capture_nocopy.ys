# ERROR: クラス 'P' は copy できません
class P:
    v: int
    def init(self, v: int) -> None:
        self.v = v

def mk(k: int) -> closure(int) -> int:
    return lambda x: x + k

class Keep:
    f: fn(int) -> int
    def init(self, f: fn(int) -> int) -> None:
        self.f = f

def main() -> int:
    p: P = P(1)
    c: closure(int) -> int = lambda x: x + p.v
    return 0
