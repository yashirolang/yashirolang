# ERROR: closure を 'Keep' の fn の引数に渡せません
class P:
    v: int
    def init(self, v: int) -> None:
        self.v = v

def mk(k: int) -> closure(int) -> int:
    return lambda x: x + k

class Keep:
    f: fn(int) -> int
    def init(self, f: fn(int) -> int) -> None:
        self.f = f

def main() -> int:
    c: closure(int) -> int = mk(1)
    k: Keep = Keep(c)
    return 0
