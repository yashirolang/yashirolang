# ERROR: 'float' は match で調べられません
# 中身の位置に値を書くと、入れ子のパターンとして読みます（A-48）。
#   float は match で調べられないので断ります（値で絞りたいときはガード：
#   case Shape.Circle(r) if r == 1.0:）。
enum Shape:
    Circle(r: float)
    Empty

def f(s: Shape) -> float:
    match s:
        case Shape.Circle(1.0):
            return 1.0
        case Shape.Empty:
            return 0.0
    return -1.0

def main() -> int:
    return 0
