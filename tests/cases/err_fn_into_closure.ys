# ERROR: fn の値は closure にできません
class P:
    v: int
    def init(self, v: int) -> None:
        self.v = v

def mk(k: int) -> closure(int) -> int:
    return lambda x: x + k

class Keep:
    f: fn(int) -> int
    def init(self, f: fn(int) -> int) -> None:
        self.f = f

def main() -> int:
    g: fn(int) -> int = lambda x: x
    c: closure(int) -> int = g
    return 0
