# ERROR: 'int' 型は for で回せません
# ERROR: 回せるのは list / str / range(...) と、__first__ / __next__ / __get__ を持つクラスです
# 数値は回せない
#
# ★ 0.31.0 までは「len は 'int' 型を受け取れません」と言っていました。
#   脱糖がパーサにあったので、**書いていない len** の名前が漏れていたためです。
#   脱糖を sema に移したので（A-39）、for の言葉で断れます。
def main() -> int:
    for x in 42:
        print(x)
    return 0
