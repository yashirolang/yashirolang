# ERROR: インタフェース 'Show' に 'extra' はありません
# インタフェース越しに呼べるのは、そこに宣言したものだけ
interface Show:
    def show(self) -> str

class P(Show):
    x: int
    def show(self) -> str:
        return "p"
    def extra(self) -> int:
        return 1

def main() -> int:
    s: Show = P()
    print(s.extra())
    return 0
