# ERROR: lambda の中から外の変数 'n' は使えません
# ERROR: 捕獲（クロージャ）はまだありません
# lambda は外の変数を捕獲できない（A-42）
#
# ★ lambda は**トップレベルの関数に持ち上げます**。外の名前はそこから
#   見えません。捕獲を入れるには「借りたものを持ち回る入れ物」が要り、
#   この言語は借用を構造体に保存できないので、表現から決め直しになります。
def main() -> int:
    n: int = 5
    p: fn(int) -> bool = lambda x: x > n
    return 0
