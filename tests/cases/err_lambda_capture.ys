# ERROR: 'g' は捕まえられません（'fn(int) -> int' 型）
# ERROR: 関数の値・Thread・mutex・ptr は捕まえられません
# A-51 から str / list / クラスも借りて捕まえられますが、関数の値は捕まえません。
#   その値がさらに借りているものを、所有権検査が追えなくなるためです。
def apply(f: fn(int) -> int, x: int) -> int:
    return f(x)

def main() -> int:
    g: fn(int) -> int = lambda x: x + 1
    p: fn(int) -> bool = lambda x: apply(g, x) > 0
    return 0
