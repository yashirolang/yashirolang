# STAGE0-ONLY: 可変性の検査は C 版だけ
# FLAGS: --deny-mut
# ERROR: error[E-MUT-1]: 読み取り専用の借用 'xs' を書き換えています
# ERROR: append はリストを書き換えます
# ERROR: 引数を 'xs: mut list[int]' にしてください
# append は書き換え（仕様 v2 §5.2 の例そのもの）
def show(xs: list[int]) -> None:
    xs.append(1)

def main() -> int:
    a: list[int] = [1]
    show(a)
    return len(a)
