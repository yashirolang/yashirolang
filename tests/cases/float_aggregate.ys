# OUTPUT: 7.5
# OUTPUT: 3
# OUTPUT: 10.0
# OUTPUT: 3.5
# EXIT: 0
# list の要素・クラスのフィールド・グローバルとしての float
G: float = 3.5

class Vec:
    x: float
    y: float

    def init(self, x: float, y: float) -> None:
        self.x = x
        self.y = y

    def dot(self, o: Vec) -> float:
        return self.x * o.x + self.y * o.y

def scale(v: Vec, k: float) -> Vec:
    return Vec(v.x * k, v.y * k)

def main() -> int:
    xs: list[float] = [1.5, 2.5]
    xs.append(3.5)
    s: float = 0.0
    for x in xs:
        s = s + x
    print(s)
    print(len(xs))
    a: Vec = Vec(1.0, 2.0)
    print(a.dot(scale(a, 2.0)))
    print(G)
    return 0
