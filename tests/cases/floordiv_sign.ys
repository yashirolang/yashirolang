# OUTPUT: ok
# EXIT: 0
# '//' と '%' の符号を Python に合わせた
#
#   '//' は 0 ではなく **負の無限大** の方向へ丸める（切り下げ）
#   '%'  の符号は **除数と同じ**になる
#
# ⚠️ この 2 つは一組です。片方だけ直すと下の恒等式が崩れます。

def check(a: int, b: int, q: int, r: int) -> bool:
    if a // b != q:
        print("// が違う: " + str(a) + " // " + str(b) + " = " + str(a // b))
        return False
    if a % b != r:
        print("% が違う: " + str(a) + " % " + str(b) + " = " + str(a % b))
        return False
    # ★ 恒等式 a == (a // b) * b + (a % b) がどの符号でも成り立つこと
    if (a // b) * b + (a % b) != a:
        print("恒等式が崩れた: " + str(a) + " / " + str(b))
        return False
    return True

def main() -> int:
    ok: bool = True

    # 符号の 4 通り（割り切れない場合）
    if not check(7, 2, 3, 1):
        ok = False
    if not check(-7, 2, -4, 1):
        ok = False
    if not check(7, -2, -4, -1):
        ok = False
    if not check(-7, -2, 3, -1):
        ok = False

    # 割り切れる場合は切り下げも切り捨ても同じ。余りは 0
    if not check(6, 2, 3, 0):
        ok = False
    if not check(-6, 2, -3, 0):
        ok = False
    if not check(6, -2, -3, 0):
        ok = False
    if not check(-6, -2, 3, 0):
        ok = False

    # 絶対値が除数より小さいとき（商が 0 か -1 になるところ）
    if not check(1, 3, 0, 1):
        ok = False
    if not check(-1, 3, -1, 2):
        ok = False
    if not check(1, -3, -1, -2):
        ok = False
    if not check(-1, -3, 0, -1):
        ok = False

    # ★ 変数どうしでも同じこと（定数畳み込みに逃げていないことの確認）
    a: int = -17
    b: int = 5
    if a // b != -4:
        ok = False
    if a % b != 3:
        ok = False

    # 累算代入（'//=' と '%=' も同じ経路を通る）
    c: int = -7
    c //= 2
    if c != -4:
        ok = False
    d: int = -7
    d %= 2
    if d != 1:
        ok = False

    if ok:
        print("ok")
        return 0
    return 1
