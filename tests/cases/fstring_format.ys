# OUTPUT: [      42]
# OUTPUT: [42      ]
# OUTPUT: [   42   ]
# OUTPUT: [  名前]
# OUTPUT: [3.14]
# OUTPUT: [     3.142]
# OUTPUT: [****42]
# OUTPUT: 42 と 3.1
# OUTPUT: [-0.50]
# OUTPUT: [12345]
# EXIT: 0
# f-string の書式指定（A-45）
#
#   ★ 形は [埋め文字][< > ^][幅][.桁数][f] です。
#
#       {x:>8}    右寄せで 8 桁
#       {x:<8}    左寄せ
#       {x:^8}    中央
#       {s:*>6}   埋め文字を指定
#       {v:.2f}   小数点以下 2 桁
#
#   ★ 桁は**表示幅**で数えます（全角は 2 桁）。バイト数で数えると日本語の表が
#     崩れます（lib/strings の width と同じ判定です）。
#
#   ★ **脱糖はパーサでします。** 出来上がるのはふつうの呼び出しなので、
#     意味解析もコード生成も書式を知りません。
#
#   注意: 既に幅を超えていたら、そのまま出します（切りません）。切ると桁は
#     揃っても中身が読めなくなります。
def main() -> int:
    x: int = 42
    v: float = 3.14159
    s: str = "名前"

    print(f"[{x:>8}]")
    print(f"[{x:<8}]")
    print(f"[{x:^8}]")
    print(f"[{s:>6}]")
    print(f"[{v:.2f}]")
    print(f"[{v:>10.3f}]")
    print(f"[{x:*>6}]")
    print(f"{x} と {v:.1f}")

    # 負の数と、幅を超える場合
    neg: float = -0.5
    print(f"[{neg:.2f}]")
    big: int = 12345
    print(f"[{big:>3}]")
    return 0
