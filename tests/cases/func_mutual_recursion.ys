# OUTPUT: 1
# OUTPUT: 0
# 相互再帰。どちらも相手より前に書かれていない状態がある
def is_even(n: int) -> bool:
    if n == 0:
        return True
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return False
    return is_even(n - 1)

def main() -> int:
    if is_even(10):
        print(1)
    if is_odd(10):
        print(2)
    print(0)
    return 0
