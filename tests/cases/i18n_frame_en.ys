# ERROR: = help: declare the parameter as 'xs: mut list[int]'
# 診断の言語の切り替え（docs/design/i18n-diagnostics.md）。
#   ★ --lang=en で、枠の言葉（ヒント → help）も文面も英語になります（段階 1〜3）。
#   注意: error[E-MUT-1]: の形は言語によらず同じです（エディタ拡張がこの形で拾うため）。
def add_item(xs: list[int], n: int) -> None:
    xs.append(n)

def main() -> int:
    xs: list[int] = [1, 2, 3]
    add_item(xs, 4)
    return 0
