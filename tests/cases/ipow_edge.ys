# OUTPUT: ok
# EXIT: 0
# '**' の桁あふれ検査が **誤検出しない**こと
#
#   注意: 繰り返し二乗法は「最後の周でも二乗する」形だと、答えは収まるのに
#     途中の二乗だけがあふれます。2 ** 62 がその例です。
#     次の周があるときだけ二乗するように直してあります。
def main() -> int:
    ok: bool = True
    if 2 ** 62 != 4611686018427387904:
        ok = False
    # ★ 答えがちょうど int の最小値になる場合（Python と同じ値）
    if (0 - 2) ** 63 != -9223372036854775807 - 1:
        ok = False
    if 2 ** 0 != 1:
        ok = False
    if 0 ** 0 != 1:
        ok = False
    if 3 ** 5 != 243:
        ok = False
    if (0 - 1) ** 63 != -1:
        ok = False
    if ok:
        print("ok")
        return 0
    return 1
