# OUTPUT: h
# OUTPUT: g
# OUTPUT: 3
# EXIT: 0
# キーワード引数の評価順（A-38）
#
# ★ 並べ替えは**意味解析でします**。そのため評価順は「書いた順」ではなく
#   **定義の順**です。ここを固定しておかないと、あとで「呼び出し側の順に
#   評価する」作りに変えたときに、誰も気づきません。
#
# 注意: 実引数に副作用のある呼び出しを書き、かつ定義と違う順に並べたときだけ
#   見える差です（既定値はリテラルしか書けないので、既定値では出ません）。
def g() -> int:
    print("g")
    return 1


def h() -> int:
    print("h")
    return 2


def f(a: int, b: int) -> int:
    return a + b


def main() -> int:
    # 書いた順は b, a。評価は定義の順（a = h() → b = g()）
    print(str(f(b = g(), a = h())))
    return 0
