# OUTPUT: True False
# OUTPUT: 2
# OUTPUT: 42 -1
# OUTPUT: 42
# OUTPUT: 15
# OUTPUT: 84
# OUTPUT: 11 9
# EXIT: 0
# lambda（A-42）
#
#   ★ **型を書きません。** どんな関数になるかは「置かれた場所」で決まります。
#
#       p: fn(int) -> bool = lambda x: x > 0
#          ^^^^^^^^^^^^^^^ これが答え
#
#     ジェネリック関数の単相化と同じ道を通しています——パーサが型引数を
#     作っておき、sema が使う側の型を束ねます（新しい仕組みはありません）。
#
#   ★ **捕獲はまだありません**（err_lambda_capture）。持ち上げた先は
#     トップレベルなので、外の変数はそこから見えません。グローバルは使えます。
#
#   注意: 本体は**式 1 つ**だけです（Python と同じ）。文が要るなら def です。
BASE: int = 10


def count_if(xs: list[int], pred: fn(int) -> bool) -> int:
    n: int = 0
    for x in xs:
        if pred(x):
            n = n + 1
    return n


def apply2(f: fn(int, int) -> int, a: int, b: int) -> int:
    return f(a, b)


class Button:
    on_click: fn(int) -> int

    def init(self, on_click: fn(int) -> int) -> None:
        self.on_click = on_click

    def click(self, v: int) -> int:
        f: fn(int) -> int = self.on_click
        return f(v)


# ★ 戻り値としても返せます（戻り型が「置かれた場所」になります）
def pick(flag: bool) -> fn(int) -> int:
    if flag:
        return lambda x: x + 1
    return lambda x: x - 1


def main() -> int:
    p: fn(int) -> bool = lambda x: x > 0
    print(str(p(3)) + " " + str(p(-1)))
    print(str(count_if([1, -2, 3, -4], lambda x: x > 0)))

    # 引数に直接渡す（引数の型から決まります）
    print(str(apply2(lambda a, b: a * b, 6, 7)) + " " +
          str(apply2(lambda a, b: a - b, 6, 7)))

    # 引数なしの lambda
    z: fn() -> int = lambda: 42
    print(str(z()))

    # グローバルは使えます（外の「変数」ではないため）
    g: fn(int) -> int = lambda x: x + BASE
    print(str(g(5)))

    b: Button = Button(lambda x: x * 2)
    print(str(b.click(42)))

    up: fn(int) -> int = pick(True)
    down: fn(int) -> int = pick(False)
    print(str(up(10)) + " " + str(down(10)))
    return 0
