# OUTPUT: 13.44
# OUTPUT: 7.46
# OUTPUT: 31.2455
# OUTPUT: 3.4950
# OUTPUT: -0.070
# OUTPUT: 1.0
# OUTPUT: True
# EXIT: 0
# A-31: 十進の固定小数点（金額のための型）。
#   ★ float では金額を扱えません（0.1 を 10 回足すと 0.9999999999999999）。
#     ここでは「整数の単位数＋小数点以下の桁数」で持つので、**正確**です。
#   ⚠️ 割り算だけは桁と丸め方を書かせます（1 / 3 に正しい答えは無いため）。
import decimal

def main() -> int:
    a: decimal.Decimal = decimal.Decimal(1045, 2)      # 10.45
    b: decimal.Decimal = decimal.Decimal(299, 2)       # 2.99
    print((a + b).to_str())
    print((a - b).to_str())
    print((a * b).to_str())
    print(a.div_to(b, 4, decimal.HALF_EVEN).to_str())

    p: decimal.Decimal | None = decimal.parse("-0.070")
    if p is not None:
        q: decimal.Decimal = p
        print(q.to_str())

    # ★ 0.1 を 10 回足すと、きっかり 1.0
    s: decimal.Decimal = decimal.zero(1)
    one_tenth: decimal.Decimal = decimal.Decimal(1, 1)
    i: int = 0
    while i < 10:
        s = s + one_tenth
        i = i + 1
    print(s.to_str())
    print(str(s == decimal.from_int(1, 1)))
    return 0
