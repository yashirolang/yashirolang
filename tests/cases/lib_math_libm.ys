# OUTPUT: done
# EXIT: 0
# math が libm と一致するか（基準値は clang の libm から生成）
#   ★ 相対誤差 1e-13 以内。sin/cos は |x|<=50、exp は ±200、log は 1e-9〜1e9 まで
#   注意: libm は呼びません。lib/math はすべて本言語で書かれています
import math

def check(name: str, got: float, want: float) -> None:
    d: float = math.fabs(got - want)
    if math.fabs(want) < 1.0e-10:
        if d > 1.0e-15:
            print("NG " + name + " abs=" + str(d * 1.0e18) + "e-18")
        return
    rel: float = d / math.fabs(want)
    if rel > 1.0e-13:
        print("NG " + name + " rel=" + str(rel * 1.0e16) + "e-16")

