# OUTPUT: port>0: True
# OUTPUT: echo:hello
# OUTPUT: 閉じた接続: ふつうに失敗する
# OUTPUT: 誰もいないポート: ふつうに失敗する
# OUTPUT: 待ち時間切れ: True / 接続は生きている: あとから
# OUTPUT: 住所が複数あるとき順に試す: True
# OUTPUT: IPv6: True
# EXIT: 0
# net — TCP ソケット（A-22 / A-23）
#
#   ★ **ポートは 0 を渡して OS に選ばせます。** 決め打ちにすると、同じ
#     機械で CI を 2 本走らせたときに衝突します。選ばれた番号は l.port です。
#
#   ★ 待ち受け口を main で作ってから、fd をスレッドへ渡します。
#     「スレッドの中で listen して、main が connect する」形にすると、
#     listen が済む前に connect してしまう競走になります。
#
#   ★ **失敗が panic ではなく raises で返ることも確かめます。**
#     サーバーは「つながらなかった」で落ちては困るからです。
import net

def server(fd: int) -> int:
    try:
        l: net.Listener = net.Listener(fd, 0)
        c: net.Conn = l.accept()
        msg: str = c.recv(1024)
        c.send("echo:" + msg)
        c.close()
    except net.NetError as e:
        print("server NG: " + e.message)
    return 0

def main() -> int:
    # ★ 誰も待っていないポート番号を先に押さえ、すぐ手放します。
    #   あとでここへ繋ぐと必ず断られます（外の通信はしません）。
    dead: int = 0
    try:
        d: net.Listener = net.listen("127.0.0.1", 0)
        dead = d.port
        d.close()
    except net.NetError as e0:
        print("NG: " + e0.message)
        return 1

    try:
        l: net.Listener = net.listen("127.0.0.1", 0)
        print("port>0: " + str(l.port > 0))

        t: Thread[int] = spawn(server, l.fd)

        c: net.Conn = net.connect("127.0.0.1", l.port)
        c.send("hello")
        # ★ 相手が閉じるまで読む（1 回の recv で全部来るとは限らない）
        print(c.recv_all())
        c.close()
        t.join()
        l.close()
    except net.NetError as e1:
        print("NG: " + e1.message)
        return 1

    # 閉じた接続から読む
    closed: net.Conn = net.Conn(-1)
    try:
        print("読めた: " + closed.recv(1))
    except net.NetError as e2:
        print("閉じた接続: ふつうに失敗する")

    # 誰も待っていないポートへ繋ぐ
    try:
        c2: net.Conn = net.connect("127.0.0.1", dead)
        c2.close()
        print("誰もいないポート: つながってしまった")
    except net.NetError as e3:
        print("誰もいないポート: ふつうに失敗する")

    # ── 待ち時間（A-23）──
    #
    # ★ **待ち時間切れは失敗と分けます。** 「まだ来ていない」だけで
    #   接続は生きているので、そのあとも読み書きできます。
    #   区別できないと、もう一度待つのか閉じるのかを呼び出し側が選べません。
    try:
        lt: net.Listener = net.listen("127.0.0.1", 0)
        ct: net.Conn = net.connect("127.0.0.1", lt.port)
        st: net.Conn = lt.accept()
        st.set_timeout(200)

        timed: bool = False
        try:
            got: str = st.recv(16)      # 相手はまだ何も送っていない
            print("読めてしまった: " + str(len(got)))
        except net.NetError as et:
            timed = et.timed_out

        ct.send("あとから")
        print("待ち時間切れ: " + str(timed) + " / 接続は生きている: " + st.recv(64))
        st.close()
        ct.close()
        lt.close()
    except net.NetError as e4:
        print("NG: " + e4.message)
        return 1

    # ── 住所が複数あるとき（A-23）──
    #
    # ★ `localhost` はふつう `::1` と `127.0.0.1` の両方を持ちます。
    #   待ち受けているのは v4 の口だけなので、**1 つめで断られたら
    #   次を試す**ようになっていないと繋がりません。
    #   ⚠️ A-22 は AF_INET 決め打ちで、この形が書けませんでした。
    try:
        lh: net.Listener = net.listen("127.0.0.1", 0)
        ch: net.Conn = net.connect("localhost", lh.port)
        sh: net.Conn = lh.accept()
        ch.send("ok")
        print("住所が複数あるとき順に試す: " + str(sh.recv(16) == "ok"))
        sh.close()
        ch.close()
        lh.close()
    except net.NetError as e5:
        print("住所が複数あるとき順に試す: NG " + e5.message)

    print("IPv6: " + str(v6_ok()))
    return 0


# IPv6 で往復できるか。
#
# ⚠️ **IPv6 が無い機械もあります**（一部の CI の入れ物）。そこで
#   「待ち受けられたなら、往復もできること」を確かめます。使えない機械では
#   確かめることが無いので True です——**使えるのに壊れている**のが
#   見つけたいことで、それはこの形で捕まります。
def v6_ok() -> bool:
    l: net.Listener = net.Listener(-1, 0)
    try:
        l = net.listen("::1", 0)
    except net.NetError as e:
        return True                 # この機械に IPv6 が無い
    try:
        c: net.Conn = net.connect("::1", l.port)
        s: net.Conn = l.accept()
        c.send("v6")
        ok: bool = s.recv(16) == "v6"
        s.close()
        c.close()
        l.close()
        return ok
    except net.NetError as e2:
        l.close()
        return False
