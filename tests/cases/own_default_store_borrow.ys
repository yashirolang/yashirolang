# ERROR: error[E-BORROW-7]: 借用した値 'a.name' をリストに保存しています
# A-24: E-BORROW-7（借りものを所有スロットへ入れる）も既定でエラーです。
#   注意: 0.15.1 で入れたときは selfhost/ に 40 件残っていたので警告どまりでした。
#     0.16.0 でぜんぶ直ったので、ここで昇格しました。
class Item:
    name: str

    def init(self, name: own str) -> None:
        self.name = name

def main() -> int:
    a: Item = Item("pen")
    names: list[str] = []
    names.append(a.name)
    print(names[0])
    return 0
