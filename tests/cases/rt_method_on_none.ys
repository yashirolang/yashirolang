# EXIT: 1
# NULL のフィールドを介したメソッド呼び出し。self の検査（メソッド側）で捕まる
class N:
    v: int
    next: N

    def init(self, ok: bool) -> None:
        self.v = 1
        if ok:
            self.next = self

    def show(self) -> None:
        print(self.v)

def main() -> int:
    a: N = N(False)
    a.next.show()
    return 0
