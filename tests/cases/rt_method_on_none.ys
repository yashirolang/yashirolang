# EXIT: 1
# NULL のフィールドを介したメソッド呼び出し。self の検査（メソッド側）で捕まる。
#   ⚠️ A-27 のあとも残る形です（代入はしますが、その前に呼んでいます）。
class Inner:
    v: int

    def init(self, v: int) -> None:
        self.v = v

    def show(self) -> None:
        print(self.v)

class Outer:
    inner: Inner

    def init(self) -> None:
        self.inner.show()        # ★ 代入する前に呼ぶ
        self.inner = Inner(1)

def main() -> int:
    o: Outer = Outer()
    o.inner.show()
    return 0
