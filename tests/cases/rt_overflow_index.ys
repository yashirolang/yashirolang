# EXIT: 1
# 添字の計算があふれたら panic
#
#   注意: **ここが健全性の要です。** 4611686018427387904 * 2 は 2^63 で、
#     折り返すと **0**（＝範囲内！）になります。あふれの旗を範囲検査に
#     相乗りさせていないと、xs[0] を静かに読んで通ってしまいます。
#
#   ★ 検査そのものは gen_index_expr（分岐を出さず旗を貯める）と
#     gen_index_addr（範囲内 かつ あふれていない、で 1 回だけ分岐）です。
def main() -> int:
    xs: list[int] = [1, 2, 3, 4]
    big: int = 4611686018427387904
    i: int = 2
    return xs[big * i]
