# EXIT: 1
# float(str) は読めない文字列を黙って 0 にしません
#
#   ⚠️ **ここが要点です。** C の atof は "abc" を黙って 0.0 にします。
#     それをやると、CSV の 1 列がずれただけで「0 が並んだ正しそうな表」に
#     なってしまいます。int(str) と同じく panic にしています。
def main() -> int:
    print(str(float("12.5")))     # ここは通る
    print(str(float("12.5x")))    # 余りがあるので panic
    return 0
