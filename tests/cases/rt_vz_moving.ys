# EXIT: 1
# 添字の中の「誘導変数でない変数」がループ内で変わるとき
#
# 注意: **これは健全性の要です。** 版分けは「両端を見れば途中も範囲内」という
#   性質に乗っています。その前提は**添字が誘導変数についてアフィンで、
#   ほかの変数は不変**であること。k がループ内で変わるとその前提が崩れ、
#   両端で確かめた値と実際の値が違ってしまいます。
#   → 版分けしないので、今までどおり範囲外で止まります。

def moving(xs: list[int], n: int) -> int:
    s: int = 0
    k: int = 0
    j: int = 0
    while j < n:
        s = s + xs[k]
        k = k + 1
        j = j + 1
    return s

def main() -> int:
    xs: list[int] = [10, 20]
    print(moving(xs, 5))     # ← xs[2] で範囲外
    return 0
