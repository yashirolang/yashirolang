# OUTPUT: 2.0
# EXIT: 1
# 行の版分けをしても、内側の添字が範囲を出たら正しい位置で止まる
#   （入口の確かめに落ちて遅い側を回り、j == 2 で止まる。j == 0, 1 の結果は残る）
def main() -> int:
    m: list[list[float]] = [[0.0, 0.0], [0.0, 0.0]]
    for j in range(3):
        m[1][j] = 1.0
        if j == 1:
            print(str(m[1][0] + m[1][1]))
    return 0
