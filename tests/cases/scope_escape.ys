# ERROR: E-SCOPE-1
# ERROR: scope: の中から 'return' で抜けることはできません
# scope: の中から途中で抜けられません
#
# 注意: scope: の出口には「まだ待っていないスレッドを全部 join する」という
#   仕事があります。途中から抜ける道があるとそれが飛び、まだ走っている
#   スレッドが借りている値の寿命が切れます。

def work(n: int) -> int:
    return n

def bad(n: int) -> int:
    scope:
        t: Thread[int] = spawn(work, n)
        return t.join()
    return 0

def main() -> int:
    return bad(1)
