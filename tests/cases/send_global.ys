# ERROR: E-SEND-3
# ERROR: グローバル変数を書き換えるので
# STAGE0-ONLY: 所有権検査は C 版にしかありません
# STAGE1-SKIP: 所有権検査（E-SEND-*）は C 版にしかないので、IR を比べられません
# スレッドからグローバルを書き換えられません（A-18）
#
# ⚠️ 呼び先まで**たどって**探します。直下だけ見る検査だと
#   「1 枚かませば通る」ので、保証として意味を持ちません。

total: int = 0

def add_it(n: int) -> None:
    total = total + n

def work(n: int) -> int:
    add_it(n)
    return total

def main() -> int:
    t: Thread[int] = spawn(work, 5)
    return t.join()
