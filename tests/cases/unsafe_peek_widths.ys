# STAGE0-ONLY: unsafe / ptr[T] は C 版だけ
# STAGE1-SKIP: stage1 はまだ unsafe / ptr[T] を解析できない（のちに移植）
# OUTPUT: 4660
# OUTPUT: 305419896
# OUTPUT: 65535
# OUTPUT: 4294967295
# OUTPUT: 13330
# OUTPUT: 1573698474
# EXIT: 0
# 16 / 32 ビットの読み書き（0.38.0）
#
#   ★ 添字は「その幅の何個目か」です（peek32(p, 1) は 4 バイト目から）。
#   ★ 読むときは符号なしで広げ、書くときは下位のビットだけを書きます。
extern def pl_alloc(size: int) -> int

def main() -> int:
    unsafe:
        p: ptr[int] = ptr_at(pl_alloc(16))
        poke16(p, 0, 0x1234)
        poke32(p, 1, 0x12345678)
        print(peek16(p, 0))
        print(peek32(p, 1))
        poke16(p, 2, -1)                 # 下位 16 ビットだけ
        poke32(p, 3, 0x1FFFFFFFF)        # 下位 32 ビットだけ
        print(peek16(p, 2))
        print(peek32(p, 3))
        # リトルエンディアン: 64 ビットで書いた値を狭い幅で読む
        poke64(p, 0, 0x5DCCBBAA00003412)
        print(peek16(p, 0))
        print(peek32(p, 1))
    return 0
