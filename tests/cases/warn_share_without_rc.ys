# STAGE0-ONLY: 所有権検査は C 版だけ
# WARN: E-MOVE-1
# EXIT: 0
# rc[T] を使わずに「入れ物に入れて、なおかつ返す」と警告が出る
#   ⚠️ これは **誤検出ではありません**。--drop を付けると null を返して落ちます。
#     正しい書き方は own_share_needs_rc（rc[T] を使う）。
class Node:
    v: int
    def init(self, v: int) -> None:
        self.v = v

class Holder:
    n: Node | None
    def init(self) -> None:
        self.n = None

def store_and_return(h: mut Holder) -> Node:
    t: Node = Node(7)
    h.n = t
    return t

def main() -> int:
    h: Holder = Holder()
    r: Node = store_and_return(h)
    print(r.v)
    return 0
