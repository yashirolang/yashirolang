# STAGE0-ONLY: 所有権検査は C 版だけ
# WARN: E-MOVE-1
# EXIT: 0
# rc[T] を使わずに「入れ物に入れて、なおかつ返す」と警告が出る
#   注意: これは **誤検出ではありません**。--drop を付けると null を返して落ちます。
#     正しい書き方は own_share_needs_rc（rc[T] を使う）。
# FLAGS: --no-drop --warn-own
#   ★ A-24 で所有権の指摘は**既定でエラー**になりました。
#     この試験は「警告に落とす逃げ道（--warn-own）」のほうを見ています。
#   ★ 既定が --drop になっても、この試験は解放しません（--drop だと落ちるのが正しい）。
class Node:
    v: int
    def init(self, v: int) -> None:
        self.v = v

class Holder:
    n: Node | None
    def init(self) -> None:
        self.n = None

def store_and_return(h: mut Holder) -> Node:
    t: Node = Node(7)
    h.n = t
    return t

def main() -> int:
    h: Holder = Holder()
    r: Node = store_and_return(h)
    print(r.v)
    return 0
