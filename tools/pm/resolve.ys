# resolve — 依存の版を決める（MVS）
#
# ★ 採っているのは Go と同じ **MVS（Minimal Version Selection）** です。
#   「その名前に対して要求された下限のうち、いちばん大きいものを選ぶ」
#   だけで、探索も後戻りもありません。
#
#   なぜ cargo 式（互換範囲の中で最大の版）にしないのか:
#
#   ① この言語ではモジュール名が IR の名前修飾そのものなので、
#      **同じパッケージの 2 つの版を同居させられません**。解の自由度が
#      もともと無く、探索する意味がありません。
#   ② 誰かが版を上げない限り、選ばれる版が勝手に動きません。
#      ロックファイルが無くても結果が再現します。
#   ③ 実装が小さく、選ばれた理由を人が説明できます。
import io
import strings
import manifest
import semver
import vcs
import langinfo

class Sel:
    name: str
    url: str
    ver: str        # 選ばれた版 "1.2.0"
    rev: str        # その版のタグが指す commit の SHA
    tree: str
    src: str        # ソースが置いてあるディレクトリ
    why: str        # この下限を要求したのは誰か（診断用）

    def init(self, name: str, url: str, ver: str, why: str) -> None:
        self.name = copy(name)
        self.url = copy(url)
        self.ver = copy(ver)
        self.rev = ""
        self.tree = ""
        self.src = "."
        self.why = copy(why)

class Req:
    name: str
    url: str
    min_: str
    why: str

    def init(self, name: str, url: str, min_: str, why: str) -> None:
        self.name = copy(name)
        self.url = copy(url)
        self.min_ = copy(min_)
        self.why = copy(why)

def die(msg: str) -> None:
    io.eprint(langinfo.pm() + ": " + msg + "\n")
    exit(1)

def find(sels: list[Sel], name: str) -> int:
    i: int = 0
    while i < len(sels):
        if sels[i].name == name:
            return i
        i = i + 1
    return -1

# 選ばれた版のタグを commit に直し、そのパッケージの package.pkg を読む
def fetch_manifest(s: mut Sel) -> manifest.Manifest:
    vcs.ensure(s.url)
    tag: str = "v" + s.ver
    rev: str = vcs.rev_of(s.url, tag)
    if len(rev) == 0:
        avail: list[str] = vcs.tags(s.url)
        hint: str = "タグがありません"
        if len(avail) > 0:
            hint = "あるタグ: " + strings.join(avail, " ")
        die("'" + s.name + "' に " + tag + " というタグがありません（" +
            s.url + "）\n    " + hint)
    s.rev = copy(rev)
    s.tree = vcs.tree_of(s.url, rev)
    if len(s.tree) == 0:
        die("'" + s.name + "' の " + tag + " から tree を読めませんでした")

    blob: vcs.Blob = vcs.show(s.url, rev, manifest.FILENAME)
    if not blob.ok:
        die("'" + s.name + "' の " + tag + " に " + manifest.FILENAME +
            " がありません\n    本言語のパッケージには宣言ファイルが要ります")
    m: manifest.Manifest = manifest.parse(blob.text,
                                          s.name + "@" + s.ver + " の " + manifest.FILENAME)
    if m.name != s.name:
        die("'" + s.name + "' として取ってきたパッケージが自分を '" + m.name +
            "' と名乗っています\n    " + s.url +
            "\n    名前が食い違うパッケージは受け取りません")
    if semver.show(semver.parse(m.version)) != s.ver:
        die("'" + s.name + "' の " + tag + " が中で version " + m.version +
            " と書いています\n    タグと version は一致させてください")
    s.src = copy(m.src)
    return m

# 根の宣言から、必要なパッケージと版を全部決める
def resolve(root: manifest.Manifest) -> list[Sel]:
    sels: list[Sel] = []

    rounds: int = 0
    changed: bool = True
    while changed:
        changed = False
        rounds = rounds + 1
        if rounds > 64:
            die("依存の解決が終わりません（版の要求が循環している可能性があります）")

        # ① いま分かっている要求を全部集める
        reqs: list[Req] = []
        for d in root.deps:
            reqs.append(Req(d.name, d.url, d.min_, "このパッケージ"))
        for s in sels:
            if len(s.rev) == 0:
                continue
            for d in fetch_manifest(s).deps:
                reqs.append(Req(d.name, d.url, d.min_, s.name + "@" + s.ver))

        # ② 下限の最大を採る（＝ MVS）
        for r in reqs:
            i: int = find(sels, r.name)
            if i < 0:
                sels.append(Sel(r.name, r.url, r.min_, r.why))
                changed = True
                continue
            cur: Sel = sels[i]
            if cur.url != r.url:
                die("'" + r.name + "' の取得元が 2 つあります\n    " +
                    cur.url + "（" + cur.why + "）\n    " +
                    r.url + "（" + r.why + "）\n" +
                    "    同じ名前は同じリポジトリからしか取れません")
            want: semver.Ver = semver.parse(r.min_)
            have: semver.Ver = semver.parse(cur.ver)
            if semver.lt(have, want):
                if not semver.compatible(have, want):
                    io.eprint(langinfo.pm() + ": 注意: '" + r.name + "' を " + cur.ver +
                              " から " + r.min_ + " へ上げます（" + r.why +
                              " の要求）。major が変わります\n")
                cur.ver = copy(r.min_)
                cur.why = copy(r.why)
                cur.rev = ""     # 版が動いたので取り直す
                changed = True

        # ③ まだ commit を引いていないものを引く（次の周で依存を集めるため）
        for s in sels:
            if len(s.rev) == 0:
                fetch_manifest(s)
                changed = True

    return sels

# 名前順に並べた**添字**を返す。
#
# ⚠️ list[Sel] を並べ替えて返すと「借用した値をリストに保存できません」
#   （E-BORROW-3）になります。添字だけを返せば所有権は動きません。
def order(sels: list[Sel]) -> list[int]:
    out: list[int] = []
    used: list[bool] = []
    for s in sels:
        used.append(False)
    n: int = len(sels)
    k: int = 0
    while k < n:
        best: int = -1
        i: int = 0
        while i < n:
            if not used[i]:
                if best < 0 or sels[i].name < sels[best].name:
                    best = i
            i = i + 1
        used[best] = True
        out.append(best)
        k = k + 1
    return out
